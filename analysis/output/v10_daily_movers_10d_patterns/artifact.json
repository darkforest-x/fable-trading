  "sources": [
    {
      "id": "derived_analysis",
      "label": "v10 十日扫描二次汇总",
      "path": "analysis/output/v10_daily_movers_10d_patterns/prepare_report_facts.sql",
      "query": {
        "language": "sqlite",
        "sql": "-- Material source query for the v10 ten-day pattern report.\n-- `signals_raw` is the existing signals.csv loaded into an in-memory SQLite DB.\nSELECT\n    day,\n    CAST(rank AS INTEGER) AS rank,\n    symbol,\n    CAST(daily_return AS REAL) AS daily_return,\n    signal_time,\n    CAST(conf AS REAL) AS conf,\n    status,\n    outcome,\n    CAST(gross AS REAL) AS gross,\n    CAST(net_taker AS REAL) AS net_taker,\n    CAST(held_bars AS REAL) AS held_bars,\n    CAST(gross AS REAL) - 0.002 AS net_project\nFROM signals_raw;",
        "description": "该 SQL 由汇总脚本在内存 SQLite 中实际执行，生成信号事实表；脚本再按币日、方向、置信度、时段和重复次数汇总。不读取 K 线、不重新推理。",
        "executed_at": "2026-07-29T06:30:00Z",
        "tables_used": [
          "analysis/output/v10_daily_movers_10d_report/signals.csv",
          "analysis/output/v10_daily_movers_10d_report/daily_rankings.csv"
        ],
        "filters": ["经济统计仅 status=closed", "日期 2026-07-18 至 2026-07-27", "每天事后绝对涨跌幅 Top20"],
        "metric_definitions": [
          "项目净收益 = gross - 0.002（20bp）",
          "首次信号 = 每个 symbol-day 中 signal_time 最早的已平仓信号",
          "全天方向 = 当日第一根开盘到最后一根收盘的涨跌方向",
          "开火覆盖率 = 有至少一条信号的 Top20 币日 / 该方向 Top20 币日"
        ]
      }
    }
  ]
}
