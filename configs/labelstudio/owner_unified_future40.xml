<View>
  <Style>
    .owner-review-controls .lsf-labels,
    .owner-review-controls .lsf-choices { margin: 0; }
  </Style>
  <View className="owner-review-controls" style="display:flex;gap:16px;align-items:center;flex-wrap:wrap">
    <RectangleLabels name="pattern" toName="image" strokeWidth="2">
      <Label value="多头" background="#16a34a" hotkey="1"/>
      <Label value="空头" background="#dc2626" hotkey="2"/>
    </RectangleLabels>
    <Choices name="no_box_reason" toName="image" choice="single" showInline="true">
      <Choice value="无目标形态"/>
      <Choice value="拿不准"/>
    </Choices>
  </View>
  <Header value="$caption" size="5" style="margin:2px 0;font-size:12px;line-height:18px;font-weight:400"/>
  <View style="display:flex;gap:16px;align-items:flex-start;flex-wrap:wrap">
    <View style="flex:1;min-width:350px">
      <Header value="调整这里的框" size="5" style="margin:2px 0;font-size:13px;line-height:20px"/>
      <Image name="image" value="$image" width="100%" maxWidth="100%" zoom="true" zoomControl="true" crosshair="true"/>
    </View>
    <View style="flex:1.2;min-width:400px">
      <Header value="后续走势参考 · 最多40根" size="5" style="margin:2px 0;font-size:13px;line-height:20px"/>
      <Image name="future" value="$future_image" width="100%" maxWidth="100%" zoom="true" zoomControl="true"/>
    </View>
  </View>
  <Collapse>
    <Panel value="查看来源参考图">
      <Image name="original" value="$original_image" width="100%" maxWidth="1000px" zoom="true" zoomControl="true"/>
    </Panel>
    <Panel value="查看补充前文或边界对照">
      <Image name="comparison" value="$comparison_image" width="100%" maxWidth="1280px" zoom="true" zoomControl="true"/>
    </Panel>
  </Collapse>
</View>
