
// TEMPORARY QA APPENDIX. Never included in the delivered private script.
// Exercises the production transition helpers with hand-computed OHLC paths.
if barstate.islast
    TxWatch fixtureWatch = TxWatch.new()
    bool watchPass = not txEligible(fixtureWatch, 1, 1000)
    txObserve(fixtureWatch, 1, 1000)
    watchPass := watchPass and not txEligible(fixtureWatch, 1, 1000) and txEligible(fixtureWatch, 1, 2000) and not txEligible(fixtureWatch, -1, 2000)
    fixtureWatch.consumed := true
    txObserve(fixtureWatch, 1, 3000)
    watchPass := watchPass and fixtureWatch.consumed and fixtureWatch.since == 1000
    txObserve(fixtureWatch, -1, 4000)
    watchPass := watchPass and not fixtureWatch.consumed and fixtureWatch.since == 4000 and txEligible(fixtureWatch, -1, 5000)
    bool stopPass = math.abs(txRoundedStop(1, 98.25, 1.0, 0.1) - 97.2) < 0.000001 and math.abs(txRoundedStop(-1, 101.25, 1.0, 0.1) - 102.3) < 0.000001
    TxTrade fixtureLong = TxTrade.new(1000, 0, 1, 100.0, 99.0, 1.0, 99.0)
    txAdvance(fixtureLong, 0, 1000, 100, 120, 1, 105, true, 1, 5, 4, 0.01)
    bool entryPass = fixtureLong.endedAt == 0 and fixtureLong.peakR == 0 and not fixtureLong.armed
    txAdvance(fixtureLong, 1000, 2000, 100, 106, 99.5, 104, true, 1, 5, 4, 0.01)
    bool armPass = not fixtureLong.armed and fixtureLong.protection == 99 and fixtureLong.peakR == 6
    txAdvance(fixtureLong, 2000, 3000, 104, 106, 100, 105, true, 1, 5, 4, 0.01)
    armPass := armPass and fixtureLong.armed and fixtureLong.armedAt == 3000 and fixtureLong.protection == 101 and fixtureLong.endedAt == 0
    txAdvance(fixtureLong, 3000, 4000, 105, 106, 102, 104, true, 1, 5, 4, 0.01)
    bool ratchetPass = fixtureLong.protection == 101
    txAdvance(fixtureLong, 4000, 5000, 104, 110, 100.5, 109, true, 1, 5, 4, 0.01)
    bool exitPass = fixtureLong.endedAt == 5000 and fixtureLong.exitPrice == 101 and fixtureLong.currentR == 1 and fixtureLong.reason == 2
    TxTrade fixtureShort = TxTrade.new(1000, 0, -1, 100.0, 101.0, 1.0, 101.0)
    txAdvance(fixtureShort, 1000, 2000, 100, 100.5, 94, 95, true, 1, 5, 4, 0.01)
    bool shortPass = fixtureShort.armed and fixtureShort.protection == 99 and fixtureShort.endedAt == 0
    txAdvance(fixtureShort, 2000, 3000, 95, 99.5, 94, 95, false, 1, 5, 4, 0.01)
    shortPass := shortPass and fixtureShort.exitPrice == 99 and fixtureShort.currentR == 1 and fixtureShort.reason == 2
    TxTrade fixtureGap = TxTrade.new(1000, 0, 1, 100.0, 99.0, 1.0, 99.0)
    txAdvance(fixtureGap, 1000, 2000, 97, 98, 96, 97, false, 1, 5, 4, 0.01)
    bool gapPass = fixtureGap.exitPrice == 97 and fixtureGap.endedAt == 1000 and fixtureGap.currentR == -3 and fixtureGap.reason == 1
    TxTrade fixtureNoPartial = TxTrade.new(1000, 0, 1, 100.0, 99.0, 1.0, 99.0)
    txAdvance(fixtureNoPartial, 1000, 2000, 100, 104, 99.5, 103, true, 0.1, 5, 4, 0.01)
    bool noPartialPass = fixtureNoPartial.endedAt == 0 and not fixtureNoPartial.armed and fixtureNoPartial.protection == 99
    array<TxTrade> independent = array.new<TxTrade>()
    TxTrade oldLive = TxTrade.new(1000, 0, 1, 100, 90, 10, 90)
    independent.push(oldLive)
    independent.push(fixtureGap)
    independent.push(fixtureNoPartial)
    txPrune(independent, 1)
    bool independentPass = independent.size() == 2 and independent.first().enteredAt == 1000 and independent.first().endedAt == 0
    txAdvance(oldLive, 5000, 6000, 100, 102, 89, 101, false, 1, 5, 4, 0.01)
    txPrune(independent, 1)
    independentPass := independentPass and independent.size() == 1 and fixtureNoPartial.endedAt == 0
    if not (independentPass and watchPass and stopPass and entryPass and armPass and ratchetPass and exitPass and shortPass and gapPass and noPartialPass)
        runtime.error("TX_NATIVE_CHECKS_FAIL watch=" + str.tostring(watchPass) + " stop=" + str.tostring(stopPass) + " entry=" + str.tostring(entryPass) + " arm=" + str.tostring(armPass) + " ratchet=" + str.tostring(ratchetPass) + " exit=" + str.tostring(exitPass) + " short=" + str.tostring(shortPass) + " gap=" + str.tostring(gapPass) + " partial=" + str.tostring(noPartialPass))

varip bool txFixtureLogged = false
if barstate.islast and not txFixtureLogged and not na(tx)
    txFixtureLogged := true
    float timeSignature = 0
    float priceSignature = 0
    float exitSignature = 0
    float directionSignature = 0
    int index = 0
    for row in str.split(tx.trades, ";")
        array<string> fields = str.split(row, ",")
        if fields.size() == 13
            index += 1
            timeSignature += index * (str.tonumber(fields.get(0)) + str.tonumber(fields.get(1))) / 60000
            priceSignature += index * (str.tonumber(fields.get(3)) + 3 * str.tonumber(fields.get(4))) / syminfo.mintick
            exitSignature += index * (str.tonumber(fields.get(9)) / 60000 + nz(str.tonumber(fields.get(10))) / syminfo.mintick + str.tonumber(fields.get(11)))
            directionSignature += index * str.tonumber(fields.get(2))
    log.info("TX_NATIVE_CHECKS_PASS count={0} active={1} total={2} through={3} watch={4}/{5}/{6} timeSig={7} priceSig={8} exitSig={9} sideSig={10}", tx.count, tx.active, tx.total, tx.closeAt, tx.watchSide, tx.watchSince, tx.consumed, timeSignature, priceSignature, exitSignature, directionSignature)
    log.info("TX_SOURCE_START {0}", tx.sourceStart)
    for row in str.split(tx.trades, ";")
        log.info("TX_ROW {0}", row)
