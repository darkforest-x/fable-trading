//@version=6
// Original research adaptation of the Timeless post, not an exact author clone.
// Native ETH 3m only; no fabricated 30s data or highest-timeframe selection.
// Source: https://discord.com/channels/1106285657879478303/1524851577817661490/1546273453005607002
// APIs: https://www.tradingview.com/pine-script-docs/language/arrays/
// https://www.tradingview.com/pine-script-docs/concepts/time/
// Closed bars only. Custom next-open ledger uses conservative same-bar SL first.
indicator("iFVG + LRL · ETH 3m v1", overlay=true, max_boxes_count=200, max_labels_count=200, max_lines_count=200)
bool useLrl = input.bool(true, "LRL 过滤")
bool onlyNy = input.bool(true, "仅纽约 09:30–10:00，周一至周五")
bool showZones = input.bool(true, "显示 FVG 区域")
bool showLevels = input.bool(true, "显示持仓止损和 1R 目标")
int startAt = input.time(timestamp("01 Aug 2023 00:00 +0000"), "回测起点")
int endAt = input.time(timestamp("01 May 2026 00:00 +0000"), "回测终点（不含后续开仓）")
const float tick = 0.01
const float fee = 0.002
const int wing = 2
const int maxAge = 20
const int rangeLen = 30
const float tolerance = 0.10
if barstate.isfirst and (timeframe.in_seconds() != 180 or not chart.is_standard or syminfo.basecurrency != "ETH")
    runtime.error("本版仅用于标准 ETH 永续 3 分钟K线；不是跨周期原版。")

f_sweep(array<float> values, array<int> origins, float extreme, bool upper) =>
    int j = array.size(values) - 1
    while j >= 0
        bool swept = upper ? extreme > array.get(values, j) : extreme < array.get(values, j)
        if swept or bar_index - array.get(origins, j) > maxAge
            array.remove(values, j)
            array.remove(origins, j)
        j -= 1

f_lrl(array<float> values, array<int> origins, int side, float tol) =>
    bool ok = false
    float target = na
    if array.size(values) >= 3
        int n = array.size(values)
        float a = array.get(values, n-3)
        float b = array.get(values, n-2)
        float d = array.get(values, n-1)
        int ia = array.get(origins, n-3)
        int ib = array.get(origins, n-2)
        int id = array.get(origins, n-1)
        float residual = math.abs(b - (a + (d-a)*(ib-ia)/(id-ia)))
        bool ordered = side == 1 ? d <= a : d >= a
        bool ahead = side*(a-close) > 0 and side*(b-close) > 0 and side*(d-close) > 0
        ok := ordered and ahead and not na(tol) and residual <= tol
        target := side == 1 ? math.min(a,b,d) : math.max(a,b,d)
    [ok, target]

var array<float> pivotHighs = array.new<float>()
var array<int> highOrigins = array.new<int>()
var array<float> pivotLows = array.new<float>()
var array<int> lowOrigins = array.new<int>()
var array<box> boxes = array.new<box>()
var array<line> lrlLines = array.new<line>()
var float lastHigh = na
var float lastLow = na
var float bullBottom = na
var float bullTop = na
var int bullBorn = na
var box bullBox = na
var float bearBottom = na
var float bearTop = na
var int bearBorn = na
var box bearBox = na
var int segmentBars = 0

var int posSide = 0
var float entry = na
var float stop = na
var float target = na
var float risk = na
var int pendingSide = 0
var float pendingStop = na
var float pendingLrl = na
var int pendingCloseTime = na
var int count = 0
var int wins = 0
var int ambiguous = 0
var int rejected = 0
var float netSum = 0.0
var float grossSum = 0.0
var float profitSum = 0.0
var float lossSum = 0.0
var float peak = 0.0
var float maxDd = 0.0
var int lossRun = 0
var int maxLossRun = 0
var int setups = 0
bool longSignal = false
bool shortSignal = false
bool enteredLong = false
bool enteredShort = false
bool closedTrade = false
float exitDisplay = na
float span = ta.highest(high, rangeLen) - ta.lowest(low, rangeLen)
bool pivotHigh = bar_index >= 4 and high[2] > high[4] and high[2] > high[3] and high[2] > high[1] and high[2] > high
bool pivotLow = bar_index >= 4 and low[2] < low[4] and low[2] < low[3] and low[2] < low[1] and low[2] < low
bool gap = not barstate.isfirst and time != time_close[1]
bool valid = not na(open) and not na(high) and not na(low) and not na(close) and low > 0 and high >= math.max(open,close,low) and low <= math.min(open,close,high)
bool permitted = time >= timestamp("31 Jul 2023 11:12 +0000") and time_close <= endAt

if barstate.isconfirmed and permitted
    if gap or not valid
        runtime.error("缺失或无效K线：停止统计，请使用连续数据。")
    if valid
        segmentBars += 1
        // A setup was known at the previous close; never use this bar to choose it.
        if pendingSide != 0
            float newRisk = pendingSide * (open - pendingStop)
            bool passed = useLrl and pendingSide * (pendingLrl - open) <= 0
            if time == pendingCloseTime and time >= startAt and time < endAt and posSide == 0 and newRisk > tick and pendingStop > 0 and not passed
                posSide := pendingSide
                entry := open
                stop := pendingStop
                risk := newRisk
                target := entry + posSide*risk
                enteredLong := posSide == 1
                enteredShort := posSide == -1
            else
                rejected += 1
            pendingSide := 0
        if posSide != 0
            bool hitStop = posSide == 1 ? low <= stop : high >= stop
            bool hitTarget = posSide == 1 ? high >= target : low <= target
            if hitStop or hitTarget
                float fill = hitStop ? (posSide == 1 ? math.min(open,stop) : math.max(open,stop)) : target
                float grossR = posSide * (fill-entry)/risk
                float netR = grossR-fee*entry/risk
                count += 1
                wins += netR > 0 ? 1 : 0
                ambiguous += hitStop and hitTarget ? 1 : 0
                netSum += netR
                grossSum += grossR
                profitSum += math.max(netR,0)
                lossSum += math.max(-netR,0)
                peak := math.max(peak,netSum)
                maxDd := math.max(maxDd,peak-netSum)
                lossRun := netR < 0 ? lossRun+1 : 0
                maxLossRun := math.max(maxLossRun,lossRun)
                closedTrade := true
                exitDisplay := fill
                posSide := 0
        // Feature updates use this completed bar and earlier bars only.
        f_sweep(pivotHighs, highOrigins, high, true)
        f_sweep(pivotLows, lowOrigins, low, false)
        if segmentBars >= 5 and pivotHigh
            lastHigh := high[2]
            array.push(pivotHighs, lastHigh)
            array.push(highOrigins, bar_index-2)
        if segmentBars >= 5 and pivotLow
            lastLow := low[2]
            array.push(pivotLows, lastLow)
            array.push(lowOrigins, bar_index-2)
        if not na(bullBorn) and bar_index-bullBorn > maxAge
            bullBorn := na
        if not na(bearBorn) and bar_index-bearBorn > maxAge
            bearBorn := na
        bool shortRaw = not na(bullBorn) and close < bullBottom
        bool longRaw = not na(bearBorn) and close > bearTop
        if shortRaw
            bullBorn := na
        if longRaw
            bearBorn := na
        if not na(bullBorn) and not na(bullBox)
            box.set_right(bullBox,bar_index)
        if not na(bearBorn) and not na(bearBox)
            box.set_right(bearBox,bar_index)
        int nyMinute = hour(time_close,"America/New_York")*60+minute(time_close,"America/New_York")
        int nyDay = dayofweek(time_close,"America/New_York")
        bool inSession = not onlyNy or (nyMinute >= 570 and nyMinute < 600 and nyDay >= dayofweek.monday and nyDay <= dayofweek.friday)
        [longLrl, longLrlTarget] = f_lrl(pivotHighs, highOrigins, 1, segmentBars >= rangeLen ? span*tolerance : na)
        [shortLrl, shortLrlTarget] = f_lrl(pivotLows, lowOrigins, -1, segmentBars >= rangeLen ? span*tolerance : na)
        int side = longRaw and not shortRaw ? 1 : shortRaw and not longRaw ? -1 : 0
        float proposedStop = side == 1 ? lastLow-tick : lastHigh+tick
        bool lrlOk = side == 1 ? longLrl : shortLrl
        float lrlTarget = side == 1 ? longLrlTarget : shortLrlTarget
        bool accepted = side != 0 and inSession and time_close >= startAt and time_close < endAt and proposedStop > 0 and side*(close-proposedStop) > tick and (not useLrl or lrlOk)
        longSignal := accepted and side == 1
        shortSignal := accepted and side == -1
        if accepted
            // Geometry is drawn only when the complete causal setup is known.
            if useLrl and lrlOk
                array<float> values = side == 1 ? pivotHighs : pivotLows
                array<int> origins = side == 1 ? highOrigins : lowOrigins
                int n = array.size(values)
                array.push(lrlLines,line.new(array.get(origins,n-3),array.get(values,n-3),array.get(origins,n-1),array.get(values,n-1),color=color.aqua,width=2))
                array.push(lrlLines,line.new(bar_index,lrlTarget,bar_index+3,lrlTarget,color=color.aqua,style=line.style_dotted))
                if array.size(lrlLines)>160
                    line.delete(array.shift(lrlLines))
                    line.delete(array.shift(lrlLines))
            setups += 1
            if posSide == 0
                pendingSide := side
                pendingStop := proposedStop
                pendingLrl := lrlTarget
                pendingCloseTime := time_close
            else
                rejected += 1
        if segmentBars >= 3 and low-high[2] >= tick
            bullBorn := bar_index
            bullBottom := high[2]
            bullTop := low
            if showZones
                bullBox := box.new(bar_index,bullTop,bar_index+1,bullBottom,border_color=color.new(color.teal,50),bgcolor=color.new(color.teal,88))
                array.push(boxes,bullBox)
        if segmentBars >= 3 and low[2]-high >= tick
            bearBorn := bar_index
            bearBottom := high
            bearTop := low[2]
            if showZones
                bearBox := box.new(bar_index,bearTop,bar_index+1,bearBottom,border_color=color.new(color.orange,50),bgcolor=color.new(color.orange,88))
                array.push(boxes,bearBox)
        if array.size(boxes)>180
            box.delete(array.shift(boxes))

plotshape(longSignal,"多头候选",shape.triangleup,location.belowbar,color.teal,size=size.small,text="iFVG\nLRL")
plotshape(shortSignal,"空头候选",shape.triangledown,location.abovebar,color.orange,size=size.small,text="iFVG\nLRL")
plotshape(enteredLong,"回测多头成交",shape.circle,location.belowbar,color.new(color.teal,20),size=size.tiny)
plotshape(enteredShort,"回测空头成交",shape.circle,location.abovebar,color.new(color.orange,20),size=size.tiny)
plot(showLevels and posSide != 0 ? stop : na,"持仓止损",color.red,1,plot.style_linebr)
plot(showLevels and posSide != 0 ? target : na,"持仓1R",color.teal,1,plot.style_linebr)
plot(closedTrade ? exitDisplay : na,"回测退出",color.yellow,2,plot.style_circles)
alertcondition(longSignal,"iFVG LRL 多头候选","ETH 3m 收盘多头候选；下一根开盘仍需校验风险及目标。")
alertcondition(shortSignal,"iFVG LRL 空头候选","ETH 3m 收盘空头候选；下一根开盘仍需校验风险及目标。")

var table panel = table.new(position.top_right,2,10,border_width=1,bgcolor=chart.bg_color)
if barstate.islast
    table.cell(panel,0,0,"ETH 3m iFVG + LRL",text_color=color.white,bgcolor=color.new(color.teal,30))
    table.cell(panel,1,0,useLrl ? "LRL开启" : "仅iFVG",text_color=color.white,bgcolor=color.new(color.teal,30))
    table.cell(panel,0,1,"候选 / 已平仓")
    table.cell(panel,1,1,str.tostring(setups)+" / "+str.tostring(count))
    table.cell(panel,0,2,"净胜率")
    table.cell(panel,1,2,count>0 ? str.tostring(100.0*wins/count,"#.##")+"%" : "无交易")
    table.cell(panel,0,3,"累计毛R / 净R")
    table.cell(panel,1,3,str.tostring(grossSum,"#.##")+" / "+str.tostring(netSum,"#.##"))
    table.cell(panel,0,4,"净PF")
    table.cell(panel,1,4,lossSum>0 ? str.tostring(profitSum/lossSum,"#.###") : "无定义")
    table.cell(panel,0,5,"最大回撤R / 连亏")
    table.cell(panel,1,5,str.tostring(maxDd,"#.##")+" / "+str.tostring(maxLossRun))
    table.cell(panel,0,6,"双触SL / 拒单")
    table.cell(panel,1,6,str.tostring(ambiguous)+" / "+str.tostring(rejected))
    table.cell(panel,0,7,"未平仓 / 待成交")
    table.cell(panel,1,7,str.tostring(posSide != 0 ? 1 : 0)+" / "+str.tostring(pendingSide != 0 ? 1 : 0))
    table.cell(panel,0,8,"口径")
    table.cell(panel,1,8,"下一开盘 · 1R · 往返0.2%")
    table.cell(panel,0,9,"范围")
    table.cell(panel,1,9,"仅图表已加载历史；本地报告为长历史")
