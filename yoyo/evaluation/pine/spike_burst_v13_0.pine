plotcandle(not na(v126CandleTone) ? open : na, high, low, close, title="突破 / Pin Bar 实体与影线", color=v126CandleTone, wickcolor=v126CandleTone, bordercolor=v126CandleTone, editable=false, force_overlay=true, display=display.pane)

