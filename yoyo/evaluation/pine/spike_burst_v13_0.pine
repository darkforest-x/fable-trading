// BEGIN V126 INPUTS
// Presentation only. No input below participates in admission, pairing or exits.
bool v126Minimal = input.bool(false, "仅六均线＋趋势线主线", group=gView, tooltip="隐藏信号文字、A/B/C、BB、盈亏框、上级均线、面板和IMACD；保留本周期/上级主趋势线及历史区域。K线着色仍由独立开关控制。副图空白区域需手动折叠。", display=display.none)
bool v126AutoContrast = input.bool(true, "趋势线自动适配背景", group=gView, tooltip="浅色背景用黑色，深色背景用白色；关闭后使用本周期/上级线自定义颜色。历史透明度仍生效。", display=display.none)
color v126Contrast = (0.2126 * color.r(chart.bg_color) + 0.7152 * color.g(chart.bg_color) + 0.0722 * color.b(chart.bg_color)) >= 128 ? color.black : color.white
bool v126PaintBreak = input.bool(true, "突破站稳K线着色", group=gView, tooltip="从已确认突破当根开始计数，不回填此前确认中的K线；收盘跌回冻结趋势线或数据断档即停止。本周期和上级突破均支持。同一B点8根内的重复确认不延长着色窗口。仅显示变化。", display=display.none)
int v126BreakBars = input.int(3, "突破着色根数（含确认当根）", minval=1, maxval=20, group=gView, display=display.none)
bool v126CustomBreak = input.bool(false, "突破K线使用自定义颜色", group=gView, tooltip="关闭时跟随对应趋势线颜色。", display=display.none)
color v126BreakColor = input.color(#E6A23C, "突破K线自定义色", group=gView, display=display.none)
bool v126PaintPin = input.bool(true, "Pin Bar 独立着色", group=gView, tooltip="仅已收盘K：实体≤全长30%，主影线≥60%，反侧影线≤20%，全长至少4个最小跳动。不要求阳线或阴线；仅标形状，不代表已确认反转或流动性扫单。", display=display.none)
color v126LowerPinColor = input.color(#009688, "Pin Bar 长下影", group=gView, display=display.none)
color v126UpperPinColor = input.color(#D65A8A, "Pin Bar 长上影", group=gView, display=display.none)
bool v126PinPriority = input.bool(false, "Pin Bar 优先于突破着色", group=gView, tooltip="默认突破颜色优先，其次Pin Bar，最后普通V9确认色。开启后Pin Bar优先。", display=display.none)

// END V126 INPUTS
bool v10OnlyJoint = input.bool(false, "仅显示突破+spike 信号", group=gView, tooltip="含「突破+spike（上级突破）」。只控制显示，不改变信号计算或预警。隐藏普通多空、单独突破、普通价格标签/染色及V9盈亏框；保留联合标记、对应趋势线、均线和IMACD。", display=display.none) and not v126Minimal

// 为联合标记预留对象配额：普通价格标签40个，退出标签20个。
const int SIGNAL_TAG_LIMIT = 40
const int EXIT_TAG_LIMIT = 20

bool showMas = input.bool(true, "六条均线", group=gView, display=display.none) or v126Minimal
bool showLabels = input.bool(true, "确认信号与价格", group=gView, tooltip="只显示完成实体支撑、原确认关联与主线转强后的最终信号，标在实际完成K线上，不回填。", display=display.none) and not v126Minimal
bool showRisk = input.bool(true, "风险区与保护线", group=gView, tooltip="确认收盘开启风险参考；同向重复不重置。反向确认在收盘结束旧参考，新风险有效时开启反向参考；本根先触及原保护时以原保护结算。", display=display.none) and not v126Minimal and not v130Retest
bool showPanel = input.bool(true, "显示状态面板", group=gView, display=display.none) and not v126Minimal
bool showMilestones = input.bool(true, "R 参考与里程碑", group=gView, tooltip="入场即预先显示 1R、2R、3R 参考价；达到后仍分别标记 3R、5R、10R。均不是固定止盈。", display=display.none) and not v126Minimal and not v130Retest
bool showExitLabels = input.bool(false, "退出文字", group=gView, display=display.none) and not v126Minimal and not v130Retest
color signalColor = input.color(color.white, "信号 K 线颜色（实体 / 影线）", group=gView, display=display.none)

color bull = #008F82
color bear = #D34B66
color gold = #AD7B29
color blue = #4679C9
color ink = chart.fg_color
color muted = color.new(ink, 40)

// ───────────── BB 通道与过滤 ─────────────

string gBb = "02 · BB 压缩通道"

bool useBbFilter = input.bool(true, "仅保留近期持续压缩后的信号", group=gBb, tooltip="信号前12根内须有连续3根带宽处于此前500根最低10%区域。不要求信号当根扩张；原V6反向确认仍可结束已有风险参考。关闭仅跳过BB条件，距离门和V9三条过滤仍独立生效。", display=display.none)

// V12 displays the historical compression zones by default.
bool showBb = input.bool(true, "显示 BB 压缩通道", group=gBb, display=display.none) and not v126Minimal
int bbLength = input.int(200, "SMA 长度", minval=2, group=gBb, display=display.none)
float bbMult = input.float(2.0, "标准差倍数", minval=0.1, step=0.1, group=gBb, display=display.none)
bool bbOnlyCompressed = input.bool(true, "仅显示压缩段", group=gBb, display=display.none)
bool bbShowBasis = input.bool(false, "显示中线", group=gBb, display=display.none)
color bbChannelColor = input.color(color.new(#7D8490, 48), "通道颜色", group=gBb, display=display.none)
color bbCompressionColor = input.color(#AD7B29, "压缩颜色", group=gBb, display=display.none)

string gV8 = "03 · V8 噪音过滤"

bool useOverheatFilter = input.bool(true, "过滤离六线超过 3ATR 的迟到信号", group=gV8, tooltip="只影响新入场确认：多头收盘离六线最高边、空头收盘离六线最低边超过3ATR时不显示、不报警。原始反向确认仍可结束已有参考。", display=display.none)

// BEGIN CONFIRMED H1 SMA60 INPUT
string gH1Sma = "03 · 15m 上级方向过滤"
bool useH1Sma60 = input.bool(true, "15分钟启用1小时 SMA60 方向过滤", group=gH1Sma, tooltip="仅15分钟生效：确认收盘价高于上一根已收盘1小时SMA60才开多，低于才开空。等于或均线未就绪时不入场。原始反向确认仍结束旧参考，其他周期不变。", display=display.none)
bool showH1Sma60 = input.bool(true, "显示1小时方向线", group=gH1Sma, tooltip="在15分钟主图显示已完成1小时SMA60。仅控制线的显示，不改变过滤。", display=display.none) and not v126Minimal
// END CONFIRMED H1 SMA60 INPUT
// BEGIN CONFIRMED H1 SMA60 HELPER
// Source: TradingView Other timeframes and data, confirmed HTF values.
// Inputs: native H1 OHLCV and clock; only 60 consecutive valid completed hours.
// Offset INSIDE security so developing H1 data never enters admission.
f_h1Sma60() =>
    bool valid = not na(open) and not na(high) and not na(low) and not na(close) and not na(volume) and low > 0 and high >= math.max(open, close, low) and low <= math.min(open, close, high) and volume >= 0
    var int contiguous = 0
    contiguous := not valid ? 0 : time == time_close[1] ? contiguous + 1 : 1
    float average = ta.sma(close, 60)
    float knownAverage = contiguous >= 60 ? average : na
    [knownAverage[1], time_close[1]]
// END CONFIRMED H1 SMA60 HELPER
// BEGIN CONFIRMED M15 EMA120 INPUT
string gM15Ema = "03 · 5m 上级方向过滤"
bool useM15Ema120 = input.bool(true, "5分钟启用15分钟 EMA120 方向过滤", group=gM15Ema, tooltip="仅5分钟生效：确认收盘价高于上一根已完成15分钟EMA120才开多，低于才开空；相等或均线未就绪不新入场。使用已完成上级K线，原始反向确认仍结束旧参考。", display=display.none)
bool showM15Ema120 = input.bool(true, "显示15分钟方向线", group=gM15Ema, tooltip="在5分钟主图显示已完成15分钟EMA120。仅控制线的显示，不改变过滤。", display=display.none) and not v126Minimal
// END CONFIRMED M15 EMA120 INPUT
// BEGIN CONFIRMED M15 EMA120 HELPER
// Source: TradingView confirmed HTF idiom and spike_v9_5m_15m_ma.confirmed_ma.
// Inputs: native M15 OHLCV and clock. First-close seed, alpha 2/121,
// 1200 consecutive valid bars before admission; invalid/missing bars reset it.
// Return the PRIOR higher bar, so its close is known at the chart bar OPEN.
f_m15Ema120() =>
    bool valid = not na(open) and not na(high) and not na(low) and not na(close) and not na(volume) and low > 0 and high >= math.max(open, close, low) and low <= math.min(open, close, high) and volume >= 0
    var int contiguous = 0
    contiguous := not valid ? 0 : time == time_close[1] ? contiguous + 1 : 1
    var float average = na
    float alpha = 2.0 / 121.0
    average := not valid ? na : contiguous == 1 ? close : alpha * close + (1.0 - alpha) * average[1]
    float knownAverage = contiguous >= 1200 ? average : na
    [knownAverage[1], time_close[1]]
// END CONFIRMED M15 EMA120 HELPER
// ───────────── 原有工具函数 ─────────────

f_risk(int side, float entry, float extreme, float a, float floorAtr, float bufferAtr, float tick) =>
    bool known = (side == 1 or side == -1) and entry > 0 and a > 0 and tick > 0 and not na(extreme)
    float candidate = side == 1 ? math.min(extreme - bufferAtr * a, entry - floorAtr * a) : math.max(extreme + bufferAtr * a, entry + floorAtr * a)
    float stop = known ? (side == 1 ? math.floor(candidate / tick) * tick : math.ceil(candidate / tick) * tick) : na
    float risk = side * (entry - stop)
    bool valid = known and stop > 0 and risk > 0
    [valid ? stop : na, valid ? risk : na, valid]

f_path(int side, float entry, float risk, float priorProtection, float priorPeak, bool wasArmed, float o, float h, float l, float c, float a, float activationR, float distanceAtr, float tick) =>
    bool stopped = side == 1 ? l <= priorProtection : h >= priorProtection
    float exitPrice = stopped ? (side == 1 ? math.min(o, priorProtection) : math.max(o, priorProtection)) : na
    float currentR = side * ((stopped ? exitPrice : c) - entry) / risk
    float peakR = stopped ? priorPeak : math.max(priorPeak, side * ((side == 1 ? h : l) - entry) / risk)
    bool armed = wasArmed or (not stopped and currentR >= activationR)
    float protection = priorProtection

    if not stopped and armed and a > 0
        float raw = c - side * distanceAtr * a
        float candidate = side == 1 ? math.floor(raw / tick) * tick : math.ceil(raw / tick) * tick
        protection := side == 1 ? math.max(priorProtection, candidate) : math.min(priorProtection, candidate)

    [not stopped, protection, peakR, currentR, exitPrice, armed]

f_smma(float source, int length) =>
    float seed = ta.sma(source, length)
    var float value = na
    value := na(value[1]) ? seed : (value[1] * (length - 1) + source) / length
    value

f_flip(float a, float b) =>
    float d = a - b
    (d > 0 and d[1] <= 0) or (d < 0 and d[1] >= 0) ? 1.0 : 0.0

f_directionalCandle(int side, float o, float h, float l, float c, float bodyGate, float endGate) =>
    float span = h - l
    bool known = span > 0 and not na(o) and not na(h) and not na(l) and not na(c)
    float body = known ? math.abs(c - o) / span : na
    float endPosition = known ? (side == 1 ? (c - l) / span : (h - c) / span) : na
    bool direction = side == 1 ? c > o : side == -1 ? c < o : false
    known and direction and body >= bodyGate and endPosition >= endGate

// ───────────── 数据与 BB 背景 ─────────────

bool pricesValid = not na(open) and not na(high) and not na(low) and not na(close) and low > 0 and high >= math.max(open, close, low) and low <= math.min(open, close, high)
bool dataGap = not barstate.isfirst and (time != time_close[1] or not pricesValid or not pricesValid[1])
bool bbDataGap = not barstate.isfirst and (time != time_close[1] or not pricesValid or not pricesValid[1])

var int bbSegmentBars = 0
bbSegmentBars := not pricesValid ? 0 : bbDataGap ? 1 : bbSegmentBars + 1

float bbBasis = ta.sma(close, bbLength)
float bbStdev = ta.stdev(close, bbLength, true)
float bbUpper = bbBasis + bbMult * bbStdev
float bbLower = bbBasis - bbMult * bbStdev
float bbWidth = bbBasis != 0 ? (bbUpper - bbLower) / math.abs(bbBasis) : na

bool bbBandReady = pricesValid and bbSegmentBars >= bbLength and not na(bbBasis) and not na(bbStdev)
float bbPriorWidthP10 = ta.percentile_linear_interpolation(bbWidth[1], 500, 10)
bool bbReady = bbBandReady and bbSegmentBars >= bbLength + 500 and not na(bbPriorWidthP10)
bool bbCompressed = bbReady and bbWidth <= bbPriorWidthP10
bool bbAdmissionReady = bbReady and bbSegmentBars >= bbLength + 500 + 12

bool bbRecentCompression = false

for bbOffset = 1 to 10
    bbRecentCompression := bbRecentCompression or (bbCompressed[bbOffset] and bbCompressed[bbOffset + 1] and bbCompressed[bbOffset + 2])

bool bbEntryAllowed = not useBbFilter or (bbAdmissionReady and bbRecentCompression)

var int segmentIndex = -1
segmentIndex := dataGap or not pricesValid ? 0 : segmentIndex + 1

bool resetVolume = barstate.isfirst or dataGap

float tr = ta.tr(true)
float smHigh = f_smma(high, maLen)
float smLow = f_smma(low, maLen)
float ema1 = ta.ema(hlc3, maLen)
float middle = 2.0 * ema1 - ta.ema(ema1, maLen)
float md = middle > smHigh ? middle - smHigh : middle < smLow ? middle - smLow : 0.0
float sb = ta.sma(md, sigLen)
float atr = f_smma(tr, 14)

// ───────────── 六均线与量能 ─────────────

float s20 = ta.sma(close, 20)
float e20 = ta.ema(close, 20)
float s60 = ta.sma(close, 60)
float e60 = ta.ema(close, 60)
float s120 = ta.sma(close, 120)
float e120 = ta.ema(close, 120)

float ropeHigh = math.max(s20, e20, s60, e60, s120, e120)
float ropeLow = math.min(s20, e20, s60, e60, s120, e120)

float width = atr > 0 ? (ropeHigh - ropeLow) / atr : na
float flips = f_flip(s20,e20) + f_flip(s20,s60) + f_flip(s20,e60) + f_flip(s20,s120) + f_flip(s20,e120) + f_flip(e20,s60) + f_flip(e20,e60) + f_flip(e20,s120) + f_flip(e20,e120) + f_flip(s60,e60) + f_flip(s60,s120) + f_flip(s60,e120) + f_flip(e60,s120) + f_flip(e60,e120) + f_flip(s120,e120)
float pastWidth = ta.sma(width[1], denseLen)
float pastCrosses = math.sum(flips[1], denseLen)

bool baseReady = pricesValid and bar_index >= math.max(340, 10 * maLen) and atr[1] > 0 and not na(sb) and not na(pastWidth)
bool ready = baseReady and segmentIndex >= breakoutLookback

var array<float> validVolumes = array.new<float>()

if resetVolume
    array.clear(validVolumes)

if not na(volume) and volume >= 0
    array.push(validVolumes, volume)
    if array.size(validVolumes) > 20
        array.shift(validVolumes)

float volumeMedian = array.size(validVolumes) == 20 ? array.median(validVolumes) : na
float rv = volumeMedian[1] > 0 and not na(volume) ? volume / volumeMedian[1] : na
float expansion = atr[1] > 0 ? tr / atr[1] : na
float recentLow = ta.lowest(low, stopLen)

// ───────────── 原有密集与启动字段 ─────────────

bool dense = baseReady and segmentIndex >= denseLen and pastWidth <= denseWidth and pastCrosses >= denseCrosses
float denseHitsRaw = math.sum(dense[1] ? 1.0 : 0.0, breakoutLookback)
float denseHits = segmentIndex >= breakoutLookback ? denseHitsRaw : na
bool recentDense = denseHits > 0

float priorHigh = ta.highest(high[1], breakoutLookback)
float priorLow = ta.lowest(low[1], breakoutLookback)
float move3 = close - close[3]
float advance3 = atr[3] > 0 ? move3 / atr[3] : na

float volumeBase3 = volumeMedian[3]
float volumeSum3 = math.sum(volume, 3)
bool volumeKnown3 = not na(volume) and not na(volume[1]) and not na(volume[2])
float volumeRatio3 = volumeKnown3 and volumeBase3 > 0 ? volumeSum3 / (3.0 * volumeBase3) : na

float trSum3 = math.sum(tr, 3)
float efficiency3 = trSum3 > 0 ? move3 / trSum3 : na
float closePosition = high > low ? (close - low) / (high - low) : na

bool aboveSix = close > ropeHigh
bool earlyRaw = ready and close > priorHigh and close > math.max(s20, e20)
bool confirmQuality = ready and recentDense and advance3 >= minAdvance and volumeRatio3 >= minVolume and md >= sb and middle > middle[1]

float recentHigh = ta.highest(high, stopLen)
bool earlyShortRaw = ready and close < priorLow and close < math.min(s20, e20)
bool confirmShortQuality = ready and recentDense and advance3 <= -minAdvance and volumeRatio3 >= minVolume and md <= sb and middle < middle[1]

bool longCandleShape = f_directionalCandle(1, open, high, low, close, minBody, minEnd)
bool shortCandleShape = f_directionalCandle(-1, open, high, low, close, minBody, minEnd)

bool longEvidenceNow = longCandleShape and advance3 >= minAdvance and volumeRatio3 >= minVolume
bool shortEvidenceNow = shortCandleShape and advance3 <= -minAdvance and volumeRatio3 >= minVolume

bool longLaunchWindowShape = longCandleShape or longCandleShape[1] or longCandleShape[2]
bool shortLaunchWindowShape = shortCandleShape or shortCandleShape[1] or shortCandleShape[2]

int longLaunchWindowShapeBar = longCandleShape ? bar_index : longCandleShape[1] ? bar_index - 1 : longCandleShape[2] ? bar_index - 2 : na
int shortLaunchWindowShapeBar = shortCandleShape ? bar_index : shortCandleShape[1] ? bar_index - 1 : shortCandleShape[2] ? bar_index - 2 : na

bool longLegacySeedEvidence = longLaunchWindowShape and advance3 >= minAdvance and volumeRatio3 >= minVolume
bool shortLegacySeedEvidence = shortLaunchWindowShape and advance3 <= -minAdvance and volumeRatio3 >= minVolume

if barstate.isfirst and (not chart.is_standard or timeframe.isticks)
    runtime.error("请使用普通时间 K 线，合成K线不支持。")

// ───────────── 原始多头确认 ─────────────

var bool previousEarlyRaw = false
var int lastAcceptedBar = na
var int parentBar = na
var float parentHigh = na
var float parentLow = na
var float parentPrice = na
var bool parentConfirmed = false

bool legacyEarlySignal = false
bool legacyConfirmedSignal = false

int legacyConfirmationAge = na
float legacyConfirmationParentPrice = na
float legacyConfirmationParentHigh = na
float legacyConfirmationParentLow = na

if barstate.isconfirmed
    if dataGap
        lastAcceptedBar := na
        previousEarlyRaw := false
        parentBar := na
        parentHigh := na
        parentLow := na
        parentPrice := na
        parentConfirmed := false

    bool cooldownPassed = na(lastAcceptedBar) or bar_index - lastAcceptedBar >= cooldownBars
    legacyEarlySignal := earlyRaw and not previousEarlyRaw and cooldownPassed
    previousEarlyRaw := earlyRaw

    if legacyEarlySignal
        lastAcceptedBar := bar_index
        parentBar := bar_index
        parentHigh := priorHigh
        parentLow := priorLow
        parentPrice := close
        parentConfirmed := false

    int age = na(parentBar) ? na : bar_index - parentBar

    if not na(age) and age > confirmMaxAge
        parentBar := na
        parentHigh := na
        parentLow := na
        parentPrice := na
        parentConfirmed := false

    if not na(parentBar) and not parentConfirmed and age >= 0 and age <= confirmMaxAge and close > parentHigh and confirmQuality
        legacyConfirmedSignal := true
        legacyConfirmationAge := age
        legacyConfirmationParentPrice := parentPrice
        legacyConfirmationParentHigh := parentHigh
        legacyConfirmationParentLow := parentLow
        parentConfirmed := true

// ───────────── 原始空头确认 ─────────────

var bool previousEarlyShortRaw = false
var int lastShortAcceptedBar = na
var int shortParentBar = na
var float shortParentHigh = na
var float shortParentLow = na
var float shortParentPrice = na
var bool shortParentConfirmed = false

bool legacyShortEarlySignal = false
bool legacyShortConfirmedSignal = false

int legacyShortConfirmationAge = na
float legacyShortConfirmationParentPrice = na
float legacyShortConfirmationParentHigh = na
float legacyShortConfirmationParentLow = na

if barstate.isconfirmed
    if dataGap
        lastShortAcceptedBar := na
        previousEarlyShortRaw := false
        shortParentBar := na
        shortParentHigh := na
        shortParentLow := na
        shortParentPrice := na
        shortParentConfirmed := false

    bool shortCooldownPassed = na(lastShortAcceptedBar) or bar_index - lastShortAcceptedBar >= cooldownBars
    legacyShortEarlySignal := earlyShortRaw and not previousEarlyShortRaw and shortCooldownPassed
    previousEarlyShortRaw := earlyShortRaw

    if legacyShortEarlySignal
        lastShortAcceptedBar := bar_index
        shortParentBar := bar_index
        shortParentHigh := priorHigh
        shortParentLow := priorLow
        shortParentPrice := close
        shortParentConfirmed := false

    int shortAge = na(shortParentBar) ? na : bar_index - shortParentBar

    if not na(shortAge) and shortAge > confirmMaxAge
        shortParentBar := na
        shortParentHigh := na
        shortParentLow := na
        shortParentPrice := na
        shortParentConfirmed := false

    if not na(shortParentBar) and not shortParentConfirmed and shortAge >= 0 and shortAge <= confirmMaxAge and close < shortParentLow and confirmShortQuality
        legacyShortConfirmedSignal := true
        legacyShortConfirmationAge := shortAge
        legacyShortConfirmationParentPrice := shortParentPrice
        legacyShortConfirmationParentHigh := shortParentHigh
        legacyShortConfirmationParentLow := shortParentLow
        shortParentConfirmed := true

// ───────────── 多头结构确认 ─────────────

var int bodySupportBar = na
var int legacyBar = na
var float legacyParentHigh = na
var float legacyParentLow = na
var bool structurePending = false
var bool launchEvidence = false
var int launchEvidenceBar = na

bool confirmedSignal = false
bool consumedLaunchEvidence = false
int consumedLaunchEvidenceBar = na
int confirmationAge = na
string pendingWhy = "idle"

if barstate.isconfirmed
    bool finiteAtr = not na(atr) and atr > 0
    bool knownStructure = ready and pricesValid and finiteAtr and not na(md) and not na(sb) and not na(ropeHigh) and not na(middle)

    if dataGap or not knownStructure
        bodySupportBar := na
        legacyBar := na
        legacyParentHigh := na
        legacyParentLow := na
        structurePending := false
        launchEvidence := false
        launchEvidenceBar := na
        pendingWhy := dataGap ? "gap" : "unknown"
    else
        bool fullBodyAbove = math.min(open, close) > ropeHigh

        if close <= ropeHigh
            bodySupportBar := na
        else if fullBodyAbove
            bodySupportBar := bar_index

        if legacyConfirmedSignal and not na(legacyConfirmationParentHigh) and not na(legacyConfirmationParentLow) and legacyConfirmationParentLow <= legacyConfirmationParentHigh
            legacyBar := bar_index
            legacyParentHigh := legacyConfirmationParentHigh
            legacyParentLow := legacyConfirmationParentLow
            structurePending := true
            launchEvidence := longLegacySeedEvidence
            launchEvidenceBar := longLegacySeedEvidence ? longLaunchWindowShapeBar : na
        else if structurePending and longEvidenceNow
            launchEvidence := true
            launchEvidenceBar := bar_index

        if structurePending and (na(legacyParentHigh) or na(legacyParentLow) or close < legacyParentLow)
            legacyBar := na
            legacyParentHigh := na
            legacyParentLow := na
            structurePending := false
            launchEvidence := false
            launchEvidenceBar := na
            pendingWhy := "parent_broken"
        else if structurePending and launchEvidence and not na(bodySupportBar) and not na(legacyParentHigh) and not na(legacyParentLow) and not na(md[1]) and close > ropeHigh and close > legacyParentHigh and md > sb and md > md[1]
            confirmedSignal := true
            consumedLaunchEvidence := launchEvidence
            consumedLaunchEvidenceBar := launchEvidenceBar
            confirmationAge := bar_index - legacyBar
            structurePending := false
            launchEvidence := false
            launchEvidenceBar := na
            pendingWhy := "confirmed"
        else
            pendingWhy := not structurePending ? "await_legacy" : not launchEvidence ? "await_launch_evidence" : na(bodySupportBar) ? "await_body" : na(md[1]) ? "await_md_turn" : "await_momentum"

// ───────────── 空头结构确认 ─────────────

var int shortBodySupportBar = na
var int shortLegacyBar = na
var float shortLegacyParentHigh = na
var float shortLegacyParentLow = na
var bool shortStructurePending = false
var bool shortLaunchEvidence = false
var int shortLaunchEvidenceBar = na

bool confirmedShortSignal = false
bool consumedShortLaunchEvidence = false
int consumedShortLaunchEvidenceBar = na
int shortConfirmationAge = na
string shortPendingWhy = "idle"

if barstate.isconfirmed
    bool finiteShortAtr = not na(atr) and atr > 0
    bool knownShortStructure = ready and pricesValid and finiteShortAtr and not na(md) and not na(sb) and not na(ropeLow) and not na(middle)

    if dataGap or not knownShortStructure
        shortBodySupportBar := na
        shortLegacyBar := na
        shortLegacyParentHigh := na
        shortLegacyParentLow := na
        shortStructurePending := false
        shortLaunchEvidence := false
        shortLaunchEvidenceBar := na
        shortPendingWhy := dataGap ? "gap" : "unknown"
    else
        bool fullBodyBelow = math.max(open, close) < ropeLow

        if close >= ropeLow
            shortBodySupportBar := na
        else if fullBodyBelow
            shortBodySupportBar := bar_index

        if legacyShortConfirmedSignal and not na(legacyShortConfirmationParentHigh) and not na(legacyShortConfirmationParentLow) and legacyShortConfirmationParentLow <= legacyShortConfirmationParentHigh
            shortLegacyBar := bar_index
            shortLegacyParentHigh := legacyShortConfirmationParentHigh
            shortLegacyParentLow := legacyShortConfirmationParentLow
            shortStructurePending := true
            shortLaunchEvidence := shortLegacySeedEvidence
            shortLaunchEvidenceBar := shortLegacySeedEvidence ? shortLaunchWindowShapeBar : na
        else if shortStructurePending and shortEvidenceNow
            shortLaunchEvidence := true
            shortLaunchEvidenceBar := bar_index

        if shortStructurePending and close > shortLegacyParentHigh
            shortLegacyBar := na
            shortLegacyParentHigh := na
            shortLegacyParentLow := na
            shortStructurePending := false
            shortLaunchEvidence := false
            shortLaunchEvidenceBar := na
            shortPendingWhy := "parent_broken"
        else if shortStructurePending and shortLaunchEvidence and not na(shortBodySupportBar) and not na(shortLegacyParentHigh) and not na(shortLegacyParentLow) and not na(md[1]) and close < ropeLow and close < shortLegacyParentLow and md < sb and md < md[1]
            confirmedShortSignal := true
            consumedShortLaunchEvidence := shortLaunchEvidence
            consumedShortLaunchEvidenceBar := shortLaunchEvidenceBar
            shortConfirmationAge := bar_index - shortLegacyBar
            shortStructurePending := false
            shortLaunchEvidence := false
            shortLaunchEvidenceBar := na
            shortPendingWhy := "confirmed"
        else
            shortPendingWhy := not shortStructurePending ? "await_legacy" : not shortLaunchEvidence ? "await_launch_evidence" : na(shortBodySupportBar) ? "await_body" : na(md[1]) ? "await_md_turn" : "await_momentum"

// ───────────── V9 最终过滤 ─────────────

int rawSignalSide = confirmedSignal ? 1 : confirmedShortSignal ? -1 : 0

float ropeDistanceAtr = rawSignalSide == 1 and atr > 0 ? (close - ropeHigh) / atr : rawSignalSide == -1 and atr > 0 ? (ropeLow - close) / atr : na
bool v8EntryAllowed = not useOverheatFilter or (not na(ropeDistanceAtr) and ropeDistanceAtr <= maxRopeDistanceAtr)

string baseAsset = str.upper(syminfo.basecurrency)
bool baseAssetKnown = not na(baseAsset) and str.length(baseAsset) > 0
bool baseAllowed = baseAssetKnown and baseAsset != "USDC"

bool volumeRatioKnown = not na(rv) and rv >= 0
bool volumeAllowed = volumeRatioKnown and rv <= maxVolumeRatio

bool entryClockKnown = not na(time_close)
bool utcSunday = entryClockKnown and dayofweek(time_close, "UTC") == dayofweek.sunday
bool calendarAllowed = entryClockKnown and not utcSunday

// BEGIN CONFIRMED H1 SMA60 GATE
bool h1SmaApplies = useH1Sma60 and timeframe.isminutes and timeframe.multiplier == 15
[h1Sma60Raw, h1SmaCloseTime] = request.security(syminfo.tickerid, "60", f_h1Sma60(), gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_on)
// Do not carry a stale higher bar over a missing hour. Chart OPEN matches study.
bool h1SmaReady = not na(h1Sma60Raw) and h1Sma60Raw > 0 and h1SmaCloseTime == time("60")
float h1Sma60 = h1SmaReady ? h1Sma60Raw : na
bool h1SmaDirectionAllowed = rawSignalSide == 1 ? close > h1Sma60 : rawSignalSide == -1 ? close < h1Sma60 : false
bool h1SmaEntryAllowed = not h1SmaApplies or (h1SmaReady and h1SmaDirectionAllowed)
// END CONFIRMED H1 SMA60 GATE
// BEGIN CONFIRMED M15 EMA120 GATE
bool m15EmaApplies = useM15Ema120 and timeframe.isminutes and timeframe.multiplier == 5
[m15Ema120Raw, m15EmaCloseTime] = request.security(syminfo.tickerid, "15", f_m15Ema120(), gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_on)
// Refuse a stale higher value across a missing M15 bucket.
bool m15EmaReady = not na(m15Ema120Raw) and m15Ema120Raw > 0 and m15EmaCloseTime == time("15")
float m15Ema120 = m15EmaReady ? m15Ema120Raw : na
bool m15EmaDirectionAllowed = rawSignalSide == 1 ? close > m15Ema120 : rawSignalSide == -1 ? close < m15Ema120 : false
bool m15EmaEntryAllowed = not m15EmaApplies or (m15EmaReady and m15EmaDirectionAllowed)
// END CONFIRMED M15 EMA120 GATE
bool v9BundleAllowed = baseAllowed and volumeAllowed and calendarAllowed
bool v9EntryAllowed = bbEntryAllowed and v8EntryAllowed and v9BundleAllowed and h1SmaEntryAllowed and m15EmaEntryAllowed

string v9Reasons = ""
v9Reasons += not baseAssetKnown ? "底层资产未知；" : not baseAllowed ? "底层USDC；" : ""
v9Reasons += not volumeRatioKnown ? "量比未知；" : not volumeAllowed ? "量比>50；" : ""
v9Reasons += not entryClockKnown ? "开仓时钟未知；" : utcSunday ? "UTC周日；" : ""
v9Reasons += not bbEntryAllowed ? "BB条件未通过；" : ""
v9Reasons += not v8EntryAllowed ? "距六线>3ATR或未知；" : ""
// BEGIN CONFIRMED H1 SMA60 REASON
v9Reasons += not h1SmaApplies ? "" : not h1SmaReady ? "1h SMA60未就绪；" : rawSignalSide == 1 and not h1SmaDirectionAllowed ? "多头未站上1h SMA60；" : rawSignalSide == -1 and not h1SmaDirectionAllowed ? "空头未跌破1h SMA60；" : ""
// END CONFIRMED H1 SMA60 REASON
// BEGIN CONFIRMED M15 EMA120 REASON
v9Reasons += not m15EmaApplies ? "" : not m15EmaReady ? "15m EMA120未就绪；" : rawSignalSide == 1 and not m15EmaDirectionAllowed ? "多头未站上15m EMA120；" : rawSignalSide == -1 and not m15EmaDirectionAllowed ? "空头未跌破15m EMA120；" : ""
// END CONFIRMED M15 EMA120 REASON
v9Reasons := v9Reasons == "" ? "通过" : v9Reasons

[signalReferenceStop, signalReferenceRisk, signalReferenceValid] = f_risk(rawSignalSide, close, rawSignalSide == 1 ? recentLow : recentHigh, atr, riskFloor, stopBuffer, syminfo.mintick)

float signalReferenceRiskFraction = signalReferenceValid ? signalReferenceRisk / close : na
float signalReferenceCostR = signalReferenceValid ? roundTripCost / signalReferenceRiskFraction : na

var string lastV9Reasons = "尚无原始确认"
var float lastV9Rv = na
var float lastV9RiskFraction = na
var float lastV9CostR = na

if barstate.isconfirmed and rawSignalSide != 0
    lastV9Reasons := v9Reasons
    lastV9Rv := rv
    lastV9RiskFraction := signalReferenceRiskFraction
    lastV9CostR := signalReferenceCostR

confirmedSignal := confirmedSignal and v9EntryAllowed
confirmedShortSignal := confirmedShortSignal and v9EntryAllowed

int signalSide = confirmedSignal ? 1 : confirmedShortSignal ? -1 : 0

// ───────────── 原有风险参考与退出 ─────────────

var int trendSide = 0
var int entryBar = na
var float entry = na
var float initialStop = na
var float risk = na
var float protection = na
var float peakR = 0.0
var float currentR = na
var bool trailArmed = false
var array<label> exitTags = array.new<label>()

bool referenceStarted = false
bool exitReference = false
bool referenceGap = false
bool referenceReverse = false

int exitSide = 0
float exitPeakR = na
float exitCurrentR = na
float exitProtection = na
float exitReferencePrice = na
string exitReason = ""

float visibleProtection = trendSide != 0 ? protection : na
float visibleInitial = trendSide != 0 ? initialStop : na
float visibleEntry = trendSide != 0 ? entry : na

if barstate.isconfirmed
    if dataGap and trendSide != 0
        referenceGap := true
        trendSide := 0
        currentR := na
        visibleProtection := na
        visibleInitial := na
        visibleEntry := na

    bool endedThisBar = false

    if ready and trendSide != 0 and bar_index > entryBar
        int activeSide = trendSide

        [alive, newProtection, newPeak, newCurrent, exitPrice, armed] = f_path(trendSide, entry, risk, protection, peakR, trailArmed, open, high, low, close, atr, armR, trailAtr, syminfo.mintick)

        protection := newProtection
        peakR := newPeak
        currentR := newCurrent
        trailArmed := armed

        if not alive
            exitReference := true
            exitSide := activeSide
            exitPeakR := peakR
            exitCurrentR := currentR
            exitProtection := protection
            exitReferencePrice := exitPrice
            exitReason := "保护触及"
            endedThisBar := true
            trendSide := 0

            if showExitLabels and not v10OnlyJoint
                string exitSideText = activeSide == 1 ? "多头" : "空头"

                if array.size(exitTags) >= EXIT_TAG_LIMIT
                    label.delete(array.shift(exitTags))

                array.push(exitTags, label.new(bar_index, exitPrice, exitSideText + "保护触及 · 参考结束\n" + str.tostring(exitPrice, format.mintick), style=activeSide == 1 ? label.style_label_down : label.style_label_up, color=color.new(chart.bg_color, 8), textcolor=ink, size=size.small, force_overlay=true))

    bool oppositeStopSignal = endedThisBar and exitSide != 0 and rawSignalSide != exitSide

    if rawSignalSide != 0 and (not endedThisBar or oppositeStopSignal) and rawSignalSide != trendSide
        [newStop, newRisk, validRisk] = f_risk(rawSignalSide, close, rawSignalSide == 1 ? recentLow : recentHigh, atr, riskFloor, stopBuffer, syminfo.mintick)

        if trendSide != 0
            referenceReverse := true
            exitReference := true
            exitSide := trendSide
            exitPeakR := peakR
            exitCurrentR := currentR
            exitProtection := protection
            exitReferencePrice := close
            exitReason := "反向确认"
            trendSide := 0

            if showExitLabels and not v10OnlyJoint
                string exitSideText = exitSide == 1 ? "多头" : "空头"

                if array.size(exitTags) >= EXIT_TAG_LIMIT
                    label.delete(array.shift(exitTags))

                array.push(exitTags, label.new(bar_index, close, exitSideText + "反向确认 · 参考结束\n" + str.tostring(close, format.mintick), style=exitSide == 1 ? label.style_label_down : label.style_label_up, color=color.new(chart.bg_color, 8), textcolor=ink, size=size.small, force_overlay=true))

        if signalSide != 0 and validRisk
            referenceStarted := true
            trendSide := signalSide
            entryBar := bar_index
            entry := close
            initialStop := newStop
            risk := newRisk
            protection := newStop
            peakR := 0.0
            currentR := 0.0
            trailArmed := false

// ───────────── 自动下降线参数 ─────────────

// Major pivots and V9 risk rules retain V11.2 defaults; local C is a separate family.
string v10LineGroup = "04 · 本周期自动下降线"

bool v10Enabled = input.bool(true, "启用自动线与联合提示", group=v10LineGroup, display=display.none)
int v12FallbackLookback = input.int(600, "搜索范围（K 数）", minval=100, maxval=1500, group=v10LineGroup, display=display.none)
int v12FallbackLife = input.int(600, "三点确认后的最长存活（K 数）", minval=20, maxval=1500, group=v10LineGroup, tooltip="搜索范围限制选点历史；已确认线不再因A移出搜索范围立即失效。仍检查真实突破，最长存活从三点确认时计算。", display=display.none)

int v12FallbackLeft = input.int(12, "高点左侧比较 K 数", minval=4, maxval=80, group=v10LineGroup, display=display.none)
int v12FallbackRight = input.int(8, "高点右侧确认 K 数", minval=2, maxval=40, group=v10LineGroup, display=display.none)
int v12FallbackMinGap = input.int(24, "独立反弹最小间隔", minval=5, maxval=200, group=v10LineGroup, display=display.none)
int v12FallbackMinSpan = input.int(72, "三点最小跨度", minval=20, maxval=600, group=v10LineGroup, display=display.none)


// Independent bar-count profiles; equal defaults preserve the audited geometry.
bool v12ByTimeframe = input.bool(true, "使用分周期结构参数", group=v10LineGroup, tooltip="15m、30m、1h、4h分别设置。单位都是各自周期K数；上级请求使用上级自己的配置。默认保持已核验的几何参数，不代表参数已优化。", display=display.none)
int v12Tf15Lookback = input.int(600, "搜索根数", minval=100, maxval=1500, group="04 · 15m 结构参数", display=display.none)
int v12Tf15Life = input.int(600, "最长存活根数", minval=20, maxval=1500, group="04 · 15m 结构参数", display=display.none)
int v12Tf15Left = input.int(12, "高点左侧根数", minval=4, maxval=80, group="04 · 15m 结构参数", display=display.none)
int v12Tf15Right = input.int(8, "高点右侧根数", minval=2, maxval=40, group="04 · 15m 结构参数", display=display.none)
int v12Tf15MinGap = input.int(24, "A-B最小间隔", minval=5, maxval=200, group="04 · 15m 结构参数", display=display.none)
int v12Tf15MinSpan = input.int(72, "A-C最小跨度", minval=20, maxval=600, group="04 · 15m 结构参数", display=display.none)
int v12Tf30Lookback = input.int(600, "搜索根数", minval=100, maxval=1500, group="04 · 30m 结构参数", display=display.none)
int v12Tf30Life = input.int(600, "最长存活根数", minval=20, maxval=1500, group="04 · 30m 结构参数", display=display.none)
int v12Tf30Left = input.int(12, "高点左侧根数", minval=4, maxval=80, group="04 · 30m 结构参数", display=display.none)
int v12Tf30Right = input.int(8, "高点右侧根数", minval=2, maxval=40, group="04 · 30m 结构参数", display=display.none)
int v12Tf30MinGap = input.int(24, "A-B最小间隔", minval=5, maxval=200, group="04 · 30m 结构参数", display=display.none)
int v12Tf30MinSpan = input.int(72, "A-C最小跨度", minval=20, maxval=600, group="04 · 30m 结构参数", display=display.none)
int v12Tf60Lookback = input.int(600, "搜索根数", minval=100, maxval=1500, group="04 · 1h 结构参数", display=display.none)
int v12Tf60Life = input.int(600, "最长存活根数", minval=20, maxval=1500, group="04 · 1h 结构参数", display=display.none)
int v12Tf60Left = input.int(12, "高点左侧根数", minval=4, maxval=80, group="04 · 1h 结构参数", display=display.none)
int v12Tf60Right = input.int(8, "高点右侧根数", minval=2, maxval=40, group="04 · 1h 结构参数", display=display.none)
int v12Tf60MinGap = input.int(24, "A-B最小间隔", minval=5, maxval=200, group="04 · 1h 结构参数", display=display.none)
int v12Tf60MinSpan = input.int(72, "A-C最小跨度", minval=20, maxval=600, group="04 · 1h 结构参数", display=display.none)
int v12Tf240Lookback = input.int(600, "搜索根数", minval=100, maxval=1500, group="04 · 4h 结构参数", display=display.none)
int v12Tf240Life = input.int(600, "最长存活根数", minval=20, maxval=1500, group="04 · 4h 结构参数", display=display.none)
int v12Tf240Left = input.int(12, "高点左侧根数", minval=4, maxval=80, group="04 · 4h 结构参数", display=display.none)
int v12Tf240Right = input.int(8, "高点右侧根数", minval=2, maxval=40, group="04 · 4h 结构参数", display=display.none)
int v12Tf240MinGap = input.int(24, "A-B最小间隔", minval=5, maxval=200, group="04 · 4h 结构参数", display=display.none)
int v12Tf240MinSpan = input.int(72, "A-C最小跨度", minval=20, maxval=600, group="04 · 4h 结构参数", display=display.none)
float v12TfSeconds = timeframe.in_seconds()
int v10Lookback = not v12ByTimeframe ? v12FallbackLookback : v12TfSeconds == 900 ? v12Tf15Lookback : v12TfSeconds == 1800 ? v12Tf30Lookback : v12TfSeconds == 3600 ? v12Tf60Lookback : v12TfSeconds == 14400 ? v12Tf240Lookback : v12FallbackLookback
int v10Life = not v12ByTimeframe ? v12FallbackLife : v12TfSeconds == 900 ? v12Tf15Life : v12TfSeconds == 1800 ? v12Tf30Life : v12TfSeconds == 3600 ? v12Tf60Life : v12TfSeconds == 14400 ? v12Tf240Life : v12FallbackLife
int v10Left = not v12ByTimeframe ? v12FallbackLeft : v12TfSeconds == 900 ? v12Tf15Left : v12TfSeconds == 1800 ? v12Tf30Left : v12TfSeconds == 3600 ? v12Tf60Left : v12TfSeconds == 14400 ? v12Tf240Left : v12FallbackLeft
int v10Right = not v12ByTimeframe ? v12FallbackRight : v12TfSeconds == 900 ? v12Tf15Right : v12TfSeconds == 1800 ? v12Tf30Right : v12TfSeconds == 3600 ? v12Tf60Right : v12TfSeconds == 14400 ? v12Tf240Right : v12FallbackRight
int v10MinGap = not v12ByTimeframe ? v12FallbackMinGap : v12TfSeconds == 900 ? v12Tf15MinGap : v12TfSeconds == 1800 ? v12Tf30MinGap : v12TfSeconds == 3600 ? v12Tf60MinGap : v12TfSeconds == 14400 ? v12Tf240MinGap : v12FallbackMinGap
int v10MinSpan = not v12ByTimeframe ? v12FallbackMinSpan : v12TfSeconds == 900 ? v12Tf15MinSpan : v12TfSeconds == 1800 ? v12Tf30MinSpan : v12TfSeconds == 3600 ? v12Tf60MinSpan : v12TfSeconds == 14400 ? v12Tf240MinSpan : v12FallbackMinSpan

string v12Group = "04A · V12 主高点＋局部回踩"
bool v12LocalEnabled = input.bool(true, "识别主高点＋局部回踩线", group=v12Group, tooltip="保留原三大高点找线；新增A/B两个已确认主高点，加较短反弹C贴线。只在C右侧确认完成后建线，不回填突破。", display=display.none)
