var table panel = table.new(position.top_right, 2, 17, bgcolor=color.new(chart.bg_color, 8), border_width=0)

if barstate.islast and showPanel
    string stateText = (v10OnlyJoint ? "仅联合显示 · " : "") + (trendSide == 1 ? "V9多头参考" : trendSide == -1 ? "V9空头参考" : "当前无跟踪参考")

    table.cell(panel, 0, 0, "SPIKE V12.8", text_color=ink, text_size=size.small)
