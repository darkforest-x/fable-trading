string v11Group = "04C · V11 上级周期突破"

string v11SourceMode = input.string("本周期+上级周期", "突破来源", options=["本周期+上级周期", "仅上级周期", "仅本周期"], group=v11Group, tooltip="SPIKE始终来自本图周期。本周期=本图自己的下降线；上级周期=上级K线收盘确认的下降线突破。", display=display.none)
string v11HtfChoice = input.string("自动", "上级周期", options=["自动", "手动"], group=v11Group, tooltip="自动：1分→5分，3/5分→15分，15分→1小时，30分→2小时，1小时→4小时，2/4小时→日线，日线→周线。", display=display.none)
string v11HtfManual = input.timeframe("60", "手动上级周期", group=v11Group, tooltip="必须大于本图周期，否则上级来源自动停用。", display=display.none)
bool v11ShowHtfLine = input.bool(true, "显示上级周期当前候选线", group=v11Group, display=display.none) or v126Minimal
bool v11ShowHtfBreak = input.bool(true, "显示上级周期突破提示", group=v11Group, display=display.none) or v126Minimal
int v11ExtendBars = input.int(0, "突破后趋势线继续向右延伸（本图K数）", minval=0, maxval=400, group=v11Group, tooltip="只影响画线：突破或联合之后，原A/B斜率继续向右画这么多根。", display=display.none)
int v11AbcKeep = input.int(8, "历史信号组保留A/B/C的最近组数", minval=0, maxval=8, group=v11Group, tooltip="更早的组只保留线和标记，控制标签总数。", display=display.none)
color v126HtfManual = input.color(#9DB7FF, "上级线自定义颜色（关闭自动后生效）", group=v11Group, display=display.none)
color v11HtfColor = v126AutoContrast ? v126Contrast : v126HtfManual

string v112Group = "04D · V11.2 规则与持仓管理"

string v112Rule = input.string("多头框内", "突破+spike 规则", options=["多头框内", "V10.4 窗口"], group=v112Group, tooltip="多头框内：V9多头盈亏框开着时出现突破（本周期或上级）就算，每个框只算第一次，不限根数、不做当根检查。V10.4窗口：SPIKE与突破间隔≤配对窗口，第二个事件当根做全部检查。", display=display.none)
bool v112UseBox = v112Rule == "多头框内"
bool v12HoldPair = input.bool(true, "先突破、持续站上线后出现 V9 也算联合", group=v112Group, tooltip="用于多头框内规则。突破确认后每根收盘必须严格高于同一冻结线；收回线上或线下、数据断档、超过本图最长存活根数即永久取消。后来重新站上不恢复旧突破。仅在新的V9多头确认当根配对，不回填；每个框一次、每条已用突破不复用。", display=display.none)
bool v112AddOnBreak = input.bool(true, "框内突破时提示加仓（止损沿用原框）", group=v112Group, display=display.none)
bool v112EarlyExit = input.bool(false, "N 根内没出突破：盈亏参考提前结束", group=v112Group, tooltip="V9多头框开了N根仍没有任何突破（本周期或上级），在第N根收盘结束参考框，标「未突破离场」。只改参考框，不下单。", display=display.none)
int v112ExitBars = input.int(6, "等待突破的根数 N", minval=1, maxval=500, group=v112Group, display=display.none)
bool v112ShowAllLines = input.bool(false, "诊断：显示本周期全部有效候选线", group=v112Group, tooltip="画出程序此刻候选池里所有未突破的下降线（虚线，编号），并在面板显示最近一次找线的结果：入池/重复/实体穿线/针刺/容量。用来查“为什么这条线没画出来”。", display=display.none) and not v126Minimal

// BEGIN V128 INPUTS
// V12.8 is deliberately chart guidance only.  It never sizes, enters, exits,
// changes the inherited ATR protection, or claims a realised profit.
string v128Group = "04E · V12.8 两次加仓提示"
bool v128Enabled = input.bool(true, "显示两次加仓候选与结构保护参考", group=v128Group, tooltip="只为原始V9多头参考显示最多两次候选。候选来自连续整点、已完成1小时回踩突破与原始2R门槛；没有数量、保证金、净利润或成交核验。旧的“框内突破时提示加仓”只提示趋势线突破且沿用原框止损，和本候选不同。原ATR保护、退出和既有预警完全不变。", display=display.none) and not v130Retest
const int V128_H1_MS = 60 * 60 * 1000
bool v128Supported = timeframe.isminutes and timeframe.multiplier <= 60 and 60 % timeframe.multiplier == 0
bool v128ChartIsH1 = timeframe.isminutes and timeframe.multiplier == 60
// END V128 INPUTS
// ───────────── 双轨高点 ─────────────

const int V10_PIVOTS = 48
const int V10_PER_BUCKET = 4
const int V10_PER_TRACK_GROUP = 2
const float V10_SWITCH_MARGIN = 0.10

bool v10Log = v10Scale == "对数"
float v10Atr = ta.atr(14)
float v10Body = math.max(open, close)
float v10Peak = v10PeakMode == "实体上沿" ? v10Body : math.min(high, v10Body + v10WickCap * v10Atr)

// Snapshot ATR on every bar, before any conditional candidate search. Native Pine
// replay showed derived-series history inside intermittent nested calls disagreeing
// with raw OHLC at the same offset. Absolute-bar slots avoid call-history indexing.
// request.security evaluates this bounded buffer separately in its own context.
const int V12_HISTORY = 2001
var array<float> v12AtrBars = array.new_float(V12_HISTORY, na)
array.set(v12AtrBars, bar_index % V12_HISTORY, v10Atr)

f_v12_atrAt(int absoluteBar) =>
    int age = bar_index - absoluteBar
    age >= 0 and age < V12_HISTORY and absoluteBar >= 0 ? array.get(v12AtrBars, absoluteBar % V12_HISTORY) : na

// 两个序列逐根计算，分别在独立候选池中选点。
float v10RawPivot = ta.pivothigh(high, v10Left, v10Right)
float v10SoftPivot = ta.pivothigh(v10Peak, v10Left, v10Right)
float v12RawTouch = ta.pivothigh(high, v12LocalLeft, v12LocalRight)
float v12SoftTouch = ta.pivothigh(v10Peak, v12LocalLeft, v12LocalRight)
int v12TouchGap = math.max(v12LocalMinGap, v12LocalRight + 1)

bool v10UseRaw = v10PeakMode == "双轨" or v10PeakMode == "完整影线"
bool v10UseSoft = v10PeakMode != "完整影线"

int v10Gap = math.max(v10MinGap, v10Right + 1)
int v10Span = math.max(v10MinSpan, 2 * v10Gap)

if barstate.isfirst and v10Enabled and v10Lookback < v10Span + v10Right
    runtime.error("V11 搜索范围不足，请增大范围或减小反弹间隔。")

// ───────────── 结构对象 ─────────────

// 确认后不调整锚点和斜率，不按第四/第五次触碰加分。
type V10Line
    int uid = 0
    int ax = na
    float ap = na
    int bx = na
    float bp = na
    int cx = na
    float cp = na
    float wave = na
    float fit = na
    float score = na
    int born = na
    int phase = 1
    int above = 0
    int stopped = na
    int source = 0
    int kind = 0  // 0: three major pivots; 1: major A/B + local C.
    int confirmedTime = na
    int brokenBar = na
    bool usable = false
    bool joined = false
    int spikeBar = na
    float parentHigh = na
    float parentLow = na

f_v10_price(int barA, float priceA, int barB, float priceB, int targetBar) =>
    float fraction = float(targetBar - barA) / (barB - barA)
    v10Log ? math.exp(math.log(priceA) + (math.log(priceB) - math.log(priceA)) * fraction) : priceA + (priceB - priceA) * fraction

method at(V10Line self, int targetBar) =>
    f_v10_price(self.ax, self.ap, self.bx, self.bp, targetBar)

// 跨度只用于容量分组，不作为触点加分。
f_v10_bucket(int span) =>
    span < v10Span * 2 ? 0 : span < v10Span * 4 ? 1 : 2

f_v10_rank(array<V10Line> bag, V10Line item) =>
    int bucket = f_v10_bucket(item.cx - item.ax)
    int count = 0
    int worst = na
    float worstScore = -1.0

    if array.size(bag) > 0
        for i = 0 to array.size(bag) - 1
            V10Line oldItem = array.get(bag, i)

            if f_v10_bucket(oldItem.cx - oldItem.ax) == bucket
                count += 1

                if oldItem.score > worstScore
                    worst := i
                    worstScore := oldItem.score

    if count < V10_PER_BUCKET
        array.push(bag, item)
    else if not na(worst) and item.score < worstScore
        array.set(bag, worst, item)

    0

// 相同几何线换了触点组合，也不当作另一条线。
f_v10_same(V10Line first, V10Line second) =>
    bool same = first.ax == second.ax and first.bx == second.bx and math.abs(first.ap - second.ap) < syminfo.mintick * 0.5 and math.abs(first.bp - second.bp) < syminfo.mintick * 0.5

    int leftEdge = math.max(first.ax, second.ax)
    int rightEdge = math.min(first.cx, second.cx)

    if not same and rightEdge - leftEdge >= v10Gap
        float leftTol = math.max(syminfo.mintick, v10Touch * 0.5 * f_v12_atrAt(leftEdge))
        float rightTol = math.max(syminfo.mintick, v10Touch * 0.5 * f_v12_atrAt(rightEdge))
        float nowTol = math.max(syminfo.mintick, v10Touch * 0.5 * v10Atr)

        same := math.abs(first.at(leftEdge) - second.at(leftEdge)) <= leftTol and math.abs(first.at(rightEdge) - second.at(rightEdge)) <= rightTol and math.abs(first.at(bar_index) - second.at(bar_index)) <= nowTol

    same

// 返回：0通过，1实体穿线，2针刺异常，3此前已突破。
f_v10_validate(V10Line item) =>
    int reason = 0
    int spikes = 0
    int previousSpike = na
    int aboveRun = 0
    int age = bar_index - item.ax

    for step = 0 to age
        int offset = age - step
        float y = item.at(item.ax + step)
        float a = math.max(nz(f_v12_atrAt(item.ax + step), syminfo.mintick), syminfo.mintick)

        if math.max(open[offset], close[offset]) > y + v10BodyTol * a + syminfo.mintick * 0.0001
            reason := 1
            break

        float pierce = (high[offset] - y) / a

        if pierce > v10WickTol
            spikes += 1

            if spikes > v10Needles or pierce > math.max(v10NeedleMax, v10WickTol) or (not na(previousSpike) and step - previousSpike == 1)
                reason := 2
                break

            previousSpike := step

        aboveRun := close[offset] > y + v10BreakBuffer * a ? aboveRun + 1 : 0

        if aboveRun >= v10BreakBars
            reason := 3
            break

    [reason, spikes]

// ───────────── 三点候选搜索 ─────────────

// 最新确认高点作为C；A来自多个历史反弹。
// 每个来源的三种跨度分别保留最多4条短名单。
f_v10_search(array<int> xs, array<float> ps, array<float> ats, int sourceId) =>
    array<V10Line> bag = array.new<V10Line>()
    int n = array.size(xs)

    if n >= 3
        int c = n - 1
        int cx = array.get(xs, c)
        float cp = array.get(ps, c)
        float ca = array.get(ats, c)

        int oldest = array.get(xs, 0)
        int total = cx - oldest

        array<float> lows = array.new_float(total + 1, na)
        float valley = na

        // lows[x-oldest] = x 到 C-1 的最低价。
        if total > 0
            for step = 1 to total
                int x = cx - step
                valley := na(valley) ? low[bar_index - x] : math.min(valley, low[bar_index - x])
                array.set(lows, x - oldest, valley)

        for a = 0 to n - 3
            int ax = array.get(xs, a)
            float ap = array.get(ps, a)
            float aa = array.get(ats, a)

            if cx - ax >= v10Span and ap > cp
                array<V10Line> localBag = array.new<V10Line>()

                for b = a + 1 to c - 1
                    int bx = array.get(xs, b)
                    float bp = array.get(ps, b)
                    float ba = array.get(ats, b)

                    if bx - ax >= v10Gap and cx - bx >= v10Gap and ap > bp and bp > cp and ap - bp >= v10Drop * math.max(aa, ba)
                        float atC = f_v10_price(ax, ap, bx, bp, cx)
                        float atNow = f_v10_price(ax, ap, bx, bp, bar_index)
                        float fit = math.abs(cp - atC) / ca

                        if fit <= v10Touch and atNow > 0 and close <= atNow
                            V10Line item = V10Line.new(ax=ax, ap=ap, bx=bx, bp=bp, cx=cx, cp=cp, fit=fit, born=bar_index, source=sourceId, confirmedTime=time_close)
                            array.push(localBag, item)

                if array.size(localBag) > 0
                    array<float> prefix = array.new_float(cx - ax + 1, na)
                    float localLow = na

                    for step = 1 to cx - ax - 1
                        float value = low[bar_index - ax - step]
                        localLow := na(localLow) ? value : math.min(localLow, value)
                        array.set(prefix, step, localLow)

                    for item in localBag
                        float ba = math.max(f_v12_atrAt(item.bx), syminfo.mintick)
                        float ab = (math.min(item.ap, item.bp) - array.get(prefix, item.bx - ax - 1)) / math.max(aa, ba)
                        float bc = (math.min(item.bp, cp) - array.get(lows, item.bx + 1 - oldest)) / math.max(ba, ca)

                        if ab >= v10Pullback and bc >= v10Pullback
                            item.wave := math.min(ab, bc)
                            item.score := item.fit + 0.20 / (1.0 + item.wave)
                            f_v10_rank(bag, item)

    bag

// ───────────── 候选池管理 ─────────────

// A/B come only from the already-confirmed major pivot arrays. C is the local
// pivot confirmed on this bar. Do not retry an old C after a later B becomes known.
// Reads only A..current bar; the inherited validator rejects prior body/break damage.
f_v12_searchLocal(array<int> xs, array<float> ps, array<float> ats, int sourceId, int cx, float cp, float ca) =>
    array<V10Line> bag = array.new<V10Line>()
    int n = array.size(xs)
    if n >= 2 and not na(cp) and not na(ca) and ca > 0
        for a = 0 to n - 2
            int ax = array.get(xs, a)
            float ap = array.get(ps, a)
            float aa = array.get(ats, a)
            if cx - ax >= v10Span and ap > cp
                for b = a + 1 to n - 1
                    int bx = array.get(xs, b)
                    float bp = array.get(ps, b)
                    float ba = array.get(ats, b)
                    if bx < cx and bx + v10Right <= bar_index and bx - ax >= v10Gap and cx - bx >= v12TouchGap and ap > bp and bp > cp and ap - bp >= v10Drop * math.max(aa, ba)
                        float atC = f_v10_price(ax, ap, bx, bp, cx)
                        float atNow = f_v10_price(ax, ap, bx, bp, bar_index)
                        float fit = math.abs(cp - atC) / ca
                        if fit <= v10Touch and atNow > 0 and close <= atNow
                            float abLow = na
                            float bcLow = na
                            for x = ax + 1 to cx - 1
                                float value = low[bar_index - x]
                                if x < bx
                                    abLow := na(abLow) ? value : math.min(abLow, value)
                                if x > bx
                                    bcLow := na(bcLow) ? value : math.min(bcLow, value)
                            float ab = (math.min(ap, bp) - abLow) / (v12ReboundAtB ? ba : math.max(aa, ba))
                            float bc = (math.min(bp, cp) - bcLow) / math.max(ba, ca)
                            if not na(ab) and not na(bc) and ab >= v10Pullback and bc >= v10Pullback
                                V10Line item = V10Line.new(ax=ax, ap=ap, bx=bx, bp=bp, cx=cx, cp=cp, fit=fit, born=bar_index, source=sourceId, kind=1, confirmedTime=time_close)
                                item.wave := math.min(ab, bc)
                                item.score := item.fit + 0.20 / (1.0 + item.wave)
                                f_v10_rank(bag, item)
    bag

f_v12_kindText(V10Line item) =>
    item.kind == 1 ? "主高点＋局部回踩" : "三主高点"

f_v10_addPivot(array<int> xs, array<float> ps, array<float> ats, int px, float price, float scale) =>
    array.push(xs, px)
    array.push(ps, price)
    array.push(ats, scale)
    0

f_v10_prunePivots(array<int> xs, array<float> ps, array<float> ats) =>
    while array.size(xs) > 0
        if bar_index - array.get(xs, 0) > v10Lookback or array.size(xs) > V10_PIVOTS
            array.shift(xs)
            array.shift(ps)
            array.shift(ats)
        else
            break

    0

// 返回：1入池，0重复，2实体拒绝，3针刺拒绝，4历史已突破，5容量拒绝。
// Each family/source/span group has two slots (at most 24 total).
// A local-touch candidate cannot evict a legacy-family line for capacity.
f_v10_store(array<V10Line> pool, V10Line item) =>
    int result = 0
    bool duplicate = false

    for known in pool
        if f_v10_same(known, item)
            duplicate := true
            break

    if not duplicate
        [reason, spikes] = f_v10_validate(item)

        if reason != 0
            result := reason + 1
        else
            item.score += 0.05 * spikes

            int groupCount = 0
            int worstIndex = na
            float worstScore = -1.0
            int bucket = f_v10_bucket(item.cx - item.ax)

            if array.size(pool) > 0
                for i = 0 to array.size(pool) - 1
                    V10Line known = array.get(pool, i)

                    if known.kind == item.kind and known.source == item.source and f_v10_bucket(known.cx - known.ax) == bucket
                        groupCount += 1

                        bool pendingPair = known.usable or not na(known.spikeBar)

                        if not pendingPair and known.score > worstScore
                            worstIndex := i
                            worstScore := known.score

            bool room = groupCount < V10_PER_TRACK_GROUP

            if not room and not na(worstIndex) and item.score < worstScore
                array.remove(pool, worstIndex)
                room := true

            if room
                array.push(pool, item)
                result := 1
            else
                result := 5

    result

// ───────────── 独立结构状态 ─────────────

var array<int> v10Xs = array.new_int()
var array<float> v10Ps = array.new_float()
var array<float> v10As = array.new_float()

var array<int> v10SoftXs = array.new_int()
var array<float> v10SoftPs = array.new_float()
var array<float> v10SoftAs = array.new_float()

var array<V10Line> v10Tracks = array.new<V10Line>()
var array<V10Line> v12Held = array.new<V10Line>()
const int V12_HELD_LIMIT = 24

// 当前主线只控制画面，不决定后台结构是否有资格发信号。
var V10Line v10Main = na
var int v10Promotion = na
var int v10Serial = 0
var int v10SegmentStart = 0
var int v10ClosedBar = na
var polyline v10Drawing = na

var array<label> v10Marks = array.new_label()
var array<label> v10DebugMarks = array.new_label()

var int v10ConsumedSpike = -1
var int v10LastEventBar = na
var int v10LastEventId = na

var float v10LastJointPrice = na
var int v10LastJointTime = na
var string v10LastJointOrder = "—"

var string v10SearchWhy = "等待已确认的独立反弹高点"
var string v12SearchWhy = "局部回踩：等待确认"
var int v12LastBreakTime = na
var string v10PairWhy = "尚无配对事件"
var string v10LastSpikeWhy = "尚无SPIKE多头确认"
var int v10LastSpikeTime = na
var int v10ActiveCount = 0
var int v10WaitingCount = 0

bool v10BornEvent = false
bool v10BreakEvent = false
bool v10JointEvent = false

// 当根联合信号对应的结构，用于冻结绘图。
V10Line v10JointLine = na

// V11：最近一次本周期突破的结构，只用于画线。
var V10Line v11LastBroken = na
var polyline v11BrokenDrawing = na
var array<label> v11BrokenMarks = array.new_label()
var polyline v11HtfDrawing = na
var polyline v11HtfActiveDrawing = na
var array<label> v11HtfMarks = array.new_label()

bool v10CanRun = pricesValid and not dataGap and not na(v10Atr) and v10Atr > 0
float v10LongDistance = atr > 0 and not na(ropeHigh) ? (close - ropeHigh) / atr : na

bool v10LongAlive = ready and pricesValid and atr > 0 and not na(ropeHigh) and close > ropeHigh and rawSignalSide != -1
bool v10Momentum = not na(md[1]) and not na(sb) and md > sb and md > md[1]
bool v10CurrentGate = bbEntryAllowed and v9BundleAllowed and (not useOverheatFilter or (not na(v10LongDistance) and v10LongDistance <= maxRopeDistanceAtr))

// ───────────── V11 上级周期结构（在上级周期内独立运行） ─────────────

bool v11UseChart = v11SourceMode != "仅上级周期"
bool v11UseHtfSource = v11SourceMode != "仅本周期"

f_v11_autoHtf() =>
    int s = timeframe.in_seconds()
    s <= 60 ? "5" : s <= 300 ? "15" : s <= 900 ? "60" : s <= 1800 ? "120" : s <= 3600 ? "240" : s <= 14400 ? "D" : s <= 86400 ? "W" : ""

f_v11_tfLabel(string tf) =>
    int s = tf == "" ? 0 : timeframe.in_seconds(tf)
    s <= 0 ? "—" : s % 604800 == 0 ? str.tostring(math.round(s / 604800)) + "W" : s % 86400 == 0 ? str.tostring(math.round(s / 86400)) + "D" : s % 3600 == 0 ? str.tostring(math.round(s / 3600)) + "h" : str.tostring(math.round(s / 60)) + "m"

string v11Htf = v11HtfChoice == "自动" ? f_v11_autoHtf() : v11HtfManual
int v11HtfSeconds = v11Htf == "" ? 0 : timeframe.in_seconds(v11Htf)
bool v11HtfOn = v10Enabled and v11UseHtfSource and v11HtfSeconds > timeframe.in_seconds()
string v11HtfText = f_v11_tfLabel(v11Htf)
int v11BarMs = timeframe.in_seconds() * 1000

// 与本周期同一套找线、校验与突破判定，只是在上级K线上运行。
// 配对不在这里做：SPIKE只来自本图。已突破的线直接离开上级候选池。
f_v11_lineEngine() =>
    var array<int> xs = array.new_int()
    var array<float> ps = array.new_float()
    var array<float> ats = array.new_float()
    var array<int> sxs = array.new_int()
    var array<float> sps = array.new_float()
    var array<float> sats = array.new_float()
    var array<V10Line> pool = array.new<V10Line>()
    var int segStart = 0
    var int bTime = na
    var int bCloseTime = na
    var int bAxT = na
    var float bAp = na
    var int bBxT = na
    var float bBp = na
    var int bCxT = na
    var float bCp = na
    var int bBornT = na
    var int bSource = na
    int aAxT = na
    float aAp = na
    int aBxT = na
    float aBp = na
    int aCxT = na
    float aCp = na

    if not v10CanRun
        array.clear(xs)
        array.clear(ps)
        array.clear(ats)
        array.clear(sxs)
        array.clear(sps)
        array.clear(sats)
        array.clear(pool)
        segStart := bar_index
    else
        V10Line winner = na

        for item in pool
            float y = item.at(bar_index)

            if item.phase == 1
                if bar_index - item.born > v10Life or y <= 0
                    item.phase := 3
                    item.stopped := bar_index
                else if bar_index > item.born
                    item.above := close > y + v10Atr * v10BreakBuffer ? item.above + 1 : 0

                    if item.above >= v10BreakBars
                        item.phase := 2
                        item.stopped := bar_index
                        item.brokenBar := bar_index

                        if na(winner) or item.score < winner.score
                            winner := item

        if not na(winner)
            bTime := time
            bCloseTime := time_close
            bAxT := time[bar_index - winner.ax]
            bAp := winner.ap
            bBxT := time[bar_index - winner.bx]
            bBp := winner.bp
            bCxT := time[bar_index - winner.cx]
            bCp := winner.cp
            bBornT := winner.confirmedTime
            bSource := winner.source + 2 * winner.kind

        bool rawNew = false
        bool softNew = false
        int pivotBar = bar_index - v10Right

        if pivotBar - v10Left >= segStart and not na(f_v12_atrAt(pivotBar))
            float pivotScale = math.max(f_v12_atrAt(pivotBar), syminfo.mintick)

            if v10UseRaw and not na(v10RawPivot)
                f_v10_addPivot(xs, ps, ats, pivotBar, v10RawPivot, pivotScale)
                rawNew := true

            if v10UseSoft and not na(v10SoftPivot)
                f_v10_addPivot(sxs, sps, sats, pivotBar, v10SoftPivot, pivotScale)
                softNew := true

        f_v10_prunePivots(xs, ps, ats)
        f_v10_prunePivots(sxs, sps, sats)

        int dropIndex = array.size(pool) - 1

        while dropIndex >= 0
            if array.get(pool, dropIndex).phase != 1
                array.remove(pool, dropIndex)

            dropIndex -= 1

        if rawNew or softNew
            for sourceId = 0 to 1
                bool admitted = sourceId == 0 ? rawNew : softNew

                if admitted
                    array<V10Line> shortList = sourceId == 0 ? f_v10_search(xs, ps, ats, 0) : f_v10_search(sxs, sps, sats, 1)

                    for item in shortList
                        f_v10_store(pool, item)

        int touchBar = bar_index - v12LocalRight
        bool touchSegment = touchBar - v12LocalLeft >= segStart
        if v12LocalEnabled and touchSegment and not na(f_v12_atrAt(touchBar))
            float touchScale = math.max(f_v12_atrAt(touchBar), syminfo.mintick)
            for sourceId = 0 to 1
                bool touchNow = sourceId == 0 ? v10UseRaw and not na(v12RawTouch) : v10UseSoft and not na(v12SoftTouch)
                if touchNow
                    array<V10Line> localList = sourceId == 0 ? f_v12_searchLocal(xs, ps, ats, 0, touchBar, v12RawTouch, touchScale) : f_v12_searchLocal(sxs, sps, sats, 1, touchBar, v12SoftTouch, touchScale)
                    for item in localList
                        f_v10_store(pool, item)

        V10Line best = na

        for item in pool
            if item.phase == 1 and close <= item.at(bar_index) and (na(best) or item.score < best.score)
                best := item

        if not na(best)
            aAxT := time[bar_index - best.ax]
            aAp := best.ap
            aBxT := time[bar_index - best.bx]
            aBp := best.bp
            aCxT := time[bar_index - best.cx]
            aCp := best.cp

    [bTime, bCloseTime, bAxT, bAp, bBxT, bBp, bCxT, bCp, bBornT, bSource, aAxT, aAp, aBxT, aBp, aCxT, aCp]

// 只取上一根已收盘上级K线的结果：上级K线收盘后的第一根本图K线才看得到。
f_v11_htfOutputs() =>
    [t1, t2, t3, p4, t5, p6, t7, p8, t9, s10, t11, p12, t13, p14, t15, p16] = f_v11_lineEngine()
    [t1[1], t2[1], t3[1], p4[1], t5[1], p6[1], t7[1], p8[1], t9[1], s10[1], t11[1], p12[1], t13[1], p14[1], t15[1], p16[1]]

[htfBreakTime, htfBreakCloseTime, htfAxT, htfAp, htfBxT, htfBp, htfCxT, htfCp, htfBornT, htfSource, htfActAxT, htfActAp, htfActBxT, htfActBp, htfActCxT, htfActCp] = request.security(syminfo.tickerid, v11HtfOn ? v11Htf : timeframe.period, f_v11_htfOutputs(), lookahead=barmerge.lookahead_on)

f_v11_timePrice(int ta, float pa, int tb, float pb, int t) =>
    float fraction = float(t - ta) / (tb - ta)
    v10Log ? math.exp(math.log(pa) + (math.log(pb) - math.log(pa)) * fraction) : pa + (pb - pa) * fraction

f_v11_timePoints(int ta, float pa, int tb, float pb, int tEnd) =>
    array<chart.point> pts = array.new<chart.point>()

    if v10Log
        for k = 0 to 40
            int t = ta + int(math.round((tEnd - ta) * k / 40.0))
            array.push(pts, chart.point.from_time(t, f_v11_timePrice(ta, pa, tb, pb, t)))
    else
        array.push(pts, chart.point.from_time(ta, pa))
        array.push(pts, chart.point.from_time(tEnd, f_v11_timePrice(ta, pa, tb, pb, tEnd)))

    pts

// 本周期线的A/B/C、A点与突破点圆圈。
f_v11_indexMarks(V10Line ln, int breakBar, color tone, string tip, bool withConfirm) =>
    array<label> marks = array.new_label()
    array.push(marks, label.new(ln.ax, ln.ap, "A", style=label.style_label_down, color=color.new(tone, 100), textcolor=tone, size=size.tiny, tooltip=tip, force_overlay=true))
    array.push(marks, label.new(ln.bx, ln.bp, "B", style=label.style_label_down, color=color.new(tone, 100), textcolor=tone, size=size.tiny, tooltip=tip, force_overlay=true))
    array.push(marks, label.new(ln.cx, ln.cp, ln.kind == 1 ? "C·RT" : "C", style=label.style_label_down, color=color.new(tone, 100), textcolor=tone, size=size.tiny, tooltip=tip, force_overlay=true))
    array.push(marks, label.new(ln.ax, ln.ap, "·", style=label.style_label_center, color=color.new(tone, 100), textcolor=v10BreakColor, size=size.tiny, tooltip=tip, force_overlay=true))

    if not na(breakBar)
        array.push(marks, label.new(breakBar, ln.at(breakBar), "·", style=label.style_label_center, color=color.new(tone, 100), textcolor=v10BreakColor, size=size.tiny, tooltip=tip, force_overlay=true))

    if withConfirm
        array.push(marks, label.new(ln.born, ln.at(ln.born), "ok", style=label.style_none, color=color.new(tone, 100), textcolor=tone, size=size.tiny, tooltip=tip, force_overlay=true))

    marks

// 上级周期线的A/B/C与圆圈，按时间定位。
f_v11_timeMarks(int axT, float ap, int bxT, float bp, int cxT, float cp, int breakT, int bornT, color tone, string tip, bool withConfirm) =>
    array<label> marks = array.new_label()
    array.push(marks, label.new(axT, ap, "A", xloc=xloc.bar_time, style=label.style_label_down, color=color.new(tone, 100), textcolor=tone, size=size.tiny, tooltip=tip, force_overlay=true))
    array.push(marks, label.new(bxT, bp, "B", xloc=xloc.bar_time, style=label.style_label_down, color=color.new(tone, 100), textcolor=tone, size=size.tiny, tooltip=tip, force_overlay=true))
    array.push(marks, label.new(cxT, cp, "C", xloc=xloc.bar_time, style=label.style_label_down, color=color.new(tone, 100), textcolor=tone, size=size.tiny, tooltip=tip, force_overlay=true))
    array.push(marks, label.new(axT, ap, "·", xloc=xloc.bar_time, style=label.style_label_center, color=color.new(tone, 100), textcolor=v10BreakColor, size=size.tiny, tooltip=tip, force_overlay=true))

    if not na(breakT)
        array.push(marks, label.new(breakT, f_v11_timePrice(axT, ap, bxT, bp, breakT), "·", xloc=xloc.bar_time, style=label.style_label_center, color=color.new(tone, 100), textcolor=v10BreakColor, size=size.tiny, tooltip=tip, force_overlay=true))

    if withConfirm and not na(bornT)
        array.push(marks, label.new(bornT, f_v11_timePrice(axT, ap, bxT, bp, bornT), "ok", xloc=xloc.bar_time, style=label.style_none, color=color.new(tone, 100), textcolor=tone, size=size.tiny, tooltip=tip, force_overlay=true))

    marks

// ───────────── 结构监测与联合判断 ─────────────

if barstate.isconfirmed and v10Enabled
    v10ClosedBar := bar_index

    if not v10CanRun
        if not na(v10Main) and v10Main.phase == 1
            v10Main.phase := 3
            v10Main.stopped := bar_index - 1

        array.clear(v10Xs)
        array.clear(v10Ps)
        array.clear(v10As)

        array.clear(v10SoftXs)
        array.clear(v10SoftPs)
        array.clear(v10SoftAs)

        array.clear(v10Tracks)
        array.clear(v12Held)

        v10SegmentStart := bar_index
        v10ActiveCount := 0
        v10WaitingCount := 0
        v10SearchWhy := "数据预热或断档：重新建立结构"
        v12SearchWhy := "局部回踩：数据预热或断档，重新建立"
        v10PairWhy := "数据未就绪"

    else
        // Retire evidence permanently at the first failed close; no resurrection.
        if array.size(v12Held) > 0
            for n = array.size(v12Held) - 1 to 0
                V10Line held = array.get(v12Held, n)
                float heldY = held.at(bar_index)
                if held.joined or bar_index - held.brokenBar > v10Life or heldY <= 0 or close <= heldY
                    array.remove(v12Held, n)

        // 先监测此前已经成立的结构，再处理本根新结构。
        V10Line breakWinner = na
        V10Line jointWinner = na
        int available = 0
        bool pairAttempt = false
        string failure = ""

        for item in v10Tracks
            float y = item.at(bar_index)

            if item.phase == 1
                if bar_index - item.born > v10Life or y <= 0
                    item.phase := 3
                    item.stopped := bar_index
                    item.spikeBar := na
                else if bar_index > item.born
                    item.above := close > y + v10Atr * v10BreakBuffer ? item.above + 1 : 0

                    if item.above >= v10BreakBars
                        item.phase := 2
                        item.stopped := bar_index
                        item.brokenBar := bar_index
                        item.usable := true
                        if v112UseBox and v12HoldPair
                            if array.size(v12Held) >= V12_HELD_LIMIT
                                array.shift(v12Held)
                            array.push(v12Held, item)

                        if na(breakWinner) or item.score < breakWinner.score
                            breakWinner := item

            // 逐结构保存和取消SPIKE证据。
            if not na(item.spikeBar)
                if item.spikeBar <= v10ConsumedSpike or bar_index - item.spikeBar > v10Window
                    item.spikeBar := na
                else if not v10LongAlive or na(item.parentLow) or close < item.parentLow or (exitReference and exitSide == 1)
                    item.spikeBar := na

            if item.usable
                if bar_index - item.brokenBar > v10Window or close <= y or rawSignalSide == -1
                    item.usable := false
                    item.spikeBar := na

            bool knownBefore = item.born < bar_index
            bool lineAvailable = knownBefore and not item.joined and (item.phase == 1 or item.usable)

            if lineAvailable
                available += 1

            if confirmedSignal and lineAvailable
                item.spikeBar := bar_index
                item.parentHigh := legacyParentHigh
                item.parentLow := legacyParentLow

            if item.usable and not item.joined and not na(item.spikeBar) and item.spikeBar > v10ConsumedSpike
                bool withinWindow = math.abs(item.spikeBar - item.brokenBar) <= v10Window
                bool secondNow = bar_index == math.max(item.spikeBar, item.brokenBar)
                bool bornBeforeBoth = item.born < math.min(item.spikeBar, item.brokenBar)
                bool parentRecovered = not na(item.parentHigh) and close > item.parentHigh

                if withinWindow and secondNow and bornBeforeBoth
                    pairAttempt := true

                    if v10LongAlive and v10Momentum and v10CurrentGate and parentRecovered
                        if na(jointWinner) or item.score < jointWinner.score
                            jointWinner := item
                    else
                        failure := not v10LongAlive ? "联合当根失去六线支撑" : not v10Momentum ? "联合当根动量未通过" : not parentRecovered ? "未站上原启动区间" : not bbEntryAllowed ? "联合当根BB过滤未通过" : not v9BundleAllowed ? "联合当根V9标的/量比/时段未通过" : "联合当根离六线过远"

        v10BreakEvent := not na(breakWinner)

        if v10BreakEvent
            v10PairWhy := "结构#" + str.tostring(breakWinner.uid) + "突破；等待SPIKE"
            v11LastBroken := breakWinner
            v12LastBreakTime := time_close

        if pairAttempt and na(jointWinner)
            v10PairWhy := failure

        // 同根多条结构联合时，只输出一个代表性信号。
        // 同一SPIKE事件不会被多条结构重复消费。
        if not v112UseBox and not na(jointWinner) and v11UseChart
            v10JointEvent := true
            v10JointLine := jointWinner
            v10ConsumedSpike := jointWinner.spikeBar

            v10LastJointPrice := close
            v10LastJointTime := time_close
            v10LastJointOrder := (jointWinner.spikeBar == jointWinner.brokenBar ? "同根" : jointWinner.spikeBar < jointWinner.brokenBar ? "SPIKE→突破" : "突破→SPIKE") + " · 线#" + str.tostring(jointWinner.uid)

            jointWinner.joined := true
            jointWinner.usable := false

            for item in v10Tracks
                if not na(item.spikeBar) and item.spikeBar <= v10ConsumedSpike
                    item.spikeBar := na

            v10PairWhy := "联合成立；不重置原盈亏框"

        V10Line eventLine = not v112UseBox and not na(jointWinner) and v11UseChart ? jointWinner : breakWinner

        if not na(eventLine)
            if na(v10Main) or v10Main.uid != eventLine.uid
                v10Promotion := bar_index

            v10Main := eventLine
            v10LastEventBar := bar_index
            v10LastEventId := eventLine.uid

        if confirmedSignal
            if not v10JointEvent and not pairAttempt
                v10PairWhy := available > 0 ? "SPIKE已确认，保存到提前成立的结构；等待突破" : "SPIKE存在：此前无有效结构，或结构已失效/配对超时"

            v10LastSpikeTime := time_close
            v10LastSpikeWhy := v10PairWhy

            if v10Debug and not v10OnlyJoint
                if array.size(v10DebugMarks) >= 8
                    label.delete(array.shift(v10DebugMarks))

                array.push(v10DebugMarks, label.new(bar_index, low - v10Atr * 2, v10PairWhy, style=label.style_label_up, color=color.new(chart.bg_color, 12), textcolor=chart.fg_color, size=size.tiny, force_overlay=true))

        // 本根确认的新拐点，分别加入两个价格来源。
        bool rawAdmitted = false
        bool softAdmitted = false
        int px = bar_index - v10Right
        bool sameSegment = px - v10Left >= v10SegmentStart

        if sameSegment and not na(f_v12_atrAt(px))
            float pivotScale = math.max(f_v12_atrAt(px), syminfo.mintick)

            if v10UseRaw and not na(v10RawPivot)
                f_v10_addPivot(v10Xs, v10Ps, v10As, px, v10RawPivot, pivotScale)
                rawAdmitted := true

            if v10UseSoft and not na(v10SoftPivot)
                f_v10_addPivot(v10SoftXs, v10SoftPs, v10SoftAs, px, v10SoftPivot, pivotScale)
                softAdmitted := true

        f_v10_prunePivots(v10Xs, v10Ps, v10As)
        f_v10_prunePivots(v10SoftXs, v10SoftPs, v10SoftAs)

        // 已失效结构独立清理，不清空全部高点。
        int dropIndex = array.size(v10Tracks) - 1

        while dropIndex >= 0
            V10Line item = array.get(v10Tracks, dropIndex)

            if item.phase != 1 and not item.usable
                array.remove(v10Tracks, dropIndex)

            dropIndex -= 1

        if rawAdmitted or softAdmitted
            int passed = 0
            int duplicates = 0
            int bodyReject = 0
            int wickReject = 0
            int breakReject = 0
            int capacityReject = 0
            int tested = 0

            for sourceId = 0 to 1
                bool admitted = sourceId == 0 ? rawAdmitted : softAdmitted

                if admitted
                    array<V10Line> shortList = sourceId == 0 ? f_v10_search(v10Xs, v10Ps, v10As, 0) : f_v10_search(v10SoftXs, v10SoftPs, v10SoftAs, 1)

                    for item in shortList
                        tested += 1
                        int code = f_v10_store(v10Tracks, item)

                        if code == 1
                            v10Serial += 1
                            item.uid := v10Serial
                            passed += 1
                            v10BornEvent := true
                        else if code == 0
                            duplicates += 1
                        else if code == 2
                            bodyReject += 1
                        else if code == 3
                            wickReject += 1
                        else if code == 4
                            breakReject += 1
                        else
                            capacityReject += 1

            v10SearchWhy := tested == 0 ? "本次未找到满足间隔/回落/三点贴合的候选" : "入池 " + str.tostring(passed) + "；重复 " + str.tostring(duplicates) + "；实体 " + str.tostring(bodyReject) + "；针刺 " + str.tostring(wickReject) + "；历史已破 " + str.tostring(breakReject) + "；容量 " + str.tostring(capacityReject)

        int touchBar = bar_index - v12LocalRight
        bool touchSegment = touchBar - v12LocalLeft >= v10SegmentStart
        if v12LocalEnabled and touchSegment and not na(f_v12_atrAt(touchBar))
            bool rawTouchNow = v10UseRaw and not na(v12RawTouch)
            bool softTouchNow = v10UseSoft and not na(v12SoftTouch)
            if rawTouchNow or softTouchNow
                float touchScale = math.max(f_v12_atrAt(touchBar), syminfo.mintick)
                int tested = 0
                int passed = 0
                int duplicates = 0
                int bodyReject = 0
                int wickReject = 0
                int breakReject = 0
                int capacityReject = 0
                for sourceId = 0 to 1
                    bool touchNow = sourceId == 0 ? rawTouchNow : softTouchNow
                    if touchNow
                        array<V10Line> localList = sourceId == 0 ? f_v12_searchLocal(v10Xs, v10Ps, v10As, 0, touchBar, v12RawTouch, touchScale) : f_v12_searchLocal(v10SoftXs, v10SoftPs, v10SoftAs, 1, touchBar, v12SoftTouch, touchScale)
                        for item in localList
                            tested += 1
                            int code = f_v10_store(v10Tracks, item)
                            if code == 1
                                v10Serial += 1
                                item.uid := v10Serial
                                passed += 1
                                v10BornEvent := true
                            else if code == 0
                                duplicates += 1
                            else if code == 2
                                bodyReject += 1
                            else if code == 3
                                wickReject += 1
                            else if code == 4
                                breakReject += 1
                            else
                                capacityReject += 1
                v12SearchWhy := "局部C " + str.format_time(time[v12LocalRight], "MM-dd HH:mm", "Asia/Shanghai") + (tested == 0 ? "：主点/间隔/回落/贴线未通过" : "：入池" + str.tostring(passed) + " 重复" + str.tostring(duplicates) + " 实体" + str.tostring(bodyReject) + " 针刺" + str.tostring(wickReject) + " 历史已破" + str.tostring(breakReject) + " 容量" + str.tostring(capacityReject))

        // 当前候选主线的选择只影响画面，不影响独立结构的突破和配对。
        V10Line best = na
        bool mainInPool = false

        v10ActiveCount := 0
        v10WaitingCount := 0

        for item in v10Tracks
            if item.phase == 1
                v10ActiveCount += 1

                if close <= item.at(bar_index) and (na(best) or item.score < best.score)
                    best := item

            if item.usable
                v10WaitingCount += 1

            if not na(v10Main) and item.uid == v10Main.uid
                mainInPool := true

        bool holdEvent = not na(v10LastEventBar) and bar_index - v10LastEventBar <= v10Window + 1

        if not holdEvent
            if not na(best)
                if na(v10Main) or v10Main.phase != 1 or not mainInPool
                    v10Main := best
                    v10Promotion := bar_index
                else if best.uid != v10Main.uid and bar_index - v10Promotion >= v10Right and best.score + V10_SWITCH_MARGIN < v10Main.score
                    v10Main := best
                    v10Promotion := bar_index
            else if not na(v10Main) and v10Main.phase == 1 and not mainInPool
                v10Main.phase := 3
                v10Main.stopped := bar_index

// ───────────── V11 上级周期突破 + 本图SPIKE ─────────────

// 规则与本周期配对相同：两事件间隔≤配对窗口（本图K数），第二个事件当根做全部检查；
// 线必须在SPIKE之前就已被三点确认；同一SPIKE只消费一次（与本周期共用消费记录）。
var int v11LastSeenBreak = na
var int v11HtfBreakBar = na
var int v11HtfBreakT = na
var int v11HtfAxT = na
var float v11HtfAp = na
var int v11HtfBxT = na
var float v11HtfBp = na
var int v11HtfCxT = na
var float v11HtfCp = na
var int v11HtfBornT = na
var int v11HtfSrc = na
var bool v11HtfUsable = false
var bool v11HtfJoined = false
var int v11SpikeBar = na
var int v11SpikeTime = na
var float v11SpikeParentHigh = na
var float v11SpikeParentLow = na
var int v11LastHtfBreakTime = na
var string v11HtfPairWhy = "尚无上级突破"

bool v11HtfBreakKnown = false
bool v11HtfJointEvent = false
string v11HtfOrder = ""

if barstate.isconfirmed and v11HtfOn
    if dataGap or not pricesValid
        v11HtfUsable := false
        v11SpikeBar := na
        v11HtfPairWhy := "数据断档：清空待配对"
    else
        // 1. 本图SPIKE证据的过期与取消（与本周期相同条件）。
        if not na(v11SpikeBar)
            if v11SpikeBar <= v10ConsumedSpike or bar_index - v11SpikeBar > v10Window
                v11SpikeBar := na
            else if not v10LongAlive or na(v11SpikeParentLow) or close < v11SpikeParentLow or (exitReference and exitSide == 1)
                v11SpikeBar := na

        // 2. 已知上级突破的可用性：超窗、收回线下或出现原始空头即失效。
        if v11HtfUsable
            float yNow = f_v11_timePrice(v11HtfAxT, v11HtfAp, v11HtfBxT, v11HtfBp, time)

            if bar_index - v11HtfBreakBar > v10Window or close <= yNow or rawSignalSide == -1
                v11HtfUsable := false

        // 3. 新的上级突破：只在上级K线收盘后的第一根本图K线登记；图表起点之前的旧突破只记录不使用。
        if not na(htfBreakTime) and (na(v11LastSeenBreak) or htfBreakTime != v11LastSeenBreak)
            v11LastSeenBreak := htfBreakTime

            if not na(htfBreakCloseTime) and time - htfBreakCloseTime < v11BarMs
                v11HtfBreakKnown := true
                v11HtfBreakBar := bar_index
                v11HtfBreakT := htfBreakTime
                v11HtfAxT := htfAxT
                v11HtfAp := htfAp
                v11HtfBxT := htfBxT
                v11HtfBp := htfBp
                v11HtfCxT := htfCxT
                v11HtfCp := htfCp
                v11HtfBornT := htfBornT
                v11HtfSrc := htfSource
                v11HtfUsable := true
                v11HtfJoined := false
                v11LastHtfBreakTime := time
                v11HtfPairWhy := v11HtfText + "突破；等待SPIKE"

        // 4. 本图SPIKE（V9最终多头确认）。
        if confirmedSignal
            v11SpikeBar := bar_index
            v11SpikeTime := time
            v11SpikeParentHigh := legacyParentHigh
            v11SpikeParentLow := legacyParentLow

        // 5. 配对：较晚的事件当根检查。
        if not v112UseBox and v11HtfUsable and not na(v11SpikeBar) and v11SpikeBar > v10ConsumedSpike
            bool withinWindow = math.abs(v11SpikeBar - v11HtfBreakBar) <= v10Window
            bool secondNow = bar_index == math.max(v11SpikeBar, v11HtfBreakBar)
            bool knownBeforeSpike = not na(v11HtfBornT) and v11HtfBornT <= v11SpikeTime
            bool parentRecovered = not na(v11SpikeParentHigh) and close > v11SpikeParentHigh

            if withinWindow and secondNow and knownBeforeSpike
                if v10LongAlive and v10Momentum and v10CurrentGate and parentRecovered
                    v11HtfJointEvent := true
                    v11HtfOrder := v11SpikeBar == v11HtfBreakBar ? "同根" : v11SpikeBar < v11HtfBreakBar ? "SPIKE→" + v11HtfText + "突破" : v11HtfText + "突破→SPIKE"
                    v10ConsumedSpike := v11SpikeBar
                    v11HtfUsable := false
                    v11HtfJoined := true
                    v11SpikeBar := na

                    v10LastJointPrice := close
                    v10LastJointTime := time_close
                    v10LastJointOrder := v11HtfOrder + " · 上级线"
                    v11HtfPairWhy := "突破+spike（上级突破）成立"
                    v10PairWhy := v11HtfPairWhy
                else
                    v11HtfPairWhy := not v10LongAlive ? "联合当根失去六线支撑" : not v10Momentum ? "联合当根动量未通过" : not parentRecovered ? "未站上原启动区间" : not bbEntryAllowed ? "联合当根BB过滤未通过" : not v9BundleAllowed ? "联合当根V9标的/量比/时段未通过" : "联合当根离六线过远"

// ───────────── V12 ordered pairing: box-first OR continuously held break-first ─────────────

type V12HeldHtf
    int ax
    float ap
    int bx
    float bp
    int cx
    float cp
    int born
    int breakTime
    int visibleBar
    int source

var array<V12HeldHtf> v12HeldHtf = array.new<V12HeldHtf>()
var int v112BoxUsed = na
var int v112BoxBroke = na
var int v112DrawnLineUid = na
bool v112BreakChart = v11UseChart and v10BreakEvent
bool v112BreakHtf = v11HtfOn and v11HtfBreakKnown
bool v112BoxJoint = false
bool v112BoxJointHtf = false
bool v112EarlyExitNow = false
V10Line v12SelectedLine = v11LastBroken
V12HeldHtf v12SelectedHtf = na
bool v12BreakFirst = false

if barstate.isconfirmed
    if dataGap or not pricesValid or not v11HtfOn
        array.clear(v12HeldHtf)
    else
        if v11HtfBreakKnown and v112UseBox and v12HoldPair
            if array.size(v12HeldHtf) >= V12_HELD_LIMIT
                array.shift(v12HeldHtf)
            array.push(v12HeldHtf, V12HeldHtf.new(v11HtfAxT, v11HtfAp, v11HtfBxT, v11HtfBp, v11HtfCxT, v11HtfCp, v11HtfBornT, v11HtfBreakT, bar_index, v11HtfSrc))
        // Check the first visible chart close too: a stale HTF cross is not a hold.
        if array.size(v12HeldHtf) > 0
            for n = array.size(v12HeldHtf) - 1 to 0
                V12HeldHtf held = array.get(v12HeldHtf, n)
                float y = f_v11_timePrice(held.ax, held.ap, held.bx, held.bp, time)
                if bar_index - held.visibleBar > v10Life or y <= 0 or close <= y
                    array.remove(v12HeldHtf, n)

// Existing V9 box first, new break second: preserve V11.2 behavior.
if barstate.isconfirmed and v10Enabled and trendSide == 1 and (v112BreakChart or v112BreakHtf)
    v112BoxBroke := entryBar

if barstate.isconfirmed and v10Enabled and v112UseBox and trendSide == 1 and (na(v112BoxUsed) or v112BoxUsed != entryBar)
    bool boxFirst = v112BreakChart or v112BreakHtf
    if boxFirst
        v112BoxJoint := true
        v112BoxJointHtf := v112BreakHtf
    else if v12HoldPair and confirmedSignal
        // Only the new V9 event may complete a break-first pair. Select newest
        // qualifying evidence, then lowest fit score for simultaneous chart lines.
        V10Line heldBest = na
        if v11UseChart
            for held in v12Held
                if not held.joined and held.brokenBar < bar_index and (na(heldBest) or held.brokenBar > heldBest.brokenBar or (held.brokenBar == heldBest.brokenBar and held.score < heldBest.score))
                    heldBest := held
        if v11HtfOn and array.size(v12HeldHtf) > 0
            v12SelectedHtf := array.last(v12HeldHtf)
        bool chooseHtf = not na(v12SelectedHtf) and (na(heldBest) or v12SelectedHtf.visibleBar >= heldBest.brokenBar)
        v112BoxJoint := not na(heldBest) or not na(v12SelectedHtf)
        v112BoxJointHtf := v112BoxJoint and chooseHtf
        v12SelectedLine := heldBest
        v12BreakFirst := v112BoxJoint

    if v112BoxJoint
        v112BoxUsed := entryBar
        v112BoxBroke := entryBar
        string boxOrder = v12BreakFirst ? "突破→连续站在线上→V9" : (v112BreakHtf ? "框内上级突破" : "框内突破") + " · V9后第" + str.tostring(bar_index - entryBar) + "根"
        v10LastJointPrice := close
        v10LastJointTime := time_close
        v10LastJointOrder := boxOrder
        v10PairWhy := "break+spike · " + boxOrder
        if v112BoxJointHtf
            v11HtfOrder := boxOrder
            if not v12BreakFirst
                v11HtfJoined := true
        else if not na(v12SelectedLine)
            v112DrawnLineUid := v12SelectedLine.uid
            v12SelectedLine.joined := true
        // All currently eligible breaks participated in this box's opportunity;
        // do not recycle parallel equivalent lines into a later V9 box.
        for held in v12Held
            held.joined := true
        array.clear(v12Held)
        array.clear(v12HeldHtf)

// Frozen event geometry, separate from the latest HTF-break display state.
int v12JointAx = v12BreakFirst and v112BoxJointHtf ? v12SelectedHtf.ax : v11HtfAxT
float v12JointAp = v12BreakFirst and v112BoxJointHtf ? v12SelectedHtf.ap : v11HtfAp
int v12JointBx = v12BreakFirst and v112BoxJointHtf ? v12SelectedHtf.bx : v11HtfBxT
float v12JointBp = v12BreakFirst and v112BoxJointHtf ? v12SelectedHtf.bp : v11HtfBp
int v12JointCx = v12BreakFirst and v112BoxJointHtf ? v12SelectedHtf.cx : v11HtfCxT
float v12JointCp = v12BreakFirst and v112BoxJointHtf ? v12SelectedHtf.cp : v11HtfCp
int v12JointBorn = v12BreakFirst and v112BoxJointHtf ? v12SelectedHtf.born : v11HtfBornT
int v12JointBreak = v12BreakFirst and v112BoxJointHtf ? v12SelectedHtf.breakTime : v11HtfBreakT
int v12JointSource = v12BreakFirst and v112BoxJointHtf ? v12SelectedHtf.source : v11HtfSrc

// N根内没出突破：在第N根收盘结束V9多头参考框（只改参考，不下单）。
if barstate.isconfirmed and v10Enabled and v112EarlyExit and trendSide == 1 and bar_index > entryBar and bar_index - entryBar >= v112ExitBars and (na(v112BoxBroke) or v112BoxBroke != entryBar)
    v112EarlyExitNow := true
    exitReference := true
    exitSide := 1
    exitPeakR := peakR
    exitCurrentR := currentR
    exitProtection := protection
    exitReferencePrice := close
    exitReason := "未突破离场"
    trendSide := 0

bool v112ChartShow = v112UseBox ? v112BoxJoint and not v112BoxJointHtf : v10JointEvent
bool v112HtfShow = v112UseBox ? v112BoxJoint and v112BoxJointHtf : v11HtfJointEvent
V10Line v112ChartLine = v112UseBox ? v12SelectedLine : v10JointLine
bool v11AnyJoint = v112ChartShow or v112HtfShow

// BEGIN V128 ROLL_HINTS
// H1 inputs are evaluated on every chart bar.  Lower charts receive only the
// preceding completed H1 candle; do not use barstate.isconfirmed inside
// request.security.  This is the confirmed-tuple pattern documented by Pine.
// Source: https://www.tradingview.com/pine-script-docs/concepts/other-timeframes-and-data/#avoiding-repainting
[v128RequestedOpen, v128RequestedHigh, v128RequestedLow, v128RequestedClose, v128RequestedTime, v128RequestedCloseTime] = request.security(syminfo.tickerid, "60", [open[1], high[1], low[1], close[1], time[1], time_close[1]], gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_on)
float v128H1Open = v128ChartIsH1 ? open : v128RequestedOpen
float v128H1High = v128ChartIsH1 ? high : v128RequestedHigh
float v128H1Low = v128ChartIsH1 ? low : v128RequestedLow
float v128H1Close = v128ChartIsH1 ? close : v128RequestedClose
int v128H1Time = v128ChartIsH1 ? time : v128RequestedTime
int v128H1CloseTime = v128ChartIsH1 ? time_close : v128RequestedCloseTime
bool v128H1ClockReady = v128ChartIsH1 ? v128H1CloseTime <= time_close : v128H1CloseTime <= time
bool v128H1Valid = not na(v128H1Open) and not na(v128H1High) and not na(v128H1Low) and not na(v128H1Close) and not na(v128H1Time) and not na(v128H1CloseTime) and v128H1Open > 0 and v128H1Low > 0 and v128H1High >= v128H1Low and v128H1High >= v128H1Open and v128H1High >= v128H1Close and v128H1Low <= v128H1Open and v128H1Low <= v128H1Close and v128H1CloseTime - v128H1Time == V128_H1_MS and v128H1ClockReady

var int v128FrameEntryBar = na
var int v128FrameConfirmTime = na
var int v128LastHourClose = na
var int v128CandidateCount = 0
var int v128StructuralSetBar = na
var float v128LastCandidatePrice = na
var float v128StructuralStop = na
var float v128RunningHigh = na
var float v128PreviousClose = na
var float v128PullbackLow = na
var float v128FrozenHurdle = na
var bool v128Seeded = false
var bool v128InPullback = false
var bool v128EpisodeInvalid = false
var bool v128EpisodePaused = false
var bool v128HasStructuralProposal = false
var array<label> v128CandidateTags = array.new<label>()
var table v128Status = table.new(position.bottom_center, 2, 2, bgcolor=color.new(chart.bg_color, 8), border_width=0)

bool v128CandidateEvent = false
bool v128FrameLong = trendSide == 1 and not na(entryBar) and not na(entry) and not na(initialStop) and not na(risk) and entry > 0 and initialStop > 0 and risk > 0

if barstate.isconfirmed
    if not v128Enabled or not v128Supported or dataGap or not pricesValid or not v128FrameLong
        v128FrameEntryBar := na
        v128FrameConfirmTime := na
        v128LastHourClose := na
        v128CandidateCount := 0
        v128StructuralSetBar := na
        v128LastCandidatePrice := na
        v128StructuralStop := na
        v128RunningHigh := na
        v128PreviousClose := na
        v128PullbackLow := na
        v128FrozenHurdle := na
        v128Seeded := false
        v128InPullback := false
        v128EpisodeInvalid := false
        v128EpisodePaused := false
        v128HasStructuralProposal := false
    else if referenceStarted or na(v128FrameEntryBar) or v128FrameEntryBar != entryBar
        // Bind once to the original V9 frame.  The first eligible H1 must begin
        // at or after this confirmation close, so a partly pre-entry hour is never read.
        v128FrameEntryBar := entryBar
        v128FrameConfirmTime := time_close
        v128LastHourClose := na
        v128CandidateCount := 0
        v128StructuralSetBar := na
        v128LastCandidatePrice := entry
        v128StructuralStop := initialStop
        v128RunningHigh := entry
        v128PreviousClose := na
        v128PullbackLow := na
        v128FrozenHurdle := na
        v128Seeded := false
        v128InPullback := false
        v128EpisodeInvalid := false
        v128EpisodePaused := false
        v128HasStructuralProposal := false
    else
        // A reference is only guidance.  From the next chart bar onward, a touch
        // pauses this frame's candidates but cannot alter inherited exits/protection.
        if v128HasStructuralProposal and not v128EpisodePaused and not na(v128StructuralSetBar) and bar_index > v128StructuralSetBar and low <= v128StructuralStop
            v128EpisodePaused := true

        bool v128NewHour = v128H1Valid and (na(v128LastHourClose) or v128H1CloseTime != v128LastHourClose)
        if v128NewHour
            int v128ExpectedFirstHour = int(math.ceil(v128FrameConfirmTime * 1.0 / V128_H1_MS) * V128_H1_MS)
            bool v128BeforeFrame = v128H1Time < v128ExpectedFirstHour
            bool v128FirstGap = not v128Seeded and not v128BeforeFrame and v128H1Time > v128ExpectedFirstHour
            bool v128LaterGap = v128Seeded and not na(v128LastHourClose) and v128H1CloseTime != v128LastHourClose + V128_H1_MS
            v128LastHourClose := v128H1CloseTime

            if v128FirstGap or v128LaterGap
                v128EpisodeInvalid := true
            else if not v128BeforeFrame and not v128EpisodeInvalid and not v128EpisodePaused
                if not v128Seeded
                    v128RunningHigh := math.max(entry, v128H1High)
                    v128PreviousClose := v128H1Close
                    v128Seeded := true
                else if not v128InPullback
                    if v128H1Close < v128PreviousClose
                        v128InPullback := true
                        v128FrozenHurdle := v128RunningHigh
                        v128PullbackLow := v128H1Low
                    else
                        v128RunningHigh := math.max(v128RunningHigh, v128H1High)
                else
                    v128PullbackLow := math.min(v128PullbackLow, v128H1Low)
                    if v128H1Close > v128FrozenHurdle
                        float v128Proposal = math.floor(v128PullbackLow / syminfo.mintick) * syminfo.mintick - syminfo.mintick
                        bool v128Improves = v128Proposal > v128StructuralStop and v128Proposal > 0 and v128Proposal < v128H1Close
                        // Lower charts learn a completed H1 on this first available
                        // chart close.  If its low already broke the new reference,
                        // suppress the candidate and pause rather than backdating it.
                        bool v128AvailabilityCross = not v128ChartIsH1 and v128Improves and low <= v128Proposal
                        if v128Improves
                            v128StructuralStop := v128Proposal
                            v128StructuralSetBar := bar_index
                            v128HasStructuralProposal := true
                        if v128AvailabilityCross
                            v128EpisodePaused := true

                        bool v128CandidateEligible = v128Improves and not v128AvailabilityCross and trendSide == 1 and close >= entry + 2.0 * risk and v128H1Close >= entry + 2.0 * risk and close > v128LastCandidatePrice and close > v128Proposal
                        if v128CandidateEligible and v128CandidateCount < 2
                            v128CandidateCount += 1
                            v128LastCandidatePrice := close
                            v128CandidateEvent := true
                            if not v126Minimal
                                if array.size(v128CandidateTags) >= 30
                                    label.delete(array.shift(v128CandidateTags))
                                string v128Tip = "V12.8 加仓候选" + str.tostring(v128CandidateCount) + "（图表提示，不是交易）\n原V9多头确认：" + str.format_time(v128FrameConfirmTime, "yyyy-MM-dd HH:mm", "Asia/Shanghai") + " 北京时间\n已完成H1：" + str.format_time(v128H1CloseTime, "yyyy-MM-dd HH:mm", "Asia/Shanghai") + " 北京时间\n本图确认收盘参考：" + str.tostring(close, format.mintick) + "\nH1收盘参考：" + str.tostring(v128H1Close, format.mintick) + "\n结构保护提案：" + str.tostring(v128Proposal, format.mintick) + "\n未核验整仓净利润、保证金或实际成交；原ATR保护/退出不变。"
                                array.push(v128CandidateTags, label.new(bar_index, math.max(syminfo.mintick, low - atr * 0.25), "add候选" + str.tostring(v128CandidateCount), style=label.style_label_up, color=color.new(bull, 82), textcolor=bull, size=size.small, tooltip=v128Tip, force_overlay=true))

                        // One completed pullback-break consumes one structural event,
                        // even if price/cap/availability suppresses its candidate.
                        v128RunningHigh := math.max(v128RunningHigh, v128H1High)
                        v128InPullback := false
                        v128PullbackLow := na
                        v128FrozenHurdle := na
                v128PreviousClose := v128H1Close

if barstate.islast
    if v128Enabled and not v126Minimal
        string v128StatusText = not v128Supported ? "仅支持60m或60整除分钟图" : v126Minimal ? "极简模式：候选/参考隐藏" : not v128FrameLong ? "等待原始V9多头参考" : v128EpisodeInvalid ? "H1断档：本框候选停用" : v128EpisodePaused ? "结构参考已触及；原退出不变" : not v128Seeded ? "等待完整入场后H1" : "候选 " + str.tostring(v128CandidateCount) + "/2 · 结构参考 " + str.tostring(v128StructuralStop, format.mintick)
        table.cell(v128Status, 0, 0, "V12.8 滚仓提示", text_color=muted, text_size=size.tiny)
        table.cell(v128Status, 1, 0, v128StatusText, text_color=v128EpisodeInvalid or v128EpisodePaused ? gold : ink, text_size=size.tiny, tooltip="结构参考不参与原ATR保护或退出；不含数量、保证金、利润或实际成交核验。")
        table.cell(v128Status, 0, 1, "H1结构", text_color=muted, text_size=size.tiny)
        table.cell(v128Status, 1, 1, v128HasStructuralProposal ? str.tostring(v128StructuralStop, format.mintick) + " · 非执行参考" : "尚无已提升参考", text_color=ink, text_size=size.tiny)
    else
        table.clear(v128Status, 0, 0, 1, 1)
// END V128 ROLL_HINTS
if v112EarlyExitNow and showExitLabels and not v10OnlyJoint
    if array.size(exitTags) >= EXIT_TAG_LIMIT
        label.delete(array.shift(exitTags))

    array.push(exitTags, label.new(bar_index, close, "未突破离场 · 参考结束\n" + str.tostring(close, format.mintick), style=label.style_label_down, color=color.new(chart.bg_color, 8), textcolor=ink, size=size.small, force_overlay=true))

// ───────────── 当前候选主线绘制 ─────────────

// 此对象只负责当前候选，不负责历史联合线。
// 历史联合线在后面单独存档，不会被这里删除。
if v10Enabled and (barstate.islastconfirmedhistory or barstate.islast)
    if not na(v10Drawing)
        polyline.delete(v10Drawing)
        v10Drawing := na

    while array.size(v10Marks) > 0
        label.delete(array.pop(v10Marks))

    if v10ShowLine and not v10OnlyJoint and not na(v10Main) and not na(v10ClosedBar) and not (v10Main.joined and v10ShowJoint) and (v10Main.phase == 1 or (v10KeepStopped and v10Main.phase == 3))
        int endBar = v10Main.phase == 1 ? v10ClosedBar + v10Ahead : v10Main.phase == 2 and not na(v10Main.brokenBar) ? v10Main.brokenBar + v11ExtendBars : v10Main.stopped

        if not na(endBar) and endBar > v10Main.ax and v10ClosedBar - v10Main.ax < 9000
            array<chart.point> points = array.new<chart.point>()

            if v10Log
                for x = v10Main.ax to endBar
                    array.push(points, chart.point.from_index(x, v10Main.at(x)))
            else
                array.push(points, chart.point.from_index(v10Main.ax, v10Main.ap))
                array.push(points, chart.point.from_index(endBar, v10Main.at(endBar)))

            color tone = v10Main.phase == 1 ? v10LineColor : color.new(v10LineColor, 65)

            v10Drawing := polyline.new(points, curved=false, closed=false, xloc=xloc.bar_index, line_color=tone, line_width=v10LineWidth, force_overlay=true)

            if v10ShowABC
                string sourceText = v10Main.source == 0 ? "完整影线" : v10PeakMode == "实体上沿" ? "实体上沿" : "削尖影线"

                string tip = "结构#" + str.tostring(v10Main.uid) + " · " + f_v12_kindText(v10Main) + " · " + sourceText + "\n三点实际确认：" + str.format_time(v10Main.confirmedTime, "MM-dd HH:mm", "Asia/Shanghai") + " 北京时间\n本次切换显示K：" + str.tostring(v10Promotion) + "。后台确认不等于当时已显示；信号不回填。"

                array.push(v10Marks, label.new(v10Main.ax, v10Main.ap, "A", style=label.style_label_down, color=color.new(tone, 100), textcolor=tone, size=size.tiny, tooltip=tip, force_overlay=true))
                array.push(v10Marks, label.new(v10Main.bx, v10Main.bp, "B", style=label.style_label_down, color=color.new(tone, 100), textcolor=tone, size=size.tiny, tooltip=tip, force_overlay=true))
                array.push(v10Marks, label.new(v10Main.cx, v10Main.cp, v10Main.kind == 1 ? "C·RT" : "C", style=label.style_label_down, color=color.new(tone, 100), textcolor=tone, size=size.tiny, tooltip=tip, force_overlay=true))
                array.push(v10Marks, label.new(v10Main.born, v10Main.at(v10Main.born), "ok", style=label.style_none, color=color.new(tone, 100), textcolor=tone, size=size.tiny, tooltip=tip, force_overlay=true))

                if v10Main.phase == 2 and not na(v10Main.brokenBar)
                    array.push(v10Marks, label.new(v10Main.brokenBar, v10Main.at(v10Main.brokenBar), "·", style=label.style_label_center, color=color.new(tone, 100), textcolor=v10BreakColor, size=size.tiny, tooltip=tip, force_overlay=true))

// ───────────── V11 最近突破线与上级周期线 ─────────────

// Broken lines are archived together with their marker below.

// 上级周期：最近一次突破的线（延伸）与当前候选线（虚线）。
if v10Enabled and (barstate.islastconfirmedhistory or barstate.islast)
    if not na(v11HtfDrawing)
        polyline.delete(v11HtfDrawing)
        v11HtfDrawing := na

    if not na(v11HtfActiveDrawing)
        polyline.delete(v11HtfActiveDrawing)
        v11HtfActiveDrawing := na

    while array.size(v11HtfMarks) > 0
        label.delete(array.pop(v11HtfMarks))

    if v11HtfOn and not v10OnlyJoint
        if v11ShowHtfLine and not na(htfActAxT) and not na(htfActBxT) and htfActBxT != htfActAxT
            int activeEnd = time + v10Ahead * v11BarMs
            v11HtfActiveDrawing := polyline.new(f_v11_timePoints(htfActAxT, htfActAp, htfActBxT, htfActBp, activeEnd), curved=false, closed=false, xloc=xloc.bar_time, line_color=color.new(v11HtfColor, 20), line_style=line.style_dashed, line_width=v10LineWidth, force_overlay=true)

            if v10ShowABC
                string activeTip = v11HtfText + " 当前候选下降线（未突破）"
                array.push(v11HtfMarks, label.new(htfActAxT, htfActAp, "A", xloc=xloc.bar_time, style=label.style_label_down, color=color.new(v11HtfColor, 100), textcolor=color.new(v11HtfColor, 20), size=size.tiny, tooltip=activeTip, force_overlay=true))
                array.push(v11HtfMarks, label.new(htfActBxT, htfActBp, "B", xloc=xloc.bar_time, style=label.style_label_down, color=color.new(v11HtfColor, 100), textcolor=color.new(v11HtfColor, 20), size=size.tiny, tooltip=activeTip, force_overlay=true))
                array.push(v11HtfMarks, label.new(htfActCxT, htfActCp, "C", xloc=xloc.bar_time, style=label.style_label_down, color=color.new(v11HtfColor, 100), textcolor=color.new(v11HtfColor, 20), size=size.tiny, tooltip=activeTip, force_overlay=true))

// 诊断：候选池里所有未突破的本周期下降线。
var array<polyline> v112DiagLines = array.new<polyline>()
var array<label> v112DiagMarks = array.new_label()

if v10Enabled and (barstate.islastconfirmedhistory or barstate.islast)
    while array.size(v112DiagLines) > 0
        polyline.delete(array.pop(v112DiagLines))

    while array.size(v112DiagMarks) > 0
        label.delete(array.pop(v112DiagMarks))

    if v112ShowAllLines
        for item in v10Tracks
            if item.phase == 1 and v10ClosedBar - item.ax < 9000
                array<chart.point> diagPoints = array.new<chart.point>()
                array.push(diagPoints, chart.point.from_index(item.ax, item.ap))
                array.push(diagPoints, chart.point.from_index(v10ClosedBar + v10Ahead, item.at(v10ClosedBar + v10Ahead)))
                array.push(v112DiagLines, polyline.new(diagPoints, curved=false, closed=false, xloc=xloc.bar_index, line_color=color.new(v10LineColor, 55), line_style=line.style_dotted, line_width=1, force_overlay=true))
                string diagTip = "候选#" + str.tostring(item.uid) + " · " + f_v12_kindText(item) + " · 分数 " + str.tostring(item.score, "#.###") + " · " + (item.source == 0 ? "完整影线" : "削尖影线") + "\n三点确认：" + str.format_time(item.confirmedTime, "MM-dd HH:mm", "Asia/Shanghai")
                array.push(v112DiagMarks, label.new(item.cx, item.cp, "#" + str.tostring(item.uid), style=label.style_label_down, color=color.new(v10LineColor, 100), textcolor=color.new(v10LineColor, 40), size=size.tiny, tooltip=diagTip, force_overlay=true))

// ───────────── 联合信号与趋势线成组保留 ─────────────

bool v10JointVisible = v10Enabled and (v10ShowJoint or v10OnlyJoint) and v112ChartShow
bool v11HtfJointVisible = v10Enabled and (v10ShowJoint or v10OnlyJoint) and v112HtfShow


// 联合信号不再使用无限历史plotshape。
// 通过一组标签+趋势线共同保留，保证不会只剩标签却没有线。
type V10SignalDrawing
    polyline trend
    label tag
    array<label> marks
    int breakContext = 0
    int pivotB = na
    float pivotPrice = na
    int firstBreak = na
    int breakCount = 1
    string breakDetails = ""
    string breakCaption = "bk"
    int regionStart = na
    int regionEnd = na
    float regionPrice = na
    float regionBand = na

method erase(V10SignalDrawing self) =>
    polyline.delete(self.trend)
    label.delete(self.tag)

    if not na(self.marks)
        while array.size(self.marks) > 0
            label.delete(array.pop(self.marks))

// Freeze the first A interval in a region. Never grow it transitively through members.
f_v122_region(array<V10SignalDrawing> history, int aStart, int aEnd, float aPrice) =>
    int regionStart = aStart
    int regionEnd = aEnd
    float regionPrice = aPrice
    float regionBand = math.max(nz(v10Atr, syminfo.mintick), 2 * syminfo.mintick)
    int pad = v122RegionGap * v11BarMs
    if v122LocalTidy
        for group in history
            if aStart < group.regionEnd + pad and aEnd > group.regionStart - pad and math.abs(aPrice - group.regionPrice) <= group.regionBand
                regionStart := group.regionStart
                regionEnd := group.regionEnd
                regionPrice := group.regionPrice
                regionBand := group.regionBand
                break
    [regionStart, regionEnd, regionPrice, regionBand]

// Only the newly inserted region is capped. Unrelated historical regions survive.
f_v11_trimAbc(array<V10SignalDrawing> history, int keep) =>
    if v122LocalTidy and array.size(history) > 0
        V10SignalDrawing newest = array.last(history)
        int regionCount = 0
        for group in history
            if group.regionStart == newest.regionStart and group.regionEnd == newest.regionEnd and group.regionPrice == newest.regionPrice
                regionCount += 1
        while regionCount > v122RegionKeep
            int victim = na
            // Retain joint evidence preferentially; within each class discard the oldest.
            for n = 0 to array.size(history) - 1
                V10SignalDrawing group = array.get(history, n)
                if group.regionStart == newest.regionStart and group.regionEnd == newest.regionEnd and group.regionPrice == newest.regionPrice
                    if na(victim)
                        victim := n
                    if group.breakContext != 0
                        victim := n
                        break
            if not na(victim)
                V10SignalDrawing removed = array.remove(history, victim)
                removed.erase()
            regionCount -= 1

    // Apply resource capacity only after local replacement; never evict another
    // region merely to insert a fourth line that will immediately be removed.
    while array.size(history) > v10JointKeep
        V10SignalDrawing oldest = array.shift(history)
        oldest.erase()

    int cut = array.size(history) - keep - 1
    if cut >= 0
        for n = 0 to cut
            V10SignalDrawing aged = array.get(history, n)
            if not na(aged.marks)
                while array.size(aged.marks) > 0
                    label.delete(array.pop(aged.marks))

    // Keep ABC on one representative per region, without hiding historical lines.
    if v122LocalTidy and array.size(history) > 0
        array<string> seenRegions = array.new_string()
        for n = array.size(history) - 1 to 0
            V10SignalDrawing group = array.get(history, n)
            string regionKey = str.tostring(group.regionStart) + ":" + str.tostring(group.regionEnd) + ":" + str.tostring(group.regionPrice, format.mintick)
            if array.includes(seenRegions, regionKey)
                while array.size(group.marks) > 0
                    label.delete(array.pop(group.marks))
            else
                array.push(seenRegions, regionKey)
    0

// Presentation only: never move the first event or replace its frozen line.
// Each update contains only confirmations known on the current closed bar.
f_v12_mergeBreak(array<V10SignalDrawing> history, int context, int pivotB, float pivotPrice, int eventBar, string detail) =>
    bool merged = false
    if v12CompactBreaks and array.size(history) > 0
        for n = array.size(history) - 1 to 0
            V10SignalDrawing group = array.get(history, n)
            // A joint separates display episodes and is never folded into bk.
            if group.breakContext == 0
                break
            if group.breakContext == context and group.pivotB == pivotB and group.pivotPrice == pivotPrice and eventBar >= group.firstBreak and eventBar - group.firstBreak <= 8
                group.breakCount += 1
                group.breakDetails += "\n\n" + detail
                if not na(group.tag)
                    label.set_text(group.tag, group.breakCaption + " · " + str.tostring(group.breakCount))
                    label.set_tooltip(group.tag, "同一B点附近 " + str.tostring(group.breakCount) + " 条候选突破，不代表多笔入场。\n仅合并显示，事件/预警/配对不变。显示首条冻结线，标记位于首次确认K。\n\n" + group.breakDetails)
                merged := true
                break
    merged

var array<V10SignalDrawing> v10SignalHistory = array.new<V10SignalDrawing>()

if v10JointVisible and not na(v112ChartLine)
    // Local replacement precedes the global resource limit inside trimAbc.

    // 冻结原A/B斜率，穿过联合确认当根继续向右延伸。
    array<chart.point> eventPoints = array.new<chart.point>()
    int eventEnd = bar_index + v11ExtendBars

    if v10Log
        for x = v112ChartLine.ax to eventEnd
            array.push(eventPoints, chart.point.from_index(x, v112ChartLine.at(x)))
    else
        array.push(eventPoints, chart.point.from_index(v112ChartLine.ax, v112ChartLine.ap))
        array.push(eventPoints, chart.point.from_index(eventEnd, v112ChartLine.at(eventEnd)))

    // 不受“显示当前候选线”和“保留失效线”开关影响。
    polyline frozenTrend = polyline.new(eventPoints, curved=false, closed=false, xloc=xloc.bar_index, line_color=color.new(v10LineColor, v122JointFade), line_width=v10JointLineWidth, force_overlay=true)

    string caption = "bk+spike"
    string tagSize = v10TagSize == "小" ? size.small : v10TagSize == "大" ? size.large : size.normal
    string sourceText = v112ChartLine.source == 0 ? "完整影线" : v10PeakMode == "实体上沿" ? "实体上沿" : "削尖影线"

    string tagTip = "突破+spike · 结构#" + str.tostring(v112ChartLine.uid) + " · " + f_v12_kindText(v112ChartLine) + " · " + sourceText + "\n联合确认：" + str.format_time(time_close, "yyyy-MM-dd HH:mm", "Asia/Shanghai") + " 北京时间\n联合收盘价：" + str.tostring(close, format.mintick) + "\n结构提前确认：" + str.format_time(v112ChartLine.confirmedTime, "MM-dd HH:mm", "Asia/Shanghai") + "\n" + v10LastJointOrder + "\n对应线固定保留。旧V9风险参考不重置；此价格不代表成交。" + (v112UseBox and v112AddOnBreak and not v12BreakFirst and bar_index > entryBar ? "\n加仓提示：止损沿用原框 " + str.tostring(initialStop, format.mintick) : "")

    float tagY = math.max(syminfo.mintick, low - v10Atr * v10TagGap)

    label signalTag = (v126Minimal or not v130LegacyVisible) ? na : label.new(
         bar_index,
         tagY,
         caption,
         xloc=xloc.bar_index,
         yloc=yloc.price,
         style=label.style_none,
         color=color.new(v10JointColor, 100),
         textcolor=v10JointColor,
         size=tagSize,
         textalign=text.align_center,
         tooltip=tagTip,
         text_formatting=text.format_bold,
         force_overlay=true)

    array<label> jointMarks = v10ShowABC and v11AbcKeep > 0 ? f_v11_indexMarks(v112ChartLine, v112ChartLine.brokenBar, color.new(v10LineColor, 55), tagTip, false) : array.new_label()
    [regionStart, regionEnd, regionPrice, regionBand] = f_v122_region(v10SignalHistory, time[bar_index - v112ChartLine.ax], time[bar_index - v112ChartLine.ax] + v11BarMs, v112ChartLine.ap)
    array.push(v10SignalHistory, V10SignalDrawing.new(frozenTrend, signalTag, jointMarks, 0, na, na, bar_index, 1, tagTip, caption, regionStart, regionEnd, regionPrice, regionBand))
    f_v11_trimAbc(v10SignalHistory, v11AbcKeep)

// 上级周期突破 + 本图SPIKE：同样整组保留线、标签与A/B/C。
if v11HtfJointVisible and not na(v12JointAx) and not na(v12JointBx) and v12JointBx != v12JointAx

    int htfEnd = time + v11ExtendBars * v11BarMs
    polyline htfTrend = polyline.new(f_v11_timePoints(v12JointAx, v12JointAp, v12JointBx, v12JointBp, htfEnd), curved=false, closed=false, xloc=xloc.bar_time, line_color=color.new(v11HtfColor, v122JointFade), line_width=v10JointLineWidth, force_overlay=true)

    // Same compact typography for chart and HTF joint confirmations.
    string htfCaption = "bk+spike"
    string htfTagSize = v10TagSize == "小" ? size.small : v10TagSize == "大" ? size.large : size.normal
    string htfSourceText = v12JointSource % 2 == 0 ? "完整影线" : v10PeakMode == "实体上沿" ? "实体上沿" : "削尖影线"
    string htfTip = "突破+spike（上级突破 · " + v11HtfText + "） · " + (v12JointSource >= 2 ? "主高点＋局部回踩 · " : "三主高点 · ") + htfSourceText + "\n联合确认：" + str.format_time(time_close, "yyyy-MM-dd HH:mm", "Asia/Shanghai") + " 北京时间\n联合收盘价：" + str.tostring(close, format.mintick) + "\n上级结构三点确认：" + str.format_time(v12JointBorn, "MM-dd HH:mm", "Asia/Shanghai") + "\n上级突破K开盘：" + str.format_time(v12JointBreak, "MM-dd HH:mm", "Asia/Shanghai") + "（收盘后本图才可见）\n" + v11HtfOrder + "\n旧V9风险参考不重置；此价格不代表成交。"

    label htfTag = (v126Minimal or not v130LegacyVisible) ? na : label.new(bar_index, math.max(syminfo.mintick, low - v10Atr * v10TagGap), htfCaption, xloc=xloc.bar_index, yloc=yloc.price, style=label.style_none, color=color.new(v10JointColor, 100), textcolor=v11HtfColor, size=htfTagSize, textalign=text.align_center, tooltip=htfTip, text_formatting=text.format_bold, force_overlay=true)

    array<label> htfJointMarks = v10ShowABC and v11AbcKeep > 0 ? f_v11_timeMarks(v12JointAx, v12JointAp, v12JointBx, v12JointBp, v12JointCx, v12JointCp, v12JointBreak, v12JointBorn, color.new(v11HtfColor, 55), htfTip, false) : array.new_label()
    [regionStart, regionEnd, regionPrice, regionBand] = f_v122_region(v10SignalHistory, v12JointAx, v12JointAx + int(timeframe.in_seconds(v11Htf) * 1000), v12JointAp)
    array.push(v10SignalHistory, V10SignalDrawing.new(htfTrend, htfTag, htfJointMarks, 0, na, na, bar_index, 1, htfTip, htfCaption, regionStart, regionEnd, regionPrice, regionBand))
    f_v11_trimAbc(v10SignalHistory, v11AbcKeep)


// Ordinary breaks can form a presentation group; signal events remain untouched.
if not v10OnlyJoint and v10Enabled and v10ShowBreak and v10BreakEvent and not v10JointVisible and not na(v11LastBroken)
    V10Line item = v11LastBroken
    string tip = "本周期 bk · #" + str.tostring(item.uid) + " · " + f_v12_kindText(item) + "\n确认收盘 " + str.format_time(time_close, "MM-dd HH:mm", "Asia/Shanghai") + "\nA " + str.format_time(time[bar_index - item.ax], "MM-dd HH:mm", "Asia/Shanghai") + " @" + str.tostring(item.ap, format.mintick) + "\nB " + str.format_time(time[bar_index - item.bx], "MM-dd HH:mm", "Asia/Shanghai") + " @" + str.tostring(item.bp, format.mintick) + "\nC " + str.format_time(time[bar_index - item.cx], "MM-dd HH:mm", "Asia/Shanghai") + " @" + str.tostring(item.cp, format.mintick)
    bool merged = f_v12_mergeBreak(v10SignalHistory, 1, item.bx, item.bp, bar_index, tip)
    if not merged
        int endBar = bar_index + v11ExtendBars
        array<chart.point> points = array.new<chart.point>()
        if v10Log
            for x = item.ax to endBar
                array.push(points, chart.point.from_index(x, item.at(x)))
        else
            array.push(points, chart.point.from_index(item.ax, item.ap))
            array.push(points, chart.point.from_index(endBar, item.at(endBar)))
        polyline trend = polyline.new(points, xloc=xloc.bar_index, line_color=color.new(v10LineColor, v122HistoryFade), line_width=v10LineWidth, force_overlay=true)
        label tag = v126Minimal ? na : label.new(bar_index, math.max(syminfo.mintick, low - v10Atr * v10TagGap), "bk", style=label.style_none, textcolor=color.new(v10BreakColor, 25), size=size.tiny, tooltip=tip, force_overlay=true)
        array<label> marks = v10ShowABC and v11AbcKeep > 0 ? f_v11_indexMarks(item, item.brokenBar, color.new(v10LineColor, 65), tip, false) : array.new_label()
        [regionStart, regionEnd, regionPrice, regionBand] = f_v122_region(v10SignalHistory, time[bar_index - item.ax], time[bar_index - item.ax] + v11BarMs, item.ap)
        array.push(v10SignalHistory, V10SignalDrawing.new(trend, tag, marks, 1, item.bx, item.bp, bar_index, 1, tip, "bk", regionStart, regionEnd, regionPrice, regionBand))
        f_v11_trimAbc(v10SignalHistory, v11AbcKeep)

if not v10OnlyJoint and v11HtfOn and v11ShowHtfBreak and v11HtfBreakKnown and not v11HtfJointVisible
    string tip = v11HtfText + " bk · 上级K已收盘，本图可见 " + str.format_time(time_close, "MM-dd HH:mm", "Asia/Shanghai") + "\nA " + str.format_time(v11HtfAxT, "MM-dd HH:mm", "Asia/Shanghai") + " @" + str.tostring(v11HtfAp, format.mintick) + "\nB " + str.format_time(v11HtfBxT, "MM-dd HH:mm", "Asia/Shanghai") + " @" + str.tostring(v11HtfBp, format.mintick) + "\nC " + str.format_time(v11HtfCxT, "MM-dd HH:mm", "Asia/Shanghai") + " @" + str.tostring(v11HtfCp, format.mintick)
    bool merged = f_v12_mergeBreak(v10SignalHistory, 2, v11HtfBxT, v11HtfBp, bar_index, tip)
    if not merged
        polyline trend = polyline.new(f_v11_timePoints(v11HtfAxT, v11HtfAp, v11HtfBxT, v11HtfBp, time + v11ExtendBars * v11BarMs), xloc=xloc.bar_time, line_color=color.new(v11HtfColor, v122HistoryFade), line_width=v10LineWidth, force_overlay=true)
        string caption = "bk " + v11HtfText
        label tag = v126Minimal ? na : label.new(bar_index, math.max(syminfo.mintick, low - v10Atr * (v10TagGap + (v10BreakEvent ? 0.6 : 0))), caption, style=label.style_none, textcolor=color.new(v11HtfColor, 25), size=size.tiny, tooltip=tip, force_overlay=true)
        array<label> marks = v10ShowABC and v11AbcKeep > 0 ? f_v11_timeMarks(v11HtfAxT, v11HtfAp, v11HtfBxT, v11HtfBp, v11HtfCxT, v11HtfCp, v11HtfBreakT, v11HtfBornT, color.new(v11HtfColor, 65), tip, false) : array.new_label()
        [regionStart, regionEnd, regionPrice, regionBand] = f_v122_region(v10SignalHistory, v11HtfAxT, v11HtfAxT + int(timeframe.in_seconds(v11Htf) * 1000), v11HtfAp)
        array.push(v10SignalHistory, V10SignalDrawing.new(trend, tag, marks, 2, v11HtfBxT, v11HtfBp, bar_index, 1, tip, caption, regionStart, regionEnd, regionPrice, regionBand))
        f_v11_trimAbc(v10SignalHistory, v11AbcKeep)

// 事件码：1结构确认，2突破，4联合，8上级突破可见，16上级突破+spike；同根可以相加。
plot(barstate.isconfirmed ? (v10BornEvent ? 1 : 0) + (v10BreakEvent ? 2 : 0) + (v112ChartShow ? 4 : 0) + (v11HtfBreakKnown ? 8 : 0) + (v112HtfShow ? 16 : 0) : na, "V12.8 事件码（1结构/2突破/4联合/8上级突破/16上级联合）", display=display.data_window)
plot(v11AnyJoint ? close : na, "突破+spike 实际收盘价", display=display.data_window)

alertcondition(not v130Retest and v10BreakEvent, "SPIKE V13.0 原版 本周期下降线突破", "SPIKE V13.0 原版 已确认下降结构突破 | {{exchange}}:{{ticker}} | {{interval}} | 收盘 {{close}}")

alertcondition(not v130Retest and v11HtfBreakKnown, "SPIKE V13.0 原版 上级周期下降线突破", "SPIKE V13.0 原版 上级周期下降线突破（上级K已收盘） | {{exchange}}:{{ticker}} | {{interval}} | 收盘 {{close}}")

alertcondition(not v130Retest and v10Enabled and v112HtfShow, "SPIKE V13.0 原版 突破+spike（上级突破）", "SPIKE V13.0 原版 突破+spike（上级突破） | {{exchange}}:{{ticker}} | {{interval}} | 联合收盘 {{close}} | 不代表成交")

alertcondition(not v130Retest and v11AnyJoint, "SPIKE V13.0 原版 突破+spike 联合确认（任一来源）", "SPIKE V13.0 原版 突破+spike | {{exchange}}:{{ticker}} | {{interval}} | 联合收盘 {{close}} | 不代表成交")

// ───────────── 普通信号显示 ─────────────

// 只显示模式不会改写confirmedSignal和confirmedShortSignal。
plotshape(v130LegacyVisible and not v126Minimal and not v10OnlyJoint and confirmedSignal and not v10JointVisible and not v11HtfJointVisible, title="确认多头", style=shape.triangleup, location=location.belowbar, color=bull, size=size.tiny, force_overlay=true, display=display.pane)

plotshape(v130LegacyVisible and not v126Minimal and not v10OnlyJoint and confirmedShortSignal, title="确认空头", style=shape.triangledown, location=location.abovebar, color=bear, size=size.tiny, force_overlay=true, display=display.pane)

var array<label> signalTags = array.new<label>()

if v130LegacyVisible and barstate.isconfirmed and not v10OnlyJoint and signalSide != 0 and showLabels and not v10JointVisible and not v11HtfJointVisible
    string trackingTip = referenceStarted ? "本根开启盈亏参考。" : trendSide != 0 ? "已有盈亏参考继续跟踪，本根确认不会重置原框。" : "本根未开启盈亏参考。"
    string signalSideText = signalSide == 1 ? "多头" : "空头"

    string tip = signalSideText + "确认收盘：" + str.tostring(close, format.mintick) + "\n" + str.format_time(time_close, "yyyy-MM-dd HH:mm", "Asia/Shanghai") + " 北京时间\n" + trackingTip + "\n资产类型：" + syminfo.type + " · 底层：" + baseAsset + "\n收盘量比：" + str.tostring(rv, "#.##") + "\n确认价参考风险：" + str.tostring(signalReferenceRiskFraction * 100, "#.####") + "% · 成本：" + str.tostring(signalReferenceCostR, "#.####") + "R（往返0.2%）"

    if array.size(signalTags) >= SIGNAL_TAG_LIMIT
        label.delete(array.shift(signalTags))

    array.push(signalTags, label.new(bar_index, signalSide == 1 ? low - atr * 0.35 : high + atr * 0.35, str.tostring(close, format.mintick), style=signalSide == 1 ? label.style_label_up : label.style_label_down, color=color.new(signalSide == 1 ? bull : bear, 91), textcolor=signalSide == 1 ? bull : bear, size=size.small, tooltip=tip, force_overlay=true))

// ───────────── 原有盈亏框 ─────────────

string rrGroup = "05 · 趋势盈亏框"

bool rrShow = input.bool(true, "显示盈亏双框", group=rrGroup, tooltip="红框为冻结初始风险；绿框先显示3R观察位，随后随已确认峰值扩展。没有固定止盈。价格均为信号收盘参考，并非实际成交。", display=display.none) and not v126Minimal

int rrKeep = input.int(30, "保留盈亏框组数", minval=1, maxval=30, group=rrGroup, tooltip="保留最近30组完整历史框、出场R虚线与价格标签，避免平台对象上限导致缺线。仅清理超出组数的最旧参考；信号箭头本身不受此限制。", display=display.none)

int rrAhead = input.int(12, "当前框向右展示根数", minval=2, maxval=60, group=rrGroup, tooltip="仅影响当前框的视觉宽度，不改变任何信号或持有规则；保护触及后固定在该根收盘。", display=display.none)

f_rrPriceTag(int stamp, float price, string caption, color tone, string tip, bool hide = false) =>
    label.new(stamp, price, caption, xloc=xloc.bar_time, yloc=yloc.price, style=label.style_label_left, color=color.new(chart.bg_color, hide ? 100 : 12), textcolor=hide ? color.new(tone, 100) : tone, size=size.small, tooltip=tip, force_overlay=true)

type RRDrawing
    box riskBox
    box rewardBox
    label entryTag
    label stopTag
    label peakTag
    array<line> targetLines
    array<line> milestoneLines
    array<label> milestoneTags
    int side
    int startedAt
    float entryPrice
    float stopPrice
    float distance
    float maximum
    bool hidden = false
    line exitLine = na
    label exitTag = na

method deleteDrawings(RRDrawing group) =>
    box.delete(group.riskBox)
    box.delete(group.rewardBox)
    label.delete(group.entryTag)
    label.delete(group.stopTag)
    label.delete(group.peakTag)
    line.delete(group.exitLine)
    label.delete(group.exitTag)

    for slot = 0 to 2
        line.delete(array.get(group.targetLines, slot))
        line.delete(array.get(group.milestoneLines, slot))
        label.delete(array.get(group.milestoneTags, slot))

// 仅显示突破+spike时，V9盈亏框先隐藏创建；框内出现突破+spike才显示，没出就随框结束删除。
method reveal(RRDrawing group, array<label> targetTags) =>
    if not na(group.riskBox)
        box.set_border_color(group.riskBox, color.new(bear, 45))
        box.set_bgcolor(group.riskBox, color.new(bear, 92))

    if not na(group.rewardBox)
        box.set_border_color(group.rewardBox, color.new(bull, 45))
        box.set_bgcolor(group.rewardBox, color.new(bull, 92))

    if not na(group.entryTag)
        label.set_color(group.entryTag, color.new(chart.bg_color, 12))
        label.set_textcolor(group.entryTag, ink)

    if not na(group.stopTag)
        label.set_color(group.stopTag, color.new(chart.bg_color, 12))
        label.set_textcolor(group.stopTag, bear)

    if not na(group.peakTag)
        label.set_color(group.peakTag, color.new(chart.bg_color, 12))
        label.set_textcolor(group.peakTag, bull)

    for slot = 0 to 2
        line targetLine = array.get(group.targetLines, slot)
        label targetTag = array.get(targetTags, slot)

        if not na(targetLine)
            line.set_color(targetLine, color.new(bull, 72))

        if not na(targetTag)
            label.set_color(targetTag, color.new(chart.bg_color, 12))
            label.set_textcolor(targetTag, bull)

    group.hidden := false
    0

var array<RRDrawing> rrHistory = array.new<RRDrawing>()
var RRDrawing activeRR = na
var array<line> rrTargetLines = array.new<line>(3, na)
var array<label> rrTargetTags = array.new<label>(3, na)

// ───────────── 原有参考绘图更新 ─────────────

if barstate.isconfirmed
    int rrBarMillis = na(time_close) ? int(timeframe.in_seconds() * 1000) : time_close - time
    int rrCloseTime = na(time_close) ? time + rrBarMillis : time_close
    int rrRightTime = rrCloseTime + rrAhead * rrBarMillis

    if referenceGap and not na(activeRR)
        if not na(activeRR.riskBox)
            box.set_right(activeRR.riskBox, time_close[1])

            if not na(activeRR.rewardBox)
                box.set_right(activeRR.rewardBox, time_close[1])

            label.set_x(activeRR.entryTag, time_close[1])
            label.set_x(activeRR.stopTag, time_close[1])

            if not na(activeRR.peakTag)
                label.set_x(activeRR.peakTag, time_close[1])

        for targetSlot = 0 to 2
            label.delete(array.get(rrTargetTags, targetSlot))

        rrTargetLines := array.new<line>(3, na)
        rrTargetTags := array.new<label>(3, na)
        activeRR := na

    if not na(activeRR) and not exitReference and activeRR.hidden and activeRR.side == 1 and v11AnyJoint
        activeRR.reveal(rrTargetTags)

    if not na(activeRR)
        bool ended = exitReference

        float groupPeakR = ended ? exitPeakR : peakR
        float groupCurrentR = ended ? exitCurrentR : currentR
        float groupProtection = ended ? exitProtection : protection

        int edge = ended ? rrCloseTime : rrRightTime
        activeRR.maximum := math.max(activeRR.maximum, nz(groupPeakR, 0.0))

        float extentR = math.max(3.0, activeRR.maximum)
        float extent = activeRR.entryPrice + activeRR.side * extentR * activeRR.distance
        string endingText = ended ? " · " + exitReason : ""

        string reference = "确认收盘参考，不是实际成交。已确认峰值 " + str.tostring(activeRR.maximum, "#.##") + "R；当前路径 " + str.tostring(groupCurrentR, "#.##") + "R。峰值未兑现；无固定止盈。" + endingText

        if not na(activeRR.riskBox)
            box.set_right(activeRR.riskBox, edge)
            label.set_x(activeRR.entryTag, edge)
            label.set_x(activeRR.stopTag, edge)
            label.set_text(activeRR.entryTag, str.tostring(activeRR.entryPrice, format.mintick))
            label.set_tooltip(activeRR.entryTag, reference)
            label.set_tooltip(activeRR.stopTag, reference + " 冻结初始风险；当前保护 " + str.tostring(groupProtection, format.mintick))

        if not na(activeRR.rewardBox) and extent > 0
            box.set_right(activeRR.rewardBox, edge)
            box.set_top(activeRR.rewardBox, math.max(activeRR.entryPrice, extent))
            box.set_bottom(activeRR.rewardBox, math.min(activeRR.entryPrice, extent))
            label.set_xy(activeRR.peakTag, edge, extent)

            label.set_text(activeRR.peakTag, showMilestones and activeRR.maximum < 3.0 ? "" : (activeRR.maximum >= 3.0 ? "峰值 " + str.tostring(activeRR.maximum, "#.##") + "R · " : "3R 观察位 · ") + str.tostring(extent, format.mintick))

            label.set_tooltip(activeRR.peakTag, reference)

        for targetSlot = 0 to 2
            line targetLine = array.get(rrTargetLines, targetSlot)
            label targetTag = array.get(rrTargetTags, targetSlot)

            if not na(targetLine)
                line.set_x2(targetLine, edge)

            if not na(targetTag)
                label.set_x(targetTag, edge)

        for slot = 0 to 2
            float level = slot == 0 ? 3.0 : slot == 1 ? 5.0 : 10.0
            float levelPrice = activeRR.entryPrice + activeRR.side * level * activeRR.distance

            if showMilestones and not v10OnlyJoint and activeRR.maximum >= level and levelPrice > 0 and na(array.get(activeRR.milestoneLines, slot))
                if slot == 0
                    line.delete(array.get(rrTargetLines, 2))
                    label.delete(array.get(rrTargetTags, 2))
                    array.set(rrTargetLines, 2, na)
                    array.set(rrTargetTags, 2, na)

                string hitTip = "收盘确认已触及 " + str.tostring(level, "#") + "R · " + str.format_time(time_close, "MM-dd HH:mm", "Asia/Shanghai") + " 北京时间。虚线为冻结入场风险计算的价位，不是止盈指令。"

                line guide = line.new(activeRR.startedAt, levelPrice, rrCloseTime, levelPrice, xloc=xloc.bar_time, color=color.new(bull, 35), style=line.style_dashed, width=1, force_overlay=true)

                label tag = v126Minimal ? na : label.new(time, levelPrice, str.tostring(level, "#") + "R 已达", xloc=xloc.bar_time, style=label.style_label_left, color=color.new(bull, 88), textcolor=bull, size=size.tiny, tooltip=hitTip, force_overlay=true)

                array.set(activeRR.milestoneLines, slot, guide)
                array.set(activeRR.milestoneTags, slot, tag)

            line guide = array.get(activeRR.milestoneLines, slot)

            if not na(guide)
                line.set_x2(guide, rrCloseTime)

        if ended
            if showRisk and rrShow and not activeRR.hidden and not na(exitReferencePrice)
                float grossR = activeRR.side * (exitReferencePrice - activeRR.entryPrice) / activeRR.distance
                float netR = grossR - activeRR.entryPrice * roundTripCost / activeRR.distance
                color exitTone = grossR >= 0 ? bull : bear
                string exitTip = exitReason + " · " + str.format_time(rrCloseTime, "MM-dd HH:mm", "Asia/Shanghai") + " 北京\n参考出场 " + str.tostring(exitReferencePrice, format.mintick) + "\n毛 " + str.tostring(grossR, "#.##") + "R · 扣0.2%成本 " + str.tostring(netR, "#.##") + "R；不是实际成交。"
                activeRR.exitLine := line.new(activeRR.startedAt, exitReferencePrice, rrCloseTime, exitReferencePrice, xloc=xloc.bar_time, color=exitTone, style=line.style_dashed, width=2, force_overlay=true)
                activeRR.exitTag := label.new(rrCloseTime, exitReferencePrice, "exit " + (grossR > 0 ? "+" : "") + str.tostring(grossR, "#.##") + "R", xloc=xloc.bar_time, style=label.style_none, textcolor=exitTone, size=size.small, tooltip=exitTip, force_overlay=true)
            for targetSlot = 0 to 2
                label.delete(array.get(rrTargetTags, targetSlot))

            if activeRR.hidden
                activeRR.deleteDrawings()

            rrTargetLines := array.new<line>(3, na)
            rrTargetTags := array.new<label>(3, na)
            activeRR := na

    if referenceStarted
        int rrNewSide = trendSide
        float rrNewDistance = rrNewSide * (entry - initialStop)

        bool rrValid = not na(entry) and not na(initialStop) and entry > 0 and initialStop > 0 and rrNewDistance > 0

        if rrValid
            while array.size(rrHistory) >= rrKeep
                RRDrawing oldest = array.shift(rrHistory)
                oldest.deleteDrawings()

            activeRR := RRDrawing.new(na, na, na, na, na, array.new<line>(3, na), array.new<line>(3, na), array.new<label>(3, na), rrNewSide, time, entry, initialStop, rrNewDistance, 0.0)

            array.push(rrHistory, activeRR)

            // 仅联合模式下隐藏旧V9参考图形，不修改参考状态和退出。
            if showRisk and rrShow
                bool rrHide = v10OnlyJoint and not (v11AnyJoint and rrNewSide == 1)
                activeRR.hidden := rrHide
                float observation = entry + rrNewSide * 3.0 * rrNewDistance
                string sideText = rrNewSide == 1 ? "多头" : "空头"

                string tip = sideText + "确认收盘参考，不是实际成交。初始风险冻结；3R仅为观察位，不触发止盈。绿色框为走势参考，峰值未兑现。"

                activeRR.riskBox := box.new(time, math.max(entry, initialStop), rrRightTime, math.min(entry, initialStop), xloc=xloc.bar_time, border_color=color.new(bear, rrHide ? 100 : 45), border_width=1, bgcolor=color.new(bear, rrHide ? 100 : 92), force_overlay=true)

                activeRR.rewardBox := observation > 0 ? box.new(time, math.max(entry, observation), rrRightTime, math.min(entry, observation), xloc=xloc.bar_time, border_color=color.new(bull, rrHide ? 100 : 45), border_width=1, bgcolor=color.new(bull, rrHide ? 100 : 92), force_overlay=true) : na

                activeRR.entryTag := f_rrPriceTag(rrRightTime, entry, str.tostring(entry, format.mintick), ink, tip, rrHide)
                activeRR.stopTag := f_rrPriceTag(rrRightTime, initialStop, "sl · " + str.tostring(initialStop, format.mintick), bear, tip, rrHide)

                activeRR.peakTag := observation > 0 ? f_rrPriceTag(rrRightTime, observation, (showMilestones ? "" : "3R 观察位 · " + str.tostring(observation, format.mintick)), bull, tip, rrHide) : na

                if showMilestones
                    rrTargetLines := activeRR.targetLines
                    rrTargetTags := array.new<label>(3, na)

                    for targetSlot = 0 to 2
                        float targetR = targetSlot + 1.0
                        float targetPrice = entry + rrNewSide * targetR * rrNewDistance

                        if targetPrice > 0
                            string targetTip = "预先显示的 " + str.tostring(targetR, "#") + "R 参考价，基于冻结初始风险；不是止盈指令。"

                            line targetLine = line.new(time, targetPrice, rrRightTime, targetPrice, xloc=xloc.bar_time, color=color.new(bull, rrHide ? 100 : 72), style=line.style_dashed, width=1, force_overlay=true)

                            label targetTag = label.new(rrRightTime, targetPrice, str.tostring(targetR, "#") + "R · " + str.tostring(targetPrice, format.mintick), xloc=xloc.bar_time, yloc=yloc.price, style=label.style_label_left, color=color.new(chart.bg_color, rrHide ? 100 : 12), textcolor=color.new(bull, rrHide ? 100 : 0), size=size.tiny, tooltip=targetTip, force_overlay=true)

                            array.set(rrTargetLines, targetSlot, targetLine)
                            array.set(rrTargetTags, targetSlot, targetTag)

// ───────────── IMACD 副图 ─────────────

float shownMd = barstate.isconfirmed ? md : md[1]
float shownSb = barstate.isconfirmed ? sb : sb[1]

hline(0, "零轴", color=color.new(ink, 38), linestyle=hline.style_solid, linewidth=1, display=v126Minimal ? display.none : display.all)

plot(v126Minimal ? na : shownMd, "IMACD 主线", blue, 2, display=display.pane + display.data_window)
plot(v126Minimal ? na : shownSb, "IMACD 信号线", #CB882A, 2, display=display.pane + display.data_window)

plot(v130LegacyVisible and not v126Minimal and not v10OnlyJoint and confirmedSignal ? md : na, "多头确认点", bull, 4, plot.style_circles, display=display.pane + display.data_window)
plot(v130LegacyVisible and not v126Minimal and not v10OnlyJoint and confirmedShortSignal ? md : na, "空头确认点", bear, 4, plot.style_circles, display=display.pane + display.data_window)

