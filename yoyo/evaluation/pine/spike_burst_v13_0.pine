    string v10RecentText = na(v10LastJointTime) ? "—" : str.format_time(v10LastJointTime, "MM-dd HH:mm", "Asia/Shanghai") + " · " + str.tostring(v10LastJointPrice, format.mintick) + " · " + v10LastJointOrder

