    string currentPairWhy = not v10Enabled ? "未启用" : not v112UseBox ? v10PairWhy : trendSide != 1 ? "无有效V9多头框；突破单独显示" : v112BoxUsed == entryBar ? "当前多头框已计第一次突破" : "多头框有效；等待首次突破"
    table.cell(panel, 0, 8, "当前配对原因", text_color=muted, text_size=size.tiny)
