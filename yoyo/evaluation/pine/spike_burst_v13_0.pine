//@version=6
// New private version: show completed H1 SMA60 on 15m by default; preserve V12.4 filters.
// Owner authorized the filter release; historical ranking is not validated profitability.
// V11：在V10.4基础上，本图SPIKE可以与上级周期的下降线突破配对（15分看1小时、1小时看4小时），
// 配成的仍叫「突破+spike」，标注（上级突破）；本图没有自己的SPIKE时，上级突破只是提示，不算信号。
// 突破后的趋势线继续向右延伸，并默认标出A/B/C与突破点。
// 上级周期突破只在上级K线收盘后的第一根本图K线才可见（lookahead_on + [1]），不回填、不重绘。
// V11.2：默认「多头框内」规则——本图V9多头框开着时出现突破（本周期或上级）就是突破+spike，每框一次、不限根数、不做当根检查；
// 可选：突破时提示加仓（止损沿用原框）；N根内没出突破则盈亏参考提前结束（未突破离场）。
// 这是指标，不下单；本地检查不等于TradingView编译或行情验证。
// V12: preserve the major-three-pivot family, add two major anchors plus a local touch.
// Local C is admitted only at its right-confirmation close, using already known A/B.
// V12 revision: persist a confirmed break while every chart close remains above
// its frozen line, then pair at the next eligible V9. HTF geometry uses HTF bars;
// held evidence deliberately uses CHART closes/lifetime because V9 is on this chart.
// Break labels and lines share bounded lifetime; exit R uses the ended frame.
// Both families share history validation, break confirmation and unchanged V9 box pairing.
// V12.2: retain historical regions; cap only lines sharing one frozen A-anchor region.
indicator("SPIKE V13.0 · 回踩再突破", shorttitle="SPIKE V13.0", overlay=false, max_labels_count=500, max_boxes_count=150, max_lines_count=400, max_polylines_count=100, max_bars_back=2000, explicit_plot_zorder=true, behind_chart=false)
// HTF anchor timestamps can outlive the search window: 1500 search + 1500 life.
max_bars_back(time, 3100)

// BEGIN V130 INPUTS
// Only the entry timing policy changes. Original signal/line calculations
// still define the anchors, independently of this display-mode selection.
string gV130 = "00 · V13.0 回踩入场"
string v130Mode = input.string("回踩确认", "信号模式", options=["回踩确认", "原版参考"], group=gV130, tooltip="回踩确认：原信号后，依次收盘突破、触位守住、再突破首段极值；下一根开盘建立模型参考。原版参考恢复V12.8图表行为。", display=display.none)
bool v130Retest = v130Mode == "回踩确认"
string v130Arm = input.string("普通多空", "回踩候选来源", options=["普通多空", "联合多头"], group=gV130, tooltip="两种来源独立比较，不混合占仓。联合多头以原版突破+spike出现的K线为锚点；普通多空以原SPIKE确认为锚点。", display=display.none)
const int V130_WAIT = 24
bool v130ShowBase = input.bool(false, "叠加原始候选标记", group=gV130, tooltip="只显示原始候选，候选本身不是回踩入场；历史趋势线始终保留。", display=display.none)
bool v130LegacyVisible = not v130Retest or v130ShowBase
bool v130ShowLevels = input.bool(true, "显示最早待确认价位与首段极值", group=gV130, display=display.none)
bool v130ShowRisk = input.bool(true, "显示回踩风险参考", group=gV130, tooltip="沿用原信号绝对止损，按确认后次开重算R。收盘2R启动4ATR追踪；反向信号后次开结束。3R框是观察位，不是止盈。", display=display.none)
// END V130 INPUTS

// ───────────── 原有参数与显示 ─────────────

