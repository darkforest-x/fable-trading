plot(showMas ? s20 : na, "SMA20", color.new(bull, 38), 1, force_overlay=true, display=display.pane + display.data_window)
plot(showMas ? e20 : na, "EMA20", color.new(bull, 58), 1, force_overlay=true, display=display.pane + display.data_window)

plot(showMas ? s60 : na, "SMA60", color.new(blue, 40), 1, force_overlay=true, display=display.pane + display.data_window)
plot(showMas ? e60 : na, "EMA60", color.new(blue, 60), 1, force_overlay=true, display=display.pane + display.data_window)

plot(showMas ? s120 : na, "SMA120", color.new(ink, 48), 1, force_overlay=true, display=display.pane + display.data_window)
plot(showMas ? e120 : na, "EMA120", color.new(ink, 66), 1, force_overlay=true, display=display.pane + display.data_window)

// ───────────── BB 图形 ─────────────

float bbUpperShown = showBb and (not bbOnlyCompressed or bbCompressed) and bbBandReady ? bbUpper : na
float bbLowerShown = showBb and (not bbOnlyCompressed or bbCompressed) and bbBandReady ? bbLower : na
float bbBasisShown = showBb and bbShowBasis and (not bbOnlyCompressed or bbCompressed) and bbBandReady ? bbBasis : na

pBbUpper = plot(bbUpperShown, "BB 上轨", bbChannelColor, 1, plot.style_linebr, force_overlay=true, display=display.pane)
pBbLower = plot(bbLowerShown, "BB 下轨", bbChannelColor, 1, plot.style_linebr, force_overlay=true, display=display.pane)

plot(bbBasisShown, "BB 中线", bbChannelColor, 1, plot.style_linebr, force_overlay=true, display=display.pane)

fill(pBbUpper, pBbLower, color=showBb and bbCompressed ? color.new(bbCompressionColor, 90) : na, title="BB 压缩区")

// ───────────── 风险参考与普通信号染色 ─────────────

bool protectionOverlapsInitial = not na(visibleProtection) and not na(visibleInitial) and visibleProtection == visibleInitial

color protectionColor = rrShow and protectionOverlapsInitial ? na : trailArmed ? bull : bear
color initialColor = rrShow ? na : color.new(bear, 55)

pProtect = plot(showRisk and not v10OnlyJoint ? visibleProtection : na, "本根有效保护", protectionColor, 1, plot.style_linebr, force_overlay=true, display=display.pane + display.data_window)

pInitial = plot(showRisk and not v10OnlyJoint ? visibleInitial : na, "冻结初始止损", initialColor, 1, plot.style_linebr, force_overlay=true, display=display.pane + display.data_window)

pEntry = plot(showRisk and not v10OnlyJoint ? visibleEntry : na, "确认收盘参考", color.new(ink, 60), 1, plot.style_linebr, force_overlay=true, display=display.pane + display.data_window)

fill(pInitial, pEntry, color.new(bear, 94), title="初始风险区")

// BEGIN V126 COLOR_STATE
// Uses only closed chart OHLC and already-confirmed frozen trendline anchors.
// A display episode never changes V9/BK signals, stop state, or alert conditions.
var V10Line v126LocalLine = na
var int v126LocalStart = na
var int v126LocalB = na
var float v126LocalBp = na
var int v126HtfStart = na
var int v126HtfA = na
var float v126HtfAp = na
var int v126HtfB = na
var float v126HtfBp = na
bool v126LocalPaint = false
bool v126HtfPaint = false
if barstate.isconfirmed
    if dataGap or not pricesValid
        v126LocalLine := na
        v126LocalStart := na
        v126HtfStart := na
    else
        if v10Enabled and v11UseChart and v10BreakEvent and not na(v11LastBroken)
            bool sameEpisode = not na(v126LocalStart) and v126LocalB == v11LastBroken.bx and v126LocalBp == v11LastBroken.bp and bar_index - v126LocalStart <= 8
            if not sameEpisode
                v126LocalLine := v11LastBroken.copy()
                v126LocalStart := bar_index
                v126LocalB := v11LastBroken.bx
                v126LocalBp := v11LastBroken.bp
        if v11HtfBreakKnown
            bool sameEpisode = not na(v126HtfStart) and v126HtfB == v11HtfBxT and v126HtfBp == v11HtfBp and bar_index - v126HtfStart <= 8
            if not sameEpisode
                v126HtfStart := bar_index
                v126HtfA := v11HtfAxT
                v126HtfAp := v11HtfAp
                v126HtfB := v11HtfBxT
                v126HtfBp := v11HtfBp
        if not na(v126LocalLine) and not na(v126LocalStart)
            float y = v126LocalLine.at(bar_index)
            if y <= 0 or close <= y
                v126LocalLine := na
            else
                v126LocalPaint := bar_index - v126LocalStart < v126BreakBars
        if not na(v126HtfA) and not na(v126HtfStart)
            float y = f_v11_timePrice(v126HtfA, v126HtfAp, v126HtfB, v126HtfBp, time)
            if y <= 0 or close <= y
                v126HtfA := na
            else
                v126HtfPaint := bar_index - v126HtfStart < v126BreakBars

// Geometry only: no pivots, future candles, volume or outcome information.
float v126Range = high - low
float v126Body = math.abs(close - open)
float v126Lower = math.min(open, close) - low
float v126Upper = high - math.max(open, close)
bool v126PinReady = barstate.isconfirmed and pricesValid and v126Range >= 4 * syminfo.mintick and v126Body <= 0.30 * v126Range
bool v126LowerPin = v126PinReady and v126Lower >= 0.60 * v126Range and v126Upper <= 0.20 * v126Range
bool v126UpperPin = v126PinReady and v126Upper >= 0.60 * v126Range and v126Lower <= 0.20 * v126Range
color v126PinTone = v126PaintPin ? (v126LowerPin ? v126LowerPinColor : v126UpperPin ? v126UpperPinColor : na) : na
color v126BreakTone = v126PaintBreak and (v126LocalPaint or v126HtfPaint) ? (v126CustomBreak ? v126BreakColor : v126LocalPaint ? v10LineColor : v11HtfColor) : na
color v126LegacyTone = v130LegacyVisible and not v126Minimal and not v10OnlyJoint and signalSide != 0 ? signalColor : na
color v126CandleTone = v126PinPriority and not na(v126PinTone) ? v126PinTone : not na(v126BreakTone) ? v126BreakTone : not na(v126PinTone) ? v126PinTone : v126LegacyTone

// END V126 COLOR_STATE
