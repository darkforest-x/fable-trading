//@version=6
// V10.4：默认配对6根；BB默认隐藏；突破+spike与对应趋势线成组保留。
// 这是指标，不下单；本地检查不等于TradingView编译或行情验证。
indicator("SPIKE V10.4 · 突破+spike", shorttitle="SPIKE V10.4", overlay=false, max_labels_count=500, max_boxes_count=150, max_lines_count=400, max_polylines_count=64, max_bars_back=2000, explicit_plot_zorder=true, behind_chart=false)

// ───────────── 原有参数与显示 ─────────────

const int maLen = 34
const int sigLen = 9
const int denseLen = 12
const float denseWidth = 3.0
const int denseCrosses = 2
const int breakoutLookback = 12
const int cooldownBars = 12
const int confirmMaxAge = 3
const float minAdvance = 1.5
const float minVolume = 1.5
const float minBody = 0.55
const float minEnd = 0.75
const int stopLen = 5
const float stopBuffer = 0.2
const float riskFloor = 2.0
const float armR = 2.0
const float trailAtr = 4.0
const float maxRopeDistanceAtr = 3.0
const float maxVolumeRatio = 50.0
const float roundTripCost = 0.002

string gView = "01 · 显示"

bool v10OnlyJoint = input.bool(false, "仅显示突破+spike 信号", group=gView, tooltip="只控制显示，不改变信号计算或预警。隐藏普通多空、单独突破、普通价格标签/染色及V9盈亏框；保留联合标记、对应趋势线、均线和IMACD。", display=display.none)

// 为联合标记预留对象配额：普通价格标签40个，退出标签20个。
const int SIGNAL_TAG_LIMIT = 40
const int EXIT_TAG_LIMIT = 20

bool showMas = input.bool(true, "六条均线", group=gView, display=display.none)
bool showLabels = input.bool(true, "确认信号与价格", group=gView, tooltip="只显示完成实体支撑、原确认关联与主线转强后的最终信号，标在实际完成K线上，不回填。", display=display.none)
bool showRisk = input.bool(true, "风险区与保护线", group=gView, tooltip="确认收盘开启风险参考；同向重复不重置。反向确认在收盘结束旧参考，新风险有效时开启反向参考；本根先触及原保护时以原保护结算。", display=display.none)
bool showPanel = input.bool(true, "显示状态面板", group=gView, display=display.none)
bool showMilestones = input.bool(true, "R 参考与里程碑", group=gView, tooltip="入场即预先显示 1R、2R、3R 参考价；达到后仍分别标记 3R、5R、10R。均不是固定止盈。", display=display.none)
bool showExitLabels = input.bool(false, "退出文字", group=gView, display=display.none)
color signalColor = input.color(color.white, "信号 K 线颜色（实体 / 影线）", group=gView, display=display.none)

color bull = #008F82
color bear = #D34B66
color gold = #AD7B29
color blue = #4679C9
color ink = chart.fg_color
color muted = color.new(ink, 40)

// ───────────── BB 通道与过滤 ─────────────

string gBb = "02 · BB 压缩通道"

bool useBbFilter = input.bool(true, "仅保留近期持续压缩后的信号", group=gBb, tooltip="信号前12根内须有连续3根带宽处于此前500根最低10%区域。不要求信号当根扩张；原V6反向确认仍可结束已有风险参考。关闭仅跳过BB条件，距离门和V9三条过滤仍独立生效。", display=display.none)

// 默认只隐藏BB图形，不关闭BB过滤。
bool showBb = input.bool(false, "显示 BB 压缩通道", group=gBb, display=display.none)
int bbLength = input.int(200, "SMA 长度", minval=2, group=gBb, display=display.none)
float bbMult = input.float(2.0, "标准差倍数", minval=0.1, step=0.1, group=gBb, display=display.none)
bool bbOnlyCompressed = input.bool(false, "仅显示压缩段", group=gBb, display=display.none)
bool bbShowBasis = input.bool(false, "显示中线", group=gBb, display=display.none)
color bbChannelColor = input.color(color.new(#7D8490, 48), "通道颜色", group=gBb, display=display.none)
color bbCompressionColor = input.color(#AD7B29, "压缩颜色", group=gBb, display=display.none)

string gV8 = "03 · V8 噪音过滤"

bool useOverheatFilter = input.bool(true, "过滤离六线超过 3ATR 的迟到信号", group=gV8, tooltip="只影响新入场确认：多头收盘离六线最高边、空头收盘离六线最低边超过3ATR时不显示、不报警。原始反向确认仍可结束已有参考。", display=display.none)

// ───────────── 原有工具函数 ─────────────

f_risk(int side, float entry, float extreme, float a, float floorAtr, float bufferAtr, float tick) =>
    bool known = (side == 1 or side == -1) and entry > 0 and a > 0 and tick > 0 and not na(extreme)
    float candidate = side == 1 ? math.min(extreme - bufferAtr * a, entry - floorAtr * a) : math.max(extreme + bufferAtr * a, entry + floorAtr * a)
    float stop = known ? (side == 1 ? math.floor(candidate / tick) * tick : math.ceil(candidate / tick) * tick) : na
    float risk = side * (entry - stop)
    bool valid = known and stop > 0 and risk > 0
    [valid ? stop : na, valid ? risk : na, valid]

f_path(int side, float entry, float risk, float priorProtection, float priorPeak, bool wasArmed, float o, float h, float l, float c, float a, float activationR, float distanceAtr, float tick) =>
    bool stopped = side == 1 ? l <= priorProtection : h >= priorProtection
    float exitPrice = stopped ? (side == 1 ? math.min(o, priorProtection) : math.max(o, priorProtection)) : na
    float currentR = side * ((stopped ? exitPrice : c) - entry) / risk
    float peakR = stopped ? priorPeak : math.max(priorPeak, side * ((side == 1 ? h : l) - entry) / risk)
    bool armed = wasArmed or (not stopped and currentR >= activationR)
    float protection = priorProtection

    if not stopped and armed and a > 0
        float raw = c - side * distanceAtr * a
        float candidate = side == 1 ? math.floor(raw / tick) * tick : math.ceil(raw / tick) * tick
        protection := side == 1 ? math.max(priorProtection, candidate) : math.min(priorProtection, candidate)

    [not stopped, protection, peakR, currentR, exitPrice, armed]

f_smma(float source, int length) =>
    float seed = ta.sma(source, length)
    var float value = na
    value := na(value[1]) ? seed : (value[1] * (length - 1) + source) / length
    value

f_flip(float a, float b) =>
    float d = a - b
    (d > 0 and d[1] <= 0) or (d < 0 and d[1] >= 0) ? 1.0 : 0.0

f_directionalCandle(int side, float o, float h, float l, float c, float bodyGate, float endGate) =>
    float span = h - l
    bool known = span > 0 and not na(o) and not na(h) and not na(l) and not na(c)
    float body = known ? math.abs(c - o) / span : na
    float endPosition = known ? (side == 1 ? (c - l) / span : (h - c) / span) : na
    bool direction = side == 1 ? c > o : side == -1 ? c < o : false
    known and direction and body >= bodyGate and endPosition >= endGate

// ───────────── 数据与 BB 背景 ─────────────

bool pricesValid = not na(open) and not na(high) and not na(low) and not na(close) and low > 0 and high >= math.max(open, close, low) and low <= math.min(open, close, high)
bool dataGap = not barstate.isfirst and (time != time_close[1] or not pricesValid or not pricesValid[1])
bool bbDataGap = not barstate.isfirst and (time != time_close[1] or not pricesValid or not pricesValid[1])

var int bbSegmentBars = 0
bbSegmentBars := not pricesValid ? 0 : bbDataGap ? 1 : bbSegmentBars + 1

float bbBasis = ta.sma(close, bbLength)
float bbStdev = ta.stdev(close, bbLength, true)
float bbUpper = bbBasis + bbMult * bbStdev
float bbLower = bbBasis - bbMult * bbStdev
float bbWidth = bbBasis != 0 ? (bbUpper - bbLower) / math.abs(bbBasis) : na

bool bbBandReady = pricesValid and bbSegmentBars >= bbLength and not na(bbBasis) and not na(bbStdev)
float bbPriorWidthP10 = ta.percentile_linear_interpolation(bbWidth[1], 500, 10)
bool bbReady = bbBandReady and bbSegmentBars >= bbLength + 500 and not na(bbPriorWidthP10)
bool bbCompressed = bbReady and bbWidth <= bbPriorWidthP10
bool bbAdmissionReady = bbReady and bbSegmentBars >= bbLength + 500 + 12

bool bbRecentCompression = false

for bbOffset = 1 to 10
    bbRecentCompression := bbRecentCompression or (bbCompressed[bbOffset] and bbCompressed[bbOffset + 1] and bbCompressed[bbOffset + 2])

bool bbEntryAllowed = not useBbFilter or (bbAdmissionReady and bbRecentCompression)

var int segmentIndex = -1
segmentIndex := dataGap or not pricesValid ? 0 : segmentIndex + 1

bool resetVolume = barstate.isfirst or dataGap

float tr = ta.tr(true)
float smHigh = f_smma(high, maLen)
float smLow = f_smma(low, maLen)
float ema1 = ta.ema(hlc3, maLen)
float middle = 2.0 * ema1 - ta.ema(ema1, maLen)
float md = middle > smHigh ? middle - smHigh : middle < smLow ? middle - smLow : 0.0
float sb = ta.sma(md, sigLen)
float atr = f_smma(tr, 14)

// ───────────── 六均线与量能 ─────────────

float s20 = ta.sma(close, 20)
float e20 = ta.ema(close, 20)
float s60 = ta.sma(close, 60)
float e60 = ta.ema(close, 60)
float s120 = ta.sma(close, 120)
float e120 = ta.ema(close, 120)

float ropeHigh = math.max(s20, e20, s60, e60, s120, e120)
float ropeLow = math.min(s20, e20, s60, e60, s120, e120)

float width = atr > 0 ? (ropeHigh - ropeLow) / atr : na
float flips = f_flip(s20,e20) + f_flip(s20,s60) + f_flip(s20,e60) + f_flip(s20,s120) + f_flip(s20,e120) + f_flip(e20,s60) + f_flip(e20,e60) + f_flip(e20,s120) + f_flip(e20,e120) + f_flip(s60,e60) + f_flip(s60,s120) + f_flip(s60,e120) + f_flip(e60,s120) + f_flip(e60,e120) + f_flip(s120,e120)
float pastWidth = ta.sma(width[1], denseLen)
float pastCrosses = math.sum(flips[1], denseLen)

bool baseReady = pricesValid and bar_index >= math.max(340, 10 * maLen) and atr[1] > 0 and not na(sb) and not na(pastWidth)
bool ready = baseReady and segmentIndex >= breakoutLookback

var array<float> validVolumes = array.new<float>()

if resetVolume
    array.clear(validVolumes)

if not na(volume) and volume >= 0
    array.push(validVolumes, volume)
    if array.size(validVolumes) > 20
        array.shift(validVolumes)

float volumeMedian = array.size(validVolumes) == 20 ? array.median(validVolumes) : na
float rv = volumeMedian[1] > 0 and not na(volume) ? volume / volumeMedian[1] : na
float expansion = atr[1] > 0 ? tr / atr[1] : na
float recentLow = ta.lowest(low, stopLen)

// ───────────── 原有密集与启动字段 ─────────────

bool dense = baseReady and segmentIndex >= denseLen and pastWidth <= denseWidth and pastCrosses >= denseCrosses
float denseHitsRaw = math.sum(dense[1] ? 1.0 : 0.0, breakoutLookback)
float denseHits = segmentIndex >= breakoutLookback ? denseHitsRaw : na
bool recentDense = denseHits > 0

float priorHigh = ta.highest(high[1], breakoutLookback)
float priorLow = ta.lowest(low[1], breakoutLookback)
float move3 = close - close[3]
float advance3 = atr[3] > 0 ? move3 / atr[3] : na

float volumeBase3 = volumeMedian[3]
float volumeSum3 = math.sum(volume, 3)
bool volumeKnown3 = not na(volume) and not na(volume[1]) and not na(volume[2])
float volumeRatio3 = volumeKnown3 and volumeBase3 > 0 ? volumeSum3 / (3.0 * volumeBase3) : na

float trSum3 = math.sum(tr, 3)
float efficiency3 = trSum3 > 0 ? move3 / trSum3 : na
float closePosition = high > low ? (close - low) / (high - low) : na

bool aboveSix = close > ropeHigh
bool earlyRaw = ready and close > priorHigh and close > math.max(s20, e20)
bool confirmQuality = ready and recentDense and advance3 >= minAdvance and volumeRatio3 >= minVolume and md >= sb and middle > middle[1]

float recentHigh = ta.highest(high, stopLen)
bool earlyShortRaw = ready and close < priorLow and close < math.min(s20, e20)
bool confirmShortQuality = ready and recentDense and advance3 <= -minAdvance and volumeRatio3 >= minVolume and md <= sb and middle < middle[1]

bool longCandleShape = f_directionalCandle(1, open, high, low, close, minBody, minEnd)
bool shortCandleShape = f_directionalCandle(-1, open, high, low, close, minBody, minEnd)

bool longEvidenceNow = longCandleShape and advance3 >= minAdvance and volumeRatio3 >= minVolume
bool shortEvidenceNow = shortCandleShape and advance3 <= -minAdvance and volumeRatio3 >= minVolume

bool longLaunchWindowShape = longCandleShape or longCandleShape[1] or longCandleShape[2]
bool shortLaunchWindowShape = shortCandleShape or shortCandleShape[1] or shortCandleShape[2]

int longLaunchWindowShapeBar = longCandleShape ? bar_index : longCandleShape[1] ? bar_index - 1 : longCandleShape[2] ? bar_index - 2 : na
int shortLaunchWindowShapeBar = shortCandleShape ? bar_index : shortCandleShape[1] ? bar_index - 1 : shortCandleShape[2] ? bar_index - 2 : na

bool longLegacySeedEvidence = longLaunchWindowShape and advance3 >= minAdvance and volumeRatio3 >= minVolume
bool shortLegacySeedEvidence = shortLaunchWindowShape and advance3 <= -minAdvance and volumeRatio3 >= minVolume

if barstate.isfirst and (not chart.is_standard or timeframe.isticks)
    runtime.error("请使用普通时间 K 线，合成K线不支持。")

// ───────────── 原始多头确认 ─────────────

var bool previousEarlyRaw = false
var int lastAcceptedBar = na
var int parentBar = na
var float parentHigh = na
var float parentLow = na
var float parentPrice = na
var bool parentConfirmed = false

bool legacyEarlySignal = false
bool legacyConfirmedSignal = false

int legacyConfirmationAge = na
float legacyConfirmationParentPrice = na
float legacyConfirmationParentHigh = na
float legacyConfirmationParentLow = na

if barstate.isconfirmed
    if dataGap
        lastAcceptedBar := na
        previousEarlyRaw := false
        parentBar := na
        parentHigh := na
        parentLow := na
        parentPrice := na
        parentConfirmed := false

    bool cooldownPassed = na(lastAcceptedBar) or bar_index - lastAcceptedBar >= cooldownBars
    legacyEarlySignal := earlyRaw and not previousEarlyRaw and cooldownPassed
    previousEarlyRaw := earlyRaw

    if legacyEarlySignal
        lastAcceptedBar := bar_index
        parentBar := bar_index
        parentHigh := priorHigh
        parentLow := priorLow
        parentPrice := close
        parentConfirmed := false

    int age = na(parentBar) ? na : bar_index - parentBar

    if not na(age) and age > confirmMaxAge
        parentBar := na
        parentHigh := na
        parentLow := na
        parentPrice := na
        parentConfirmed := false

    if not na(parentBar) and not parentConfirmed and age >= 0 and age <= confirmMaxAge and close > parentHigh and confirmQuality
        legacyConfirmedSignal := true
        legacyConfirmationAge := age
        legacyConfirmationParentPrice := parentPrice
        legacyConfirmationParentHigh := parentHigh
        legacyConfirmationParentLow := parentLow
        parentConfirmed := true

// ───────────── 原始空头确认 ─────────────

var bool previousEarlyShortRaw = false
var int lastShortAcceptedBar = na
var int shortParentBar = na
var float shortParentHigh = na
var float shortParentLow = na
var float shortParentPrice = na
var bool shortParentConfirmed = false

bool legacyShortEarlySignal = false
bool legacyShortConfirmedSignal = false

int legacyShortConfirmationAge = na
float legacyShortConfirmationParentPrice = na
float legacyShortConfirmationParentHigh = na
float legacyShortConfirmationParentLow = na

if barstate.isconfirmed
    if dataGap
        lastShortAcceptedBar := na
        previousEarlyShortRaw := false
        shortParentBar := na
        shortParentHigh := na
        shortParentLow := na
        shortParentPrice := na
        shortParentConfirmed := false

    bool shortCooldownPassed = na(lastShortAcceptedBar) or bar_index - lastShortAcceptedBar >= cooldownBars
    legacyShortEarlySignal := earlyShortRaw and not previousEarlyShortRaw and shortCooldownPassed
    previousEarlyShortRaw := earlyShortRaw

    if legacyShortEarlySignal
        lastShortAcceptedBar := bar_index
        shortParentBar := bar_index
        shortParentHigh := priorHigh
        shortParentLow := priorLow
        shortParentPrice := close
        shortParentConfirmed := false

    int shortAge = na(shortParentBar) ? na : bar_index - shortParentBar

    if not na(shortAge) and shortAge > confirmMaxAge
        shortParentBar := na
        shortParentHigh := na
        shortParentLow := na
        shortParentPrice := na
        shortParentConfirmed := false

    if not na(shortParentBar) and not shortParentConfirmed and shortAge >= 0 and shortAge <= confirmMaxAge and close < shortParentLow and confirmShortQuality
        legacyShortConfirmedSignal := true
        legacyShortConfirmationAge := shortAge
        legacyShortConfirmationParentPrice := shortParentPrice
        legacyShortConfirmationParentHigh := shortParentHigh
        legacyShortConfirmationParentLow := shortParentLow
        shortParentConfirmed := true

// ───────────── 多头结构确认 ─────────────

var int bodySupportBar = na
var int legacyBar = na
var float legacyParentHigh = na
var float legacyParentLow = na
var bool structurePending = false
var bool launchEvidence = false
var int launchEvidenceBar = na

bool confirmedSignal = false
bool consumedLaunchEvidence = false
int consumedLaunchEvidenceBar = na
int confirmationAge = na
string pendingWhy = "idle"

if barstate.isconfirmed
    bool finiteAtr = not na(atr) and atr > 0
    bool knownStructure = ready and pricesValid and finiteAtr and not na(md) and not na(sb) and not na(ropeHigh) and not na(middle)

    if dataGap or not knownStructure
        bodySupportBar := na
        legacyBar := na
        legacyParentHigh := na
        legacyParentLow := na
        structurePending := false
        launchEvidence := false
        launchEvidenceBar := na
        pendingWhy := dataGap ? "gap" : "unknown"
    else
        bool fullBodyAbove = math.min(open, close) > ropeHigh

        if close <= ropeHigh
            bodySupportBar := na
        else if fullBodyAbove
            bodySupportBar := bar_index

        if legacyConfirmedSignal and not na(legacyConfirmationParentHigh) and not na(legacyConfirmationParentLow) and legacyConfirmationParentLow <= legacyConfirmationParentHigh
            legacyBar := bar_index
            legacyParentHigh := legacyConfirmationParentHigh
            legacyParentLow := legacyConfirmationParentLow
            structurePending := true
            launchEvidence := longLegacySeedEvidence
            launchEvidenceBar := longLegacySeedEvidence ? longLaunchWindowShapeBar : na
        else if structurePending and longEvidenceNow
            launchEvidence := true
            launchEvidenceBar := bar_index

        if structurePending and (na(legacyParentHigh) or na(legacyParentLow) or close < legacyParentLow)
            legacyBar := na
            legacyParentHigh := na
            legacyParentLow := na
            structurePending := false
            launchEvidence := false
            launchEvidenceBar := na
            pendingWhy := "parent_broken"
        else if structurePending and launchEvidence and not na(bodySupportBar) and not na(legacyParentHigh) and not na(legacyParentLow) and not na(md[1]) and close > ropeHigh and close > legacyParentHigh and md > sb and md > md[1]
            confirmedSignal := true
            consumedLaunchEvidence := launchEvidence
            consumedLaunchEvidenceBar := launchEvidenceBar
            confirmationAge := bar_index - legacyBar
            structurePending := false
            launchEvidence := false
            launchEvidenceBar := na
            pendingWhy := "confirmed"
        else
            pendingWhy := not structurePending ? "await_legacy" : not launchEvidence ? "await_launch_evidence" : na(bodySupportBar) ? "await_body" : na(md[1]) ? "await_md_turn" : "await_momentum"

// ───────────── 空头结构确认 ─────────────

var int shortBodySupportBar = na
var int shortLegacyBar = na
var float shortLegacyParentHigh = na
var float shortLegacyParentLow = na
var bool shortStructurePending = false
var bool shortLaunchEvidence = false
var int shortLaunchEvidenceBar = na

bool confirmedShortSignal = false
bool consumedShortLaunchEvidence = false
int consumedShortLaunchEvidenceBar = na
int shortConfirmationAge = na
string shortPendingWhy = "idle"

if barstate.isconfirmed
    bool finiteShortAtr = not na(atr) and atr > 0
    bool knownShortStructure = ready and pricesValid and finiteShortAtr and not na(md) and not na(sb) and not na(ropeLow) and not na(middle)

    if dataGap or not knownShortStructure
        shortBodySupportBar := na
        shortLegacyBar := na
        shortLegacyParentHigh := na
        shortLegacyParentLow := na
        shortStructurePending := false
        shortLaunchEvidence := false
        shortLaunchEvidenceBar := na
        shortPendingWhy := dataGap ? "gap" : "unknown"
    else
        bool fullBodyBelow = math.max(open, close) < ropeLow

        if close >= ropeLow
            shortBodySupportBar := na
        else if fullBodyBelow
            shortBodySupportBar := bar_index

        if legacyShortConfirmedSignal and not na(legacyShortConfirmationParentHigh) and not na(legacyShortConfirmationParentLow) and legacyShortConfirmationParentLow <= legacyShortConfirmationParentHigh
            shortLegacyBar := bar_index
            shortLegacyParentHigh := legacyShortConfirmationParentHigh
            shortLegacyParentLow := legacyShortConfirmationParentLow
            shortStructurePending := true
            shortLaunchEvidence := shortLegacySeedEvidence
            shortLaunchEvidenceBar := shortLegacySeedEvidence ? shortLaunchWindowShapeBar : na
        else if shortStructurePending and shortEvidenceNow
            shortLaunchEvidence := true
            shortLaunchEvidenceBar := bar_index

        if shortStructurePending and close > shortLegacyParentHigh
            shortLegacyBar := na
            shortLegacyParentHigh := na
            shortLegacyParentLow := na
            shortStructurePending := false
            shortLaunchEvidence := false
            shortLaunchEvidenceBar := na
            shortPendingWhy := "parent_broken"
        else if shortStructurePending and shortLaunchEvidence and not na(shortBodySupportBar) and not na(shortLegacyParentHigh) and not na(shortLegacyParentLow) and not na(md[1]) and close < ropeLow and close < shortLegacyParentLow and md < sb and md < md[1]
            confirmedShortSignal := true
            consumedShortLaunchEvidence := shortLaunchEvidence
            consumedShortLaunchEvidenceBar := shortLaunchEvidenceBar
            shortConfirmationAge := bar_index - shortLegacyBar
            shortStructurePending := false
            shortLaunchEvidence := false
            shortLaunchEvidenceBar := na
            shortPendingWhy := "confirmed"
        else
            shortPendingWhy := not shortStructurePending ? "await_legacy" : not shortLaunchEvidence ? "await_launch_evidence" : na(shortBodySupportBar) ? "await_body" : na(md[1]) ? "await_md_turn" : "await_momentum"

// ───────────── V9 最终过滤 ─────────────

int rawSignalSide = confirmedSignal ? 1 : confirmedShortSignal ? -1 : 0

float ropeDistanceAtr = rawSignalSide == 1 and atr > 0 ? (close - ropeHigh) / atr : rawSignalSide == -1 and atr > 0 ? (ropeLow - close) / atr : na
bool v8EntryAllowed = not useOverheatFilter or (not na(ropeDistanceAtr) and ropeDistanceAtr <= maxRopeDistanceAtr)

string baseAsset = str.upper(syminfo.basecurrency)
bool baseAssetKnown = not na(baseAsset) and str.length(baseAsset) > 0
bool baseAllowed = baseAssetKnown and baseAsset != "USDC"

bool volumeRatioKnown = not na(rv) and rv >= 0
bool volumeAllowed = volumeRatioKnown and rv <= maxVolumeRatio

bool entryClockKnown = not na(time_close)
bool utcSunday = entryClockKnown and dayofweek(time_close, "UTC") == dayofweek.sunday
bool calendarAllowed = entryClockKnown and not utcSunday

bool v9BundleAllowed = baseAllowed and volumeAllowed and calendarAllowed
bool v9EntryAllowed = bbEntryAllowed and v8EntryAllowed and v9BundleAllowed

string v9Reasons = ""
v9Reasons += not baseAssetKnown ? "底层资产未知；" : not baseAllowed ? "底层USDC；" : ""
v9Reasons += not volumeRatioKnown ? "量比未知；" : not volumeAllowed ? "量比>50；" : ""
v9Reasons += not entryClockKnown ? "开仓时钟未知；" : utcSunday ? "UTC周日；" : ""
v9Reasons += not bbEntryAllowed ? "BB条件未通过；" : ""
v9Reasons += not v8EntryAllowed ? "距六线>3ATR或未知；" : ""
v9Reasons := v9Reasons == "" ? "通过" : v9Reasons

[signalReferenceStop, signalReferenceRisk, signalReferenceValid] = f_risk(rawSignalSide, close, rawSignalSide == 1 ? recentLow : recentHigh, atr, riskFloor, stopBuffer, syminfo.mintick)

float signalReferenceRiskFraction = signalReferenceValid ? signalReferenceRisk / close : na
float signalReferenceCostR = signalReferenceValid ? roundTripCost / signalReferenceRiskFraction : na

var string lastV9Reasons = "尚无原始确认"
var float lastV9Rv = na
var float lastV9RiskFraction = na
var float lastV9CostR = na

if barstate.isconfirmed and rawSignalSide != 0
    lastV9Reasons := v9Reasons
    lastV9Rv := rv
    lastV9RiskFraction := signalReferenceRiskFraction
    lastV9CostR := signalReferenceCostR

confirmedSignal := confirmedSignal and v9EntryAllowed
confirmedShortSignal := confirmedShortSignal and v9EntryAllowed

int signalSide = confirmedSignal ? 1 : confirmedShortSignal ? -1 : 0

// ───────────── 原有风险参考与退出 ─────────────

var int trendSide = 0
var int entryBar = na
var float entry = na
var float initialStop = na
var float risk = na
var float protection = na
var float peakR = 0.0
var float currentR = na
var bool trailArmed = false
var array<label> exitTags = array.new<label>()

bool referenceStarted = false
bool exitReference = false
bool referenceGap = false
bool referenceReverse = false

int exitSide = 0
float exitPeakR = na
float exitCurrentR = na
float exitProtection = na
float exitReferencePrice = na
string exitReason = ""

float visibleProtection = trendSide != 0 ? protection : na
float visibleInitial = trendSide != 0 ? initialStop : na
float visibleEntry = trendSide != 0 ? entry : na

if barstate.isconfirmed
    if dataGap and trendSide != 0
        referenceGap := true
        trendSide := 0
        currentR := na
        visibleProtection := na
        visibleInitial := na
        visibleEntry := na

    bool endedThisBar = false

    if ready and trendSide != 0 and bar_index > entryBar
        int activeSide = trendSide

        [alive, newProtection, newPeak, newCurrent, exitPrice, armed] = f_path(trendSide, entry, risk, protection, peakR, trailArmed, open, high, low, close, atr, armR, trailAtr, syminfo.mintick)

        protection := newProtection
        peakR := newPeak
        currentR := newCurrent
        trailArmed := armed

        if not alive
            exitReference := true
            exitSide := activeSide
            exitPeakR := peakR
            exitCurrentR := currentR
            exitProtection := protection
            exitReferencePrice := exitPrice
            exitReason := "保护触及"
            endedThisBar := true
            trendSide := 0

            if showExitLabels and not v10OnlyJoint
                string exitSideText = activeSide == 1 ? "多头" : "空头"

                if array.size(exitTags) >= EXIT_TAG_LIMIT
                    label.delete(array.shift(exitTags))

                array.push(exitTags, label.new(bar_index, exitPrice, exitSideText + "保护触及 · 参考结束\n" + str.tostring(exitPrice, format.mintick), style=activeSide == 1 ? label.style_label_down : label.style_label_up, color=color.new(chart.bg_color, 8), textcolor=ink, size=size.small, force_overlay=true))

    bool oppositeStopSignal = endedThisBar and exitSide != 0 and rawSignalSide != exitSide

    if rawSignalSide != 0 and (not endedThisBar or oppositeStopSignal) and rawSignalSide != trendSide
        [newStop, newRisk, validRisk] = f_risk(rawSignalSide, close, rawSignalSide == 1 ? recentLow : recentHigh, atr, riskFloor, stopBuffer, syminfo.mintick)

        if trendSide != 0
            referenceReverse := true
            exitReference := true
            exitSide := trendSide
            exitPeakR := peakR
            exitCurrentR := currentR
            exitProtection := protection
            exitReferencePrice := close
            exitReason := "反向确认"
            trendSide := 0

            if showExitLabels and not v10OnlyJoint
                string exitSideText = exitSide == 1 ? "多头" : "空头"

                if array.size(exitTags) >= EXIT_TAG_LIMIT
                    label.delete(array.shift(exitTags))

                array.push(exitTags, label.new(bar_index, close, exitSideText + "反向确认 · 参考结束\n" + str.tostring(close, format.mintick), style=exitSide == 1 ? label.style_label_down : label.style_label_up, color=color.new(chart.bg_color, 8), textcolor=ink, size=size.small, force_overlay=true))

        if signalSide != 0 and validRisk
            referenceStarted := true
            trendSide := signalSide
            entryBar := bar_index
            entry := close
            initialStop := newStop
            risk := newRisk
            protection := newStop
            peakR := 0.0
            currentR := 0.0
            trailArmed := false

// ───────────── 自动下降线参数 ─────────────

// 双轨找线、V9信号及参考退出沿用V10.3；本版只改默认配对间隔与显示。
string v10LineGroup = "04 · V10.4 自动下降线"

bool v10Enabled = input.bool(true, "启用自动线与联合提示", group=v10LineGroup, display=display.none)
int v10Lookback = input.int(600, "搜索范围（K 数）", minval=100, maxval=1500, group=v10LineGroup, display=display.none)
int v10Life = input.int(600, "三点确认后的最长存活（K 数）", minval=20, maxval=1500, group=v10LineGroup, tooltip="搜索范围限制选点历史；已确认线不再因A移出搜索范围立即失效。仍检查真实突破，最长存活从三点确认时计算。", display=display.none)

int v10Left = input.int(12, "高点左侧比较 K 数", minval=4, maxval=80, group=v10LineGroup, display=display.none)
int v10Right = input.int(8, "高点右侧确认 K 数", minval=2, maxval=40, group=v10LineGroup, display=display.none)
int v10MinGap = input.int(24, "独立反弹最小间隔", minval=5, maxval=200, group=v10LineGroup, display=display.none)
int v10MinSpan = input.int(72, "三点最小跨度", minval=20, maxval=600, group=v10LineGroup, display=display.none)

float v10Pullback = input.float(2.0, "反弹之间最小回落（ATR）", minval=0.5, maxval=10, step=0.25, group=v10LineGroup, display=display.none)
float v10Drop = input.float(1.0, "A 到 B 最小下降（ATR）", minval=0.1, step=0.1, group=v10LineGroup, display=display.none)
float v10Touch = input.float(0.35, "第三点贴线误差（ATR）", minval=0.05, maxval=1.5, step=0.05, group=v10LineGroup, display=display.none)

string v10PeakMode = input.string("双轨", "反弹高点取值", options=["双轨", "完整影线", "削尖影线", "实体上沿"], group=v10LineGroup, tooltip="双轨分别寻找完整影线与削尖影线的三点线，不混用价格口径；任一候选都必须通过实体/针刺检查。", display=display.none)

float v10WickCap = input.float(0.60, "削尖模式：保留上影长度（ATR）", minval=0, maxval=3, step=0.05, group=v10LineGroup, display=display.none)
float v10BodyTol = input.float(0.15, "建线前实体越线容差（ATR）", minval=0, maxval=0.5, step=0.05, group=v10LineGroup, display=display.none)
float v10WickTol = input.float(0.35, "普通上影越线容差（ATR）", minval=0, maxval=1.5, step=0.05, group=v10LineGroup, display=display.none)
int v10Needles = input.int(2, "最多允许几根孤立针刺", minval=0, maxval=5, group=v10LineGroup, display=display.none)
float v10NeedleMax = input.float(3.0, "单次针刺最大越线（ATR）", minval=0.5, maxval=6, step=0.25, group=v10LineGroup, tooltip="针刺不得连续；超过实体容差仍淘汰。不是越长的影线越能被忽略。", display=display.none)

string v10Scale = input.string("线性", "趋势线坐标", options=["线性", "对数"], group=v10LineGroup, tooltip="按图表价格坐标选择。程序不自动读取图表的对数开关；画线和突破计算采用相同公式。", display=display.none)

int v10BreakBars = input.int(2, "突破：连续收盘确认根数", minval=1, maxval=5, group=v10LineGroup, display=display.none)
float v10BreakBuffer = input.float(0.20, "突破缓冲（ATR）", minval=0, step=0.05, group=v10LineGroup, display=display.none)

// ───────────── 联合与显示参数 ─────────────

string v10JointGroup = "04B · 联合与显示"

int v10Window = input.int(6, "SPIKE 与突破最大间隔（0=同根）", minval=0, maxval=12, group=v10JointGroup, display=display.none)

bool v10ShowLine = input.bool(true, "显示当前候选主线（最多一条）", group=v10JointGroup, tooltip="只控制当前候选线，不会隐藏已经显示的突破+spike所对应的历史趋势线。", display=display.none)
bool v10ShowBreak = input.bool(true, "显示单独突破", group=v10JointGroup, display=display.none)
bool v10ShowJoint = input.bool(true, "显示突破+spike", group=v10JointGroup, tooltip="开启仅显示模式时，强制显示联合标记。联合标记和对应趋势线一起创建和清理。", display=display.none)
bool v10KeepStopped = input.bool(true, "失效后保留最近淡色线", group=v10JointGroup, display=display.none)

bool v10ShowABC = input.bool(false, "核对：A/B/C 与结构确认时间", group=v10JointGroup, display=display.none)
bool v10Debug = input.bool(false, "核对：最近8次 SPIKE 配对说明", group=v10JointGroup, tooltip="仅说明这次SPIKE与主线的关系，不把未来结果当作当时已知信息。", display=display.none)

color v10LineColor = input.color(color.white, "主线颜色", group=v10JointGroup, display=display.none)
color v10BreakColor = input.color(#4679C9, "突破颜色", group=v10JointGroup, display=display.none)
color v10JointColor = input.color(#AD7B29, "联合颜色", group=v10JointGroup, display=display.none)

int v10LineWidth = input.int(1, "主线宽度", minval=1, maxval=3, group=v10JointGroup, display=display.none)
int v10Ahead = input.int(24, "向右预留 K 数", minval=0, maxval=200, group=v10JointGroup, display=display.none)

int v10JointKeep = input.int(30, "保留联合信号与趋势线组数", minval=1, maxval=60, group=v10JointGroup, tooltip="每组包含一条冻结趋势线和一个标记。超出数量时整组删除，避免只剩信号没有线。", display=display.none)
int v10JointLineWidth = input.int(2, "联合趋势线线宽", minval=1, maxval=4, group=v10JointGroup, display=display.none)

string v10TagSize = input.string("小", "突破+spike 标签大小", options=["小", "正常", "大"], group=v10JointGroup, display=display.none)
bool v10TagPrice = input.bool(true, "标签显示联合确认价", group=v10JointGroup, display=display.none)
float v10TagGap = input.float(0.8, "标签距K线（ATR）", minval=0.1, maxval=4.0, step=0.1, group=v10JointGroup, display=display.none)

// ───────────── 双轨高点 ─────────────

const int V10_PIVOTS = 48
const int V10_PER_BUCKET = 4
const int V10_PER_TRACK_GROUP = 2
const float V10_SWITCH_MARGIN = 0.10

bool v10Log = v10Scale == "对数"
float v10Atr = ta.atr(14)
float v10Body = math.max(open, close)
float v10Peak = v10PeakMode == "实体上沿" ? v10Body : math.min(high, v10Body + v10WickCap * v10Atr)

// 两个序列逐根计算，分别在独立候选池中选点。
float v10RawPivot = ta.pivothigh(high, v10Left, v10Right)
float v10SoftPivot = ta.pivothigh(v10Peak, v10Left, v10Right)

bool v10UseRaw = v10PeakMode == "双轨" or v10PeakMode == "完整影线"
bool v10UseSoft = v10PeakMode != "完整影线"

int v10Gap = math.max(v10MinGap, v10Right + 1)
int v10Span = math.max(v10MinSpan, 2 * v10Gap)

if barstate.isfirst and v10Enabled and v10Lookback < v10Span + v10Right
    runtime.error("V10.4 搜索范围不足，请增大范围或减小反弹间隔。")

// ───────────── 结构对象 ─────────────

// 确认后不调整锚点和斜率，不按第四/第五次触碰加分。
type V10Line
    int uid = 0
    int ax = na
    float ap = na
    int bx = na
    float bp = na
    int cx = na
    float cp = na
    float wave = na
    float fit = na
    float score = na
    int born = na
    int phase = 1
    int above = 0
    int stopped = na
    int source = 0
    int confirmedTime = na
    int brokenBar = na
    bool usable = false
    bool joined = false
    int spikeBar = na
    float parentHigh = na
    float parentLow = na

f_v10_price(int barA, float priceA, int barB, float priceB, int targetBar) =>
    float fraction = float(targetBar - barA) / (barB - barA)
    v10Log ? math.exp(math.log(priceA) + (math.log(priceB) - math.log(priceA)) * fraction) : priceA + (priceB - priceA) * fraction

method at(V10Line self, int targetBar) =>
    f_v10_price(self.ax, self.ap, self.bx, self.bp, targetBar)

// 跨度只用于容量分组，不作为触点加分。
f_v10_bucket(int span) =>
    span < v10Span * 2 ? 0 : span < v10Span * 4 ? 1 : 2

f_v10_rank(array<V10Line> bag, V10Line item) =>
    int bucket = f_v10_bucket(item.cx - item.ax)
    int count = 0
    int worst = na
    float worstScore = -1.0

    if array.size(bag) > 0
        for i = 0 to array.size(bag) - 1
            V10Line oldItem = array.get(bag, i)

            if f_v10_bucket(oldItem.cx - oldItem.ax) == bucket
                count += 1

                if oldItem.score > worstScore
                    worst := i
                    worstScore := oldItem.score

    if count < V10_PER_BUCKET
        array.push(bag, item)
    else if not na(worst) and item.score < worstScore
        array.set(bag, worst, item)

    0

// 相同几何线换了触点组合，也不当作另一条线。
f_v10_same(V10Line first, V10Line second) =>
    bool same = first.ax == second.ax and first.bx == second.bx and math.abs(first.ap - second.ap) < syminfo.mintick * 0.5 and math.abs(first.bp - second.bp) < syminfo.mintick * 0.5

    int leftEdge = math.max(first.ax, second.ax)
    int rightEdge = math.min(first.cx, second.cx)

    if not same and rightEdge - leftEdge >= v10Gap
        float leftTol = math.max(syminfo.mintick, v10Touch * 0.5 * v10Atr[bar_index - leftEdge])
        float rightTol = math.max(syminfo.mintick, v10Touch * 0.5 * v10Atr[bar_index - rightEdge])
        float nowTol = math.max(syminfo.mintick, v10Touch * 0.5 * v10Atr)

        same := math.abs(first.at(leftEdge) - second.at(leftEdge)) <= leftTol and math.abs(first.at(rightEdge) - second.at(rightEdge)) <= rightTol and math.abs(first.at(bar_index) - second.at(bar_index)) <= nowTol

    same

// 返回：0通过，1实体穿线，2针刺异常，3此前已突破。
f_v10_validate(V10Line item) =>
    int reason = 0
    int spikes = 0
    int previousSpike = na
    int aboveRun = 0
    int age = bar_index - item.ax

    for step = 0 to age
        int offset = age - step
        float y = item.at(item.ax + step)
        float a = math.max(nz(v10Atr[offset], syminfo.mintick), syminfo.mintick)

        if v10Body[offset] > y + v10BodyTol * a + syminfo.mintick * 0.0001
            reason := 1
            break

        float pierce = (high[offset] - y) / a

        if pierce > v10WickTol
            spikes += 1

            if spikes > v10Needles or pierce > math.max(v10NeedleMax, v10WickTol) or (not na(previousSpike) and step - previousSpike == 1)
                reason := 2
                break

            previousSpike := step

        aboveRun := close[offset] > y + v10BreakBuffer * a ? aboveRun + 1 : 0

        if aboveRun >= v10BreakBars
            reason := 3
            break

    [reason, spikes]

// ───────────── 三点候选搜索 ─────────────

// 最新确认高点作为C；A来自多个历史反弹。
// 每个来源的三种跨度分别保留最多4条短名单。
f_v10_search(array<int> xs, array<float> ps, array<float> ats, int sourceId) =>
    array<V10Line> bag = array.new<V10Line>()
    int n = array.size(xs)

    if n >= 3
        int c = n - 1
        int cx = array.get(xs, c)
        float cp = array.get(ps, c)
        float ca = array.get(ats, c)

        int oldest = array.get(xs, 0)
        int total = cx - oldest

        array<float> lows = array.new_float(total + 1, na)
        float valley = na

        // lows[x-oldest] = x 到 C-1 的最低价。
        if total > 0
            for step = 1 to total
                int x = cx - step
                valley := na(valley) ? low[bar_index - x] : math.min(valley, low[bar_index - x])
                array.set(lows, x - oldest, valley)

        for a = 0 to n - 3
            int ax = array.get(xs, a)
            float ap = array.get(ps, a)
            float aa = array.get(ats, a)

            if cx - ax >= v10Span and ap > cp
                array<V10Line> localBag = array.new<V10Line>()

                for b = a + 1 to c - 1
                    int bx = array.get(xs, b)
                    float bp = array.get(ps, b)
                    float ba = array.get(ats, b)

                    if bx - ax >= v10Gap and cx - bx >= v10Gap and ap > bp and bp > cp and ap - bp >= v10Drop * math.max(aa, ba)
                        float atC = f_v10_price(ax, ap, bx, bp, cx)
                        float atNow = f_v10_price(ax, ap, bx, bp, bar_index)
                        float fit = math.abs(cp - atC) / ca

                        if fit <= v10Touch and atNow > 0 and close <= atNow
                            V10Line item = V10Line.new(ax=ax, ap=ap, bx=bx, bp=bp, cx=cx, cp=cp, fit=fit, born=bar_index, source=sourceId, confirmedTime=time_close)
                            array.push(localBag, item)

                if array.size(localBag) > 0
                    array<float> prefix = array.new_float(cx - ax + 1, na)
                    float localLow = na

                    for step = 1 to cx - ax - 1
                        float value = low[bar_index - ax - step]
                        localLow := na(localLow) ? value : math.min(localLow, value)
                        array.set(prefix, step, localLow)

                    for item in localBag
                        float ba = math.max(v10Atr[bar_index - item.bx], syminfo.mintick)
                        float ab = (math.min(item.ap, item.bp) - array.get(prefix, item.bx - ax - 1)) / math.max(aa, ba)
                        float bc = (math.min(item.bp, cp) - array.get(lows, item.bx + 1 - oldest)) / math.max(ba, ca)

                        if ab >= v10Pullback and bc >= v10Pullback
                            item.wave := math.min(ab, bc)
                            item.score := item.fit + 0.20 / (1.0 + item.wave)
                            f_v10_rank(bag, item)

    bag

// ───────────── 候选池管理 ─────────────

f_v10_addPivot(array<int> xs, array<float> ps, array<float> ats, int px, float price, float scale) =>
    array.push(xs, px)
    array.push(ps, price)
    array.push(ats, scale)
    0

f_v10_prunePivots(array<int> xs, array<float> ps, array<float> ats) =>
    while array.size(xs) > 0
        if bar_index - array.get(xs, 0) > v10Lookback or array.size(xs) > V10_PIVOTS
            array.shift(xs)
            array.shift(ps)
            array.shift(ats)
        else
            break

    0

// 返回：1入池，0重复，2实体拒绝，3针刺拒绝，4历史已突破，5容量拒绝。
// 各来源/跨度组最多2条，合计最多12条。
f_v10_store(array<V10Line> pool, V10Line item) =>
    int result = 0
    bool duplicate = false

    for known in pool
        if f_v10_same(known, item)
            duplicate := true
            break

    if not duplicate
        [reason, spikes] = f_v10_validate(item)

        if reason != 0
            result := reason + 1
        else
            item.score += 0.05 * spikes

            int groupCount = 0
            int worstIndex = na
            float worstScore = -1.0
            int bucket = f_v10_bucket(item.cx - item.ax)

            if array.size(pool) > 0
                for i = 0 to array.size(pool) - 1
                    V10Line known = array.get(pool, i)

                    if known.source == item.source and f_v10_bucket(known.cx - known.ax) == bucket
                        groupCount += 1

                        bool pendingPair = known.usable or not na(known.spikeBar)

                        if not pendingPair and known.score > worstScore
                            worstIndex := i
                            worstScore := known.score

            bool room = groupCount < V10_PER_TRACK_GROUP

            if not room and not na(worstIndex) and item.score < worstScore
                array.remove(pool, worstIndex)
                room := true

            if room
                array.push(pool, item)
                result := 1
            else
                result := 5

    result

// ───────────── 独立结构状态 ─────────────

var array<int> v10Xs = array.new_int()
var array<float> v10Ps = array.new_float()
var array<float> v10As = array.new_float()

var array<int> v10SoftXs = array.new_int()
var array<float> v10SoftPs = array.new_float()
var array<float> v10SoftAs = array.new_float()

var array<V10Line> v10Tracks = array.new<V10Line>()

// 当前主线只控制画面，不决定后台结构是否有资格发信号。
var V10Line v10Main = na
var int v10Promotion = na
var int v10Serial = 0
var int v10SegmentStart = 0
var int v10ClosedBar = na
var polyline v10Drawing = na

var array<label> v10Marks = array.new_label()
var array<label> v10DebugMarks = array.new_label()

var int v10ConsumedSpike = -1
var int v10LastEventBar = na
var int v10LastEventId = na

var float v10LastJointPrice = na
var int v10LastJointTime = na
var string v10LastJointOrder = "—"

var string v10SearchWhy = "等待已确认的独立反弹高点"
var string v10PairWhy = "尚无配对事件"
var string v10LastSpikeWhy = "尚无SPIKE多头确认"
var int v10LastSpikeTime = na
var int v10ActiveCount = 0
var int v10WaitingCount = 0

bool v10BornEvent = false
bool v10BreakEvent = false
bool v10JointEvent = false

// 当根联合信号对应的结构，用于冻结绘图。
V10Line v10JointLine = na

bool v10CanRun = pricesValid and not dataGap and not na(v10Atr) and v10Atr > 0
float v10LongDistance = atr > 0 and not na(ropeHigh) ? (close - ropeHigh) / atr : na

bool v10LongAlive = ready and pricesValid and atr > 0 and not na(ropeHigh) and close > ropeHigh and rawSignalSide != -1
bool v10Momentum = not na(md[1]) and not na(sb) and md > sb and md > md[1]
bool v10CurrentGate = bbEntryAllowed and v9BundleAllowed and (not useOverheatFilter or (not na(v10LongDistance) and v10LongDistance <= maxRopeDistanceAtr))

// ───────────── 结构监测与联合判断 ─────────────

if barstate.isconfirmed and v10Enabled
    v10ClosedBar := bar_index

    if not v10CanRun
        if not na(v10Main) and v10Main.phase == 1
            v10Main.phase := 3
            v10Main.stopped := bar_index - 1

        array.clear(v10Xs)
        array.clear(v10Ps)
        array.clear(v10As)

        array.clear(v10SoftXs)
        array.clear(v10SoftPs)
        array.clear(v10SoftAs)

        array.clear(v10Tracks)

        v10SegmentStart := bar_index
        v10ActiveCount := 0
        v10WaitingCount := 0
        v10SearchWhy := "数据预热或断档：重新建立结构"
        v10PairWhy := "数据未就绪"

    else
        // 先监测此前已经成立的结构，再处理本根新结构。
        V10Line breakWinner = na
        V10Line jointWinner = na
        int available = 0
        bool pairAttempt = false
        string failure = ""

        for item in v10Tracks
            float y = item.at(bar_index)

            if item.phase == 1
                if bar_index - item.born > v10Life or y <= 0
                    item.phase := 3
                    item.stopped := bar_index
                    item.spikeBar := na
                else if bar_index > item.born
                    item.above := close > y + v10Atr * v10BreakBuffer ? item.above + 1 : 0

                    if item.above >= v10BreakBars
                        item.phase := 2
                        item.stopped := bar_index
                        item.brokenBar := bar_index
                        item.usable := true

                        if na(breakWinner) or item.score < breakWinner.score
                            breakWinner := item

            // 逐结构保存和取消SPIKE证据。
            if not na(item.spikeBar)
                if item.spikeBar <= v10ConsumedSpike or bar_index - item.spikeBar > v10Window
                    item.spikeBar := na
                else if not v10LongAlive or na(item.parentLow) or close < item.parentLow or (exitReference and exitSide == 1)
                    item.spikeBar := na

            if item.usable
                if bar_index - item.brokenBar > v10Window or close <= y or rawSignalSide == -1
                    item.usable := false
                    item.spikeBar := na

            bool knownBefore = item.born < bar_index
            bool lineAvailable = knownBefore and not item.joined and (item.phase == 1 or item.usable)

            if lineAvailable
                available += 1

            if confirmedSignal and lineAvailable
                item.spikeBar := bar_index
                item.parentHigh := legacyParentHigh
                item.parentLow := legacyParentLow

            if item.usable and not item.joined and not na(item.spikeBar) and item.spikeBar > v10ConsumedSpike
                bool withinWindow = math.abs(item.spikeBar - item.brokenBar) <= v10Window
                bool secondNow = bar_index == math.max(item.spikeBar, item.brokenBar)
                bool bornBeforeBoth = item.born < math.min(item.spikeBar, item.brokenBar)
                bool parentRecovered = not na(item.parentHigh) and close > item.parentHigh

                if withinWindow and secondNow and bornBeforeBoth
                    pairAttempt := true

                    if v10LongAlive and v10Momentum and v10CurrentGate and parentRecovered
                        if na(jointWinner) or item.score < jointWinner.score
                            jointWinner := item
                    else
                        failure := not v10LongAlive ? "联合当根失去六线支撑" : not v10Momentum ? "联合当根动量未通过" : not parentRecovered ? "未站上原启动区间" : not bbEntryAllowed ? "联合当根BB过滤未通过" : not v9BundleAllowed ? "联合当根V9标的/量比/时段未通过" : "联合当根离六线过远"

        v10BreakEvent := not na(breakWinner)

        if v10BreakEvent
            v10PairWhy := "结构#" + str.tostring(breakWinner.uid) + "突破；等待SPIKE"

        if pairAttempt and na(jointWinner)
            v10PairWhy := failure

        // 同根多条结构联合时，只输出一个代表性信号。
        // 同一SPIKE事件不会被多条结构重复消费。
        if not na(jointWinner)
            v10JointEvent := true
            v10JointLine := jointWinner
            v10ConsumedSpike := jointWinner.spikeBar

            v10LastJointPrice := close
            v10LastJointTime := time_close
            v10LastJointOrder := (jointWinner.spikeBar == jointWinner.brokenBar ? "同根" : jointWinner.spikeBar < jointWinner.brokenBar ? "SPIKE→突破" : "突破→SPIKE") + " · 线#" + str.tostring(jointWinner.uid)

            jointWinner.joined := true
            jointWinner.usable := false

            for item in v10Tracks
                if not na(item.spikeBar) and item.spikeBar <= v10ConsumedSpike
                    item.spikeBar := na

            v10PairWhy := "联合成立；不重置原盈亏框"

        V10Line eventLine = not na(jointWinner) ? jointWinner : breakWinner

        if not na(eventLine)
            if na(v10Main) or v10Main.uid != eventLine.uid
                v10Promotion := bar_index

            v10Main := eventLine
            v10LastEventBar := bar_index
            v10LastEventId := eventLine.uid

        if confirmedSignal
            if not v10JointEvent and not pairAttempt
                v10PairWhy := available > 0 ? "SPIKE已确认，保存到提前成立的结构；等待突破" : "SPIKE存在：此前无有效结构，或结构已失效/配对超时"

            v10LastSpikeTime := time_close
            v10LastSpikeWhy := v10PairWhy

            if v10Debug and not v10OnlyJoint
                if array.size(v10DebugMarks) >= 8
                    label.delete(array.shift(v10DebugMarks))

                array.push(v10DebugMarks, label.new(bar_index, low - v10Atr * 2, v10PairWhy, style=label.style_label_up, color=color.new(chart.bg_color, 12), textcolor=chart.fg_color, size=size.tiny, force_overlay=true))

        // 本根确认的新拐点，分别加入两个价格来源。
        bool rawAdmitted = false
        bool softAdmitted = false
        int px = bar_index - v10Right
        bool sameSegment = px - v10Left >= v10SegmentStart

        if sameSegment and not na(v10Atr[v10Right])
            float pivotScale = math.max(v10Atr[v10Right], syminfo.mintick)

            if v10UseRaw and not na(v10RawPivot)
                f_v10_addPivot(v10Xs, v10Ps, v10As, px, v10RawPivot, pivotScale)
                rawAdmitted := true

            if v10UseSoft and not na(v10SoftPivot)
                f_v10_addPivot(v10SoftXs, v10SoftPs, v10SoftAs, px, v10SoftPivot, pivotScale)
                softAdmitted := true

        f_v10_prunePivots(v10Xs, v10Ps, v10As)
        f_v10_prunePivots(v10SoftXs, v10SoftPs, v10SoftAs)

        // 已失效结构独立清理，不清空全部高点。
        int dropIndex = array.size(v10Tracks) - 1

        while dropIndex >= 0
            V10Line item = array.get(v10Tracks, dropIndex)

            if item.phase != 1 and not item.usable
                array.remove(v10Tracks, dropIndex)

            dropIndex -= 1

        if rawAdmitted or softAdmitted
            int passed = 0
            int duplicates = 0
            int bodyReject = 0
            int wickReject = 0
            int breakReject = 0
            int capacityReject = 0
            int tested = 0

            for sourceId = 0 to 1
                bool admitted = sourceId == 0 ? rawAdmitted : softAdmitted

                if admitted
                    array<V10Line> shortList = sourceId == 0 ? f_v10_search(v10Xs, v10Ps, v10As, 0) : f_v10_search(v10SoftXs, v10SoftPs, v10SoftAs, 1)

                    for item in shortList
                        tested += 1
                        int code = f_v10_store(v10Tracks, item)

                        if code == 1
                            v10Serial += 1
                            item.uid := v10Serial
                            passed += 1
                            v10BornEvent := true
                        else if code == 0
                            duplicates += 1
                        else if code == 2
                            bodyReject += 1
                        else if code == 3
                            wickReject += 1
                        else if code == 4
                            breakReject += 1
                        else
                            capacityReject += 1

            v10SearchWhy := tested == 0 ? "本次未找到满足间隔/回落/三点贴合的候选" : "入池 " + str.tostring(passed) + "；重复 " + str.tostring(duplicates) + "；实体 " + str.tostring(bodyReject) + "；针刺 " + str.tostring(wickReject) + "；历史已破 " + str.tostring(breakReject) + "；容量 " + str.tostring(capacityReject)

        // 当前候选主线的选择只影响画面，不影响独立结构的突破和配对。
        V10Line best = na
        bool mainInPool = false

        v10ActiveCount := 0
        v10WaitingCount := 0

        for item in v10Tracks
            if item.phase == 1
                v10ActiveCount += 1

                if close <= item.at(bar_index) and (na(best) or item.score < best.score)
                    best := item

            if item.usable
                v10WaitingCount += 1

            if not na(v10Main) and item.uid == v10Main.uid
                mainInPool := true

        bool holdEvent = not na(v10LastEventBar) and bar_index - v10LastEventBar <= v10Window + 1

        if not holdEvent
            if not na(best)
                if na(v10Main) or v10Main.phase != 1 or not mainInPool
                    v10Main := best
                    v10Promotion := bar_index
                else if best.uid != v10Main.uid and bar_index - v10Promotion >= v10Right and best.score + V10_SWITCH_MARGIN < v10Main.score
                    v10Main := best
                    v10Promotion := bar_index
            else if not na(v10Main) and v10Main.phase == 1 and not mainInPool
                v10Main.phase := 3
                v10Main.stopped := bar_index

// ───────────── 当前候选主线绘制 ─────────────

// 此对象只负责当前候选，不负责历史联合线。
// 历史联合线在后面单独存档，不会被这里删除。
if v10Enabled and (barstate.islastconfirmedhistory or barstate.islast)
    if not na(v10Drawing)
        polyline.delete(v10Drawing)
        v10Drawing := na

    while array.size(v10Marks) > 0
        label.delete(array.pop(v10Marks))

    if v10ShowLine and not v10OnlyJoint and not na(v10Main) and not na(v10ClosedBar) and not (v10Main.joined and v10ShowJoint) and (v10Main.phase == 1 or v10KeepStopped)
        int endBar = v10Main.phase == 1 ? v10ClosedBar + v10Ahead : v10Main.stopped

        if not na(endBar) and endBar > v10Main.ax and v10ClosedBar - v10Main.ax < 9000
            array<chart.point> points = array.new<chart.point>()

            if v10Log
                for x = v10Main.ax to endBar
                    array.push(points, chart.point.from_index(x, v10Main.at(x)))
            else
                array.push(points, chart.point.from_index(v10Main.ax, v10Main.ap))
                array.push(points, chart.point.from_index(endBar, v10Main.at(endBar)))

            color tone = v10Main.phase == 1 ? v10LineColor : color.new(v10LineColor, 65)

            v10Drawing := polyline.new(points, curved=false, closed=false, xloc=xloc.bar_index, line_color=tone, line_width=v10LineWidth, force_overlay=true)

            if v10ShowABC
                string sourceText = v10Main.source == 0 ? "完整影线" : v10PeakMode == "实体上沿" ? "实体上沿" : "削尖影线"

                string tip = "结构#" + str.tostring(v10Main.uid) + " · " + sourceText + "\n三点实际确认：" + str.format_time(v10Main.confirmedTime, "MM-dd HH:mm", "Asia/Shanghai") + " 北京时间\n本次切换显示K：" + str.tostring(v10Promotion) + "。后台确认不等于当时已显示；信号不回填。"

                array.push(v10Marks, label.new(v10Main.ax, v10Main.ap, "A", style=label.style_label_down, color=color.new(tone, 100), textcolor=tone, tooltip=tip, force_overlay=true))
                array.push(v10Marks, label.new(v10Main.bx, v10Main.bp, "B", style=label.style_label_down, color=color.new(tone, 100), textcolor=tone, tooltip=tip, force_overlay=true))
                array.push(v10Marks, label.new(v10Main.cx, v10Main.cp, "C", style=label.style_label_down, color=color.new(tone, 100), textcolor=tone, tooltip=tip, force_overlay=true))
                array.push(v10Marks, label.new(v10Main.born, v10Main.at(v10Main.born), "三点确认", style=label.style_label_up, color=color.new(tone, 88), textcolor=tone, size=size.tiny, tooltip=tip, force_overlay=true))

// ───────────── 联合信号与趋势线成组保留 ─────────────

bool v10JointVisible = v10Enabled and (v10ShowJoint or v10OnlyJoint) and v10JointEvent

plotshape(not v10OnlyJoint and v10Enabled and v10ShowBreak and v10BreakEvent and not v10JointVisible, title="V10 下降线突破", style=shape.triangleup, location=location.belowbar, color=v10BreakColor, size=size.small, text="突破", textcolor=v10BreakColor, force_overlay=true, display=display.pane)

// 联合信号不再使用无限历史plotshape。
// 通过一组标签+趋势线共同保留，保证不会只剩标签却没有线。
type V10SignalDrawing
    polyline trend
    label tag

method erase(V10SignalDrawing self) =>
    polyline.delete(self.trend)
    label.delete(self.tag)

var array<V10SignalDrawing> v10SignalHistory = array.new<V10SignalDrawing>()

if v10JointVisible and not na(v10JointLine)
    // 先整组删除旧记录，再创建新记录，避免触发对象垃圾回收。
    while array.size(v10SignalHistory) >= v10JointKeep
        V10SignalDrawing oldestSignal = array.shift(v10SignalHistory)
        oldestSignal.erase()

    // 冻结原A/B斜率，延伸到联合确认当根。
    array<chart.point> eventPoints = array.new<chart.point>()

    if v10Log
        for x = v10JointLine.ax to bar_index
            array.push(eventPoints, chart.point.from_index(x, v10JointLine.at(x)))
    else
        array.push(eventPoints, chart.point.from_index(v10JointLine.ax, v10JointLine.ap))
        array.push(eventPoints, chart.point.from_index(bar_index, v10JointLine.at(bar_index)))

    // 不受“显示当前候选线”和“保留失效线”开关影响。
    polyline frozenTrend = polyline.new(eventPoints, curved=false, closed=false, xloc=xloc.bar_index, line_color=v10LineColor, line_width=v10JointLineWidth, force_overlay=true)

    string caption = "突破+spike" + (v10TagPrice ? "\n" + str.tostring(close, format.mintick) : "")
    string tagSize = v10TagSize == "小" ? size.small : v10TagSize == "大" ? size.large : size.normal
    string sourceText = v10JointLine.source == 0 ? "完整影线" : v10PeakMode == "实体上沿" ? "实体上沿" : "削尖影线"

    string tagTip = "突破+spike · 结构#" + str.tostring(v10JointLine.uid) + " · " + sourceText + "\n联合确认：" + str.format_time(time_close, "yyyy-MM-dd HH:mm", "Asia/Shanghai") + " 北京时间\n联合收盘价：" + str.tostring(close, format.mintick) + "\n结构提前确认：" + str.format_time(v10JointLine.confirmedTime, "MM-dd HH:mm", "Asia/Shanghai") + "\n" + v10LastJointOrder + "\n对应线固定保留。旧V9风险参考不重置；此价格不代表成交。"

    float tagY = math.max(syminfo.mintick, low - v10Atr * v10TagGap)

    label signalTag = label.new(
         bar_index,
         tagY,
         caption,
         xloc=xloc.bar_index,
         yloc=yloc.price,
         style=label.style_label_up,
         color=color.new(v10JointColor, 12),
         textcolor=color.white,
         size=tagSize,
         textalign=text.align_center,
         tooltip=tagTip,
         text_formatting=text.format_bold,
         force_overlay=true)

    array.push(v10SignalHistory, V10SignalDrawing.new(frozenTrend, signalTag))

// 事件码：1结构确认，2突破，4联合；同根可以相加。
plot(barstate.isconfirmed ? (v10BornEvent ? 1 : 0) + (v10BreakEvent ? 2 : 0) + (v10JointEvent ? 4 : 0) : na, "V10 事件码（1结构确认/2突破/4联合）", display=display.data_window)
plot(v10JointEvent ? close : na, "突破+spike 实际收盘价", display=display.data_window)

alertcondition(v10BreakEvent, "SPIKE V10 下降趋势线突破", "SPIKE V10.4 已确认下降结构突破 | {{exchange}}:{{ticker}} | {{interval}} | 收盘 {{close}}")

alertcondition(v10JointEvent, "SPIKE V10 突破+spike 联合确认", "SPIKE V10.4 突破+spike | {{exchange}}:{{ticker}} | {{interval}} | 联合收盘 {{close}} | 不代表成交")

// ───────────── 普通信号显示 ─────────────

// 只显示模式不会改写confirmedSignal和confirmedShortSignal。
plotshape(not v10OnlyJoint and confirmedSignal and not v10JointVisible, title="确认多头", style=shape.triangleup, location=location.belowbar, color=bull, size=size.tiny, force_overlay=true, display=display.pane)

plotshape(not v10OnlyJoint and confirmedShortSignal, title="确认空头", style=shape.triangledown, location=location.abovebar, color=bear, size=size.tiny, force_overlay=true, display=display.pane)

var array<label> signalTags = array.new<label>()

if barstate.isconfirmed and not v10OnlyJoint and signalSide != 0 and showLabels and not v10JointVisible
    string trackingTip = referenceStarted ? "本根开启盈亏参考。" : trendSide != 0 ? "已有盈亏参考继续跟踪，本根确认不会重置原框。" : "本根未开启盈亏参考。"
    string signalSideText = signalSide == 1 ? "多头" : "空头"

    string tip = signalSideText + "确认收盘：" + str.tostring(close, format.mintick) + "\n" + str.format_time(time_close, "yyyy-MM-dd HH:mm", "Asia/Shanghai") + " 北京时间\n" + trackingTip + "\n资产类型：" + syminfo.type + " · 底层：" + baseAsset + "\n收盘量比：" + str.tostring(rv, "#.##") + "\n确认价参考风险：" + str.tostring(signalReferenceRiskFraction * 100, "#.####") + "% · 成本：" + str.tostring(signalReferenceCostR, "#.####") + "R（往返0.2%）"

    if array.size(signalTags) >= SIGNAL_TAG_LIMIT
        label.delete(array.shift(signalTags))

    array.push(signalTags, label.new(bar_index, signalSide == 1 ? low - atr * 0.35 : high + atr * 0.35, str.tostring(close, format.mintick), style=signalSide == 1 ? label.style_label_up : label.style_label_down, color=color.new(signalSide == 1 ? bull : bear, 91), textcolor=signalSide == 1 ? bull : bear, size=size.small, tooltip=tip, force_overlay=true))

// ───────────── 原有盈亏框 ─────────────

string rrGroup = "05 · 趋势盈亏框"

bool rrShow = input.bool(true, "显示盈亏双框", group=rrGroup, tooltip="红框为冻结初始风险；绿框先显示3R观察位，随后随已确认峰值扩展。没有固定止盈。价格均为信号收盘参考，并非实际成交。", display=display.none)

int rrKeep = input.int(60, "保留盈亏框组数", minval=1, maxval=60, group=rrGroup, tooltip="保留最近 60 组以内的完整历史框、价格标签和 R 虚线。仅清理超出组数的最旧参考；信号箭头本身不受此限制。", display=display.none)

int rrAhead = input.int(12, "当前框向右展示根数", minval=2, maxval=60, group=rrGroup, tooltip="仅影响当前框的视觉宽度，不改变任何信号或持有规则；保护触及后固定在该根收盘。", display=display.none)

f_rrPriceTag(int stamp, float price, string caption, color tone, string tip) =>
    label.new(stamp, price, caption, xloc=xloc.bar_time, yloc=yloc.price, style=label.style_label_left, color=color.new(chart.bg_color, 12), textcolor=tone, size=size.small, tooltip=tip, force_overlay=true)

type RRDrawing
    box riskBox
    box rewardBox
    label entryTag
    label stopTag
    label peakTag
    array<line> targetLines
    array<line> milestoneLines
    array<label> milestoneTags
    int side
    int startedAt
    float entryPrice
    float stopPrice
    float distance
    float maximum

method deleteDrawings(RRDrawing group) =>
    box.delete(group.riskBox)
    box.delete(group.rewardBox)
    label.delete(group.entryTag)
    label.delete(group.stopTag)
    label.delete(group.peakTag)

    for slot = 0 to 2
        line.delete(array.get(group.targetLines, slot))
        line.delete(array.get(group.milestoneLines, slot))
        label.delete(array.get(group.milestoneTags, slot))

var array<RRDrawing> rrHistory = array.new<RRDrawing>()
var RRDrawing activeRR = na
var array<line> rrTargetLines = array.new<line>(3, na)
var array<label> rrTargetTags = array.new<label>(3, na)

// ───────────── 原有参考绘图更新 ─────────────

if barstate.isconfirmed
    int rrBarMillis = na(time_close) ? int(timeframe.in_seconds() * 1000) : time_close - time
    int rrCloseTime = na(time_close) ? time + rrBarMillis : time_close
    int rrRightTime = rrCloseTime + rrAhead * rrBarMillis

    if referenceGap and not na(activeRR)
        if not na(activeRR.riskBox)
            box.set_right(activeRR.riskBox, time_close[1])

            if not na(activeRR.rewardBox)
                box.set_right(activeRR.rewardBox, time_close[1])

            label.set_x(activeRR.entryTag, time_close[1])
            label.set_x(activeRR.stopTag, time_close[1])

            if not na(activeRR.peakTag)
                label.set_x(activeRR.peakTag, time_close[1])

        for targetSlot = 0 to 2
            label.delete(array.get(rrTargetTags, targetSlot))

        rrTargetLines := array.new<line>(3, na)
        rrTargetTags := array.new<label>(3, na)
        activeRR := na

    if not na(activeRR)
        bool ended = exitReference

        float groupPeakR = ended ? exitPeakR : peakR
        float groupCurrentR = ended ? exitCurrentR : currentR
        float groupProtection = ended ? exitProtection : protection

        int edge = ended ? rrCloseTime : rrRightTime
        activeRR.maximum := math.max(activeRR.maximum, nz(groupPeakR, 0.0))

        float extentR = math.max(3.0, activeRR.maximum)
        float extent = activeRR.entryPrice + activeRR.side * extentR * activeRR.distance
        string endingText = ended ? " · " + exitReason : ""

        string reference = "确认收盘参考，不是实际成交。已确认峰值 " + str.tostring(activeRR.maximum, "#.##") + "R；当前路径 " + str.tostring(groupCurrentR, "#.##") + "R。峰值未兑现；无固定止盈。" + endingText

        if not na(activeRR.riskBox)
            box.set_right(activeRR.riskBox, edge)
            label.set_x(activeRR.entryTag, edge)
            label.set_x(activeRR.stopTag, edge)
            label.set_text(activeRR.entryTag, str.tostring(activeRR.entryPrice, format.mintick))
            label.set_tooltip(activeRR.entryTag, reference)
            label.set_tooltip(activeRR.stopTag, reference + " 冻结初始风险；当前保护 " + str.tostring(groupProtection, format.mintick))

        if not na(activeRR.rewardBox) and extent > 0
            box.set_right(activeRR.rewardBox, edge)
            box.set_top(activeRR.rewardBox, math.max(activeRR.entryPrice, extent))
            box.set_bottom(activeRR.rewardBox, math.min(activeRR.entryPrice, extent))
            label.set_xy(activeRR.peakTag, edge, extent)

            label.set_text(activeRR.peakTag, showMilestones and activeRR.maximum < 3.0 ? "" : (activeRR.maximum >= 3.0 ? "峰值 " + str.tostring(activeRR.maximum, "#.##") + "R · " : "3R 观察位 · ") + str.tostring(extent, format.mintick))

            label.set_tooltip(activeRR.peakTag, reference)

        for targetSlot = 0 to 2
            line targetLine = array.get(rrTargetLines, targetSlot)
            label targetTag = array.get(rrTargetTags, targetSlot)

            if not na(targetLine)
                line.set_x2(targetLine, edge)

            if not na(targetTag)
                label.set_x(targetTag, edge)

        for slot = 0 to 2
            float level = slot == 0 ? 3.0 : slot == 1 ? 5.0 : 10.0
            float levelPrice = activeRR.entryPrice + activeRR.side * level * activeRR.distance

            if showMilestones and not v10OnlyJoint and activeRR.maximum >= level and levelPrice > 0 and na(array.get(activeRR.milestoneLines, slot))
                if slot == 0
                    line.delete(array.get(rrTargetLines, 2))
                    label.delete(array.get(rrTargetTags, 2))
                    array.set(rrTargetLines, 2, na)
                    array.set(rrTargetTags, 2, na)

                string hitTip = "收盘确认已触及 " + str.tostring(level, "#") + "R · " + str.format_time(time_close, "MM-dd HH:mm", "Asia/Shanghai") + " 北京时间。虚线为冻结入场风险计算的价位，不是止盈指令。"

                line guide = line.new(activeRR.startedAt, levelPrice, rrCloseTime, levelPrice, xloc=xloc.bar_time, color=color.new(bull, 35), style=line.style_dashed, width=1, force_overlay=true)

                label tag = label.new(time, levelPrice, str.tostring(level, "#") + "R 已达", xloc=xloc.bar_time, style=label.style_label_left, color=color.new(bull, 88), textcolor=bull, size=size.tiny, tooltip=hitTip, force_overlay=true)

                array.set(activeRR.milestoneLines, slot, guide)
                array.set(activeRR.milestoneTags, slot, tag)

            line guide = array.get(activeRR.milestoneLines, slot)

            if not na(guide)
                line.set_x2(guide, rrCloseTime)

        if ended
            for targetSlot = 0 to 2
                label.delete(array.get(rrTargetTags, targetSlot))

            rrTargetLines := array.new<line>(3, na)
            rrTargetTags := array.new<label>(3, na)
            activeRR := na

    if referenceStarted
        int rrNewSide = trendSide
        float rrNewDistance = rrNewSide * (entry - initialStop)

        bool rrValid = not na(entry) and not na(initialStop) and entry > 0 and initialStop > 0 and rrNewDistance > 0

        if rrValid
            while array.size(rrHistory) >= rrKeep
                RRDrawing oldest = array.shift(rrHistory)
                oldest.deleteDrawings()

            activeRR := RRDrawing.new(na, na, na, na, na, array.new<line>(3, na), array.new<line>(3, na), array.new<label>(3, na), rrNewSide, time, entry, initialStop, rrNewDistance, 0.0)

            array.push(rrHistory, activeRR)

            // 仅联合模式下隐藏旧V9参考图形，不修改参考状态和退出。
            if showRisk and rrShow and not v10OnlyJoint
                float observation = entry + rrNewSide * 3.0 * rrNewDistance
                string sideText = rrNewSide == 1 ? "多头" : "空头"

                string tip = sideText + "确认收盘参考，不是实际成交。初始风险冻结；3R仅为观察位，不触发止盈。绿色框为走势参考，峰值未兑现。"

                activeRR.riskBox := box.new(time, math.max(entry, initialStop), rrRightTime, math.min(entry, initialStop), xloc=xloc.bar_time, border_color=color.new(bear, 45), border_width=1, bgcolor=color.new(bear, 92), force_overlay=true)

                activeRR.rewardBox := observation > 0 ? box.new(time, math.max(entry, observation), rrRightTime, math.min(entry, observation), xloc=xloc.bar_time, border_color=color.new(bull, 45), border_width=1, bgcolor=color.new(bull, 92), force_overlay=true) : na

                activeRR.entryTag := f_rrPriceTag(rrRightTime, entry, str.tostring(entry, format.mintick), ink, tip)
                activeRR.stopTag := f_rrPriceTag(rrRightTime, initialStop, "sl · " + str.tostring(initialStop, format.mintick), bear, tip)

                activeRR.peakTag := observation > 0 ? f_rrPriceTag(rrRightTime, observation, (showMilestones ? "" : "3R 观察位 · " + str.tostring(observation, format.mintick)), bull, tip) : na

                if showMilestones
                    rrTargetLines := activeRR.targetLines
                    rrTargetTags := array.new<label>(3, na)

                    for targetSlot = 0 to 2
                        float targetR = targetSlot + 1.0
                        float targetPrice = entry + rrNewSide * targetR * rrNewDistance

                        if targetPrice > 0
                            string targetTip = "预先显示的 " + str.tostring(targetR, "#") + "R 参考价，基于冻结初始风险；不是止盈指令。"

                            line targetLine = line.new(time, targetPrice, rrRightTime, targetPrice, xloc=xloc.bar_time, color=color.new(bull, 72), style=line.style_dashed, width=1, force_overlay=true)

                            label targetTag = label.new(rrRightTime, targetPrice, str.tostring(targetR, "#") + "R · " + str.tostring(targetPrice, format.mintick), xloc=xloc.bar_time, yloc=yloc.price, style=label.style_label_left, color=color.new(chart.bg_color, 12), textcolor=bull, size=size.tiny, tooltip=targetTip, force_overlay=true)

                            array.set(rrTargetLines, targetSlot, targetLine)
                            array.set(rrTargetTags, targetSlot, targetTag)

// ───────────── IMACD 副图 ─────────────

float shownMd = barstate.isconfirmed ? md : md[1]
float shownSb = barstate.isconfirmed ? sb : sb[1]

hline(0, "零轴", color=color.new(ink, 38), linestyle=hline.style_solid, linewidth=1)

plot(shownMd, "IMACD 主线", blue, 2, display=display.pane + display.data_window)
plot(shownSb, "IMACD 信号线", #CB882A, 2, display=display.pane + display.data_window)

plot(not v10OnlyJoint and confirmedSignal ? md : na, "多头确认点", bull, 4, plot.style_circles, display=display.pane + display.data_window)
plot(not v10OnlyJoint and confirmedShortSignal ? md : na, "空头确认点", bear, 4, plot.style_circles, display=display.pane + display.data_window)

// ───────────── 主图六均线 ─────────────

plot(showMas ? s20 : na, "SMA20", color.new(bull, 38), 1, force_overlay=true, display=display.pane + display.data_window)
plot(showMas ? e20 : na, "EMA20", color.new(bull, 58), 1, force_overlay=true, display=display.pane + display.data_window)

plot(showMas ? s60 : na, "SMA60", color.new(blue, 40), 1, force_overlay=true, display=display.pane + display.data_window)
plot(showMas ? e60 : na, "EMA60", color.new(blue, 60), 1, force_overlay=true, display=display.pane + display.data_window)

plot(showMas ? s120 : na, "SMA120", color.new(ink, 48), 1, force_overlay=true, display=display.pane + display.data_window)
plot(showMas ? e120 : na, "EMA120", color.new(ink, 66), 1, force_overlay=true, display=display.pane + display.data_window)

// ───────────── BB 图形 ─────────────

float bbUpperShown = showBb and (not bbOnlyCompressed or bbCompressed) and bbBandReady ? bbUpper : na
float bbLowerShown = showBb and (not bbOnlyCompressed or bbCompressed) and bbBandReady ? bbLower : na
float bbBasisShown = showBb and bbShowBasis and (not bbOnlyCompressed or bbCompressed) and bbBandReady ? bbBasis : na

pBbUpper = plot(bbUpperShown, "BB 上轨", bbChannelColor, 1, plot.style_linebr, force_overlay=true, display=display.pane)
pBbLower = plot(bbLowerShown, "BB 下轨", bbChannelColor, 1, plot.style_linebr, force_overlay=true, display=display.pane)

plot(bbBasisShown, "BB 中线", bbChannelColor, 1, plot.style_linebr, force_overlay=true, display=display.pane)

fill(pBbUpper, pBbLower, color=showBb and bbCompressed ? color.new(bbCompressionColor, 90) : na, title="BB 压缩区")

// ───────────── 风险参考与普通信号染色 ─────────────

bool protectionOverlapsInitial = not na(visibleProtection) and not na(visibleInitial) and visibleProtection == visibleInitial

color protectionColor = rrShow and protectionOverlapsInitial ? na : trailArmed ? bull : bear
color initialColor = rrShow ? na : color.new(bear, 55)

pProtect = plot(showRisk and not v10OnlyJoint ? visibleProtection : na, "本根有效保护", protectionColor, 1, plot.style_linebr, force_overlay=true, display=display.pane + display.data_window)

pInitial = plot(showRisk and not v10OnlyJoint ? visibleInitial : na, "冻结初始止损", initialColor, 1, plot.style_linebr, force_overlay=true, display=display.pane + display.data_window)

pEntry = plot(showRisk and not v10OnlyJoint ? visibleEntry : na, "确认收盘参考", color.new(ink, 60), 1, plot.style_linebr, force_overlay=true, display=display.pane + display.data_window)

fill(pInitial, pEntry, color.new(bear, 94), title="初始风险区")

barcolor(not v10OnlyJoint and signalSide != 0 ? signalColor : na, title="确认关键K线")

plotcandle(not v10OnlyJoint and signalSide != 0 ? open : na, high, low, close, title="确认K线实体与影线", color=signalColor, wickcolor=signalColor, bordercolor=signalColor, editable=false, force_overlay=true, display=display.pane)

// ───────────── 数据窗口 ─────────────

float pendingWhyCode = pendingWhy == "await_legacy" ? 1 : pendingWhy == "await_body" ? 2 : pendingWhy == "await_md_turn" ? 3 : pendingWhy == "await_momentum" ? 4 : pendingWhy == "confirmed" ? 5 : pendingWhy == "parent_broken" ? 6 : pendingWhy == "gap" ? 7 : pendingWhy == "unknown" ? 8 : pendingWhy == "await_launch_evidence" ? 9 : 0

float shortPendingWhyCode = shortPendingWhy == "await_legacy" ? 1 : shortPendingWhy == "await_body" ? 2 : shortPendingWhy == "await_md_turn" ? 3 : shortPendingWhy == "await_momentum" ? 4 : shortPendingWhy == "confirmed" ? 5 : shortPendingWhy == "parent_broken" ? 6 : shortPendingWhy == "gap" ? 7 : shortPendingWhy == "unknown" ? 8 : shortPendingWhy == "await_launch_evidence" ? 9 : 0

plot(barstate.isconfirmed ? rv : na, "收盘量比 RV", display=display.data_window)
plot(barstate.isconfirmed ? denseHits : na, "前12根密集命中", display=display.data_window)
plot(barstate.isconfirmed ? advance3 : na, "三根净进展 ATR", display=display.data_window)
plot(barstate.isconfirmed ? volumeRatio3 : na, "三根量比", display=display.data_window)
plot(barstate.isconfirmed ? ropeDistanceAtr : na, "V9 离六线距离 ATR", display=display.data_window)
plot(barstate.isconfirmed ? (v9EntryAllowed ? 1 : 0) : na, "V9 全部入场过滤通过", display=display.data_window)
plot(barstate.isconfirmed and signalSide != 0 ? close : na, "确认实际收盘价", display=display.data_window)
plot(barstate.isconfirmed ? (referenceStarted ? 1 : 0) : na, "确认参考起点", display=display.data_window)

float referenceExitCode = exitReference ? (referenceReverse ? 2.0 : 1.0) : 0.0

plot(barstate.isconfirmed ? referenceExitCode : na, "V6 参考结束事件（1保护 / 2反向）", display=display.data_window)
plot(barstate.isconfirmed and exitReference ? exitReferencePrice : na, "V6 参考结束价格", display=display.data_window)

// ───────────── 状态面板 ─────────────

var table panel = table.new(position.top_right, 2, 11, bgcolor=color.new(chart.bg_color, 8), border_width=0)

if barstate.islast and showPanel
    string stateText = (v10OnlyJoint ? "仅联合显示 · " : "") + (trendSide == 1 ? "V9多头参考" : trendSide == -1 ? "V9空头参考" : "当前无跟踪参考")

    table.cell(panel, 0, 0, "SPIKE V10.4", text_color=ink, text_size=size.small)
    table.cell(panel, 1, 0, stateText, text_color=trendSide == 1 ? bull : trendSide == -1 ? bear : muted, text_size=size.small)

    table.cell(panel, 0, 1, "参考 / 峰值", text_color=muted, text_size=size.tiny)
    table.cell(panel, 1, 1, na(currentR) ? "—" : str.tostring(currentR, "#.##") + "R / " + str.tostring(peakR, "#.##") + "R", text_color=ink, text_size=size.tiny)

    table.cell(panel, 0, 2, "资产类型 / 底层", text_color=muted, text_size=size.tiny)
    table.cell(panel, 1, 2, syminfo.type + " / " + (baseAssetKnown ? baseAsset : "未知"), text_color=ink, text_size=size.tiny)

    table.cell(panel, 0, 3, "最近原始确认", text_color=muted, text_size=size.tiny)
    table.cell(panel, 1, 3, lastV9Reasons, text_color=lastV9Reasons == "通过" ? bull : gold, text_size=size.tiny)

    table.cell(panel, 0, 4, "确认量比", text_color=muted, text_size=size.tiny)
    table.cell(panel, 1, 4, na(lastV9Rv) ? "未知" : str.tostring(lastV9Rv, "#.##"), text_color=ink, text_size=size.tiny)

    table.cell(panel, 0, 5, "确认价参考风险", text_color=muted, text_size=size.tiny)
    table.cell(panel, 1, 5, na(lastV9RiskFraction) ? "—" : str.tostring(lastV9RiskFraction * 100, "#.####") + "%", text_color=ink, text_size=size.tiny)

    table.cell(panel, 0, 6, "往返0.2%参考成本", text_color=muted, text_size=size.tiny)
    table.cell(panel, 1, 6, na(lastV9CostR) ? "—" : str.tostring(lastV9CostR, "#.####") + "R", text_color=ink, text_size=size.tiny)

    string v10StateText = not v10Enabled ? "未启用" : "有效结构 " + str.tostring(v10ActiveCount) + "；已破待配对 " + str.tostring(v10WaitingCount)

    string v10RecentText = na(v10LastJointTime) ? "—" : str.format_time(v10LastJointTime, "MM-dd HH:mm", "Asia/Shanghai") + " · " + str.tostring(v10LastJointPrice, format.mintick) + " · " + v10LastJointOrder

    string v10SpikeText = na(v10LastSpikeTime) ? "—" : str.format_time(v10LastSpikeTime, "MM-dd HH:mm", "Asia/Shanghai") + " · " + v10LastSpikeWhy

    table.cell(panel, 0, 7, "V10.4 结构 / 候选", text_color=muted, text_size=size.tiny)
    table.cell(panel, 1, 7, v10StateText + " / " + str.tostring(array.size(v10Tracks)), text_color=v10JointColor, text_size=size.tiny, tooltip=v10SearchWhy)

    table.cell(panel, 0, 8, "当前配对原因", text_color=muted, text_size=size.tiny)
    table.cell(panel, 1, 8, v10PairWhy, text_color=ink, text_size=size.tiny, tooltip=v10SearchWhy)

    table.cell(panel, 0, 9, "最近SPIKE · 北京", text_color=muted, text_size=size.tiny)
    table.cell(panel, 1, 9, v10SpikeText, text_color=ink, text_size=size.tiny)

    table.cell(panel, 0, 10, "最近联合 · 北京", text_color=muted, text_size=size.tiny)
    table.cell(panel, 1, 10, v10RecentText, text_color=ink, text_size=size.tiny)

// ───────────── 原有结构与参考预警 ─────────────

// “仅显示”不改变这些预警条件。
// 只接收联合通知时，创建预警应选择“突破+spike 联合确认”。
alertcondition(signalSide != 0, "SPIKE V10 结构确认", "SPIKE V10 结构确认 | {{exchange}}:{{ticker}} | {{interval}} | 实际确认收盘 {{close}}")

alertcondition(confirmedSignal, "SPIKE V10 多头结构确认", "SPIKE V10 多头结构确认 | {{exchange}}:{{ticker}} | {{interval}} | 实际确认收盘 {{close}}")

alertcondition(confirmedShortSignal, "SPIKE V10 空头结构确认", "SPIKE V10 空头结构确认 | {{exchange}}:{{ticker}} | {{interval}} | 实际确认收盘 {{close}}")

alertcondition(exitReference and not referenceReverse, "SPIKE 参考保护触及", "SPIKE 参考保护已触及 | {{exchange}}:{{ticker}} | {{interval}} | 已收盘确认，请查看参考价")

alertcondition(referenceReverse, "SPIKE 参考反向结束", "SPIKE 参考反向结束 | {{exchange}}:{{ticker}} | {{interval}} | 反向确认收盘 {{close}}")
