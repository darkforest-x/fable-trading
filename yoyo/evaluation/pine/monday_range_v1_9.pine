//@version=6
// Monday high/low range display, v1.9 (ICT weekly-profile helper).
//
// v1.4 is built on v1 (not v1.1-v1.3, owner 2026-10-14) and adds Fibonacci
// levels on the latest week's Monday range, drawn from both ends.
// v1.5: Fib labels one size larger and darker, matching the owner's manual
// Fib tool (screenshot 2026-10-14); line and text colours split.
// v1.6: weekend candles are painted a lighter opaque grey instead of the v1
// "hidden" colour, which TradingView rendered as native red/green.
// v1.7: every completed week's Monday range also gets a fainter Fib
// (0.5 / 0.618 / 0.705, both ends) drawn only from that Monday's first bar to
// its last weekday bar, so it never runs into the weekend.
// v1.8: history Fib lines carry "ratio (price)" labels at their Friday end.
// v1.9: independent H/L and Fib retention, timestamp drawings, budgeted
// objects and optional 4-timeframe six-MA mini charts (closed samples only).
//
// Display only: no signals, alerts or orders. "Monday" and "weekend" are
// evaluated in the selected timezone (default America/New_York; a local setting, not a verified
// claim about any author). Daily bars use the exchange timezone instead, because a daily
// bar's open time is a trading-day stamp, not a New York wall-clock instant.
//
// Weekend candles get their own lighter grey. It must stay opaque: a 100%-
// transparent barcolor() falls back to the native red/green candles (see
// docs/learnings/pine-transparent-barcolor-falls-back-to-native-candles.md).
//
// Native candles are recoloured with barcolor(); a same-colour plotcandle is
// also drawn in front (behind_chart=false) so native red/green bodies, wicks
// or borders cannot leak through on weekdays (see
// docs/learnings/pine-candle-style-parity-requires-foreground-z-order.md).
//
// Rays start at the bar that set the Monday high/low and update live while
// Monday is in progress. The current week's rays extend right; older weeks are
// cut at the last bar before the next Monday unless "extend history" is on.
//
// Fibonacci: only the latest Monday range. Every ratio r is drawn from both
// ends, low + r * range and high - r * range (0.5 coincides, drawn once), so
// 1.13 / 1.27 / 1.618 project above the high and below the low. Lines start at
// that Monday's first bar and extend right only, never left (owner
// 2026-10-14). They are rebuilt on the last bar, so they follow the live
// Monday range.

indicator("周一高低点区间 · v1.9", shorttitle="Monday Range v1.9", overlay=true,
     behind_chart=false, max_lines_count=500, max_labels_count=500, max_bars_back=300)

string timeGroup = "时间"
string tzOpt = input.string("America/New_York", "时区（判断周一 / 周末）",
     options=["America/New_York", "UTC", "Asia/Shanghai", "交易所时区"], group=timeGroup)

string candleGroup = "K线"
color baseCol = input.color(color.gray, "普通K线", group=candleGroup)
color mondayCol = input.color(color.green, "周一K线", group=candleGroup)
color weekendCol = input.color(#B2B5BE, "周六、周日K线", group=candleGroup)

string rayGroup = "周一高低点射线"
color highCol = input.color(#F23645, "高点射线", group=rayGroup)
color lowCol = input.color(#2962FF, "低点射线", group=rayGroup)
int rayWidth = input.int(1, "线宽", minval=1, maxval=4, group=rayGroup)
string rayStyleOpt = input.string("实线", "线型", options=["实线", "虚线", "点线"], group=rayGroup)
// Per kept week: 2 rays + up to 5 history Fib lines; plus 11 latest-Fib lines,
// all inside max_lines_count=500 (labels follow the same count).
int keepWeeks = input.int(104, "高低点保留周数", minval=1, maxval=240, group=rayGroup)
bool extendHistory = input.bool(false, "历史周的射线也无限向右延伸", group=rayGroup)
bool showLabels = input.bool(true, "显示价格标签", group=rayGroup)

string fibGroup = "斐波那契（最新一周的周一区间）"
bool showFib = input.bool(true, "显示斐波那契", group=fibGroup)
string fibLevelsStr = input.string("0.5, 0.618, 0.705, 1.13, 1.27, 1.618",
     "比例（逗号分隔，上下两个方向都画）", group=fibGroup)
color fibCol = input.color(#787B86A6, "线颜色", group=fibGroup)
color fibTextCol = input.color(#787B86, "文字颜色", group=fibGroup)
string fibSizeOpt = input.string("中", "文字大小", options=["小", "中", "大"], group=fibGroup)

string histFibGroup = "斐波那契（历史周，只画周一到周五）"
int keepFibWeeks = input.int(12, "历史 Fib 保留周数（预算不足自动缩减）", minval=0, maxval=80, group=histFibGroup)
bool showHistFib = input.bool(true, "显示历史周斐波那契", group=histFibGroup)
string histFibLevelsStr = input.string("0.5, 0.618, 0.705",
     "比例（逗号分隔，上下两个方向都画）", group=histFibGroup)
color histFibCol = input.color(#787B8659, "线颜色", group=histFibGroup)
color histFibTextCol = input.color(#787B86A6, "文字颜色", group=histFibGroup)

if barstate.isfirst and (timeframe.isweekly or timeframe.ismonthly)
    runtime.error("请在日线或更低周期使用：周线 / 月线没有单独的“周一”K线。")

string tz = timeframe.isdaily or tzOpt == "交易所时区" ? syminfo.timezone : tzOpt
string rayStyle = rayStyleOpt == "虚线" ? line.style_dashed : rayStyleOpt == "点线" ? line.style_dotted : line.style_solid

int dow = dayofweek(time, tz)
bool isMonday = dow == dayofweek.monday
bool isWeekend = dow == dayofweek.saturday or dow == dayofweek.sunday
int dateKey = year(time, tz) * 10000 + month(time, tz) * 100 + dayofmonth(time, tz)
// The date key also catches back-to-back Mondays when a whole week is missing.
bool newMonday = isMonday and (not isMonday[1] or dateKey != dateKey[1])

// ---- Candles -------------------------------------------------------------
color hiddenCol = color.new(color.white, 100)
color candleCol = isWeekend ? weekendCol : isMonday ? mondayCol : baseCol
barcolor(candleCol, title="K线着色")
plotcandle(open, high, low, close, "K线", color=candleCol, wickcolor=candleCol,
     bordercolor=candleCol, display=display.pane)

// ---- Monday rays ---------------------------------------------------------
var array<line> highLines = array.new<line>()
var array<line> lowLines = array.new<line>()
var array<label> highLabels = array.new<label>()
var array<label> lowLabels = array.new<label>()
var float monHigh = na
var float monLow = na
var int monStartTime = na
var int lastWeekdayTime = na
var array<line> histFibLines = array.new<line>()
var array<label> histFibLabels = array.new<label>()
var array<int> histFibWeekSizes = array.new<int>()
string fibSize = fibSizeOpt == "小" ? size.small : fibSizeOpt == "大" ? size.large : size.normal

labelText(string name, float price) =>
    name + " " + str.tostring(price, format.mintick)

newRayLabel(float price, string name, color col) =>
    label.new(time, price, labelText(name, price), style=label.style_label_left,
         color=hiddenCol, textcolor=col, size=size.small, xloc=xloc.bar_time)

// Both-end Fib prices of a range, with the ratio behind each price; a ratio
// whose two prices coincide (0.5) is kept once.
fibPrices(float hi, float lo, string levels) =>
    array<float> prices = array.new<float>()
    array<float> ratios = array.new<float>()
    float rng = hi - lo
    for item in str.split(str.replace_all(levels, " ", ""), ",")
        float r = str.tonumber(item)
        if not na(r) and r >= 0
            float up = lo + r * rng
            float dn = hi - r * rng
            prices.push(up)
            ratios.push(r)
            if math.abs(up - dn) >= syminfo.mintick
                prices.push(dn)
                ratios.push(r)
    [prices, ratios]

fibText(float r, float price) =>
    str.tostring(r) + " (" + str.tostring(price, format.mintick) + ")"

// Compute budgets from actual input ratios, before allocating drawings.
ratioCount(string levels) =>
    int count = 0
    for item in str.split(str.replace_all(levels, " ", ""), ",")
        float ratio = str.tonumber(item)
        if not na(ratio) and ratio >= 0
            count += ratio == 0.5 ? 1 : 2
    count
int latestCount = showFib ? ratioCount(fibLevelsStr) : 0
int historyCount = ratioCount(histFibLevelsStr)
if barstate.isfirst and (latestCount > 40 or historyCount > 40)
    runtime.error("每组比例最多生成 40 条线，请减少自定义比例。")
int actualRangeWeeks = math.min(keepWeeks, int(math.floor((498 - latestCount) / 2)))
int actualFibWeeks = showHistFib and historyCount > 0 ? math.min(keepFibWeeks, math.min(actualRangeWeeks - 1, int(math.floor((498 - latestCount - 2 * actualRangeWeeks) / historyCount)))) : 0

if newMonday
    // Freeze the previous week at the last bar before this Monday.
    if highLines.size() > 0 and not extendHistory
        for l in array.from(highLines.last(), lowLines.last())
            l.set_extend(extend.none)
            l.set_x2(time_close[1])
    // The week that just ended gets its faint Fib, Monday through its last
    // weekday bar. lastWeekdayTime has not seen this bar yet.
    if actualFibWeeks > 0 and not na(monStartTime) and not na(lastWeekdayTime) and lastWeekdayTime >= monStartTime
        [hp, hr] = fibPrices(monHigh, monLow, histFibLevelsStr)
        // Retire whole weeks, even when rounding collapses some Fib levels.
        while histFibWeekSizes.size() >= actualFibWeeks
            int retired = histFibWeekSizes.shift()
            for j = 0 to retired - 1
                histFibLines.shift().delete()
                histFibLabels.shift().delete()
        histFibWeekSizes.push(hp.size())
        for [i, p] in hp
            histFibLines.push(line.new(monStartTime, p, lastWeekdayTime, p, color=histFibCol, width=1, xloc=xloc.bar_time))
            histFibLabels.push(label.new(lastWeekdayTime, p, fibText(hr.get(i), p),
                 style=label.style_label_left, color=hiddenCol, textcolor=histFibTextCol, size=fibSize, xloc=xloc.bar_time))
    while highLines.size() >= actualRangeWeeks
        highLines.shift().delete()
        lowLines.shift().delete()
    while highLabels.size() >= actualRangeWeeks
        highLabels.shift().delete()
        lowLabels.shift().delete()
    monHigh := high
    monLow := low
    monStartTime := time
    highLines.push(line.new(time, high, time_close, high, xloc=xloc.bar_time, extend=extend.right,
         color=highCol, style=rayStyle, width=rayWidth))
    lowLines.push(line.new(time, low, time_close, low, xloc=xloc.bar_time, extend=extend.right,
         color=lowCol, style=rayStyle, width=rayWidth))
    if showLabels
        highLabels.push(newRayLabel(high, "周一高", highCol))
        lowLabels.push(newRayLabel(low, "周一低", lowCol))
    if highLines.size() > actualRangeWeeks
        highLines.shift().delete()
        lowLines.shift().delete()
    if highLabels.size() > actualRangeWeeks
        highLabels.shift().delete()
        lowLabels.shift().delete()
else if isMonday and highLines.size() > 0
    if high > monHigh
        monHigh := high
        highLines.last().set_xy1(time, high)
        highLines.last().set_xy2(time_close, high)
    if low < monLow
        monLow := low
        lowLines.last().set_xy1(time, low)
        lowLines.last().set_xy2(time_close, low)

if not isWeekend
    lastWeekdayTime := time_close

// The current week's labels ride on the latest bar; once the next Monday
// starts they stay at the old week's last bar (the weekend slot).
if highLabels.size() > 0
    highLabels.last().set_xy(time, monHigh)
    highLabels.last().set_text(labelText("周一高", monHigh))
    lowLabels.last().set_xy(time, monLow)
    lowLabels.last().set_text(labelText("周一低", monLow))

// ---- Fibonacci on the latest Monday range --------------------------------
var array<line> fibLines = array.new<line>()
var array<label> fibLabels = array.new<label>()
// Fib labels sit right of the Monday labels so the two do not collide.
int fibLabelOffset = 20

if showFib and barstate.islast and not na(monStartTime)
    for l in fibLines
        l.delete()
    for lb in fibLabels
        lb.delete()
    fibLines.clear()
    fibLabels.clear()
    [fp, fr] = fibPrices(monHigh, monLow, fibLevelsStr)
    for [i, p] in fp
        fibLines.push(line.new(monStartTime, p, time_close, p, extend=extend.right,
             color=fibCol, width=1, xloc=xloc.bar_time))
        fibLabels.push(label.new(time + int(timeframe.in_seconds() * 1000) * fibLabelOffset, p,
             fibText(fr.get(i), p), style=label.style_label_left, color=hiddenCol,
             textcolor=fibTextCol, size=fibSize, xloc=xloc.bar_time))

// ---- Four-timeframe MA mini charts ---------------------------------------
// Each panel shares one price scale across SMA/EMA 20/60/120, 8 samples.
// Only preceding source-timeframe bars are returned. A lower-TF panel is a
// recent snapshot, not a reconstruction of every intrabar of the chart.
string miniGroup = "右上角多周期均线"
bool showMini = input.bool(true, "显示 5m / 15m / 1H / 4H 均线小图", group=miniGroup)
bool showInfo = input.bool(true, "显示日界与历史预算", group=miniGroup)
type MASnapshot
    array<float> values
    int stamp

maSnapshot() =>
    float a = ta.sma(close, 20)
    float b = ta.ema(close, 20)
    float c = ta.sma(close, 60)
    float d = ta.ema(close, 60)
    float e = ta.sma(close, 120)
    float f = ta.ema(close, 120)
    MASnapshot snapshot = na
    if barstate.islast
        array<float> values = array.new<float>()
        for i = 8 to 1
            values.push(a[i])
            values.push(b[i])
            values.push(c[i])
            values.push(d[i])
            values.push(e[i])
            values.push(f[i])
        snapshot := MASnapshot.new(values, time_close[1])
    snapshot

// Requests stay active on historical bars, so realtime contexts are ready.
MASnapshot m5 = request.security(syminfo.tickerid, "5", maSnapshot(), lookahead=barmerge.lookahead_off)
MASnapshot m15 = request.security(syminfo.tickerid, "15", maSnapshot(), lookahead=barmerge.lookahead_off)
MASnapshot m60 = request.security(syminfo.tickerid, "60", maSnapshot(), lookahead=barmerge.lookahead_off)
MASnapshot m240 = request.security(syminfo.tickerid, "240", maSnapshot(), lookahead=barmerge.lookahead_off)
var table mini = table.new(position.top_right, showMini ? 18 : 1, showMini ? 26 : 2,
     bgcolor=showMini or showInfo ? color.white : na)
if barstate.isfirst and showMini
    table.merge_cells(mini, 0, 0, 7, 0)
    table.merge_cells(mini, 10, 0, 17, 0)
    table.merge_cells(mini, 0, 11, 7, 11)
    table.merge_cells(mini, 10, 11, 17, 11)
    for row = 22 to 25
        table.merge_cells(mini, 0, row, 17, row)
var array<color> maColors = array.from(#e67e22, #f4bd74, #2176c1, #79b6e5, #803bad, #b782db)

drawMini(MASnapshot shot, int x, int y, string tf) =>
    string stamp = na(shot) ? "无样本" : str.format_time(shot.stamp, "HH:mm", tz) + (na(shot.values.get(5)) ? " · 预热不足" : "")
    table.cell(mini, x, y, tf + " · " + stamp, width=0.30, text_color=color.black, text_size=size.tiny)
    for col = 0 to 7
        for row = 1 to 9
            table.cell(mini, x + col, y + row, "", width=0.30, height=0.65, bgcolor=color.new(#e7ecef, 10))
    if not na(shot)
        float lowMA = shot.values.min()
        float highMA = shot.values.max()
        float span = math.max(highMA - lowMA, syminfo.mintick)
        for col = 0 to 7
            for curve = 0 to 5
                float v = shot.values.get(col * 6 + curve)
                if not na(v)
                    int row = 9 - int(math.round((v - lowMA) / span * 8))
                    table.cell_set_bgcolor(mini, x + col, y + row, maColors.get(curve))

if barstate.islast
    if showMini
        drawMini(m5, 0, 0, "5m")
        drawMini(m15, 10, 0, "15m")
        drawMini(m60, 0, 11, "1H")
        drawMini(m240, 10, 11, "4H")
        table.cell(mini, 0, 22, "SMA 深 / EMA 浅 · 20 橙 / 60 蓝 / 120 紫", width=0.30, text_color=color.black, text_size=size.tiny)
        table.cell(mini, 0, 23, "8 根已完成样本 · 各图独立缩放 · 非入场信号", width=0.30, text_color=color.gray, text_size=size.tiny)
    if showInfo
        table.cell(mini, 0, showMini ? 24 : 0, tz + (isMonday ? " · 周一区间形成中" : " · 周一区间已结束"), text_color=color.black, text_size=size.tiny)
        table.cell(mini, 0, showMini ? 25 : 1, "H/L " + str.tostring(highLines.size()) + "/" + str.tostring(actualRangeWeeks) + " 周 · 历史 Fib 上限 " + str.tostring(actualFibWeeks) + " 周\n受已加载行情限制", text_color=color.gray, text_size=size.tiny)
