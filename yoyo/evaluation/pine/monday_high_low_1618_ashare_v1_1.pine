//@version=6
// A-share V1.1, owner request 2026-10-28. Visual reference, no orders.
// Final levels use confirmed exchange Monday daily OHLC, including auctions.
// Minute data only supplies developing values and observed extrema anchors.
// SSE intraday time_close can be 11:31 / 15:01; auction minute bars can be absent.
// Source fields: time/time_close/high/low. No source bar after the observation clock.
// Final anchors are retrospective, never a claim that the final range was known then.
// https://www.tradingview.com/pine-script-docs/concepts/other-timeframes-and-data/
// https://www.tradingview.com/pine-script-docs/concepts/time/
// https://english.sse.com.cn/start/trading/schedule/
indicator("周一高低点 · 1.618 A股 V1.1", shorttitle="周一 1.618 A股 V1.1", overlay=true,
     max_lines_count=200, max_labels_count=400)

string tz = "Asia/Shanghai"
bool preview = input.bool(true, "显示周一形成中的虚线", tooltip="固定北京时间。形成中使用已收盘分时K线；最终高低点以含集合竞价的周一日线收盘为准。午休正常衔接；周一休市不借用周二。", display=display.none)
bool prices = input.bool(true, "显示名称与价格", display=display.none)
bool dots = input.bool(true, "显示高低点起点", display=display.none)
int visibleLimit = input.int(40, "可见区间最多周数", minval=1, maxval=50,
     tooltip="保留已加载历史，拖动图表会重绘可见各周；超限优先较近的周。细周期历史深度受TradingView套餐限制。", display=display.none)
int fade = input.int(55, "历史线淡化（0–90）", minval=0, maxval=90, display=display.none)
color edgeColor = input.color(#63899B, "周一高低点", display=display.none)
color upperColor = input.color(#F23645, "上 1.618", display=display.none)
color lowerColor = input.color(#089981, "下 1.618", display=display.none)
int width = input.int(2, "1.618 线宽", minval=1, maxval=4, display=display.none)
bool diagnostic = input.bool(false, "输出核对日志", display=display.none)

int chartSeconds = int(timeframe.in_seconds())
bool direct = chartSeconds <= 300
bool supported = chart.is_standard and chartSeconds >= 60 and chartSeconds <= 86400 and
     (direct ? (chartSeconds == 60 or chartSeconds == 180 or chartSeconds == 300) : chartSeconds % 300 == 0)
if barstate.isfirst and not supported
    runtime.error("请使用标准K线：1/3/5分钟，或5分钟整数倍至1日。周线、合成K线及不对齐周期不适用。")

if barstate.isfirst and (syminfo.type != "stock" or syminfo.timezone != "Asia/Shanghai")
    runtime.error("本版本适用于上海时区的A股股票。其他市场请使用对应版本。")

type WeekRange
    int start
    int finish
    int expires
    float hi = na
    float lo = na
    int hiTime = na
    int loTime = na
    float minuteHi = na
    float minuteLo = na
    int minuteHiTime = na
    int minuteLoTime = na
    bool frozen = false
    int bars = 0

weekTimes(int t) =>
    int y = year(t, tz)
    int m = month(t, tz)
    int d = dayofmonth(t, tz)
    int offset = (dayofweek(t, tz) + 5) % 7
    [timestamp(tz, y, m, d - offset, 0, 0),
     timestamp(tz, y, m, d - offset, 15, 1),
     timestamp(tz, y, m, d - offset + 7, 0, 0)]

var array<WeekRange> history = array.new<WeekRange>()

getRange(array<WeekRange> ledger, int t) =>
    [start, finish, expires] = weekTimes(t)
    if ledger.size() == 0 or ledger.last().start < start
        ledger.push(WeekRange.new(start, finish, expires))
    ledger.last()

// The explicit observation clock excludes forming source bars in native QA and live use.
consumeMinutes(array<WeekRange> ledger, int t, int tc, float h, float l, int observedAt) =>
    int minuteOfDay = hour(t, tz) * 60 + minute(t, tz)
    bool inSession = (minuteOfDay >= 570 and minuteOfDay < 691) or (minuteOfDay >= 780 and minuteOfDay < 901)
    if dayofweek(t, tz) == dayofweek.monday and inSession and tc <= observedAt and tc > t and not na(h) and not na(l) and h >= l
        WeekRange r = getRange(ledger, t)
        [start, finish, expires] = weekTimes(t)
        if r.start == start
            if na(r.minuteHi) or h > r.minuteHi
                r.minuteHi := h
                r.minuteHiTime := t
            if na(r.minuteLo) or l < r.minuteLo
                r.minuteLo := l
                r.minuteLoTime := t
            if not r.frozen
                r.hi := r.minuteHi
                r.lo := r.minuteLo
                r.hiTime := r.minuteHiTime
                r.loTime := r.minuteLoTime
            r.bars += 1

// Daily OHLC is authoritative: auctions need not appear in TradingView minute data.
// Intraday gaps cannot invalidate a completed official daily range or fabricate its time.
freezeDaily(array<WeekRange> ledger, int t, int tc, float h, float l, int observedAt) =>
    if not na(t) and dayofweek(t, tz) == dayofweek.monday and tc <= observedAt and tc > t and not na(h) and not na(l) and h >= l
        WeekRange r = getRange(ledger, t)
        [start, finish, expires] = weekTimes(t)
        if r.start == start
            r.hi := h
            r.lo := l
            r.finish := tc
            r.frozen := true
            r.hiTime := not na(r.minuteHi) and math.abs(r.minuteHi - h) < syminfo.mintick / 2 ? r.minuteHiTime : na
            r.loTime := not na(r.minuteLo) and math.abs(r.minuteLo - l) < syminfo.mintick / 2 ? r.minuteLoTime : na

int observedClose = barstate.isrealtime ? timenow : time_close
// Prior completed day is stable from the next session; current day is accepted only at its close.
[prevTime, prevClose, prevHi, prevLo] = request.security(syminfo.tickerid, "D", [time[1], time_close[1], high[1], low[1]], lookahead=barmerge.lookahead_on)
[dayTime, dayClose, dayHi, dayLo] = request.security(syminfo.tickerid, "D", [time, time_close, high, low], lookahead=barmerge.lookahead_off)
freezeDaily(history, prevTime, prevClose, prevHi, prevLo, observedClose)
if direct
    if barstate.isconfirmed
        consumeMinutes(history, time, time_close, high, low, observedClose)
else
    [times, closes, highs, lows] = request.security_lower_tf(syminfo.tickerid, "5", [time, time_close, high, low])
    if times.size() > 0
        for i = 0 to times.size() - 1
            consumeMinutes(history, times.get(i), closes.get(i), highs.get(i), lows.get(i), observedClose)
// Require a confirmed chart bar too: wall time alone can run ahead of delayed SSE quotes.
if barstate.isconfirmed
    freezeDaily(history, dayTime, dayClose, dayHi, dayLo, observedClose)

var array<line> lines = array.new<line>()
var array<label> labels = array.new<label>()
int left = chart.left_visible_bar_time
int right = chart.right_visible_bar_time
[currentStart, currentFinish, currentExpires] = weekTimes(observedClose)

drawLevel(WeekRange r, float value, int origin, string title, color base, int thickness, bool forming) =>
    bool old = r.start < currentStart
    color ink = color.new(base, old ? fade : 0)
    bool located = not na(origin)
    int from = math.max(located ? origin : r.start + 570 * 60000, left)
    int until = r.expires
    string tooltip = str.format_time(r.start, "yyyy-MM-dd", tz) + " · " + tz +
         "\n" + title + " = " + str.tostring(value, format.mintick) +
         "\n周一高 " + str.tostring(r.hi, format.mintick) + " / 低 " + str.tostring(r.lo, format.mintick) +
         "\n" + (forming ? "形成中：已收盘分时范围；含集合竞价的最终值以周一日线为准" : "周一日线收盘后确认，含集合竞价；回标起点不表示当时已知最终值")
    tooltip += located ? "\n起点：分时可见极值K线" : "\n日线极值未在可用分时中定位；起点使用周一09:30，不冒充极值时刻"
    if from < until
        lines.push(line.new(from, value, until, value, xloc=xloc.bar_time,
             color=ink, width=thickness, style=forming ? line.style_dashed : line.style_solid))
        if prices
            int labelAt = math.max(from, math.min(until, right))
            labels.push(label.new(labelAt, value, title + (forming ? " · 形成中" : not located ? " · 日线定位" : "") + " (" + str.tostring(value, format.mintick) + ")",
                 xloc=xloc.bar_time, style=label.style_label_lower_right, textalign=text.align_right,
                 color=color.new(base, 100), textcolor=ink, size=size.small, tooltip=tooltip))
        if dots and located and origin >= left and origin <= right
            labels.push(label.new(origin, value, "•", xloc=xloc.bar_time, style=label.style_none,
                 textcolor=ink, size=size.small, tooltip=tooltip))

var table status = table.new(position.bottom_left, 1, 1)
if barstate.islast
    while lines.size() > 0
        line.delete(lines.pop())
    while labels.size() > 0
        label.delete(labels.pop())
    int shown = 0
    int eligible = 0
    int incomplete = 0
    if history.size() > 0
        for j = 0 to history.size() - 1
            WeekRange r = history.get(history.size() - 1 - j)
            bool intersects = r.expires > left and r.start <= right
            bool forming = not r.frozen and r.start == currentStart and observedClose < r.finish
            bool full = r.frozen
            bool valid = r.hi > r.lo and (forming ? preview : full)
            if intersects and valid
                eligible += 1
                if shown < visibleLimit
                    float span = r.hi - r.lo
                    drawLevel(r, r.hi, r.hiTime, "周一高", edgeColor, 1, forming)
                    drawLevel(r, r.lo, r.loTime, "周一低", edgeColor, 1, forming)
                    drawLevel(r, r.hi + 0.618 * span, r.hiTime, "上 1.618", upperColor, width, forming)
                    drawLevel(r, r.lo - 0.618 * span, r.loTime, "下 1.618", lowerColor, width, forming)
                    shown += 1
            if intersects and not forming and not full
                incomplete += 1
    string message = eligible > visibleLimit ? "可见周数超限，请缩小范围" : incomplete > 0 ? "部分周一日线尚未确认，已跳过" : shown == 0 ? "当前窗口无已确认周一行情（休市/停牌/历史不足）" : ""
    bool currentSeen = history.size() > 0 and history.last().start == currentStart
    if message == "" and not currentSeen and currentStart <= right and currentExpires > left and observedClose >= currentFinish
        message := "本周无周一行情，未借用其他交易日"
    table.cell(status, 0, 0, message, text_color=chart.fg_color, text_size=size.tiny,
         bgcolor=message == "" ? color.new(color.black, 100) : color.new(color.gray, 85))

if diagnostic and (barstate.islastconfirmedhistory or (barstate.islast and barstate.isconfirmed)) and history.size() > 0
    for j = math.max(0, history.size() - 2) to history.size() - 1
        WeekRange r = history.get(j)
        log.info("MONDAY1618_ASHARE {0} tz={1} high={2} low={3} upper={4} lower={5} bars={6} complete={7} from={8} through={9} expires={10}",
             str.format_time(r.start, "yyyy-MM-dd", tz), tz, str.tostring(r.hi, format.mintick), str.tostring(r.lo, format.mintick),
             str.tostring(r.hi + 0.618 * (r.hi-r.lo), "#.##########"), str.tostring(r.lo - 0.618 * (r.hi-r.lo), "#.##########"),
             r.bars, r.frozen, r.start, r.finish, r.expires)
