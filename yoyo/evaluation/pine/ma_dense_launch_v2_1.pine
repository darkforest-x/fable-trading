var array<float> S2FAMILY = f_pool_s2family()

// ---------------------------------------------------------------- distance helpers
// A sequence is flat and channel-major: value(channel, t) = seq[channel * width + t].
var array<float> BUF_A = array.new<float>()
var array<float> BUF_B = array.new<float>()
var array<float> BUF_DA = array.new<float>()
var array<float> BUF_DB = array.new<float>()
var array<float> BUF_COST = array.new<float>()

// Copy one segment of `channels` rows, z-normalized per channel, into `out`.
f_segment(array<float> seq, int offset, int width, int channels, int from, int len, array<float> out) =>
    array.clear(out)
    for ch = 0 to channels - 1
        float mean = 0.0
        for t = 0 to len - 1
            mean += array.get(seq, offset + ch * width + from + t)
        mean := mean / len
        float acc = 0.0
        for t = 0 to len - 1
            float d = array.get(seq, offset + ch * width + from + t) - mean
            acc += d * d
        float sd = math.sqrt(acc / len)
        float safe = sd <= 1e-12 ? 1.0 : sd
        for t = 0 to len - 1
            array.push(out, (array.get(seq, offset + ch * width + from + t) - mean) / safe)

f_lockstep(array<float> a, array<float> b) =>
    float acc = 0.0
    int n = array.size(a)
    for i = 0 to n - 1
        float d = array.get(a, i) - array.get(b, i)
        acc += d * d
    math.sqrt(acc / n)

// Keogh derivative of an already normalized block; writes channels x (len - 2).
f_derivative(array<float> src, int channels, int len, array<float> out) =>
    array.clear(out)
    for ch = 0 to channels - 1
        for t = 1 to len - 2
            float prev = array.get(src, ch * len + t - 1)
            float cur = array.get(src, ch * len + t)
            float next = array.get(src, ch * len + t + 1)
            array.push(out, 0.5 * ((cur - prev) + 0.5 * (next - prev)))

f_dtw(array<float> a, array<float> b, int channels, int len, int radius) =>
    int n = len
    int m = len
    array.clear(BUF_COST)
    for i = 0 to (n + 1) * (m + 1) - 1
        array.push(BUF_COST, 1.0e300)
    array.set(BUF_COST, 0, 0.0)
    for i = 1 to n
        int lo = math.max(1, i - radius)
        int hi = math.min(m, i + radius)
        for j = lo to hi
            float local = 0.0
            for ch = 0 to channels - 1
                float d = array.get(a, ch * len + i - 1) - array.get(b, ch * len + j - 1)
                local += d * d
            float best = math.min(math.min(array.get(BUF_COST, (i - 1) * (m + 1) + j - 1), array.get(BUF_COST, (i - 1) * (m + 1) + j)), array.get(BUF_COST, i * (m + 1) + j - 1))
            array.set(BUF_COST, i * (m + 1) + j, best + local)
    math.sqrt(array.get(BUF_COST, n * (m + 1) + m) / (channels * len))

// Segmented blend for one 7x22 pair; `mode` 0 = lock-step prefilter, 1 = full blend.
f_seq_distance(array<float> left, int leftOffset, array<float> right, int rightOffset, int mode) =>
    float total = 0.0
    for seg = 0 to 2
        int from = seg == 0 ? 0 : seg == 1 ? 12 : 17
        int len = seg == 0 ? 12 : 5
        float segWeight = seg == 0 ? 0.2500000000 : seg == 1 ? 0.3500000000 : 0.4000000000
        f_segment(left, leftOffset, 22, 7, from, len, BUF_A)
        f_segment(right, rightOffset, 22, 7, from, len, BUF_B)
        float lockstep = f_lockstep(BUF_A, BUF_B)
        float value = lockstep
        if mode == 1
            int radius = math.min(2, len - 1)
            float dtw = f_dtw(BUF_A, BUF_B, 7, len, radius)
            f_derivative(BUF_A, 7, len, BUF_DA)
            f_derivative(BUF_B, 7, len, BUF_DB)
            float ddtw = f_dtw(BUF_DA, BUF_DB, 7, len - 2, radius)
            value := 0.3500000000 * lockstep + 0.4000000000 * dtw + 0.2500000000 * ddtw
        total += segWeight * value
    total

// Nearest reference: lock-step prefilter to 3, then the full blend.
f_nearest(array<float> candidate, array<float> pool) =>
    int count = array.size(pool) / 154
    array<int> order = array.new<int>()
    array<float> score = array.new<float>()
    for r = 0 to count - 1
        array.push(order, r)
        array.push(score, count > 3 ? f_seq_distance(candidate, 0, pool, r * 154, 0) : 0.0)
    if count > 3
        for i = 0 to count - 2
            for j = 0 to count - 2 - i
                if array.get(score, j) > array.get(score, j + 1)
                    float sv = array.get(score, j)
                    array.set(score, j, array.get(score, j + 1))
                    array.set(score, j + 1, sv)
                    int ov = array.get(order, j)
                    array.set(order, j, array.get(order, j + 1))
                    array.set(order, j + 1, ov)
    int take = math.min(count, 3)
    float best = 1.0e300
    for i = 0 to take - 1
        best := math.min(best, f_seq_distance(candidate, 0, pool, array.get(order, i) * 154, 1))
    best

f_clip(float v) =>
    math.max(0.0, math.min(1.0, v))

// numpy.interp of a 4- or 5-point core onto five points
f_resample(array<float> src, int len, array<float> out) =>
    if len == 5
        for t = 0 to 4
            array.push(out, array.get(src, t))
    else
        for t = 0 to 4
            float pos = t / 4.0 * (len - 1)
            int lo = int(math.floor(pos))
            int hi = math.min(len - 1, lo + 1)
            float w = pos - lo
            array.push(out, array.get(src, lo) * (1.0 - w) + array.get(src, hi) * w)

// One profile channel at bar offset `k`, direction-normalized in ATR units.
f_channel(int ch, int k, float sign, float atr, float origin) =>
    float bh = math.max(open[k], close[k])
    float bl = math.min(open[k], close[k])
    switch ch
        0 => sign * (close[k] - origin) / atr
        1 => sign * (close[k] - open[k]) / atr
        2 => (sign > 0 ? high[k] - bh : bl - low[k]) / atr
        3 => (sign > 0 ? bl - low[k] : high[k] - bh) / atr
        4 => sign * (maMid[k] - origin) / atr
        5 => (maHi[k] - maLo[k]) / atr
        => sign * (close[k] - maMid[k]) / atr

// ---------------------------------------------------------------- candidate evaluation
var array<float> CAND1 = array.new<float>()   // stage-1 profile: 14 features + 4x10 sequence
var array<float> CAND2 = array.new<float>()   // stage-2 sequence: 7x22
var array<float> CORE_BUF = array.new<float>()

// Returns [gradeA, hardGates, quality, stage1Distance, coreHigh, coreLow].
f_eval(float sign, int L) =>
    int endO = 5
    int startO = 4 + L
    int winO = 16 + L
    float atr = atr14[3]
    bool ok = bar_index > winO + 1 and not na(atr) and atr > 0
    if ok and barstate.isconfirmed
        array.set(FUNNEL, 0, array.get(FUNNEL, 0) + 1)
    if ok
        float q1 = sign * (close[4] - close[5]) / atr
        float q2 = sign * (close[3] - close[5]) / atr
        float q3 = sign * (close[2] - close[5]) / atr
        float q5 = sign * (close[0] - close[5]) / atr
        ok := q1 >= 0.0 and q2 >= 1.0 and q3 >= 1.25 and q5 >= 1.75
        if ok and barstate.isconfirmed
            array.set(FUNNEL, 1, array.get(FUNNEL, 1) + 1)
    if ok
        for k = 0 to winO - 1
            if time[k] - time[k + 1] != tfMs
                ok := false
                break
    if ok
        for k = 0 to winO
            if na(s120[k]) or na(e120[k]) or na(s60[k]) or na(s20[k])
                ok := false
                break
    bool hard = false
    bool gradeA = false
    float quality = na
    float s1dist = na
    float cHigh = na
    float cLow = na
    if ok
        float envHi = -1.0e300
        float envLo = 1.0e300
        float maxBody = 0.0
        float minCloseToMa = 1.0e300
        float maxCloseToEnv = 0.0
        float maxBodyToEnv = 0.0
        int touch = 0
        int bodyTouch = 0
        int coreRev = 0
        array<float> closeDist = array.new<float>()
        array<float> wicks = array.new<float>()
        float hh = -1.0e300
        float ll = 1.0e300
        for k = endO to startO
            float o = open[k]
            float c = close[k]
            float h = high[k]
            float l = low[k]
            float lo6 = maLo[k]
            float hi6 = maHi[k]
            envHi := math.max(envHi, hi6)
            envLo := math.min(envLo, lo6)
            maxBody := math.max(maxBody, math.abs(c - o) / atr)
            for j = 0 to 5
                minCloseToMa := math.min(minCloseToMa, math.abs(c - f_ma(k, j)) / atr)
            float cd = math.max(math.max(lo6 - c, c - hi6), 0.0) / atr
            maxCloseToEnv := math.max(maxCloseToEnv, cd)
            array.push(closeDist, cd)
            float bh = math.max(o, c)
            float bl = math.min(o, c)
            maxBodyToEnv := math.max(maxBodyToEnv, math.max(math.max(lo6 - bh, bl - hi6), 0.0) / atr)
            if h >= lo6 and l <= hi6
                touch += 1
            if bh + 0.05 * atr >= lo6 and bl - 0.05 * atr <= hi6
                bodyTouch += 1
            array.push(wicks, ((h - bh) + (bl - l)) / atr)
            if sign * (c - o) / atr < -0.20
                coreRev += 1
            hh := math.max(hh, h)
            ll := math.min(ll, l)
        cHigh := hh
        cLow := ll
        float coreEnv = (envHi - envLo) / atr
        float endSpread = (maHi[endO] - maLo[endO]) / atr
        float coreProg = sign * (close[endO] - close[startO]) / atr
        float p1 = sign * (close[4] - close[5]) / atr
        float p2 = sign * (close[3] - close[5]) / atr
        float p3 = sign * (close[2] - close[5]) / atr
        float p4 = sign * (close[1] - close[5]) / atr
        float p5 = sign * (close[0] - close[5]) / atr
        float slopeSum = 0.0
        float slopeSq = 0.0
        for j = 0 to 5
            float sl = (f_ma(endO, j) - f_ma(startO, j)) / atr
            slopeSum += sl
            slopeSq += sl * sl
        float slopeMean = slopeSum / 6.0
        float slope1 = sign * slopeMean
        float slopeStd = math.sqrt(math.max(slopeSq / 6.0 - slopeMean * slopeMean, 0.0))
        bool pass1 = coreEnv <= 1.5 and endSpread <= 1.1 and maxBody <= 1.2 and coreProg >= -0.6 and coreProg <= 1.3 and p1 >= 0.0 and p2 >= 1.0 and p3 >= 1.25 and p5 >= 1.75 and slope1 >= 0.03 and minCloseToMa <= 1.0 and maxCloseToEnv <= 1.9 and maxBodyToEnv <= 1.5
        if pass1 and barstate.isconfirmed
            array.set(FUNNEL, 2, array.get(FUNNEL, 2) + 1)
        float bundleRatio = na
        float touchRate = na
        float closeQ75 = na
        float wickQ90 = na
        float preBodyQ90 = na
        float prePath = na
        float preLast3 = na
        float preFav = na
        float slope2 = na
        float retrace = na
        float maxOppPost = na
        int dec = 0
        int flips = 0
        int posSteps = 0
        int postRev = 0
        if pass1
            float bwStart = (maHi[startO] - maLo[startO]) / atr
            bundleRatio := endSpread / math.max(bwStart, 1.0e-12)
            for k = endO to startO - 1
                if (maHi[k] - maLo[k]) < (maHi[k + 1] - maLo[k + 1])
                    dec += 1
            for a = 0 to 4
                for b = a + 1 to 5
                    int prevS = 0
                    bool first = true
                    for k = startO + 1 to endO
                        float d = f_ma(k, a) - f_ma(k, b)
                        int sgn = d > 0 ? 1 : d < 0 ? -1 : prevS
                        if not first and sgn != prevS and sgn != 0 and prevS != 0
                            flips += 1
                        prevS := sgn
                        first := false
            bool topology = (bundleRatio <= 0.9 and dec >= 2) or (bundleRatio <= 1.15 and flips >= 3)
            slope2 := sign * (maMid[endO] - maMid[startO]) / atr / math.max(L - 1, 1)
            touchRate := float(touch) / L
            closeQ75 := f_quantile(closeDist, 0.75)
            wickQ90 := f_quantile(wicks, 0.90)
            array<float> preBodies = array.new<float>()
            prePath := 0.0
            preFav := 0.0
            float preBase = close[startO + 12]
            for k = startO + 12 to startO + 1
                array.push(preBodies, math.abs(close[k] - open[k]) / atr)
                if k < startO + 12
                    prePath += math.abs(close[k] - close[k + 1])
                preFav := math.max(preFav, sign * (close[k] - preBase) / atr)
            prePath := prePath / atr
            preBodyQ90 := f_quantile(preBodies, 0.90)
            preLast3 := sign * (close[startO + 1] - close[startO + 4]) / atr
            array<float> path = array.from(0.0, p1, p2, p3, p4, p5)
            float peak = 0.0
            retrace := 0.0
            float minProg = 0.0
            for i = 0 to 5
                float v = array.get(path, i)
                peak := math.max(peak, v)
                retrace := math.max(retrace, peak - v)
                minProg := math.min(minProg, v)
            float minPostBody = 1.0e300
            for k = 4 to 0
                if sign * (close[k] - close[k + 1]) > 0
                    posSteps += 1
                float pb = sign * (close[k] - open[k]) / atr
                if pb < -0.20
                    postRev += 1
                minPostBody := math.min(minPostBody, pb)
            maxOppPost := math.max(0.0, -minPostBody)
            hard := endSpread <= 0.95 and coreEnv <= 1.5 and coreProg >= -0.6 and coreProg <= 1.0 and slope2 >= 0.02 and topology and touchRate >= 0.4 and closeQ75 <= 1.5 and preBodyQ90 <= 1.1 and prePath <= 5.5 and preLast3 <= 1.0 and preFav <= 3.0 and wickQ90 <= 2.0 and coreRev <= 1 and maxBody <= 1.2 and p1 >= 0.0 and p2 >= 1.0 and p3 >= 1.25 and p5 >= 1.75 and minProg >= 0.0 and posSteps >= 3 and retrace <= 0.75 and postRev <= 1 and maxOppPost <= 0.8
        if hard and barstate.isconfirmed
            array.set(FUNNEL, 3, array.get(FUNNEL, 3) + 1)
        if hard
            // ---- stage-1 profile: fourteen features then four resampled channels
            float origin = maMid[startO]
            array.clear(CAND1)
            array.push(CAND1, coreEnv)
            array.push(CAND1, endSpread)
            array.push(CAND1, (hh - ll) / atr)
            array.push(CAND1, maxBody)
            array.push(CAND1, coreProg)
            array.push(CAND1, p1)
            array.push(CAND1, p2)
            array.push(CAND1, p3)
            array.push(CAND1, p5)
            array.push(CAND1, slope1)
            array.push(CAND1, slopeStd)
            array.push(CAND1, minCloseToMa)
            array.push(CAND1, maxCloseToEnv)
            array.push(CAND1, maxBodyToEnv)
            for ch = 0 to 3
                array.clear(CORE_BUF)
                for k = startO to endO
                    float v = ch == 0 ? sign * (close[k] - origin) / atr : ch == 1 ? sign * (close[k] - open[k]) / atr : ch == 2 ? sign * (maMid[k] - origin) / atr : (maHi[k] - maLo[k]) / atr
                    array.push(CORE_BUF, v)
                f_resample(CORE_BUF, L, CAND1)
                for k = 4 to 0
                    float v = ch == 0 ? sign * (close[k] - origin) / atr : ch == 1 ? sign * (close[k] - open[k]) / atr : ch == 2 ? sign * (maMid[k] - origin) / atr : (maHi[k] - maLo[k]) / atr
                    array.push(CAND1, v)
            s1dist := 1.0e300
            int refs = array.size(S1REF) / 54
            for r = 0 to refs - 1
                float fAcc = 0.0
                for i = 0 to 13
                    float d = (array.get(CAND1, i) - array.get(S1REF, r * 54 + i)) / array.get(S1SCALE, i)
                    fAcc += d * d
                float sAcc = 0.0
                for i = 14 to 54 - 1
                    float d = array.get(CAND1, i) - array.get(S1REF, r * 54 + i)
                    sAcc += d * d
                s1dist := math.min(s1dist, 0.4500000000 * math.sqrt(fAcc / 14.0) + 0.5500000000 * math.sqrt(sAcc / 40.0))
            if s1dist <= 0.5000000000 and barstate.isconfirmed
                array.set(FUNNEL, 4, array.get(FUNNEL, 4) + 1)
            if s1dist <= 0.5000000000
                // ---- stage-2 sequence: seven channels over 12 pre + 5 resampled core + 5 release
                array.clear(CAND2)
                for ch = 0 to 6
                    for k = startO + 12 to startO + 1
                        array.push(CAND2, f_channel(ch, k, sign, atr, origin))
                    array.clear(CORE_BUF)
                    for k = startO to endO
                        array.push(CORE_BUF, f_channel(ch, k, sign, atr, origin))
                    f_resample(CORE_BUF, L, CAND2)
                    for k = 4 to 0
                        array.push(CAND2, f_channel(ch, k, sign, atr, origin))
                float good = f_nearest(CAND2, S2ANCHOR)
                float bad = f_nearest(CAND2, S2BAD)
                float family = f_nearest(CAND2, S2FAMILY)
                float contraction = f_clip((1.15 - bundleRatio) / 0.50)
                float topologyScore = math.max((contraction + f_clip(dec / 4.0)) / 2.0, (contraction + f_clip(flips / 6.0)) / 2.0)
                float density = (f_clip((1.10 - endSpread) / 0.85) + f_clip((1.60 - coreEnv) / 1.35) + topologyScore + f_clip(slope2 / 0.08)) / 4.0
                float quiet = (f_clip(1.0 - preBodyQ90 / 1.10) + f_clip(1.0 - prePath / 5.50) + f_clip(1.0 - math.max(0.0, preLast3)) + f_clip(1.0 - preFav / 3.00)) / 4.0
                float contact = (f_clip((touchRate - 0.40) / 0.60) + f_clip(1.0 - closeQ75 / 1.50) + float(bodyTouch) / L) / 3.0
                float release = (f_clip(p1 / 1.50) + f_clip(p2 / 2.00) + f_clip(p3 / 2.50) + f_clip(p5 / 3.50) + f_clip(posSteps / 5.0) + f_clip(1.0 - retrace / 0.75)) / 6.0
                float clean = (f_clip(1.0 - wickQ90 / 2.00) + f_clip(1.0 - coreRev / 2.0) + f_clip(1.0 - maxBody / 1.20) + f_clip(1.0 - maxOppPost / 0.80)) / 4.0
                float similar = 0.50 * math.exp(-good / 1.1995844783) + 0.25 * math.exp(-family / 1.1995844783) + 0.25 * (1.0 / (1.0 + math.exp(-(bad - good) / 1.1995844783)))
                float weighted = 0.2500000000 * density + 0.1500000000 * quiet + 0.1000000000 * contact + 0.2000000000 * release + 0.1000000000 * clean + 0.2000000000 * similar
                float weakest = math.min(math.min(math.min(density, quiet), math.min(contact, release)), math.min(clean, similar))
                quality := (1.0 - 0.2500000000) * weighted + 0.2500000000 * weakest
                gradeA := quality >= 0.3611898959
                if gradeA and barstate.isconfirmed
                    array.set(FUNNEL, 5, array.get(FUNNEL, 5) + 1)
    [gradeA, hard, quality, s1dist, cHigh, cLow]

// ---------------------------------------------------------------- state
type Trade
    int dir
    int entryBar
    float stop
    float entry
    float target
    line lEntry
    line lStop
    line lTarget

var array<Trade> pending = array.new<Trade>()
var array<Trade> active = array.new<Trade>()
// Pine functions may not assign to globals, so mutable state lives in arrays.
// COUNT: 0 signals, 1 targets, 2 stops, 3 timeouts. ACC: 0 net R, 1 net bp, 2 last long core end, 3 last short core end.
var array<int> COUNT = array.new<int>(4, 0)
// FUNNEL: 0 evaluated, 1 released, 2 stage-1 gate, 3 stage-2 hard gates, 4 similarity, 5 Grade-A.
var array<int> FUNNEL = array.new<int>(6, 0)
var array<float> ACC = array.from(0.0, 0.0, float(na), float(na))
var table stats = table.new(position.top_right, 2, 8, bgcolor=color.new(color.white, 10), border_color=color.new(#D8DEE6, 0), border_width=1)

f_signal(int dir, int L, float cH, float cL, float quality) =>
    box.new(bar_index - (4 + L), cH, bar_index - 5, cL, border_color=color.new(#E0A100, 0), bgcolor=color.new(#F6C453, 70))
    string tag = (dir == 1 ? "密集↑" : "密集↓") + (showScore and not na(quality) ? " " + str.tostring(quality, "#.00") : "")
    if dir == 1
        label.new(bar_index, low, tag, style=label.style_label_up, color=color.new(#2E7D32, 0), textcolor=color.white, size=size.small)
    else
        label.new(bar_index, high, tag, style=label.style_label_down, color=color.new(#B3261E, 0), textcolor=color.white, size=size.small)
    array.push(pending, Trade.new(dir, bar_index + 1, dir == 1 ? cL : cH, na, na, na, na, na))
    array.set(COUNT, 0, array.get(COUNT, 0) + 1)

// Evaluate both core lengths in both directions, apply the cooldown, draw new signals.
f_open_signals() =>
    [l4g, l4h_, l4q, l4d, l4hi, l4lo] = f_eval(1.0, 4)
    [l5g, l5h_, l5q, l5d, l5hi, l5lo] = f_eval(1.0, 5)
    [s4g, s4h_, s4q, s4d, s4hi, s4lo] = f_eval(-1.0, 4)
    [s5g, s5h_, s5q, s5d, s5hi, s5lo] = f_eval(-1.0, 5)
    bool long4 = requireGradeA ? l4g : l4h_
    bool long5 = requireGradeA ? l5g : l5h_
    bool short4 = requireGradeA ? s4g : s4h_
    bool short5 = requireGradeA ? s5g : s5h_
    float coreEndTime = time[5]
    bool longRaw = barstate.isconfirmed and showLong and (long4 or long5)
    bool shortRaw = barstate.isconfirmed and showShort and (short4 or short5)
    bool longSig = longRaw and (na(array.get(ACC, 2)) or coreEndTime - array.get(ACC, 2) > cooldownMin * 60000)
    bool shortSig = shortRaw and (na(array.get(ACC, 3)) or coreEndTime - array.get(ACC, 3) > cooldownMin * 60000)
    if longSig
        array.set(ACC, 2, coreEndTime)
        int L = long4 ? 4 : 5
        f_signal(1, L, L == 4 ? l4hi : l5hi, L == 4 ? l4lo : l5lo, L == 4 ? l4q : l5q)
    if shortSig
        array.set(ACC, 3, coreEndTime)
        int L = short4 ? 4 : 5
        f_signal(-1, L, L == 4 ? s4hi : s5hi, L == 4 ? s4lo : s5lo, L == 4 ? s4q : s5q)
    [longSig, shortSig]

// Fill at the next bar's open and draw the reference levels.
f_fill() =>
    if array.size(pending) > 0
        for i = array.size(pending) - 1 to 0
            Trade t = array.get(pending, i)
            if bar_index == t.entryBar
                t.entry := open
                float risk = t.dir * (t.entry - t.stop)
                if risk > 0
                    t.target := t.entry + t.dir * rMult * risk
                    if showTrade
                        int right = projectLines ? bar_index + horizonBars : bar_index
                        t.lEntry := line.new(bar_index, t.entry, right, t.entry, color=#1565C0, style=line.style_dashed)
                        t.lStop := line.new(bar_index, t.stop, right, t.stop, color=#C62828, style=line.style_dashed)
                        t.lTarget := line.new(bar_index, t.target, right, t.target, color=#2E7D32, style=line.style_dashed)
                    array.push(active, t)
                array.remove(pending, i)

f_close(Trade t, float px, string tag, color col) =>
    float grossR = t.dir * (px - t.entry) / (t.dir * (t.entry - t.stop))
    float netBp = (t.dir * (px / t.entry - 1.0) - costPct / 100.0) * 10000.0
    if showTrade
        line.set_x2(t.lEntry, bar_index)
        line.set_x2(t.lStop, bar_index)
        line.set_x2(t.lTarget, bar_index)
        label.new(bar_index, px, tag, style=label.style_label_left, color=color.new(col, 20), textcolor=color.white, size=size.tiny)
    array.set(ACC, 0, array.get(ACC, 0) + grossR - (costPct / 100.0) / math.abs(t.entry - t.stop) * t.entry)
    array.set(ACC, 1, array.get(ACC, 1) + netBp)

// Stop first inside a bar, then target, then the holding-time cap.
f_resolve() =>
    if array.size(active) > 0
        for i = array.size(active) - 1 to 0
            Trade t = array.get(active, i)
            if showTrade and not projectLines
                line.set_x2(t.lEntry, bar_index)
                line.set_x2(t.lStop, bar_index)
                line.set_x2(t.lTarget, bar_index)
            bool hitStop = t.dir == 1 ? low <= t.stop : high >= t.stop
            bool hitTarget = t.dir == 1 ? high >= t.target : low <= t.target
            int held = bar_index - t.entryBar + 1
            if hitStop
                f_close(t, t.dir == 1 ? math.min(open, t.stop) : math.max(open, t.stop), "止损", #B3261E)
                array.set(COUNT, 2, array.get(COUNT, 2) + 1)
                array.remove(active, i)
            else if hitTarget
                f_close(t, t.target, str.tostring(rMult) + "R", #2E7D32)
                array.set(COUNT, 1, array.get(COUNT, 1) + 1)
                array.remove(active, i)
            else if held >= horizonBars
                f_close(t, close, "到期", #5A6475)
                array.set(COUNT, 3, array.get(COUNT, 3) + 1)
                array.remove(active, i)

f_stats() =>
    if showStats and barstate.islast
        int nSig = array.get(COUNT, 0)
        int nTP = array.get(COUNT, 1)
        int nSL = array.get(COUNT, 2)
        int nTO = array.get(COUNT, 3)
        float sumR = array.get(ACC, 0)
        float sumBp = array.get(ACC, 1)
        int done = nTP + nSL + nTO
        table.cell(stats, 0, 0, "均线密集 V2", text_color=#18202D, text_size=size.small)
        table.cell(stats, 1, 0, timeframe.period + (requireGradeA ? " · A级" : " · 仅硬条件"), text_color=#18202D, text_size=size.small)
        table.cell(stats, 0, 1, "信号", text_size=size.small)
        table.cell(stats, 1, 1, str.tostring(nSig), text_size=size.small)
        table.cell(stats, 0, 2, "到 " + str.tostring(rMult) + "R", text_size=size.small)
        table.cell(stats, 1, 2, str.tostring(nTP), text_size=size.small)
        table.cell(stats, 0, 3, "止损 / 到期", text_size=size.small)
        table.cell(stats, 1, 3, str.tostring(nSL) + " / " + str.tostring(nTO), text_size=size.small)
        table.cell(stats, 0, 4, "3R 命中率", text_size=size.small)
        table.cell(stats, 1, 4, done > 0 ? str.tostring(100.0 * nTP / done, "#.0") + "%" : "-", text_size=size.small)
        table.cell(stats, 0, 5, "平均净 R", text_size=size.small)
        table.cell(stats, 1, 5, done > 0 ? str.tostring(sumR / done, "#.00") : "-", text_size=size.small)
        table.cell(stats, 0, 6, "平均净 bp", text_size=size.small)
        table.cell(stats, 1, 6, done > 0 ? str.tostring(sumBp / done, "#.0") : "-", text_size=size.small)
        table.cell(stats, 0, 7, "A 级门槛", text_size=size.small)
        table.cell(stats, 1, 7, str.tostring(0.3611898959, "#.000"), text_size=size.small)

var table funnel = table.new(position.bottom_right, 2, 7, bgcolor=color.new(color.white, 10), border_color=color.new(#D8DEE6, 0), border_width=1)

f_funnel() =>
    if showFunnel and barstate.islast
        table.cell(funnel, 0, 0, "每一关通过", text_color=#18202D, text_size=size.tiny)
        table.cell(funnel, 1, 0, "次数（4 组合计）", text_color=#18202D, text_size=size.tiny)
        table.cell(funnel, 0, 1, "已评估", text_size=size.tiny)
        table.cell(funnel, 1, 1, str.tostring(array.get(FUNNEL, 0)), text_size=size.tiny)
        table.cell(funnel, 0, 2, "确认段已走出", text_size=size.tiny)
        table.cell(funnel, 1, 2, str.tostring(array.get(FUNNEL, 1)), text_size=size.tiny)
        table.cell(funnel, 0, 3, "第一道形态", text_size=size.tiny)
        table.cell(funnel, 1, 3, str.tostring(array.get(FUNNEL, 2)), text_size=size.tiny)
        table.cell(funnel, 0, 4, "第二道硬条件", text_size=size.tiny)
        table.cell(funnel, 1, 4, str.tostring(array.get(FUNNEL, 3)), text_size=size.tiny)
        table.cell(funnel, 0, 5, "相似度 ≤ 0.5", text_size=size.tiny)
        table.cell(funnel, 1, 5, str.tostring(array.get(FUNNEL, 4)), text_size=size.tiny)
        table.cell(funnel, 0, 6, "A 级（质量分达标）", text_size=size.tiny)
        table.cell(funnel, 1, 6, str.tostring(array.get(FUNNEL, 5)), text_size=size.tiny)

// ---------------------------------------------------------------- main body
[longSignal, shortSignal] = f_open_signals()
f_fill()
f_resolve()
f_stats()
f_funnel()

// Display only. `ta.*` must run on every bar, so compute first and choose in plot().
float dispSrc = maSource == "收盘价（规则口径）" ? close : hl2
float d20s = ta.sma(dispSrc, 20)
float d20e = ta.ema(dispSrc, 20)
float d60s = ta.sma(dispSrc, 60)
float d60e = ta.ema(dispSrc, 60)
float d120s = ta.sma(dispSrc, 120)
float d120e = ta.ema(dispSrc, 120)
plot(showMAs ? d20s : na, "SMA20", color=#F28E2B, linewidth=1)
plot(showMAs ? d20e : na, "EMA20", color=#E15759, linewidth=1)
plot(showMAs ? d60s : na, "SMA60", color=#59A14F, linewidth=1)
plot(showMAs ? d60e : na, "EMA60", color=#4E79A7, linewidth=1)
plot(showMAs ? d120s : na, "SMA120", color=#B07AA1, linewidth=1)
plot(showMAs ? d120e : na, "EMA120", color=#9C755F, linewidth=1)

alertcondition(longSignal, "密集启动 做多", "均线密集启动 V2：做多信号（收拢后第 5 根收盘）")
alertcondition(shortSignal, "密集启动 做空", "均线密集启动 V2：做空信号（收拢后第 5 根收盘）")
