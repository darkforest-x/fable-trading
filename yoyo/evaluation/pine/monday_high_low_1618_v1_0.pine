//@version=6
// Standalone V1.0, owner screenshot 2026-10-26. Visual reference, no orders.
// NY calendar Monday [00:00 Tue - 24h, Tue 00:00); freeze only complete data.
// Source fields: confirmed time/time_close/high/low within that Monday only.
// Above 5m, inspect every available 5m intrabar, never classify a whole 4H bar.
// Final anchors are drawn retrospectively at the extrema; they were NOT known then.
// https://www.tradingview.com/pine-script-docs/concepts/other-timeframes-and-data/
// https://www.tradingview.com/pine-script-docs/concepts/time/
indicator("周一高低点 · 1.618 V1.0", shorttitle="周一 1.618 V1.0", overlay=true,
     max_lines_count=200, max_labels_count=400)

string tz = input.string("America/New_York", "周一时区", options=["America/New_York", "UTC", "Asia/Shanghai"],
     tooltip="默认纽约当地周一00:00至周二00:00，自动处理夏令时。与图表显示时区无关。", display=display.none)
bool preview = input.bool(true, "显示本周形成中的虚线", tooltip="只用已收盘小周期K线；周一内会变化，结束且数据完整才冻结。", display=display.none)
bool prices = input.bool(true, "显示名称与价格", display=display.none)
bool dots = input.bool(true, "显示高低点起点", display=display.none)
int visibleLimit = input.int(40, "可见区间最多周数", minval=1, maxval=50,
     tooltip="保留已加载历史，拖动图表会重绘可见各周；超限优先较近的周。细周期历史深度受TradingView套餐限制。", display=display.none)
int fade = input.int(55, "历史线淡化（0–90）", minval=0, maxval=90, display=display.none)
color edgeColor = input.color(#63899B, "周一高低点", display=display.none)
color upperColor = input.color(#F23645, "上 1.618", display=display.none)
color lowerColor = input.color(#089981, "下 1.618", display=display.none)
int width = input.int(2, "1.618 线宽", minval=1, maxval=4, display=display.none)
bool diagnostic = input.bool(false, "输出核对日志", display=display.none)

int chartSeconds = int(timeframe.in_seconds())
bool direct = chartSeconds <= 300
bool supported = chart.is_standard and chartSeconds >= 60 and chartSeconds <= 86400 and
     (direct ? 300 % chartSeconds == 0 : chartSeconds % 300 == 0)
if barstate.isfirst and not supported
    runtime.error("请使用标准K线：1/3/5分钟，或5分钟整数倍至1日。周线、合成K线及不对齐周期不适用。")

type WeekRange
    int start
    int finish
    int expires
    float hi = na
    float lo = na
    int hiTime = na
    int loTime = na
    int nextExpected = na
    bool complete = true
    int bars = 0

weekTimes(int t) =>
    int y = year(t, tz)
    int m = month(t, tz)
    int d = dayofmonth(t, tz)
    int offset = (dayofweek(t, tz) + 5) % 7
    [timestamp(tz, y, m, d - offset, 0, 0),
     timestamp(tz, y, m, d - offset + 1, 0, 0),
     timestamp(tz, y, m, d - offset + 7, 0, 0)]

var array<WeekRange> history = array.new<WeekRange>()

// The data ledger is independent of viewport and the drawing budget.
consume(int t, int tc, float h, float l) =>
    if dayofweek(t, tz) == dayofweek.monday
        [start, finish, expires] = weekTimes(t)
        if history.size() == 0 or history.last().start != start
            WeekRange added = WeekRange.new(start, finish, expires)
            added.nextExpected := start
            history.push(added)
        WeekRange r = history.last()
        // Duplicate source bars cannot contribute twice.
        if r.bars == 0 or t >= r.nextExpected
            r.complete := r.complete and t == r.nextExpected and tc <= finish and not na(h) and not na(l)
            if na(r.hi) or h > r.hi
                r.hi := h
                r.hiTime := t
            if na(r.lo) or l < r.lo
                r.lo := l
                r.loTime := t
            r.nextExpected := tc
            r.bars += 1

if direct
    if barstate.isconfirmed
        consume(time, time_close, high, low)
else
    [times, closes, highs, lows] = request.security_lower_tf(syminfo.tickerid, "5", [time, time_close, high, low])
    if times.size() > 0
        for i = 0 to times.size() - 1
            if closes.get(i) <= timenow
                consume(times.get(i), closes.get(i), highs.get(i), lows.get(i))

var array<line> lines = array.new<line>()
var array<label> labels = array.new<label>()
int left = chart.left_visible_bar_time
int right = chart.right_visible_bar_time
int barMs = chartSeconds * 1000
// The live NY midnight can lie INSIDE the open chart candle in winter.
int observedClose = barstate.isrealtime ? timenow : time_close
[currentStart, currentFinish, currentExpires] = weekTimes(observedClose)

drawLevel(WeekRange r, float value, int origin, string title, color base, int thickness, bool forming) =>
    bool old = r.start < currentStart
    color ink = color.new(base, old ? fade : 0)
    int from = math.max(origin, left)
    int until = r.expires
    string tooltip = str.format_time(r.start, "yyyy-MM-dd", tz) + " · " + tz +
         "\n" + title + " = " + str.tostring(value, format.mintick) +
         "\n周一高 " + str.tostring(r.hi, format.mintick) + " / 低 " + str.tostring(r.lo, format.mintick) +
         "\n" + (forming ? "形成中：随已收盘K线更新" : "周一结束后确认；起点回标到极值，不表示当时已知最终值")
    if from < until
        lines.push(line.new(from, value, until, value, xloc=xloc.bar_time,
             color=ink, width=thickness, style=forming ? line.style_dashed : line.style_solid))
        if prices
            int labelAt = math.max(from, math.min(until, right))
            labels.push(label.new(labelAt, value, title + (forming ? " · 形成中" : "") + " (" + str.tostring(value, format.mintick) + ")",
                 xloc=xloc.bar_time, style=label.style_label_lower_right, textalign=text.align_right,
                 color=color.new(base, 100), textcolor=ink, size=size.small, tooltip=tooltip))
        if dots and origin >= left and origin <= right
            labels.push(label.new(origin, value, "•", xloc=xloc.bar_time, style=label.style_none,
                 textcolor=ink, size=size.small, tooltip=tooltip))

var table status = table.new(position.bottom_left, 1, 1)
if barstate.islast
    while lines.size() > 0
        line.delete(lines.pop())
    while labels.size() > 0
        label.delete(labels.pop())
    int shown = 0
    int eligible = 0
    int incomplete = 0
    if history.size() > 0
        for j = 0 to history.size() - 1
            WeekRange r = history.get(history.size() - 1 - j)
            bool intersects = r.expires > left and r.start <= right
            bool forming = r.start == currentStart and observedClose < r.finish
            bool full = r.complete and r.nextExpected == r.finish
            bool valid = r.hi > r.lo and r.complete and (forming ? preview : full)
            if intersects and valid
                eligible += 1
                if shown < visibleLimit
                    float span = r.hi - r.lo
                    drawLevel(r, r.hi, r.hiTime, "周一高", edgeColor, 1, forming)
                    drawLevel(r, r.lo, r.loTime, "周一低", edgeColor, 1, forming)
                    drawLevel(r, r.hi + 0.618 * span, r.hiTime, "上 1.618", upperColor, width, forming)
                    drawLevel(r, r.lo - 0.618 * span, r.loTime, "下 1.618", lowerColor, width, forming)
                    shown += 1
            if intersects and not forming and not full
                incomplete += 1
    string message = eligible > visibleLimit ? "可见周数超限，请缩小范围" : incomplete > 0 ? "部分周一数据不完整，已跳过" : shown == 0 ? "当前窗口无完整周一数据" : ""
    table.cell(status, 0, 0, message, text_color=chart.fg_color, text_size=size.tiny,
         bgcolor=message == "" ? color.new(color.black, 100) : color.new(color.gray, 85))

if diagnostic and (barstate.islastconfirmedhistory or (barstate.islast and barstate.isconfirmed)) and history.size() > 0
    for j = math.max(0, history.size() - 2) to history.size() - 1
        WeekRange r = history.get(j)
        log.info("MONDAY1618 {0} tz={1} high={2} low={3} upper={4} lower={5} bars={6} complete={7} from={8} through={9} expires={10}",
             str.format_time(r.start, "yyyy-MM-dd", tz), tz, str.tostring(r.hi, format.mintick), str.tostring(r.lo, format.mintick),
             str.tostring(r.hi + 0.618 * (r.hi-r.lo), "#.##########"), str.tostring(r.lo - 0.618 * (r.hi-r.lo), "#.##########"),
             r.bars, r.complete and r.nextExpected == r.finish, r.start, r.nextExpected, r.expires)
