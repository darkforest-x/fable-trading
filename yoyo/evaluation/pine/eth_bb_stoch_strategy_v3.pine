//@version=6
// v3 adds ONE owner-requested change to v2 (2026-09-16): a Parabolic RSI
// [ChartPrime] zone gate on NEW ENTRIES ONLY — long needs RSI < 30, short
// needs RSI > 70 on that same confirmed signal bar. RSI line only; the source
// script's SAR flip / strong diamond is a different event and is not used.
// Parabolic RSI [ChartPrime]: https://www.tradingview.com/script/NI0Qhwy7/
// Exits are untouched: the initial 3% stop, the 50% band-touch take profit,
// the break-even runner and the full opposite composite exit still use the
// UNFILTERED v2 signal, so the filter can never hold a losing trade open.
// Everything else is v2: whole candle outside BB, 3% SL, native strategy.
// Signals: original V9 SMA200/population stdev2 + owner Stoch5/3/3 arrows.
// Real fills own the position and drawings. R labels are price-distance R.
// Resting limits solve the developing BB touch exactly using prior N-1 closes.
// See the experiment PROJECT_PLAN for execution timing and synthetic validation.
strategy("ETH BB × Stoch × RSI · 策略 v3", shorttitle="BB×Stoch×RSI v3", overlay=true, pyramiding=0, initial_capital=100000, default_qty_type=strategy.fixed, default_qty_value=1, commission_type=strategy.commission.percent, commission_value=0.1, slippage=0, margin_long=100, margin_short=100, calc_on_every_tick=true, calc_on_order_fills=true, process_orders_on_close=false, max_boxes_count=100, max_lines_count=200, max_labels_count=300, behind_chart=false)

string gb = "布林带"
int bbLength = input.int(200, "BB 长度", minval=3, group=gb)
float bbMult = input.float(2.0, "BB 倍数", minval=0.1, step=0.1, group=gb)
bool showBB = input.bool(false, "显示 BB 通道", group=gb)
bool showBasis = input.bool(false, "显示 BB 中线", group=gb)
string gq = "RSI 区域过滤"
bool useRSI = input.bool(true, "启用 RSI 区域过滤（关闭 = 原 v2）", group=gq)
int rsiLength = input.int(14, "RSI 长度", minval=1, group=gq)
float oversold = input.float(30.0, "超卖：RSI 低于此值才允许做多", minval=0, maxval=100, step=0.5, group=gq)
float overbought = input.float(70.0, "超买：RSI 高于此值才允许做空", minval=0, maxval=100, step=0.5, group=gq)
string gr = "仓位"
float stopPct = input.float(3.0, "初始止损 (%)", minval=0.1, maxval=50, step=0.1, group=gr) / 100
string gv = "显示"
int keepGroups = input.int(15, "保留交易框", minval=1, maxval=30, group=gv)
bool showR = input.bool(true, "显示 1R / 2R / 3R", group=gv)
int labelGap = input.int(2, "提示横向间距 (K线)", minval=1, maxval=8, group=gv)
bool showPanel = input.bool(true, "显示右下角面板", group=gv)
bool selfTest = input.bool(false, "合成自检与样式预览", group="检查", tooltip="禁止真实行情信号和模拟订单，只运行固定算例并绘制两组合成交易。")

color up = #008F82
color down = #D34B66
color ink = chart.fg_color
color faint = color.new(ink, 55)
float src = selfTest ? na : close
float basis = ta.sma(src, bbLength)
float dev = ta.stdev(src, bbLength, true)
float upper = basis + bbMult * dev
float lower = basis - bbMult * dev
float k = ta.sma(ta.stoch(src, selfTest ? na : high, selfTest ? na : low, 5), 3)
float d = ta.sma(k, 3)
bool green = ta.crossover(k, d) and k < 20 and d < 20
bool red = ta.crossunder(k, d) and k > 80 and d > 80

f_signal(float h, float l, float hi, float lo, bool g, bool r) =>
    h < lo and g ? 1 : l > hi and r ? -1 : 0
f_r(int side, float entry, float risk, float price) =>
    risk > 0 ? side * (price - entry) / risk : na
f_rt(float value) =>
    (value > 0 ? "+" : "") + str.tostring(value, "#.##") + "R"
f_px(float value) =>
    str.tostring(value, format.mintick)
// For a developing bar x and fixed preceding N-1 closes, solve x=BB(x).
// This limit can rest BEFORE the wick occurs; no final-bar band is backdated.
f_touch(float meanPrev, float sdPrev, int n, float mult, int side) =>
    meanPrev + side * mult * sdPrev * math.sqrt(n / (n - 1.0 - mult * mult))
f_limit(float value, int side) =>
    (side == 1 ? math.ceil(value / syminfo.mintick) : math.floor(value / syminfo.mintick)) * syminfo.mintick
f_decision(bool confirmed, bool changedByFill, int priorDecision, int thisBar) =>
    confirmed and not changedByFill and (na(priorDecision) or priorDecision != thisBar)
// Same-bar zone test. No remembered oversold state, no extra confirmation bar
// and no SAR direction. Undefined RSI and equality at a threshold do not pass.
f_zone(int side, float value, float lo, float hi, bool active) =>
    not active ? side : na(value) ? 0 : side == 1 and value < lo ? 1 : side == -1 and value > hi ? -1 : 0
if bbLength <= 1 + bbMult * bbMult
    runtime.error("BB 长度必须大于 1 + 倍数²，才能计算盘中触轨价。")
if oversold >= overbought
    runtime.error("超卖阈值必须小于超买阈值。")
float nextMean = ta.sma(src, bbLength - 1)
float nextSd = ta.stdev(src, bbLength - 1, true)
float nextUpperTouch = f_limit(f_touch(nextMean, nextSd, bbLength, bbMult, 1), 1)
float nextLowerTouch = f_limit(f_touch(nextMean, nextSd, bbLength, bbMult, -1), -1)
bool chartOK = syminfo.ticker == "ETHUSDT.P" and syminfo.basecurrency == "ETH" and syminfo.currency == "USDT" and timeframe.isminutes and timeframe.multiplier == 5 and chart.is_standard
int sig = selfTest or not chartOK ? 0 : f_signal(high, low, upper, lower, green, red)
// ChartPrime's RSI line is ta.rsi(close, len); selfTest feeds na and blocks it.
float rsi = ta.rsi(src, rsiLength)
int entrySig = f_zone(sig, rsi, oversold, overbought, useRSI)

// varip facts survive realtime rollback. Fill recalculations MUST NOT consume
// historical final H/L/C for new entries or for updating the next-bar target.
varip float seenSize = 0.0
varip int seenClosed = 0
varip int lastDecisionBar = na
varip int queuedEntry = 0
varip float pendingUpper = na
varip float pendingLower = na
varip float entryPrice = na
varip float fullQty = na
varip float risk = na
varip bool partial = false
varip bool halfStopped = false
varip float lastPriceR = na
bool fillPass = strategy.position_size != seenSize or strategy.closedtrades != seenClosed
bool newPosition = strategy.position_size != 0 and (seenSize == 0 or math.sign(strategy.position_size) != math.sign(seenSize))
if newPosition
    entryPrice := strategy.position_avg_price
    fullQty := math.abs(strategy.position_size)
    risk := entryPrice * stopPct
    partial := false
    halfStopped := false
if strategy.closedtrades > seenClosed
    for i = seenClosed to strategy.closedtrades - 1
        string reason = strategy.closedtrades.exit_comment(i)
        float oldEntry = strategy.closedtrades.entry_price(i)
        int oldSide = strategy.closedtrades.size(i) > 0 ? 1 : -1
        lastPriceR := f_r(oldSide, oldEntry, oldEntry * stopPct, strategy.closedtrades.exit_price(i))
        if reason == "TP50%"
            partial := true
        if reason == "SL50%"
            halfStopped := true
bool decisionClose = f_decision(barstate.isconfirmed, fillPass, lastDecisionBar, bar_index)
bool reverseNow = false
if not selfTest and chartOK and not na(nextUpperTouch) and decisionClose
    lastDecisionBar := bar_index
    // These bands belong to the next bar. This block never runs on fill passes.
    pendingUpper := nextUpperTouch
    pendingLower := nextLowerTouch
    int sideNow = strategy.position_size > 0 ? 1 : strategy.position_size < 0 ? -1 : 0
    reverseNow := sideNow != 0 and sig == -sideNow
    if reverseNow
        strategy.cancel_all()
        strategy.close(sideNow == 1 ? "L" : "S", comment="REV", immediately=true)
    // Only this line is filtered. reverseNow above keeps the raw v2 exit.
    if entrySig != 0 and (sideNow == 0 or reverseNow)
        queuedEntry := entrySig

// Wait for the immediate close's fill callback before issuing a reverse entry.
// Otherwise strategy.entry may include the still-open old size in its order.
if not selfTest and queuedEntry != 0 and strategy.position_size == 0
    strategy.entry(queuedEntry == 1 ? "L" : "S", queuedEntry == 1 ? strategy.long : strategy.short, comment=queuedEntry == 1 ? "L" : "S")
    queuedEntry := 0

// Two independent reserved tranches. A first-half stop is not a TP and must
// never move the runner to BE or recreate a half-position exit order.
if not selfTest and strategy.position_size != 0 and not reverseNow
    int sideNow = strategy.position_size > 0 ? 1 : -1
    float stopNow = entryPrice - sideNow * risk
    float targetNow = sideNow == 1 ? pendingUpper : pendingLower
    string entryId = sideNow == 1 ? "L" : "S"
    if not partial and not halfStopped
        strategy.exit("HALF", from_entry=entryId, qty=fullQty * 0.5, limit=targetNow, stop=stopNow, oca_name="HALF", comment_profit="TP50%", comment_loss="SL50%")
    strategy.exit("TAIL", from_entry=entryId, qty=fullQty * 0.5, stop=partial ? entryPrice : stopNow, oca_name="TAIL", comment_loss=partial ? "BE" : "SL")
seenSize := strategy.position_size
seenClosed := strategy.closedtrades

// Rebuild drawings from the broker ledger, so partial exits and reverse fills
// cannot leave an old reference box extending forever or an intrabar label lost.
// One View groups a full position and its two native closed-trade records.
int barMillis = int(timeframe.in_seconds() * 1000)
int textMillis = labelGap * barMillis

type View
    int entryTime
    int side
    float entry
    float initialRisk
    int endTime
    float endPrice
    string reason
    bool live = false
    int tpTime = na
    float tpPrice = na

var array<box> drawnBoxes = array.new<box>()
var array<line> drawnLines = array.new<line>()
var array<label> drawnLabels = array.new<label>()
f_text(int x, float y, string caption, color tone, string align) =>
    array.push(drawnLabels, label.new(x, y, caption, xloc=xloc.bar_time, style=label.style_none, textcolor=tone, size=size.small, textalign=align, force_overlay=true))
f_line(int left, float price, int right, color tone, string style) =>
    array.push(drawnLines, line.new(left, price, right, price, xloc=xloc.bar_time, color=tone, style=style, force_overlay=true))
f_draw(View v) =>
    int right = v.live ? time + textMillis * 3 : v.endTime
    float sl = v.entry - v.side * v.initialRisk
    float reward = v.live and na(v.tpTime) ? (v.side == 1 ? pendingUpper : pendingLower) : v.endPrice
    if selfTest
        reward := v.endPrice
    float rewardEdge = v.entry + v.side * math.max(v.side * (reward - v.entry), 0)
    array.push(drawnBoxes, box.new(v.entryTime, math.max(v.entry, sl), right, math.min(v.entry, sl), xloc=xloc.bar_time, border_color=color.new(down, 72), bgcolor=color.new(down, 93), force_overlay=true))
    array.push(drawnBoxes, box.new(v.entryTime, math.max(v.entry, rewardEdge), right, math.min(v.entry, rewardEdge), xloc=xloc.bar_time, border_color=color.new(up, 68), bgcolor=color.new(up, 93), force_overlay=true))
    f_line(v.entryTime, v.entry, right, color.new(ink, 65), line.style_dotted)
    f_line(v.entryTime, sl, na(v.tpTime) ? right : v.tpTime, color.new(down, 40), line.style_solid)
    f_text(v.entryTime, sl - v.side * v.initialRisk * 0.20, v.side == 1 ? "L" : "S", v.side == 1 ? up : down, text.align_left)
    f_text(v.entryTime + textMillis, sl - v.side * v.initialRisk * 0.07, "SL", down, text.align_left)
    if showR
        for level = 1 to 3
            float price = v.entry + v.side * v.initialRisk * level
            f_line(v.entryTime, price, right, color.new(up, 82), line.style_dotted)
            f_text(v.entryTime + textMillis, price + v.side * v.initialRisk * 0.06, str.tostring(level) + "R", color.new(up, 15), text.align_left)
    if not na(v.tpTime)
        f_line(v.tpTime, v.entry, right, color.new(up, 40), line.style_dashed)
        f_text(v.tpTime - textMillis, v.tpPrice + v.side * v.initialRisk * 0.16, "TP50%", up, text.align_right)
        f_text(v.tpTime + textMillis, v.entry - v.side * v.initialRisk * 0.13, "BE", up, text.align_left)
    if v.live
        f_text(right + textMillis, v.endPrice, f_rt(f_r(v.side, v.entry, v.initialRisk, v.endPrice)), ink, text.align_left)
    else
        string exitWord = v.reason == "REV" ? "REV" : v.reason == "BE" ? "BE" : "SL"
        f_text(right + textMillis, v.endPrice + v.side * v.initialRisk * 0.08, exitWord + " " + f_rt(f_r(v.side, v.entry, v.initialRisk, v.endPrice)), v.reason == "SL" or v.reason == "SL50%" ? down : up, text.align_left)

// Fixed numerical fixtures; no market series is used in their arithmetic.
bool signalsPass = f_signal(98, 95, 102, 99, true, false) == 1 and f_signal(99, 95, 102, 99, true, false) == 0 and f_signal(100, 97, 102, 99, true, false) == 0 and f_signal(105, 103, 102, 99, false, true) == -1 and f_signal(105, 102, 102, 99, false, true) == 0 and f_signal(98, 95, 102, 99, false, false) == 0
float fixtureTouch = f_touch(100, 3, 200, 2, 1)
float fixtureMean = (199 * 100 + fixtureTouch) / 200
float fixtureVariance = (199 * 9 + 199.0 / 200 * math.pow(fixtureTouch - 100, 2)) / 200
bool touchPass = math.abs(fixtureTouch - (fixtureMean + 2 * math.sqrt(fixtureVariance))) < 0.0000001
float undefinedRSI = na
bool zonePass = f_zone(1, 29.99, 30, 70, true) == 1 and f_zone(1, 30, 30, 70, true) == 0 and f_zone(1, 85, 30, 70, true) == 0 and f_zone(-1, 70.01, 30, 70, true) == -1 and f_zone(-1, 70, 30, 70, true) == 0 and f_zone(-1, 12, 30, 70, true) == 0 and f_zone(1, undefinedRSI, 30, 70, true) == 0 and f_zone(0, 12, 30, 70, true) == 0 and f_zone(1, 85, 30, 70, false) == 1 and f_zone(-1, 12, 30, 70, false) == -1
bool riskPass = math.abs(f_r(1, 100, 3, 106) - 2) < 0.0000001 and math.abs(f_r(-1, 100, 3, 94) - 2) < 0.0000001
bool decisionPass = f_decision(true, false, 10, 11) and not f_decision(true, true, 10, 11) and not f_decision(false, false, 10, 11) and not f_decision(true, false, 11, 11)
if selfTest and not (signalsPass and touchPass and riskPass and decisionPass and zonePass)
    runtime.error("BB Stoch v2 synthetic check failed")

if barstate.islast
    while array.size(drawnBoxes) > 0
        box.delete(array.pop(drawnBoxes))
    while array.size(drawnLines) > 0
        line.delete(array.pop(drawnLines))
    while array.size(drawnLabels) > 0
        label.delete(array.pop(drawnLabels))
    array<View> views = array.new<View>()
    if selfTest
        // Layout-only, fixed prices and bar-relative positions; no trade orders.
        array.push(views, View.new(time - 105 * barMillis, 1, 2400, 72, time - 65 * barMillis, 2544, "REV", false, time - 87 * barMillis, 2472))
        array.push(views, View.new(time - 50 * barMillis, -1, 2530, 75.9, time - 12 * barMillis, 2530, "BE", false, time - 31 * barMillis, 2454.1))
    else
        if strategy.opentrades > 0
            int openSide = strategy.position_size > 0 ? 1 : -1
            float openEntry = strategy.opentrades.entry_price(0)
            array.push(views, View.new(strategy.opentrades.entry_time(0), openSide, openEntry, openEntry * stopPct, time, close, "", true))
        if strategy.closedtrades > 0
            int oldest = math.max(strategy.closedtrades.first_index, strategy.closedtrades - keepGroups * 2 - 2)
            for i = strategy.closedtrades - 1 to oldest
                int eb = strategy.closedtrades.entry_time(i)
                int side = strategy.closedtrades.size(i) > 0 ? 1 : -1
                View v = array.size(views) > 0 ? array.get(views, array.size(views) - 1) : na
                bool same = not na(v) and v.entryTime == eb and v.side == side
                if not same
                    if array.size(views) >= keepGroups
                        break
                    float ep = strategy.closedtrades.entry_price(i)
                    v := View.new(eb, side, ep, ep * stopPct, strategy.closedtrades.exit_time(i), strategy.closedtrades.exit_price(i), strategy.closedtrades.exit_comment(i))
                    array.push(views, v)
                if strategy.closedtrades.exit_comment(i) == "TP50%"
                    v.tpTime := strategy.closedtrades.exit_time(i)
                    v.tpPrice := strategy.closedtrades.exit_price(i)
        // A live runner's first partial is paired above with the same entry bar.
    if array.size(views) > 0
        for v in views
            f_draw(v)

plot(rsi, "RSI", display=display.data_window)
plot(sig, "原始信号（1多/-1空）", display=display.data_window)
plot(entrySig, "过滤后入场信号（1多/-1空）", display=display.data_window)
p1 = plot(showBB and not selfTest ? upper : na, "BB 上轨", color.new(ink, 50))
p2 = plot(showBB and not selfTest ? lower : na, "BB 下轨", color.new(ink, 50))
plot(showBB and showBasis and not selfTest ? basis : na, "BB 中线", color.new(ink, 75))
fill(p1, p2, showBB and not selfTest ? color.new(up, 97) : na, title="BB 通道")
var table panel = table.new(position.bottom_right, 2, 5, bgcolor=color.new(chart.bg_color, 15), border_width=0)
if barstate.islast and showPanel
    int ps = strategy.position_size > 0 ? 1 : strategy.position_size < 0 ? -1 : 0
    string positionCaption = ps == 0 ? "空仓" : (ps == 1 ? "L " : "S ") + (partial ? "50%" : "100%")
    float currentR = ps == 0 ? lastPriceR : f_r(ps, entryPrice, risk, close)
    table.cell(panel, 0, 0, "BB × Stoch v2", text_color=ink, text_size=size.small)
    table.cell(panel, 1, 0, selfTest ? "合成预览" : chartOK ? "5m" : "请用 ETHUSDT.P 5m", text_color=chartOK ? up : down, text_size=size.small)
    table.cell(panel, 0, 1, "仓位", text_color=faint, text_size=size.small)
    table.cell(panel, 1, 1, selfTest ? "SELFTEST PASS" : positionCaption, text_color=up, text_size=size.small)
    table.cell(panel, 0, 2, "价格 R", text_color=faint, text_size=size.small)
    table.cell(panel, 1, 2, selfTest or na(currentR) ? "—" : f_rt(currentR), text_color=ink, text_size=size.small)
    table.cell(panel, 0, 3, ps != 0 and partial ? "BE" : "SL", text_color=faint, text_size=size.small)
    table.cell(panel, 1, 3, ps == 0 ? "—" : f_px(partial ? entryPrice : entryPrice - ps * risk), text_color=partial ? up : down, text_size=size.small)
    float shownRSI = barstate.isconfirmed ? rsi : rsi[1]
    string zoneWord = not useRSI ? "已关闭" : na(shownRSI) ? "预热中" : shownRSI < oversold ? "超卖·可做多" : shownRSI > overbought ? "超买·可做空" : "中间区·不新开"
    table.cell(panel, 0, 4, "RSI 过滤", text_color=faint, text_size=size.small)
    table.cell(panel, 1, 4, selfTest or na(shownRSI) ? zoneWord : str.tostring(shownRSI, "#.0") + " " + zoneWord, text_color=useRSI ? ink : faint, text_size=size.small)
