    {
      "id": "oss.qlib.kmid2",
      "name": "实体占比（带方向）",
      "category": "candle_structure",
      "definition": "当根带方向实体 / 当根振幅。",
      "expression": "(close-open)/(high-low+1e-12)",
      "inputs": [
        "open",
        "high",
        "low",
        "close"
      ],
      "lookback_bars": 1,
      "warmup_bars": 1,
      "implementation_version": "1.0.0",
      "status": "implemented",
      "stage": "hypothesis",
      "source_path": "yoyo/research_workspace/open_factors.py",
      "experiment_ids": [],
      "causality": "单标的、单周期、已收盘 K 线；最多使用截至当前根的 1 根。若输入索引为开盘时间，仍需等本根收盘才能使用。窗口包含当前根。尚未检验收益或生产适用性。",
      "adaptation": "保留 Qlib 原始当根公式及 1e-12 分母保护；不做全样本归一化、缺失填充或空头翻转。",
      "hypothesis": "识别密集区离开时是否出现有方向的实体，而非仅有影线。",
      "redundant_with": [],
      "upstream": {
        "project": "Qlib Alpha158",
