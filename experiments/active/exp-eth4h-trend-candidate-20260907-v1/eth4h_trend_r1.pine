//@version=5
//@strategy_alert_message {{strategy.order.alert_message}}
// Research candidate. Defaults match the Python S5 contract; no live deployment.
strategy("ETH 4H Trend R1 - research", overlay=true, initial_capital=500,
     pyramiding=0, default_qty_type=strategy.fixed, calc_on_every_tick=false,
     calc_on_order_fills=false, process_orders_on_close=false,
     commission_type=strategy.commission.percent, commission_value=0.10,
     slippage=0, margin_long=100, margin_short=100, use_bar_magnifier=false)

int analysisStart = input.time(timestamp("2021-01-01T00:00:00Z"), "Research start UTC")
int requestedEnd = input.time(timestamp("2026-05-01T00:00:00Z"), "Research end UTC, exclusive")
int analysisEnd = math.min(requestedEnd, timestamp("2026-05-01T00:00:00Z"))
if barstate.isfirst and (timeframe.period != "240" or syminfo.tickerid != "BINANCE:ETHUSDT.P")
    runtime.error("Use ordinary BINANCE:ETHUSDT.P 4h candles. Other feeds are unvalidated.")

// All windows end at the current confirmed bar. Original signal parameters.
float fastMa = ta.sma(hl2, 10)
float slowMa = ta.sma(hl2, 60)
float regimeMa = ta.ema(close, 100)
float atr = ta.atr(14)
float diff = hl2 - ta.sma(hl2, 40)
float p99 = ta.percentile_linear_interpolation(diff, 200, 99)
float ratio = not na(p99) and p99 != 0 ? diff / p99 : 0.0
float osc = ta.hma(ratio - ratio[10], 10)
bool rawLong = ta.crossover(fastMa, slowMa) and close > slowMa and close > regimeMa and osc > 0.2 and osc > osc[1]
bool rawShort = ta.crossunder(fastMa, slowMa) and close < slowMa and close < regimeMa and osc < -0.2 and osc < osc[1]
float atrPct = atr / close * 100
bool calendarAllowed = dayofweek(time, "UTC") != dayofweek.sunday and not (hour(time, "UTC") >= 21 and hour(time, "UTC") < 23)
bool volatilityAllowed = atrPct >= 0.1 and atrPct <= 10.0
bool rangeAllowed = time >= analysisStart and time_close < analysisEnd

// Fresh cooldown state: prices never decide retroactive order submission.
var int tradesToSkip = 0
if strategy.closedtrades > nz(strategy.closedtrades[1])
    int k = strategy.closedtrades - 1
    float notional = math.abs(strategy.closedtrades.entry_price(k) * strategy.closedtrades.size(k))
    float tradePct = notional > 0 ? strategy.closedtrades.profit(k) / notional * 100 : 0.0
    if tradePct > 20.0
        tradesToSkip := 7
    else if tradePct > 2.0
        tradesToSkip := 1
bool skipped = (rawLong or rawShort) and tradesToSkip > 0
if skipped
    tradesToSkip -= 1
bool common = barstate.isconfirmed and rangeAllowed and calendarAllowed and volatilityAllowed and not skipped
bool longSignal = common and rawLong
bool shortSignal = common and rawShort

// 0.5% equity price-stop risk, max1x notional. Fees/gaps are additional risk.
float distance = math.min(atr * 4.0, close * 0.03)
float leverage = distance > 0 ? math.min(1.0, 0.005 / (distance / close)) : 0.0
float quantity = math.max(strategy.equity, 0) * leverage / close

// Every entry has its own ID and pre-submitted absolute-price stop.
var string pendingId = ""
var float pendingStop = na
var string activeId = ""
var float activeStop = na
bool hasPosition = strategy.position_size != 0
if hasPosition
    string observedId = strategy.opentrades.entry_id(strategy.opentrades - 1)
    if observedId != activeId
        activeId := observedId
        activeStop := pendingStop
else
    activeId := ""
    activeStop := na

if longSignal or shortSignal
    int side = longSignal ? 1 : -1
    float proposed = close - side * distance
    if not hasPosition and quantity > 0
        pendingId := (side > 0 ? "L-" : "S-") + str.tostring(time)
        pendingStop := proposed
        strategy.entry(pendingId, side > 0 ? strategy.long : strategy.short, qty=quantity,
             alert_message=side > 0 ? "ETH4H R1 OPEN LONG - research" : "ETH4H R1 OPEN SHORT - research")
        strategy.exit("X-" + pendingId, from_entry=pendingId, stop=pendingStop,
             alert_message="ETH4H R1 INITIAL STOP - research")
    else if strategy.position_size * side > 0
        activeStop := side > 0 ? math.max(activeStop, proposed) : math.min(activeStop, proposed)
    else if hasPosition
        // Close-only prevents a second position being created by reverse sizing.
        strategy.close(activeId, comment="Opposite signal", alert_message="ETH4H R1 CLOSE - research")

if hasPosition and not na(activeStop)
    float entry = strategy.position_avg_price
    if strategy.position_size > 0 and high > entry * 1.015
        activeStop := math.max(activeStop, entry * 1.001)
    if strategy.position_size < 0 and low < entry * 0.985
        activeStop := math.min(activeStop, entry * 0.999)
    strategy.exit("X-" + activeId, from_entry=activeId, stop=activeStop,
         alert_message="ETH4H R1 MANAGED STOP - research")

// This administrative boundary is included in the Python research accounting.
if barstate.isconfirmed and time < analysisEnd and time_close >= analysisEnd
    strategy.cancel_all()
    strategy.close_all(comment="Research end", immediately=true)

plot(fastMa, "SMA10", color=color.new(color.teal, 15))
plot(slowMa, "SMA60", color=color.new(color.orange, 15))
plot(regimeMa, "EMA100", color=color.new(color.gray, 35))
plot(hasPosition ? activeStop : na, "Active stop", color=color.red, style=plot.style_linebr)
plotshape(longSignal and not hasPosition, "Long request", shape.triangleup, location.belowbar, color.teal, size=size.tiny)
plotshape(shortSignal and not hasPosition, "Short request", shape.triangledown, location.abovebar, color.orange, size=size.tiny)
var table info = table.new(position.bottom_right, 2, 3)
if barstate.islast
    table.cell(info, 0, 0, "ETH 4H R1")
    table.cell(info, 1, 0, "RESEARCH")
    table.cell(info, 0, 1, "Planned risk")
    table.cell(info, 1, 1, "0.5% / max1x")
    table.cell(info, 0, 2, "Date scope")
    table.cell(info, 1, 2, "Before May2026")
