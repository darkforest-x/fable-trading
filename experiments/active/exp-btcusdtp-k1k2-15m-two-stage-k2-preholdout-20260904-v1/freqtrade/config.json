{
  "$schema": "https://schema.freqtrade.io/schema.json",
  "bot_name": "fable-two-stage-k2-research",
  "strategy": "FableTwoStageK2",
  "timeframe": "15m",
  "max_open_trades": 1,
  "stake_currency": "USDT",
  "stake_amount": 1000,
  "tradable_balance_ratio": 0.99,
  "dry_run": true,
  "dry_run_wallet": 1000000,
  "trading_mode": "futures",
  "margin_mode": "isolated",
  "futures_funding_rate": 0.0,
  "minimal_roi": {
    "0": 1000.0
  },
  "stoploss": -0.99,
  "trailing_stop": false,
  "use_exit_signal": false,
  "exit_profit_only": false,
  "ignore_roi_if_entry_signal": false,
  "unfilledtimeout": {
    "entry": 10,
    "exit": 10,
    "exit_timeout_count": 0,
    "unit": "minutes"
  },
  "entry_pricing": {
    "price_side": "same",
    "use_order_book": false,
    "order_book_top": 1,
    "price_last_balance": 0.0,
    "check_depth_of_market": {
      "enabled": false,
      "bids_to_ask_delta": 1
    }
  },
  "exit_pricing": {
    "price_side": "same",
    "use_order_book": false,
    "order_book_top": 1,
    "price_last_balance": 0.0
  },
  "order_types": {
    "entry": "market",
    "exit": "market",
    "emergency_exit": "market",
    "force_exit": "market",
    "force_entry": "market",
    "stoploss": "market",
    "stoploss_on_exchange": false
  },
  "order_time_in_force": {
    "entry": "GTC",
    "exit": "GTC"
  },
  "pairlists": [
    {
      "method": "StaticPairList"
    }
  ],
  "exchange": {
    "name": "okx",
    "key": "",
    "secret": "",
    "password": "",
    "ccxt_config": {
      "options": {
        "defaultType": "swap"
      }
    },
    "ccxt_async_config": {},
    "pair_whitelist": [
      "BTC/USDT:USDT"
    ],
    "pair_blacklist": []
  },
  "telegram": {
    "enabled": false
  },
  "api_server": {
    "enabled": false
  },
  "internals": {
    "process_throttle_secs": 5
  },
  "dataformat_ohlcv": "json",
  "dataformat_trades": "json"
}
