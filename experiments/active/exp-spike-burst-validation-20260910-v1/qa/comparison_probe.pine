//@version=6
// Synthetic comparison semantics only. No market-dependent conditions, orders,
// alerts, input fitting, or production indicator changes.
indicator("SPIKE · float comparison probe", overlay=false)
float z = float(bar_index) * 0.0
var table result = table.new(position.middle_center, 3, 20, bgcolor=#111827, border_width=1)
f_row(int row, string name, bool actual, bool expected) =>
    bool ok = actual == expected
    table.cell(result, 0, row, name, text_color=color.white, text_size=size.small)
    table.cell(result, 1, row, str.tostring(actual), text_color=ok ? color.lime : color.red, text_size=size.small)
    table.cell(result, 2, row, str.tostring(expected), text_color=color.silver, text_size=size.small)
    ok ? 1 : 0
if barstate.islast
    table.cell(result, 0, 0, "Synthetic comparison", text_color=color.white)
    table.cell(result, 1, 0, "Native", text_color=color.white)
    table.cell(result, 2, 0, "Round9 / tie up", text_color=color.white)
    int passed = 0
    passed += f_row(1, "+0.49e-9 > 0", z + 0.49e-9 > 0.0, false)
    passed += f_row(2, "+0.51e-9 > 0", z + 0.51e-9 > 0.0, true)
    passed += f_row(3, "-0.49e-9 < 0", z - 0.49e-9 < 0.0, false)
    passed += f_row(4, "-0.51e-9 < 0", z - 0.51e-9 < 0.0, true)
    passed += f_row(5, "+0.50e-9 > 0 [tie]", z + 0.50e-9 > 0.0, true)
    passed += f_row(6, "+2.50e-9 > 2e-9 [tie]", z + 2.50e-9 > 2e-9, true)
    passed += f_row(7, "-0.50e-9 >= 0 [tie]", z - 0.50e-9 >= 0.0, true)
    passed += f_row(8, "-1.50e-9 >= -1e-9 [tie]", z - 1.50e-9 >= -1e-9, true)
    passed += f_row(9, "-2.50e-9 >= -2e-9 [tie]", z - 2.50e-9 >= -2e-9, true)
    passed += f_row(10, "100 + 0.4e-9 > 100", z + 100.0000000004 > 100.0, false)
    passed += f_row(11, "100 + 0.6e-9 > 100", z + 100.0000000006 > 100.0, true)
    passed += f_row(12, "tiny MA difference <= 0", (z + 0.0000010004) - 0.000001 <= 0.0, true)
    passed += f_row(13, "price 1.0004e-6 > 1e-6", z + 0.0000010004 > 0.000001, false)
    passed += f_row(14, "RV 3.9999999996 >= 4", z + 3.9999999996 >= 4.0, true)
    passed += f_row(15, "tick 1e-10 > 0", z + 1e-10 > 0.0, false)
    passed += f_row(16, "tick 1e-9 > 0", z + 1e-9 > 0.0, true)
    passed += f_row(17, "low=stop+0.4e-9 <= stop", z + 0.0000100004 <= 0.00001, true)
    table.cell(result, 0, 19, "Native matched " + str.tostring(passed) + "/17", text_color=passed == 17 ? color.lime : color.orange)
    table.cell(result, 1, 19, "Record all rows", text_color=color.white)
    table.cell(result, 2, 19, "No returns", text_color=color.white)
plot(na, display=display.none)
