//@version=6
// High-recall 15m research display. Not a validated profitable strategy.
// EMA30(HL2) identifies direct crossings, physical rejections, and compressed
// releases. A signal re-arms only after three bars without the same directional
// state. Entry/risk visualization starts at the next bar open. The initial
// disaster stop is 2 ATR14; after a completed close reaches +2 ATR, the active
// stop follows SMA60(HL2) minus/plus 1 ATR from the following bar.
indicator(
     "Fable 15m Trend · Research V2",
     shorttitle = "Fable 15m Trend V2",
     overlay = true,
     behind_chart = false,
     max_bars_back = 600,
     max_labels_count = 300,
     max_boxes_count = 200)

string GROUP_RULE = "1 · Signal"
string GROUP_RISK = "2 · Trend management"
string GROUP_DISPLAY = "3 · Display"
string GROUP_ALERTS = "4 · Alerts"

string sideMode = input.string(
     "Both", "Direction", options = ["Both", "Long only", "Short only"], group = GROUP_RULE)
bool requireHighScore = input.bool(
     false,
     "High-score launches only",
     tooltip = "Off by default so obvious 15m transitions are not hidden. This is a display filter, not a validated profitability gate.",
     group = GROUP_RULE)
float highScoreMin = input.float(
     0.72, "High-score minimum", minval = 0.0, maxval = 1.0, step = 0.01, group = GROUP_RULE)

float disasterStopAtr = input.float(
     2.0, "Initial stop (ATR)", minval = 0.5, maxval = 6.0, step = 0.25, group = GROUP_RISK)
float runnerArmAtr = input.float(
     2.0, "Arm runner after close profit (ATR)", minval = 0.5, maxval = 8.0, step = 0.25, group = GROUP_RISK)
float runnerBufferAtr = input.float(
     1.0, "SMA60 stop buffer (ATR)", minval = 0.0, maxval = 4.0, step = 0.25, group = GROUP_RISK)
int maxHoldBars = input.int(96, "Maximum hold bars", minval = 8, maxval = 400, group = GROUP_RISK)
float rewardGuideAtr = input.float(
     5.0,
     "Reward guide (ATR, visual only)",
     minval = 1.0,
     maxval = 20.0,
     step = 0.5,
     tooltip = "The green zone is a visual trend guide. It is not a fixed take-profit order.",
     group = GROUP_RISK)

bool showMainMa = input.bool(true, "EMA30 · main", group = GROUP_DISPLAY)
bool showGlow = input.bool(false, "EMA30 · glow", group = GROUP_DISPLAY)
bool showTrendMa = input.bool(true, "SMA60 · runner", group = GROUP_DISPLAY)
bool colourBars = input.bool(true, "MA Shift candles · source", group = GROUP_DISPLAY)
bool showKeyTags = input.bool(true, "K1 / K2 tags", group = GROUP_DISPLAY)
bool showSignals = input.bool(true, "L / S signals", group = GROUP_DISPLAY)
bool showZones = input.bool(true, "Reward / risk zones", group = GROUP_DISPLAY)
bool showActiveStop = input.bool(true, "Active trend stop", group = GROUP_DISPLAY)
int zoneProjection = input.int(12, "Zone width", minval = 2, maxval = 96, group = GROUP_DISPLAY)
bool showPanel = input.bool(true, "Tiny status chip", group = GROUP_DISPLAY)
bool alertsEnabled = input.bool(true, "Signal alerts", group = GROUP_ALERTS)

float atr14 = ta.atr(14)
float ema30 = ta.ema(hl2, 30)
float sma60 = ta.sma(hl2, 60)
int maSide = hl2 >= ema30 ? 1 : -1

f_clamp(float value, float lowValue, float highValue) =>
    math.max(lowValue, math.min(highValue, nz(value, lowValue)))

// Returns raw state, direct, rejection, coil, composite quality.
f_launchState(int direction) =>
    float safeAtr = atr14 > 0.0 ? atr14 : na
    float candleRange = high - low
    float signedClose = direction * (close - ema30) / safeAtr
    float previousSignedClose = direction * (close[1] - ema30[1]) / atr14[1]
    float signedSlope = direction * (ema30 - ema30[4]) / (safeAtr * 4.0)
    float signedBody = direction * (close - open) / safeAtr
    float rangeAtr = candleRange / safeAtr
    float closeLocation =
         candleRange > 0.0 ?
         (direction == 1 ? (close - low) / candleRange : (high - close) / candleRange) : na
    float priorHigh = ta.highest(high[1], 8)
    float priorLow = ta.lowest(low[1], 8)
    float breakoutAtr = direction * (close - (direction == 1 ? priorHigh : priorLow)) / safeAtr
    float nearNow = math.abs((close - ema30) / safeAtr) <= 0.8 ? 1.0 : 0.0
    float priorNearShare = ta.sma(nearNow, 8)[1]
    float priorRangeAtr = (priorHigh - priorLow) / safeAtr
    bool finite =
         not na(signedClose) and not na(previousSignedClose) and not na(signedSlope) and
         not na(signedBody) and not na(rangeAtr) and not na(closeLocation)
    bool direct =
         finite and previousSignedClose <= 0.10 and signedClose >= 0.10 and
         signedBody >= 0.20 and rangeAtr >= 0.65 and closeLocation >= 0.60 and
         signedSlope >= -0.04
    bool touched = direction == 1 ? low <= ema30 : high >= ema30
    bool rejection =
         finite and touched and signedClose >= 0.05 and signedBody >= 0.10 and
         closeLocation >= 0.65 and signedSlope >= -0.03
    bool coil =
         finite and not na(breakoutAtr) and not na(priorNearShare) and
         signedClose >= 0.15 and breakoutAtr >= 0.05 and signedBody >= 0.25 and
         rangeAtr >= 0.70 and closeLocation >= 0.60 and priorNearShare >= 0.50 and
         priorRangeAtr <= 2.75 and signedSlope >= -0.03
    float score = (
         f_clamp(signedClose / 0.75, 0.0, 1.0) +
         f_clamp(signedBody / 1.25, 0.0, 1.0) +
         f_clamp(closeLocation, 0.0, 1.0) +
         f_clamp((signedSlope + 0.04) / 0.14, 0.0, 1.0)) / 4.0
    [direct or rejection or coil, direct, rejection, coil, score]

[longRawBase, longDirect, longReject, longCoil, longScore] = f_launchState(1)
[shortRawBase, shortDirect, shortReject, shortCoil, shortScore] = f_launchState(-1)

bool isFifteenMinute = timeframe.in_seconds() == 900
bool longAllowed = sideMode != "Short only"
bool shortAllowed = sideMode != "Long only"
bool longRaw =
     isFifteenMinute and longAllowed and longRawBase and
     (not requireHighScore or longScore >= highScoreMin)
bool shortRaw =
     isFifteenMinute and shortAllowed and shortRawBase and
     (not requireHighScore or shortScore >= highScoreMin)

// State-transition de-duplication: a new episode needs three false bars.
bool longSignal = barstate.isconfirmed and longRaw and not longRaw[1] and not longRaw[2] and not longRaw[3]
bool shortSignal = barstate.isconfirmed and shortRaw and not shortRaw[1] and not shortRaw[2] and not shortRaw[3]

color MA_UP = #17A297
color MA_DOWN = color.orange
color KEY_LONG = #00D7BD
color KEY_SHORT = #FFB020
color REWARD = #089981
color RISK = #F23645
color NEUTRAL = #787B86
color maColour = maSide == 1 ? MA_UP : MA_DOWN

// Exact source style: body, wick, border, and the thin main line share state colour.
plot(showMainMa ? ema30 : na, "EMA30 · main", color = maColour, linewidth = 1)
plot(
     showGlow ? ema30 : na,
     "EMA30 · glow",
     color = color.new(maColour, 80),
     linewidth = 7,
     display = display.none)
plot(
     showTrendMa ? sma60 : na,
     "SMA60 · runner",
     color = color.new(maColour, 35),
     linewidth = 1)
barcolor(colourBars and not na(ema30) ? maColour : na, title = "MA Shift bar colour · source")
plotcandle(
     colourBars and not na(ema30) ? open : na,
     colourBars and not na(ema30) ? high : na,
     colourBars and not na(ema30) ? low : na,
     colourBars and not na(ema30) ? close : na,
     title = "MA Shift candles · source",
     color = maColour,
     wickcolor = maColour,
     bordercolor = maColour)

color keyColour = longSignal ? KEY_LONG : shortSignal ? KEY_SHORT : na
plotcandle(
     longSignal or shortSignal ? open : na,
     longSignal or shortSignal ? high : na,
     longSignal or shortSignal ? low : na,
     longSignal or shortSignal ? close : na,
     title = "Signal candle · bright",
     color = keyColour,
     wickcolor = keyColour,
     bordercolor = keyColour)

plotshape(
     showSignals and longSignal,
     title = "Long launch",
     style = shape.triangleup,
     location = location.belowbar,
     color = KEY_LONG,
     textcolor = #131722,
     size = size.tiny,
     text = "L")
plotshape(
     showSignals and shortSignal,
     title = "Short launch",
     style = shape.triangledown,
     location = location.abovebar,
     color = KEY_SHORT,
     textcolor = #131722,
     size = size.tiny,
     text = "S")

bool longK1 = longSignal and longDirect
bool shortK1 = shortSignal and shortDirect
bool longK2 = longSignal and not longDirect and (longReject or longCoil)
bool shortK2 = shortSignal and not shortDirect and (shortReject or shortCoil)
plotshape(
     showKeyTags and longK1,
     "Long K1",
     shape.labelup,
     location.belowbar,
     KEY_LONG,
     text = "K1",
     textcolor = #131722,
     size = size.tiny)
plotshape(
     showKeyTags and shortK1,
     "Short K1",
     shape.labeldown,
     location.abovebar,
     KEY_SHORT,
     text = "K1",
     textcolor = #131722,
     size = size.tiny)
plotshape(
     showKeyTags and longK2,
     "Long K2",
     shape.labelup,
     location.belowbar,
     KEY_LONG,
     text = "K2",
     textcolor = #131722,
     size = size.tiny)
plotshape(
     showKeyTags and shortK2,
     "Short K2",
     shape.labeldown,
     location.abovebar,
     KEY_SHORT,
     text = "K2",
     textcolor = #131722,
     size = size.tiny)

// One-position research visualization. Signals remain visible while a position is active.
var int positionSide = 0
var int entryBar = na
var float entryPrice = na
var float signalAtr = na
var float activeStop = na
var bool runnerArmed = false
var box rewardBox = na
var box riskBox = na

bool enterLong = barstate.isnew and positionSide == 0 and longSignal[1] and not shortSignal[1]
bool enterShort = barstate.isnew and positionSide == 0 and shortSignal[1] and not longSignal[1]
if barstate.isnew and positionSide == 0 and longSignal[1] and shortSignal[1]
    enterLong := longScore[1] >= shortScore[1]
    enterShort := not enterLong

if enterLong or enterShort
    positionSide := enterLong ? 1 : -1
    entryBar := bar_index
    entryPrice := open
    signalAtr := atr14[1]
    activeStop := entryPrice - positionSide * disasterStopAtr * signalAtr
    runnerArmed := false
    if showZones
        float rewardGuide = entryPrice + positionSide * rewardGuideAtr * signalAtr
        rewardBox := box.new(
             bar_index,
             math.max(entryPrice, rewardGuide),
             bar_index + zoneProjection,
             math.min(entryPrice, rewardGuide),
             border_color = color.new(REWARD, 25),
             border_width = 1,
             bgcolor = color.new(REWARD, 88))
        riskBox := box.new(
             bar_index,
             math.max(entryPrice, activeStop),
             bar_index + zoneProjection,
             math.min(entryPrice, activeStop),
             border_color = color.new(RISK, 25),
             border_width = 1,
             bgcolor = color.new(RISK, 88))

bool stopHit =
     positionSide == 1 ? low <= activeStop :
     positionSide == -1 ? high >= activeStop : false
bool timeExit = positionSide != 0 and bar_index - entryBar + 1 >= maxHoldBars

if barstate.isconfirmed and positionSide != 0
    if showZones
        box.set_right(rewardBox, bar_index + zoneProjection)
        box.set_right(riskBox, bar_index + zoneProjection)
    if stopHit or timeExit
        if showZones
            box.set_right(rewardBox, bar_index)
            box.set_right(riskBox, bar_index)
        positionSide := 0
        entryBar := na
        entryPrice := na
        signalAtr := na
        activeStop := na
        runnerArmed := false
    else
        float signedCloseProfitAtr = positionSide * (close - entryPrice) / signalAtr
        if not runnerArmed and signedCloseProfitAtr >= runnerArmAtr
            runnerArmed := true
        if runnerArmed
            float candidateStop = sma60 - positionSide * runnerBufferAtr * atr14
            activeStop :=
                 positionSide == 1 ? math.max(activeStop, candidateStop) : math.min(activeStop, candidateStop)

plot(
     showActiveStop and positionSide != 0 ? activeStop : na,
     "Active trend stop",
     color = runnerArmed ? color.new(REWARD, 0) : color.new(RISK, 0),
     linewidth = 1,
     style = plot.style_linebr)
plot(entryPrice, "Active entry", color = na, display = display.data_window)
plot(activeStop, "Active stop value", color = na, display = display.data_window)
plot(longScore, "Long launch score", color = na, display = display.data_window)
plot(shortScore, "Short launch score", color = na, display = display.data_window)

alertcondition(longSignal, "15m long launch", "Fable 15m Trend LONG on {{ticker}} {{interval}}")
alertcondition(shortSignal, "15m short launch", "Fable 15m Trend SHORT on {{ticker}} {{interval}}")
if alertsEnabled and longSignal
    alert(
         "Fable 15m Trend | LONG | " + syminfo.tickerid +
              " | next-open entry | initial stop 2ATR | SMA60-ATR runner after +2ATR close",
         alert.freq_once_per_bar_close)
else if alertsEnabled and shortSignal
    alert(
         "Fable 15m Trend | SHORT | " + syminfo.tickerid +
              " | next-open entry | initial stop 2ATR | SMA60+ATR runner after +2ATR close",
         alert.freq_once_per_bar_close)

var table hud = table.new(
     position.top_right,
     1,
     1,
     bgcolor = color.new(#131722, 35),
     frame_width = 0,
     border_width = 0)
if barstate.islast
    string status =
         not isFifteenMinute ? "TF!" :
         positionSide == 1 ? (runnerArmed ? "L RUN" : "L") :
         positionSide == -1 ? (runnerArmed ? "S RUN" : "S") : "15M"
    color statusColour =
         not isFifteenMinute ? RISK : positionSide == -1 ? KEY_SHORT : KEY_LONG
    if showPanel
        table.cell(
             hud,
             0,
             0,
             status,
             text_color = statusColour,
             bgcolor = color.new(#131722, 35),
             text_size = size.tiny)
    else
        table.clear(hud, 0, 0, 0, 0)
