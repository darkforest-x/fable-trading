    {
      "id": "monthly",
      "label": "V28 · 保存证据实际SQLite查询 · monthly",
      "path": "experiments/active/exp-btcusdtp-1h-vwma-fixed-clock-preholdout-20260907-v28/results",
      "query": {
        "sql": "WITH c AS (SELECT mother_month AS month,COUNT(*) AS mothers,\nCOUNT(cost_threshold_markout) AS known,AVG(gross_markout)*10000 AS gross_bp,\nAVG(cost_threshold_markout)*10000 AS cost_threshold_bp\nFROM cases WHERE horizon_hours=4 GROUP BY mother_month),\np AS (SELECT mother_month AS month,COUNT(cost_threshold_excess_markout) AS paired,\nAVG(control_mean_cost_threshold_markout)*10000 AS background_bp,\nAVG(cost_threshold_excess_markout)*10000 AS excess_bp\nFROM pairs WHERE horizon_hours=4 GROUP BY mother_month)\nSELECT * FROM c JOIN p USING(month) ORDER BY month",
        "engine": "sqlite",
        "language": "sql",
        "executed_at": "2026-09-07T03:05:53.537909+00:00",
        "tables_used": [
          "cases",
          "pairs"
        ],
        "description": "按原始母单时间聚合；保留未知分母和全部尾部，不用于调参",
        "filters": [
          "2023/24 development,288 original VWMA mothers"
        ],
        "metric_definitions": {
          "case_labels": "experiments/active/exp-btcusdtp-1h-vwma-fixed-clock-preholdout-20260907-v28/results/case_labels.csv.gz",
          "paired_labels": "experiments/active/exp-btcusdtp-1h-vwma-fixed-clock-preholdout-20260907-v28/results/paired_labels.csv.gz"
        }
      }
    },
    {
      "id": "distribution",
      "label": "V28 · 保存证据实际SQLite查询 · distribution",
      "path": "experiments/active/exp-btcusdtp-1h-vwma-fixed-clock-preholdout-20260907-v28/results",
      "query": {
        "sql": "WITH RECURSIVE binned AS (\nSELECT FLOOR(cost_threshold_markout*10000/50)*50 AS lower_bp FROM cases\nWHERE horizon_hours=4 AND status='known'),\nbins(lower_bp) AS (SELECT MIN(lower_bp) FROM binned UNION ALL\nSELECT lower_bp+50 FROM bins WHERE lower_bp<(SELECT MAX(lower_bp) FROM binned)),\ncounts AS (SELECT lower_bp,COUNT(*) AS events FROM binned GROUP BY lower_bp)\nSELECT CAST(bins.lower_bp AS INTEGER)||' to <'||CAST(bins.lower_bp+50 AS INTEGER) AS bin,\nbins.lower_bp,bins.lower_bp+50 AS upper_bp,COALESCE(counts.events,0) AS events\nFROM bins LEFT JOIN counts USING(lower_bp) ORDER BY bins.lower_bp",
        "engine": "sqlite",
        "language": "sql",
        "executed_at": "2026-09-07T03:05:53.537909+00:00",
