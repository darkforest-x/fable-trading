            [s, e, r] = f_v130_step(s0, e0, 1, 10.0, 7.0, j, array.get(a0_open_,j), array.get(a0_high,j), array.get(a0_low,j), array.get(a0_close,j), array.get(a0_gap,j), array.get(a0_raw_side,j), 24)
            s0 := s
