//@version=6
// Fable K1->K2 5m research parameters.
//
// Causal entry rule:
// - K1 crosses SMA40(HL2), has body/range >= 0.65, and its MA-side colour
//   agrees with direction.
// - Every completed bar strictly between K1 and K2 both closes and colours on
//   the intended SMA40 side.
// - K2 physically touches SMA40 with its rejection wick, while SMA40 never
//   enters the K2 body.
// - The next-open entry is kept only when 0.2% / initial-risk-percent <= 1.25R.
//
// Frozen 5m research defaults: gap 2--8, exact K2-extreme stop, 3R target, and a
// fee-cover protection stop armed only after a completed bar closes at 1.5R.
// The protection stop may act from the following bar. No parameter change met
// the development gate and frozen validation failed; this is research-only.
indicator(
     "Fable K1→K2 · 5m Research V1",
     shorttitle = "Fable K1→K2 5m",
     overlay = true,
     behind_chart = false,
     max_bars_back = 500,
     max_labels_count = 200,
     max_lines_count = 500,
     max_boxes_count = 200)

// ─────────────────────────────────────────────────────────────────────────────
// Inputs
// ─────────────────────────────────────────────────────────────────────────────
string GROUP_RULE = "1 · Rule"
string GROUP_DISPLAY = "2 · Display"
string GROUP_ALERTS = "3 · Alerts"

string sideMode = input.string(
     "Both", "Direction", options = ["Both", "Long only", "Short only"], group = GROUP_RULE)
float feeToRiskMax = input.float(
     1.25,
     "Maximum fee / risk (R)",
     minval = 0.05,
     maxval = 5.0,
     step = 0.05,
     tooltip = "0.2% round-trip cost divided by next-open initial risk percent.",
     group = GROUP_RULE)
float roundTripCost = input.float(
     0.002, "Round-trip cost", minval = 0.0, maxval = 0.02, step = 0.0001, group = GROUP_RULE)
int cooldownBars = input.int(72, "Signal cooldown", minval = 1, maxval = 500, group = GROUP_RULE)
float targetR = input.float(3.0, "Target (R)", minval = 0.25, maxval = 20.0, step = 0.25, group = GROUP_RULE)
float protectionTriggerR = input.float(
     1.5,
     "Protection arm on close (R)",
     minval = 0.25,
     maxval = 10.0,
     step = 0.25,
     tooltip = "After a completed close reaches this level, move the stop to the fee-cover line from the next bar.",
     group = GROUP_RULE)

bool showSma40 = input.bool(true, "Show SMA40(HL2)", group = GROUP_DISPLAY)
bool colourBars = input.bool(true, "Source-style MA candles", group = GROUP_DISPLAY)
bool showKeyCandles = input.bool(true, "K1 / K2 highlights", group = GROUP_DISPLAY)
bool showSignals = input.bool(true, "Compact L / S marker", group = GROUP_DISPLAY)
bool showPositionBoxes = input.bool(true, "Target / risk zones", group = GROUP_DISPLAY)
bool showManagementLines = input.bool(true, "Protection levels", group = GROUP_DISPLAY)
int projectionBars = input.int(12, "Zone width", minval = 1, maxval = 100, group = GROUP_DISPLAY)
bool showPanel = input.bool(true, "Tiny status chip", group = GROUP_DISPLAY)

bool alertNextOpen = input.bool(true, "Alert causal next-open signal", group = GROUP_ALERTS)

// ─────────────────────────────────────────────────────────────────────────────
// Frozen indicator state
// ─────────────────────────────────────────────────────────────────────────────
float atr14 = ta.atr(14)
float sma40 = ta.sma(hl2, 40)
float sma20 = ta.sma(close, 20)
float ema20 = ta.ema(close, 20)
float sma60 = ta.sma(close, 60)
float ema60 = ta.ema(close, 60)
float sma120 = ta.sma(close, 120)
float ema120 = ta.ema(close, 120)
float ropeHigh = math.max(
     math.max(math.max(sma20, ema20), math.max(sma60, ema60)),
     math.max(sma120, ema120))
float ropeLow = math.min(
     math.min(math.min(sma20, ema20), math.min(sma60, ema60)),
     math.min(sma120, ema120))
float ropeMid = (sma20 + ema20 + sma60 + ema60 + sma120 + ema120) / 6.0
int maCandleSide = hl2 >= sma40 ? 1 : -1

f_clamp01(float value) =>
    math.max(0.0, math.min(1.0, nz(value, 0.0)))

// Returns: found, selected gap, K1 quality.
f_findBestK1(int direction) =>
    bool found = false
    int bestGap = na
    float bestQuality = na

    float k2Range = high - low
    float k2Body = math.abs(close - open)
    float k2BodyRatio = k2Range > 0.0 ? k2Body / k2Range : na
    float k2Wick =
         direction == 1 ? math.min(open, close) - low : high - math.max(open, close)
    float k2WickShare = k2Range > 0.0 ? k2Wick / k2Range : na
    float k2RejectLocation =
         direction == 1 ? (close - low) / k2Range : (high - close) / k2Range
    float k2TouchDepth =
         direction == 1 ? (sma40 - low) / atr14 : (high - sma40) / atr14
    float k2CloseSide =
         direction == 1 ? (close - sma40) / atr14 : (sma40 - close) / atr14
    bool k2BodyTrendSide =
         direction == 1 ? math.min(open, close) >= sma40 : math.max(open, close) <= sma40
    bool k2Morphology =
         not na(k2BodyRatio) and
         not na(k2TouchDepth) and
         k2WickShare >= 0.25 and
         k2BodyRatio <= 0.50 and
         k2RejectLocation >= 0.25 and
         k2TouchDepth >= 0.00 and
         k2TouchDepth <= 1.50 and
         k2CloseSide >= 0.00 and
         k2BodyTrendSide

    if k2Morphology
        for gap = 2 to 8
            float k1Range = high[gap] - low[gap]
            float k1Body = math.abs(close[gap] - open[gap])
            float k1Atr = atr14[gap]
            float k1BodyRatio = k1Range > 0.0 ? k1Body / k1Range : na
            float k1RangeAtr = k1Atr > 0.0 ? k1Range / k1Atr : na
            float k1CloseLocation =
                 direction == 1 ?
                 (close[gap] - low[gap]) / k1Range :
                 (high[gap] - close[gap]) / k1Range
            float k1EntryDepth =
                 direction == 1 ?
                 (sma40[gap] - open[gap]) / k1Atr :
                 (open[gap] - sma40[gap]) / k1Atr
            float k1ExitDepth =
                 direction == 1 ?
                 (close[gap] - sma40[gap]) / k1Atr :
                 (sma40[gap] - close[gap]) / k1Atr
            bool k1DirectionalBody = direction * (close[gap] - open[gap]) > 0.0
            bool k1MaAligned = maCandleSide[gap] == direction
            bool k1Morphology =
                 not na(k1BodyRatio) and
                 not na(k1EntryDepth) and
                 k1DirectionalBody and
                 k1BodyRatio >= 0.65 and
                 k1RangeAtr >= 0.95 and
                 k1CloseLocation >= 0.70 and
                 k1EntryDepth >= -0.05 and
                 k1ExitDepth >= -0.05 and
                 k1MaAligned

            if k1Morphology and not na(ropeHigh[gap]) and not na(ropeLow[gap])
                int wrongSmaCloses = 0
                int alignedMaBars = 0
                for step = 1 to gap - 1
                    bool wrongClose =
                         direction == 1 ? close[step] < sma40[step] : close[step] > sma40[step]
                    if wrongClose
                        wrongSmaCloses += 1
                    int middleMaSide = hl2[step] >= sma40[step] ? 1 : -1
                    if middleMaSide == direction
                        alignedMaBars += 1
                bool pathPass = wrongSmaCloses == 0 and alignedMaBars == gap - 1

                if pathPass
                    float k1BodyLow = math.min(open[gap], close[gap])
                    float k1BodyHigh = math.max(open[gap], close[gap])
                    float ropeWidth = ropeHigh[gap] - ropeLow[gap]
                    float ropeOverlap = math.max(
                         0.0,
                         math.min(k1BodyHigh, ropeHigh[gap]) - math.max(k1BodyLow, ropeLow[gap]))
                    float ropeCoverage =
                         ropeWidth > 0.0 ?
                         math.min(1.0, ropeOverlap / ropeWidth) :
                         (k1BodyLow <= ropeMid[gap] and k1BodyHigh >= ropeMid[gap] ? 1.0 : 0.0)
                    float ropeEntryDepth =
                         direction == 1 ?
                         (ropeLow[gap] - open[gap]) / k1Atr :
                         (open[gap] - ropeHigh[gap]) / k1Atr
                    float ropeExitDepth =
                         direction == 1 ?
                         (close[gap] - ropeHigh[gap]) / k1Atr :
                         (ropeLow[gap] - close[gap]) / k1Atr
                    float smaCrossDepth = math.min(k1EntryDepth, k1ExitDepth)
                    float k1Quality = (
                         math.min(1.0, ropeCoverage) +
                         math.min(1.0, math.max(0.0, k1BodyRatio)) +
                         math.min(1.0, math.max(0.0, k1RangeAtr / 2.0)) +
                         math.min(1.0, math.max(0.0, (smaCrossDepth + 0.05) / 0.50))
                         ) / 4.0
                    if not found or k1Quality > bestQuality
                        found := true
                        bestGap := gap
                        bestQuality := k1Quality
    [found, bestGap, bestQuality]

[longK2Found, longK1Gap, longK1Quality] = f_findBestK1(1)
[shortK2Found, shortK1Gap, shortK1Quality] = f_findBestK1(-1)

bool isFiveMinute = timeframe.in_seconds() == 300
bool timeframeOk = isFiveMinute
bool longAllowed = sideMode != "Short only"
bool shortAllowed = sideMode != "Long only"

// ─────────────────────────────────────────────────────────────────────────────
// Causal next-open economics and de-duplication
// ─────────────────────────────────────────────────────────────────────────────
float longRisk = longK2Found[1] ? open - low[1] : na
float shortRisk = shortK2Found[1] ? high[1] - open : na
float longRiskAtr = longK2Found[1] and atr14[1] > 0.0 ? longRisk / atr14[1] : na
float shortRiskAtr = shortK2Found[1] and atr14[1] > 0.0 ? shortRisk / atr14[1] : na
float longRiskFraction = longRisk > 0.0 ? longRisk / open : na
float shortRiskFraction = shortRisk > 0.0 ? shortRisk / open : na
float longFeeToRisk = longRiskFraction > 0.0 ? roundTripCost / longRiskFraction : na
float shortFeeToRisk = shortRiskFraction > 0.0 ? roundTripCost / shortRiskFraction : na
bool rawLongEntry =
     timeframeOk and longAllowed and longK2Found[1] and
     longRiskAtr >= 0.15 and longRiskAtr <= 2.50 and longFeeToRisk <= feeToRiskMax
bool rawShortEntry =
     timeframeOk and shortAllowed and shortK2Found[1] and
     shortRiskAtr >= 0.15 and shortRiskAtr <= 2.50 and shortFeeToRisk <= feeToRiskMax

varip bool longEntryEvent = false
varip bool shortEntryEvent = false
varip int eventGap = na
varip float eventFeeToRisk = na
varip int lastAcceptedBar = na
varip int lastLongK1Bar = na
varip int lastShortK1Bar = na

if barstate.isnew
    longEntryEvent := false
    shortEntryEvent := false
    eventGap := na
    eventFeeToRisk := na
    bool cooldownReady = na(lastAcceptedBar) or bar_index - lastAcceptedBar >= cooldownBars
    int proposedLongK1Bar =
         rawLongEntry and not na(longK1Gap[1]) ? bar_index - 1 - longK1Gap[1] : na
    int proposedShortK1Bar =
         rawShortEntry and not na(shortK1Gap[1]) ? bar_index - 1 - shortK1Gap[1] : na
    bool longK1Unused = na(lastLongK1Bar) or proposedLongK1Bar != lastLongK1Bar
    bool shortK1Unused = na(lastShortK1Bar) or proposedShortK1Bar != lastShortK1Bar
    if rawLongEntry and cooldownReady and longK1Unused
        longEntryEvent := true
        eventGap := longK1Gap[1]
        eventFeeToRisk := longFeeToRisk
        lastAcceptedBar := bar_index
        lastLongK1Bar := proposedLongK1Bar
    else if rawShortEntry and cooldownReady and shortK1Unused
        shortEntryEvent := true
        eventGap := shortK1Gap[1]
        eventFeeToRisk := shortFeeToRisk
        lastAcceptedBar := bar_index
        lastShortK1Bar := proposedShortK1Bar

bool eventLong = longEntryEvent
bool eventShort = shortEntryEvent
float eventEntry = open
float eventStop = eventLong ? low[1] : eventShort ? high[1] : na
float eventRisk = eventLong ? eventEntry - eventStop : eventShort ? eventStop - eventEntry : na
float eventTarget =
     eventLong ? eventEntry + eventRisk * targetR :
     eventShort ? eventEntry - eventRisk * targetR : na
float eventProtectionArm =
     eventLong ? eventEntry + eventRisk * protectionTriggerR :
     eventShort ? eventEntry - eventRisk * protectionTriggerR : na
float eventFeeCover =
     eventLong ? eventEntry * (1.0 + roundTripCost) :
     eventShort ? eventEntry * (1.0 - roundTripCost) : na

// ─────────────────────────────────────────────────────────────────────────────
// Exact ChartPrime MA Shift source-style candles and thin line
// ─────────────────────────────────────────────────────────────────────────────
color MA_UP = #17A297
color MA_DOWN = color.orange
color LONG = MA_UP
color SHORT = MA_DOWN
color TARGET = #089981
color RISK = #F23645
color KEY_LONG = #00D7BD
color KEY_SHORT = #FFB020
color NEUTRAL = #787B86
color maShiftColor = maCandleSide == 1 ? MA_UP : MA_DOWN

plot(showSma40 ? sma40 : na, "MA Shift 40 · main", color = maShiftColor, linewidth = 1)
plot(
     showSma40 ? sma40 : na,
     "MA Shift 40 · glow",
     color = color.new(maShiftColor, 80),
     linewidth = 7,
     display = display.none)
barcolor(colourBars and not na(sma40) ? maShiftColor : na, title = "MA Shift bar colour · source")
plotcandle(
     colourBars and not na(sma40) ? open : na,
     colourBars and not na(sma40) ? high : na,
     colourBars and not na(sma40) ? low : na,
     colourBars and not na(sma40) ? close : na,
     title = "MA Shift candles · source",
     color = maShiftColor,
     wickcolor = maShiftColor,
     bordercolor = maShiftColor)

plot(eventFeeToRisk, "Fee / initial risk (R)", color = na, display = display.data_window)
plot(longK1Quality, "Long selected K1 quality", color = na, display = display.data_window)
plot(shortK1Quality, "Short selected K1 quality", color = na, display = display.data_window)

// ─────────────────────────────────────────────────────────────────────────────
// Compact key candles, markers, and clean position zones
// ─────────────────────────────────────────────────────────────────────────────
if showKeyCandles and (eventLong or eventShort)
    int k2History = 1
    int k1History = 1 + eventGap
    int k2X = bar_index - k2History
    int k1X = bar_index - k1History
    color keyColor = eventLong ? KEY_LONG : KEY_SHORT
    line.new(k1X, low[k1History], k1X, high[k1History], color = keyColor, width = 2)
    line.new(k1X, open[k1History], k1X, close[k1History], color = keyColor, width = 5)
    line.new(k2X, low[k2History], k2X, high[k2History], color = keyColor, width = 2)
    line.new(k2X, open[k2History], k2X, close[k2History], color = keyColor, width = 5)
    label.new(
         k1X,
         eventLong ? low[k1History] : high[k1History],
         "K1",
         yloc = eventLong ? yloc.belowbar : yloc.abovebar,
         style = eventLong ? label.style_label_up : label.style_label_down,
         color = color.new(keyColor, 5),
         textcolor = #131722,
         size = size.tiny)
    label.new(
         k2X,
         eventLong ? high[k2History] : low[k2History],
         "K2",
         yloc = eventLong ? yloc.abovebar : yloc.belowbar,
         style = eventLong ? label.style_label_down : label.style_label_up,
         color = color.new(keyColor, 5),
         textcolor = #131722,
         size = size.tiny)

plotshape(
     showSignals and eventLong,
     title = "Long signal",
     style = shape.triangleup,
     location = location.belowbar,
     color = LONG,
     textcolor = color.white,
     size = size.small,
     text = "L",
     offset = -1)
plotshape(
     showSignals and eventShort,
     title = "Short signal",
     style = shape.triangledown,
     location = location.abovebar,
     color = SHORT,
     textcolor = color.white,
     size = size.small,
     text = "S",
     offset = -1)

if (eventLong or eventShort) and showPositionBoxes
    int rightX = bar_index + projectionBars
    box.new(
         bar_index,
         math.max(eventEntry, eventTarget),
         rightX,
         math.min(eventEntry, eventTarget),
         border_color = color.new(TARGET, 28),
         border_width = 1,
         bgcolor = color.new(TARGET, 88))
    box.new(
         bar_index,
         math.max(eventEntry, eventStop),
         rightX,
         math.min(eventEntry, eventStop),
         border_color = color.new(RISK, 28),
         border_width = 1,
         bgcolor = color.new(RISK, 88))
    line.new(bar_index, eventEntry, rightX, eventEntry, color = color.new(NEUTRAL, 18), width = 1)
    if showManagementLines
        line.new(
             bar_index,
             eventProtectionArm,
             rightX,
             eventProtectionArm,
             color = color.new(KEY_SHORT, 35),
             style = line.style_dashed,
             width = 1)
        line.new(
             bar_index,
             eventFeeCover,
             rightX,
             eventFeeCover,
             color = color.new(NEUTRAL, 45),
             style = line.style_dotted,
             width = 1)

// ─────────────────────────────────────────────────────────────────────────────
// Alerts and one-cell status chip
// ─────────────────────────────────────────────────────────────────────────────
alertcondition(eventLong, "5m causal long next-open", "Fable K1→K2 5m LONG on {{ticker}} {{interval}}")
alertcondition(eventShort, "5m causal short next-open", "Fable K1→K2 5m SHORT on {{ticker}} {{interval}}")

if alertNextOpen and barstate.isnew and eventLong
    alert(
         "Fable K1→K2 5m | LONG | " + syminfo.tickerid +
              " | entry=" + str.tostring(eventEntry, format.mintick) +
              " | stop=" + str.tostring(eventStop, format.mintick) +
              " | target=" + str.tostring(eventTarget, format.mintick) +
              " | fee/risk=" + str.tostring(eventFeeToRisk, "#.00") + "R" +
              " | protect after " + str.tostring(protectionTriggerR, "#.00") +
              "R close, next bar fee-cover stop",
         alert.freq_once_per_bar)
else if alertNextOpen and barstate.isnew and eventShort
    alert(
         "Fable K1→K2 5m | SHORT | " + syminfo.tickerid +
              " | entry=" + str.tostring(eventEntry, format.mintick) +
              " | stop=" + str.tostring(eventStop, format.mintick) +
              " | target=" + str.tostring(eventTarget, format.mintick) +
              " | fee/risk=" + str.tostring(eventFeeToRisk, "#.00") + "R" +
              " | protect after " + str.tostring(protectionTriggerR, "#.00") +
              "R close, next bar fee-cover stop",
         alert.freq_once_per_bar)

var table hud = table.new(
     position.top_right,
     1,
     1,
     bgcolor = color.new(#131722, 28),
     frame_width = 0,
     border_width = 0)
if barstate.islast
    string statusText = isFiveMinute ? "5M" : "TF!"
    color statusColor = timeframeOk ? LONG : RISK
    if showPanel
        table.cell(
             hud,
             0,
             0,
             statusText,
             text_color = statusColor,
             bgcolor = color.new(#131722, 28),
             text_size = size.tiny)
    else
        table.clear(hud, 0, 0, 0, 0)
