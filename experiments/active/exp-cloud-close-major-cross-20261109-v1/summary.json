  "signal_rule": {
    "ema": "Reuse cloud_close_reward_paths._ema_points_12h: alpha=2/(period+1), first completed close seed, 50 consecutive 12H bars required, reset after any 12H gap.",
    "direction_flip": "A nonzero EMA20-EMA50 sign change from the last nonzero direction; equality is neutral and does not create a flip. The initial ready direction is not an entry because no prior direction exists.",
    "entry_filter": "At that exact flip's completed 12H close: long requires close>EMA20 and close>EMA50; short requires close<EMA20 and close<EMA50. Strict inequalities. If it fails, skip that flip and wait for a later opposite direction reversal.",
    "entry_execution": "Market at the exact H1 open timestamp equal to the completed 12H confirmation time. If no exact open exists, mark no entry; do not shift later.",
    "stop": "Use fixed_stop('BTC' or 'ETH', side, confirmed_signal_EMA50); this retains the original BTC/ETH 1.5% fixed distance from the completed slow EMA. Reject and count an entry if the stop is not adverse relative to the executable H1 open.",
    "weekly_filter": "None. The native New York-week calendar is retained only as a descriptive label."
  },
  "exit_rule": {
    "engine": "Reuse cloud_close_reward_paths._simulate_symbol / VectorBT callback with tp_r=0; use the V1.7 intrabar EMA20/50 cross, open-gap, stale-data, and true source-tail semantics.",
    "protection": "The signal EMA50-anchored fixed_stop remains unchanged for the entire position.",
    "same_open_reverse": "Keep the existing wallet.admit rule: an old position with exit_bar_ms equal to a new same-symbol entry_ms still occupies that symbol slot. Do not use lookahead to close then re-enter within one open; count and label such missed reversals.",
    "funding": "Not included."
  },
